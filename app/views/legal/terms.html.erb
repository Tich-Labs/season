<%# Utility/legal screen, not a primary app screen — no FAB. %>
<% content_for(:hide_quick_actions) { "true" } %>
<% content_for(:hide_calendar_fab) { "true" } %>

<div class="bg-white min-h-screen max-w-app mx-auto px-8" style="padding-top:calc(60px + env(safe-area-inset-top,0px));padding-bottom:calc(3rem + env(safe-area-inset-bottom,0px))">

  <div class="mb-6">
    <a href="javascript:history.back()" class="text-brand-primary no-underline text-base font-normal">
      <%= t("shared.back") %>
    </a>
  </div>

  <h1 class="text-brand-primary text-28 font-bold uppercase tracking-[2px] mb-8 text-center">
    <%= t("legal.terms.title") %>
  </h1>

  <div class="text-brand-secondary text-15 leading-relaxed">

    <p class="mb-5">
      <%= t("legal.terms.intro") %>
    </p>

    <h2 class="text-brand-primary text-17 font-semibold mb-2.5"><%= t("legal.terms.use.title") %></h2>
    <p class="mb-5">
      <%= t("legal.terms.use.body") %>
    </p>

    <h2 class="text-brand-primary text-17 font-semibold mb-2.5"><%= t("legal.terms.health.title") %></h2>
    <p class="mb-5">
      <%= t("legal.terms.health.body") %>
    </p>

    <h2 class="text-brand-primary text-17 font-semibold mb-2.5"><%= t("legal.terms.data.title") %></h2>
    <p class="mb-5">
      <%= t("legal.terms.data.body_html", privacy_link: link_to(t("legal.terms.data.privacy_link"), privacy_path, class: "text-brand-primary")) %>
    </p>

    <h2 class="text-brand-primary text-17 font-semibold mb-2.5"><%= t("legal.terms.changes.title") %></h2>
    <p class="mb-5">
      <%= t("legal.terms.changes.body") %>
    </p>

    <h2 class="text-brand-primary text-17 font-semibold mb-2.5"><%= t("legal.terms.contact.title") %></h2>
    <p class="mb-5">
      <%= t("legal.terms.contact.body_html", email_link: mail_to(t("legal.terms.contact.email_link"), t("legal.terms.contact.email_link"), class: "text-brand-primary")) %>
    </p>

  </div>

</div>
