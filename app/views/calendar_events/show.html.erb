<% content_for(:page_title) { "Appointment" } %>
<% content_for(:header_left) do %>
  <%= link_to calendar_appointments_path,
        class: "inline-flex items-center justify-center w-10 h-10 rounded-xl text-brand-primary" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
      <polyline points="15 18 9 12 15 6" />
    </svg>
  <% end %>
<% end %>

<%
  phase     = current_user.current_phase
  phase_col = CycleCalculatorService::PHASE_META[phase]&.dig(:colour) || "#933a35"
%>

<div class="bg-brand-background min-h-screen pb-24">
  <div class="max-w-app mx-auto">

    <div class="relative">
      <div class="h-20 bg-brand-field"></div>
      <div class="absolute inset-0 flex items-center px-4">
        <%= content_for :header_left %>
        <div class="flex-1 text-center">
          <h1 class="text-lg font-semibold text-brand-primary">Appointment</h1>
        </div>
        <div class="w-10"></div>
      </div>
    </div>

    <div class="px-4 pt-5 space-y-4">
      <%# ── Date/Time Header ── %>
      <div class="rounded-[32px] overflow-hidden" style="background: <%= phase_col %>33;">
        <div class="px-5 pt-5 pb-4">
          <h2 class="text-3xl font-semibold text-white"><%= @event.title %></h2>
        </div>

        <div class="mx-4 mb-[-24px]">
          <div class="rounded-[30px] bg-white p-5 shadow-sm">
            <p class="text-sm font-semibold text-brand-primary"><%= @event.date.strftime("%A, %B %-d %Y") %></p>
            <p class="mt-3 text-xl font-semibold text-brand-primary">
              <% if @event.start_time.present? && @event.end_time.present? %>
                <%= @event.start_time.strftime("%-H:%M") %> – <%= @event.end_time.strftime("%-H:%M") %>
              <% elsif @event.start_time.present? %>
                <%= @event.start_time.strftime("%-H:%M") %>
              <% else %>
                All day
              <% end %>
            </p>
          </div>
        </div>
      </div>

      <%# ── Details Card ── %>
      <div class="rounded-[28px] bg-white p-4 shadow-sm space-y-4">
        <%# Reminders %>
        <% if @event.reminders&.any? %>
          <div class="space-y-2 border-b border-brand-field pb-4">
            <p class="text-xs font-semibold text-brand-secondary uppercase">Reminders</p>
            <% @event.reminders.each do |reminder| %>
              <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-brand-primary">
                  <path d="M12 8v4l3 3" />
                  <path d="M19.4 15a7.5 7.5 0 1 0-1.4 1.4" />
                </svg>
                <span class="text-sm font-medium text-brand-primary"><%= reminder.duration %> before</span>
              </div>
            <% end %>
          </div>
        <% end %>

        <%# Location %>
        <% if @event.location.present? %>
          <div class="space-y-2 border-b border-brand-field pb-4">
            <p class="text-xs font-semibold text-brand-secondary uppercase">Location</p>
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-brand-primary">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
              <span class="text-sm font-medium text-brand-primary"><%= @event.location %></span>
            </div>
          </div>
        <% end %>

        <%# Notes %>
        <% if @event.notes.present? %>
          <div class="space-y-2 border-b border-brand-field pb-4">
            <p class="text-xs font-semibold text-brand-secondary uppercase">Notes</p>
            <p class="text-sm text-brand-primary"><%= @event.notes %></p>
          </div>
        <% end %>

        <%# Category %>
        <% if @event.category.present? %>
          <div class="space-y-2">
            <p class="text-xs font-semibold text-brand-secondary uppercase">Category</p>
            <div class="flex items-center gap-2">
              <% icon_map = {
                'Friends' => 'family.svg',
                'Dinner' => 'dinner.svg',
                'Date' => 'date.svg',
                'Sports' => 'sport.svg',
                'Medical' => 'medical.svg',
                'Birthday' => 'birthday.svg',
                'Work' => 'work.svg',
                'Coffee' => 'coffee.svg',
                'Shopping' => 'shopping.svg'
              } %>
              <% if icon_map[@event.category].present? %>
                <%= image_tag "icons/appointment/#{icon_map[@event.category]}", alt: @event.category, class: "w-6 h-6" %>
              <% end %>
              <span class="text-sm font-medium text-brand-primary"><%= @event.category %></span>
            </div>
          </div>
        <% end %>
      </div>

      <%# ── Action Buttons ── %>
      <div class="space-y-3 pb-6">
        <%= link_to "Edit appointment", edit_calendar_event_path(@event), class: "block w-full bg-brand-primary text-white text-center rounded-xl py-3 font-semibold no-underline" %>

        <%= button_to "Delete appointment", calendar_event_path(@event), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "w-full bg-brand-error text-brand-primary border border-brand-primary rounded-xl py-3 font-semibold" %>
      </div>
    </div>
  </div>
</div>
