<% content_for(:page_title) { "Appointments" } %>
<% content_for(:header_left) do %>
  <%= link_to user_root_path,
        class: "inline-flex items-center justify-center w-10 h-10 rounded-xl text-brand-primary" do %>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
      <path d="M3 18H21V16H3V18ZM3 13H21V11H3V13ZM3 6V8H21V6H3Z" fill="#933A35" />
    </svg>
  <% end %>
<% end %>

<div class="bg-white min-h-screen pb-24 font-sans">
  <div class="max-w-app mx-auto px-4 pt-5">

    <% if @events.any? %>
      <% @events.group_by { |e| e.date }.sort.each do |date, events| %>
        <div class="mb-6">
          <p class="text-sm font-semibold text-brand-secondary uppercase mb-3"><%= date.strftime("%A, %B %-d %Y") %></p>
          <div class="space-y-3">
            <% events.sort_by { |e| e.start_time || Time.zone.now }.each do |event| %>
              <%= link_to edit_calendar_event_path(event), class: "block no-underline" do %>
                <div class="rounded-lg p-4 relative" style="background:rgba(147,58,53,0.1);">
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <p class="text-xl font-semibold text-brand-primary leading-tight font-sans"><%= event.title %></p>
                      <p class="mt-2 text-sm font-medium text-brand-secondary font-sans">
                        <% if event.start_time.present? && event.end_time.present? %>
                          <%= event.start_time.strftime("%H:%M") %> - <%= event.end_time.strftime("%H:%M") %>
                        <% elsif event.start_time.present? %>
                          <%= event.start_time.strftime("%H:%M") %>
                        <% else %>
                          All day
                        <% end %>
                      </p>
                    </div>
                    <% if event.category.present? %>
                      <% icon_map = { 'Friends'=>'family.svg','Dinner'=>'dinner.svg','Date'=>'date.svg','Sports'=>'sport.svg','Medical'=>'medical.svg','Birthday'=>'birthday.svg','Work'=>'work.svg','Coffee'=>'coffee.svg','Shopping'=>'shopping.svg' } %>
                      <% if icon_map[event.category].present? %>
                        <div class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-primary/10 shrink-0">
                          <%= image_tag "icons/appointment/#{icon_map[event.category]}", alt: event.category, class: "w-8 h-8", style: "filter:brightness(0) saturate(100%) invert(28%) sepia(84%) saturate(1607%) hue-rotate(342deg) brightness(63%) contrast(94%);" %>
                        </div>
                      <% end %>
                    <% end %>
                  </div>
                  <% if event.notes.present? %>
                    <p class="mt-3 text-sm leading-relaxed text-brand-secondary font-sans">Note:<br><%= event.notes.truncate(60) %></p>
                  <% end %>
                  <div class="absolute bottom-4 right-4 flex h-10 w-10 items-center justify-center rounded-full bg-white shadow-sm">
                    <svg width="20" height="20" viewBox="0 0 23 23" fill="none">
                      <path d="M10.538 1.917H8.621C3.83 1.917 1.913 3.834 1.913 8.625v5.75c0 4.792 1.917 6.709 6.708 6.709h5.75c4.792 0 6.709-1.917 6.709-6.709v-1.916" stroke="#933A35" stroke-width="2.02" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M15.37 2.894L7.818 10.446c-.287.287-.575.853-.632 1.265l-.412 2.884c-.154 1.045.584 1.773 1.629 1.63l2.884-.413c.403-.057.968-.345 1.265-.632l7.552-7.552c1.303-1.303 1.917-2.817 0-4.734-1.917-1.917-3.431-1.303-4.734 0z" stroke="#933A35" stroke-width="2.02" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M14.285 3.978a5.75 5.75 0 014.734 4.734" stroke="#933A35" stroke-width="2.02" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="flex flex-col items-center justify-center py-16 text-center">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-brand-field mb-4">
          <rect x="3" y="4" width="18" height="18" rx="2" />
          <path d="M16 2v4M8 2v4M3 10h18" />
        </svg>
        <p class="text-brand-secondary text-lg font-medium font-sans">No appointments yet</p>
        <p class="text-brand-secondary text-sm mt-2 font-sans">Create your first appointment to get started</p>
        <%= link_to "Create appointment", new_calendar_event_path, class: "mt-6 inline-block bg-brand-primary text-white px-6 py-3 rounded-xl font-semibold no-underline font-sans" %>
      </div>
    <% end %>

  </div>
</div>
