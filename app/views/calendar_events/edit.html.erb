            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
          </svg>
        </div>
        <div class="absolute left-[18px] top-[101px] w-[320px] h-0 border border-brand-field"></div>
        <div class="absolute left-[36px] top-[130px] w-[283px] h-[100px] flex items-center justify-center gap-3 overflow-hidden">
          <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-11 bg-brand-field rounded-lg pointer-events-none"></div>
          <div data-season-modal-target="customReminderNum"
               class="overflow-y-auto snap-y snap-mandatory h-full w-14 [scrollbar-width:none] text-center relative z-[1]">
            <% (1..60).each do |n| %>
              <div data-value="<%= n %>" class="h-11 flex items-center justify-center text-22 tracking-003 text-brand-primary snap-center" style="font-weight:<%= n == 5 ? '700' : '400' %>;opacity:<%= n == 5 ? '1' : '0.4' %>"><%= format('%02d', n) %></div>
            <% end %>
