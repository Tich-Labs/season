        </button>
        <div class="absolute left-[152px] top-[34px] w-11 h-11 flex items-center justify-center">
          <svg width="44" height="44" viewBox="0 0 44 44" fill="none"><path d="M36.667 38.5V35.3333C36.667 33.3884 35.894 31.5232 34.519 30.1479C33.144 28.7726 31.278 28 29.333 28H14.667C12.722 28 10.857 28.7726 9.4813 30.1479C8.1059 31.5232 7.33337 33.3884 7.33337 35.3333V38.5" stroke="#933A35" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /><circle cx="22" cy="15.1667" r="7.33333" stroke="#933A35" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </div>
        <div class="absolute left-[34px] top-[100px] w-[280px] h-0 border border-brand-field"></div>
        <span class="absolute left-1/2 -translate-x-1/2 top-[120px] font-medium text-22 leading-[27px] tracking-003 text-brand-primary whitespace-nowrap">Invite Guests</span>
        <div class="absolute left-[32px] top-[166px] w-[284px] h-[52px] bg-brand-field opacity-50 rounded-lg"></div>
        <input type="email" autocomplete="off"
               data-season-modal-target="guestsInput"
               data-action="keydown->season-modal#guestsKeydown"
               class="absolute left-[49px] top-[166px] w-[250px] h-[52px] bg-transparent border-none p-0 font-medium text-22 leading-[52px] tracking-003 text-brand-primary/50 outline-none"
               placeholder="Add email address">
        <div data-season-modal-target="guestsList"
             class="absolute left-[32px] top-[228px] w-[284px] max-h-[120px] overflow-y-auto flex flex-col gap-1 [scrollbar-width:none]"></div>
        <div data-season-modal-target="guestsSubmitBg"
             class="absolute left-[32px] top-[241px] w-[284px] h-[52px] bg-brand-primary rounded-lg transition-[top] duration-[250ms] ease-in-out"></div>
        <button type="button" data-action="click->season-modal#addGuest"
                data-season-modal-target="guestsSubmitBtn"
                class="absolute left-[32px] top-[241px] w-[284px] h-[52px] bg-transparent border-none cursor-pointer p-0 flex items-center justify-center font-medium text-22 leading-[27px] tracking-003 text-white transition-[top] duration-[250ms] ease-in-out">Invite Guests</button>
      </div>
    </div>

    <%# ── Repeat modal ── %>
    <div data-season-modal-target="repeatBackdrop" class="hidden fixed inset-0 bg-black/40 z-[65]"></div>
    <div data-season-modal-target="repeatModal" role="dialog" aria-modal="true" aria-label="Repeat"
         class="hidden fixed inset-0 z-[70] flex items-center justify-center">
      <div class="w-[361px] h-[776px] bg-white rounded-[29px] shadow-[0_24px_64px_rgba(0,0,0,0.16)] relative overflow-y-auto [scrollbar-width:none]">
        <button type="button" data-action="click->season-modal#closeRepeat"
                class="absolute left-[304px] top-[13px] w-[37px] h-[37px] bg-transparent border-none cursor-pointer p-0 z-[2]">
          <svg width="37" height="37" viewBox="0 0 53 53" fill="none"><path d="M35.8 16.2L36 16.4C36.2 16.6 36.4 17 36.4 17.4C36.4 17.7 36.3 18.1 36.1 18.4L36 18.5L28.3 26.2L36 33.8C36.2 34.1 36.4 34.4 36.4 34.8C36.4 35.2 36.3 35.5 36.1 35.8L36 36C35.7 36.2 35.4 36.4 35 36.4C34.6 36.4 34.2 36.3 33.9 36.1L33.8 36L26.2 28.3L18.5 36C18.3 36.2 17.9 36.4 17.5 36.4C17.2 36.4 16.8 36.3 16.5 36.1L16.4 36C16.1 35.7 16 35.4 15.9 35C15.9 34.6 16 34.2 16.2 33.9L16.4 33.8L24 26.2L16.4 18.5C16.1 18.3 16 17.9 15.9 17.5C15.9 17.2 16 16.8 16.2 16.5L16.4 16.4C16.6 16.1 17 16 17.4 15.9C17.7 15.9 18.1 16 18.4 16.2L18.5 16.4L26.2 24L33.8 16.4C34.1 16.1 34.4 16 34.8 15.9C35.2 15.9 35.5 16 35.8 16.2L36 16.4L35.8 16.2Z" fill="#A43600" /></svg>
        </button>
        <p class="absolute left-1/2 -translate-x-1/2 top-[34px] font-medium text-22 leading-[27px] tracking-003 text-brand-primary whitespace-nowrap">Repeat this event</p>
        <div class="absolute left-[13px] top-[96px] w-[335px] h-0 border border-brand-field"></div>
        <% edit_repeat_opts = [['daily','Daily'],['weekly','Weekly'],['monthly','Monthly'],['yearly','Every Year'],['custom','Custom']] %>
        <% edit_sel_repeat = repeat_val || 'monthly' %>
        <% edit_tops = [144,199,254,309,364] %>
        <% edit_repeat_opts.each_with_index do |(val,label),idx| %>
          <% active = edit_sel_repeat == val %>
          <div data-season-modal-target="repeatOption"
               data-repeat-value="<%= val %>"
               data-action="click->season-modal#selectRepeat"
               class="absolute left-[29px] w-[289px] h-[38px] rounded-[10px] cursor-pointer flex items-center justify-center transition-colors duration-[150ms]"
               style="top:<%= edit_tops[idx] %>px;background:<%= active ? '#EDE1D5' : 'rgba(237,225,213,0.5)' %>">
            <span class="font-medium text-base tracking-007 text-brand-primary"><%= label %></span>
          </div>
        <% end %>
        <div class="absolute left-[30px] top-[430px] w-[287px] h-0 border border-brand-field"></div>
        <div data-season-modal-target="repeatSubOptions" class="absolute left-[30px] right-[30px] top-[456px]">
          <% sub_opts = [{val:'endless',label:'Repeat endlessly',active:true,top:0},{val:'until',label:'Repeat until',active:false,top:49},{val:'count',label:'Repeat',active:false,top:98}] %>
          <% sub_opts.each do |opt| %>
            <div class="absolute left-0 right-0 h-[34px] flex items-center justify-between" style="top:<%= opt[:top] %>px">
              <span class="font-medium text-base tracking-007 text-brand-primary"><%= opt[:label] %></span>
              <div class="w-[63px] h-[34px] rounded-[17px] cursor-pointer relative shrink-0"
                   data-action="click->season-modal#toggleRepeatSub"
                   data-sub-value="<%= opt[:val] %>"
                   style="background:<%= opt[:active] ? '#933A35' : '#D9D9D9' %>">
                <div class="absolute top-[2px] w-[30px] h-[30px] bg-white rounded-full shadow-[0_1px_4px_rgba(0,0,0,0.2)] transition-all duration-200" style="<%= opt[:active] ? 'right:2px;' : 'left:2px;' %>"></div>
              </div>
            </div>
          <% end %>
        </div>
        <div class="absolute left-[33px] top-[676px] w-[290px] h-[52px] bg-brand-primary rounded-lg"></div>
        <button type="button" data-action="click->season-modal#confirmRepeat"
                class="absolute left-[33px] top-[676px] w-[290px] h-[52px] bg-transparent border-none cursor-pointer p-0 flex items-center justify-center font-medium text-base leading-5 tracking-007 text-white">Save</button>
      </div>
    </div>

    <%# ── Custom repeat modal ── %>
    <div data-season-modal-target="customRepeatBackdrop" class="hidden fixed inset-0 bg-black/40 z-[65]"></div>
    <div data-season-modal-target="customRepeatModal" role="dialog" aria-modal="true" aria-label="Custom repeat"
         class="hidden fixed inset-0 z-[70] flex items-center justify-center">
      <div class="w-[361px] h-[451px] bg-white rounded-[29px] shadow-[0_24px_64px_rgba(0,0,0,0.16)] relative overflow-y-auto [scrollbar-width:none]">
        <button type="button" data-action="click->season-modal#closeCustomRepeat"
                class="absolute left-[304px] top-[13px] w-[37px] h-[37px] bg-transparent border-none cursor-pointer p-0 z-[2]">
          <svg width="37" height="37" viewBox="0 0 53 53" fill="none"><path d="M35.8 16.2L36 16.4C36.2 16.6 36.4 17 36.4 17.4C36.4 17.7 36.3 18.1 36.1 18.4L36 18.5L28.3 26.2L36 33.8C36.2 34.1 36.4 34.4 36.4 34.8C36.4 35.2 36.3 35.5 36.1 35.8L36 36C35.7 36.2 35.4 36.4 35 36.4C34.6 36.4 34.2 36.3 33.9 36.1L33.8 36L26.2 28.3L18.5 36C18.3 36.2 17.9 36.4 17.5 36.4C17.2 36.4 16.8 36.3 16.5 36.1L16.4 36C16.1 35.7 16 35.4 15.9 35C15.9 34.6 16 34.2 16.2 33.9L16.4 33.8L24 26.2L16.4 18.5C16.1 18.3 16 17.9 15.9 17.5C15.9 17.2 16 16.8 16.2 16.5L16.4 16.4C16.6 16.1 17 16 17.4 15.9C17.7 15.9 18.1 16 18.4 16.2L18.5 16.4L26.2 24L33.8 16.4C34.1 16.1 34.4 16 34.8 15.9C35.2 15.9 35.5 16 35.8 16.2L36 16.4L35.8 16.2Z" fill="#A43600" /></svg>
        </button>
        <p class="absolute left-1/2 -translate-x-1/2 top-[34px] font-medium text-22 leading-[27px] tracking-003 text-brand-primary whitespace-nowrap">Custom repeat</p>
        <div class="absolute left-[36px] top-[100px] w-[287px] h-0 border border-brand-field"></div>
        <% edit_custom_rows = [{label:'Every',unit:'days',max:365,top:140,default:1},{label:'Every',unit:'weeks',max:52,top:205,default:1},{label:'Every',unit:'months',max:24,top:270,default:1}] %>
        <% edit_custom_rows.each do |row| %>
          <div class="absolute left-[36px] w-[287px] h-[38px] bg-brand-field/50 rounded-[10px] flex items-center px-4 gap-1" style="top:<%= row[:top] %>px">
            <span class="font-medium text-base tracking-007 text-brand-primary"><%= row[:label] %></span>
            <input type="number" inputmode="numeric" min="1" max="<%= row[:max] %>" value="<%= row[:default] %>" autocomplete="off" class="w-14 h-full bg-transparent border-none font-bold text-base text-brand-primary text-center outline-none">
            <span class="font-medium text-base tracking-007 text-brand-primary"><%= row[:unit] %></span>
          </div>
        <% end %>
        <div class="absolute left-[36px] top-[352px] w-[287px] h-[52px] bg-brand-primary rounded-lg"></div>
        <button type="button" data-action="click->season-modal#confirmCustomRepeat"
                class="absolute left-[36px] top-[352px] w-[287px] h-[52px] bg-transparent border-none cursor-pointer p-0 flex items-center justify-center font-medium text-base leading-5 tracking-007 text-white">Save</button>
      </div>
    </div>

    <%# ── Repeat until date modal ── %>
    <div data-season-modal-target="repeatUntilBackdrop" class="hidden fixed inset-0 bg-black/40 z-[65]" data-action="click->season-modal#closeRepeatUntil"></div>
    <div data-season-modal-target="repeatUntilModal" role="dialog" aria-modal="true" aria-label="Repeat until"
         class="hidden fixed inset-0 z-[70] flex items-center justify-center">
      <div class="w-[361px] h-[438px] bg-white rounded-[29px] shadow-[0_24px_64px_rgba(0,0,0,0.16)] relative">
        <button type="button" data-action="click->season-modal#closeRepeatUntil"
                class="absolute left-[304px] top-[13px] w-[37px] h-[37px] bg-transparent border-none cursor-pointer p-0 z-[2]">
          <svg width="37" height="37" viewBox="0 0 53 53" fill="none"><path d="M35.8 16.2L36 16.4C36.2 16.6 36.4 17 36.4 17.4C36.4 17.7 36.3 18.1 36.1 18.4L36 18.5L28.3 26.2L36 33.8C36.2 34.1 36.4 34.4 36.4 34.8C36.4 35.2 36.3 35.5 36.1 35.8L36 36C35.7 36.2 35.4 36.4 35 36.4C34.6 36.4 34.2 36.3 33.9 36.1L33.8 36L26.2 28.3L18.5 36C18.3 36.2 17.9 36.4 17.5 36.4C17.2 36.4 16.8 36.3 16.5 36.1L16.4 36C16.1 35.7 16 35.4 15.9 35C15.9 34.6 16 34.2 16.2 33.9L16.4 33.8L24 26.2L16.4 18.5C16.1 18.3 16 17.9 15.9 17.5C15.9 17.2 16 16.8 16.2 16.5L16.4 16.4C16.6 16.1 17 16 17.4 15.9C17.7 15.9 18.1 16 18.4 16.2L18.5 16.4L26.2 24L33.8 16.4C34.1 16.1 34.4 16 34.8 15.9C35.2 15.9 35.5 16 35.8 16.2L36 16.4L35.8 16.2Z" fill="#A43600" /></svg>
        </button>
        <% edit_until_date = evt_date + 30 %>
        <% edit_until_days = (edit_until_date - evt_date).to_i %>
        <% edit_day_names = %w[S M T W T F S] %>
        <% ud = edit_until_date.day; um = edit_until_date.month; uy = edit_until_date.year %>
        <% edit_date_label = "#{edit_day_names[edit_until_date.wday]} #{format('%02d', ud)}.#{format('%02d', um)}.#{uy}" %>
        <p class="absolute left-1/2 -translate-x-1/2 top-[34px] font-medium text-22 leading-[27px] tracking-003 text-brand-primary whitespace-nowrap">Repeat until day <%= edit_until_days %></p>
        <div class="absolute left-[36px] top-[100px] w-[287px] h-0 border border-brand-field"></div>
        <p class="absolute left-1/2 -translate-x-1/2 top-[136px] font-bold text-base tracking-007 text-brand-primary whitespace-nowrap"><%= edit_date_label %></p>
        <div class="relative left-[36px] top-[176px] w-[287px] h-[100px] bg-white rounded-lg flex items-center justify-center gap-3 overflow-hidden">
          <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-11 bg-brand-field rounded-lg pointer-events-none"></div>
          <div class="overflow-y-auto snap-y snap-mandatory h-full w-11 [scrollbar-width:none] text-center relative z-[1]"
               onscroll="const t=this;t.querySelectorAll('div').forEach(el=>{const r=el.getBoundingClientRect(),p=t.getBoundingClientRect(),c=r.top-p.top+r.height/2-t.clientHeight/2;el.style.opacity=Math.abs(c)<22?'1':'0.35';el.style.fontWeight=Math.abs(c)<22?'700':'400'})">
            <% (1..31).each do |day| %>
              <div class="h-11 flex items-center justify-center text-base text-brand-primary snap-center" style="font-weight:<%= day == ud ? '700' : '400' %>;opacity:<%= day == ud ? '1' : '0.35' %>"><%= format('%02d', day) %></div>
            <% end %>
          </div>
          <% edit_months = %w[Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec] %>
          <div class="overflow-y-auto snap-y snap-mandatory h-full w-[52px] [scrollbar-width:none] text-center relative z-[1]"
               onscroll="const t=this;t.querySelectorAll('div').forEach(el=>{const r=el.getBoundingClientRect(),p=t.getBoundingClientRect(),c=r.top-p.top+r.height/2-t.clientHeight/2;el.style.opacity=Math.abs(c)<22?'1':'0.35';el.style.fontWeight=Math.abs(c)<22?'700':'400'})">
            <% edit_months.each_with_index do |mon, mi| %>
              <% mo = mi + 1 %>
              <div class="h-11 flex items-center justify-center text-base text-brand-primary snap-center" style="font-weight:<%= mo == um ? '700' : '400' %>;opacity:<%= mo == um ? '1' : '0.35' %>"><%= mon %></div>
            <% end %>
          </div>
          <div class="overflow-y-auto snap-y snap-mandatory h-full w-[60px] [scrollbar-width:none] text-center relative z-[1]"
               onscroll="const t=this;t.querySelectorAll('div').forEach(el=>{const r=el.getBoundingClientRect(),p=t.getBoundingClientRect(),c=r.top-p.top+r.height/2-t.clientHeight/2;el.style.opacity=Math.abs(c)<22?'1':'0.35';el.style.fontWeight=Math.abs(c)<22?'700':'400'})">
            <% (2025..2035).each do |yr| %>
              <div class="h-11 flex items-center justify-center text-base text-brand-primary snap-center" style="font-weight:<%= yr == uy ? '700' : '400' %>;opacity:<%= yr == uy ? '1' : '0.35' %>"><%= yr %></div>
            <% end %>
          </div>
        </div>
        <div class="absolute left-[36px] top-[341px] w-[287px] h-[52px] bg-brand-primary rounded-lg"></div>
        <button type="button" data-action="click->season-modal#confirmRepeatUntil"
                class="absolute left-[36px] top-[341px] w-[287px] h-[52px] bg-transparent border-none cursor-pointer p-0 flex items-center justify-center font-medium text-base leading-5 tracking-007 text-white">Save</button>
      </div>
    </div>

    <%# ── Recurring event edit modal ── %>
    <div data-season-modal-target="recurringBackdrop" class="hidden fixed inset-0 bg-black/40 z-[150]" data-action="click->season-modal#closeRecurring"></div>
    <div data-season-modal-target="recurringModal" role="dialog" aria-modal="true"
         class="hidden fixed inset-0 z-[150] flex items-center justify-center">
      <div class="w-[337px] bg-white rounded-[29px] shadow-[0_24px_64px_rgba(0,0,0,0.16)] px-7 pt-8 pb-6">
        <p class="font-medium text-lg text-brand-primary mb-2 mt-0 text-center">This is a recurring event.</p>
        <div class="h-px bg-brand-field my-4"></div>
        <div class="flex flex-col gap-3">
          <% [['Edit only this event', :single], ['Edit this and subsequent events', :forward], ['Edit all events', :all]].each do |(label, scope)| %>
            <button type="button"
                    data-action="click->season-modal#closeRecurring"
                    class="w-full h-11 bg-brand-field border-none rounded-[10px] font-medium text-15 text-brand-primary cursor-pointer">
              <%= label %>
            </button>
          <% end %>
          <button type="button" data-action="click->season-modal#closeRecurring"
                  class="w-full h-11 bg-transparent border-none font-medium text-15 text-brand-primary cursor-pointer opacity-60">
            Cancel
          </button>
        </div>
      </div>
    </div>

    <%# ── Notify guests on delete modal ── %>
    <div data-season-modal-target="notifyBackdrop" class="hidden fixed inset-0 bg-black/40 z-[150]" data-action="click->season-modal#closeNotify"></div>
    <div data-season-modal-target="notifyModal" role="dialog" aria-modal="true"
         class="hidden fixed inset-0 z-[150] flex items-center justify-center">
      <div class="w-[337px] bg-white rounded-[29px] shadow-[0_24px_64px_rgba(0,0,0,0.16)] px-7 pt-8 pb-6">
        <p class="font-medium text-base text-brand-primary mb-2 mt-0 text-center">Others are also involved in this meeting.</p>
        <div class="h-px bg-brand-field my-4"></div>
        <div class="flex flex-col gap-3">
          <%= button_to "Notify all parties involved",
                calendar_event_path(@event),
                method: :delete,
                class: "w-full h-11 bg-brand-primary border-none rounded-[10px] font-medium text-15 text-white cursor-pointer" %>
          <%= button_to "Notify nobody",
                calendar_event_path(@event),
                method: :delete,
                class: "w-full h-11 bg-brand-field border-none rounded-[10px] font-medium text-15 text-brand-primary cursor-pointer" %>
          <button type="button" data-action="click->season-modal#closeNotify"
                  class="w-full h-11 bg-transparent border-none font-medium text-15 text-brand-primary cursor-pointer opacity-60">
            Cancel
          </button>
        </div>
      </div>
    </div>

    <%# ── Attention dialogs ── %>
    <div data-season-modal-target="attentionBackdrop" class="hidden fixed inset-0 bg-black/40 z-[200]"></div>
    <div data-season-modal-target="attentionModal" role="alertdialog" aria-modal="true"
         class="hidden fixed inset-0 z-[200] flex items-center justify-center">
      <div class="w-[337px] bg-white rounded-[29px] shadow-[0_24px_64px_rgba(0,0,0,0.16)] px-7 pt-8 pb-6">
        <p class="font-bold text-lg text-brand-primary mb-3 mt-0">Attention</p>
        <p data-season-modal-target="attentionBody" class="font-normal text-sm leading-relaxed text-brand-primary mb-6 mt-0"></p>
        <div class="flex gap-3">
          <button type="button" data-action="click->season-modal#closeAttention"
                  data-season-modal-target="attentionCancel"
                  class="flex-1 h-11 bg-brand-field border-none rounded-[10px] font-medium text-15 text-brand-primary cursor-pointer">
            Keep editing
          </button>
          <button type="button" data-season-modal-target="attentionConfirm"
                  class="flex-1 h-11 bg-brand-primary border-none rounded-[10px] font-medium text-15 text-white cursor-pointer">
            OK
          </button>
        </div>
      </div>
    </div>

  </div>
</div>
