<% content_for(:page_title) { "Appointment" } %>
<%# No header_left here — Figma's app bar for this screen is the plain
     default (hamburger + title), not a custom back arrow. "< Back" is a
     separate line in the page's own content below the bar, confirmed
     directly off the Figma node: the app-bar frame is 0-81px tall, "< Back"
     sits at y=95, clearly below it, not inside that bar alongside the
     title. %>
<% content_for(:hide_quick_actions) { "true" } %>
<% content_for(:hide_calendar_fab) { "true" } %>

<%
  evt_date       = @event.date
  now            = Time.zone.now
  default_start  = @event.start_time || now.change(min: 0) + 1.hour
  default_end    = @event.end_time   || default_start + 1.hour
  repeat_val     = @event.repeat_frequency
%>

<div class="bg-white min-h-screen pb-32 font-sans"
     data-controller="season-modal appointment-date-picker"
     data-appointment-date-picker-selected-date-value="<%= evt_date %>"
     data-appointment-date-picker-period-ranges-value="<%= @period_ranges %>"
     data-appointment-date-picker-prototype-value="true">
  <div class="max-w-app mx-auto px-4 pt-5">

    <a href="<%= safe_back_path(calendar_path(date: @event.date)) %>"
       onclick="if (window.history.length > 1) { window.history.back(); return false; }"
       data-turbo="false"
       class="inline-flex items-center py-2 mb-2 text-brand-primary text-sm font-medium no-underline">
       &lt; back
    </a>

    <% category_icons = {
      'Friends' => 'family.svg', 'Dinner' => 'dinner.svg', 'Date' => 'date.svg',
      'Sport' => 'sport.svg', 'Medical' => 'medical.svg', 'Birthday' => 'birthday.svg',
      'Work' => 'work.svg', 'Coffee' => 'coffee.svg', 'Shopping' => 'shopping.svg'
    } %>

    <%= form_with model: @event, url: calendar_event_path(@event), method: :patch, local: true, data: { turbo: false } do |f| %>

      <div class="relative">

        <%# Category trigger button %>
        <% has_category = @event.category.present? && category_icons.key?(@event.category) %>
        <button type="button" data-action="click->season-modal#open"
                data-season-modal-target="triggerButton"
                aria-label="Choose event type"
                class="absolute top-0 right-0 w-11 h-11 rounded-full bg-brand-field flex items-center justify-center p-0 cursor-pointer">
          <% if has_category %>
            <%# Height-constrained, width auto — not a fixed square box. The
                 nine category assets range from 27x38 to 63x57 (see the
                 icon-picker modal below for the full breakdown); forcing a
                 fixed w+h here would squish/stretch every non-square one. %>
            <%= image_tag "icons/appointment/#{category_icons[@event.category]}", alt: @event.category, class: "max-h-[22px] w-auto" %>
          <% else %>
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24">
              <path d="M12 5v14M5 12h14" stroke="#A43600" stroke-width="2.5" stroke-linecap="round"></path>
            </svg>
          <% end %>
        </button>

        <%# Title input %>
        <div class="bg-white rounded-3xl px-4 pt-4 pb-1 pr-12">
          <%= f.text_field :title,
                placeholder: "Enter title",
                required: true,
                value: @event.title,
                class: "w-full bg-transparent border-none text-22 font-medium text-brand-primary placeholder:text-brand-field p-0 outline-none font-sans" %>
        </div>

        <div class="mx-5 mt-1 mb-5 w-[304px] h-px bg-brand-primary"></div>

        <%# Date + time block %>
        <div class="py-5">
          <div class="mx-auto relative w-[360px] h-[125px]">
            <svg width="360" height="125" viewBox="0 0 360 125" fill="none" xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 pointer-events-none">
              <path d="M0 19C0 8.50659 8.50659 0 19 0H341C351.493 0 360 8.50659 360 19V106C360 116.493 351.493 125 341 125H19C8.50659 125 0 116.493 0 106V19Z" fill="#933A35" />
            </svg>
            <div class="relative z-10 flex flex-col justify-center items-center gap-2 h-full text-center">
              <% end_date = @event.end_date %>
              <% multi_day = end_date.present? && end_date != evt_date %>
              <button type="button" data-action="click->appointment-date-picker#open"
                      data-appointment-date-picker-target="dateDisplay"
                      class="text-white text-22 font-medium tracking-wide font-sans bg-transparent border-none cursor-pointer p-0 text-center leading-snug">
                <%# Figma's multi-day card (node 12090:3531) is three lines
                     — date, a "-" on its own line, date — not two dates
                     stacked directly on each other. %>
                <% if multi_day %>
                  <%= evt_date.strftime("%a. %B ") %><%= evt_date.day.ordinalize %><%= evt_date.strftime(" %Y") %><br>
                  <span class="font-light">-</span><br>
                  <%= end_date.strftime("%a. %B ") %><%= end_date.day.ordinalize %><%= end_date.strftime(" %Y") %>
                <% else %>
                  <%= evt_date.strftime("%a. %B ") %><%= evt_date.day.ordinalize %><%= evt_date.strftime(" %Y") %>
                <% end %>
              </button>
              <%
                st_h    = default_start.hour > 12 ? default_start.hour - 12 : (default_start.hour == 0 ? 12 : default_start.hour)
                st_m    = (default_start.min / 5).round * 5
                st_ampm = default_start.hour >= 12 ? 'PM' : 'AM'
                et_h    = default_end.hour > 12 ? default_end.hour - 12 : (default_end.hour == 0 ? 12 : default_end.hour)
                et_m    = (default_end.min / 5).round * 5
                et_ampm = default_end.hour >= 12 ? 'PM' : 'AM'
              %>
              <%# Time is display-only here — editing happens exclusively
                   through the "Set date" modal above (its own From/To time
                   scroller), not via a second pop-up on this pill. Hidden
                   entirely for a multi-day span — Figma shows just the two
                   dates then, no time row at all. Always rendered (never
                   omitted) so toggling between single- and multi-day live
                   in the picker can show/hide it via the timeRow target
                   instead of needing a reload; #applyDateDisplay keeps
                   this in sync going forward. %>
              <button type="button" data-action="click->appointment-date-picker#open" data-appointment-date-picker-target="timeRow" class="flex items-center justify-center gap-1 bg-transparent border-none p-0 cursor-pointer <%= 'hidden' if multi_day %>" aria-label="Edit date and time">
                <span data-appointment-date-picker-target="startTimeDisplay"
                      class="text-white text-22 font-medium tracking-wide font-sans"><%= st_h %>:<%= format('%02d', st_m) %> <%= st_ampm %></span>
                <span class="text-white text-22 font-light font-sans">-</span>
                <span data-appointment-date-picker-target="endTimeDisplay"
                      class="text-white text-22 font-medium tracking-wide font-sans"><%= et_h %>:<%= format('%02d', et_m) %> <%= et_ampm %></span>
              </button>
              <input type="hidden" name="calendar_event[start_time]" data-appointment-date-picker-target="startField" value="<%= default_start.strftime('%H:%M') %>">
              <input type="hidden" name="calendar_event[end_time]" data-appointment-date-picker-target="endField" value="<%= default_end.strftime('%H:%M') %>">
              <%= f.hidden_field :date, value: evt_date, data: { appointment_date_picker_target: 'dateField' } %>
              <%= f.hidden_field :end_date, value: @event.end_date, data: { appointment_date_picker_target: 'endDateField' } %>
            </div>
          </div>
        </div>

      </div>

      <hr class="border-brand-primary/50 my-5 mx-5">

      <%# Reminder row %>
      <% rem = @event.reminder_minutes || 15 %>
      <% rem_label = case rem when 0 then 'No reminder' when -1 then 'Custom timer' when 10080 then '1 week before' when 1440 then '1 day before' when 360 then '6 hours before' when 60 then '1 hour before' else "#{rem} minutes before" end %>
      <div class="flex items-center gap-3 py-3.5 px-5 cursor-pointer"
           data-action="click->season-modal#openReminder">
        <div data-season-modal-target="reminderIconBg" class="w-[39px] h-[38px] rounded-full flex items-center justify-center shrink-0 <%= rem == 0 ? 'bg-brand-field/50' : 'bg-brand-field' %>">
          <svg width="20" height="20" fill="none" stroke="#933A35" stroke-width="2" viewBox="0 0 24 24" <%= rem == 0 ? 'opacity="0.5"' : '' %>>
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
          </svg>
        </div>
        <span data-season-modal-target="reminderLabel" class="text-base font-medium tracking-007 flex-1 font-sans <%= rem == 0 ? 'text-brand-graytext' : 'text-brand-primary' %>"><%= rem_label %></span>
        <%# Quick-clear — Figma shows this only when a reminder is actually
             set; opening the picker modal just to pick "No reminder" is the
             only way to clear one otherwise. Stops propagation so it doesn't
             also fire the row's own openReminder click. %>
        <button type="button" data-season-modal-target="reminderClearBtn" data-action="click->season-modal#clearReminder"
                aria-label="Remove reminder" class="shrink-0 bg-transparent border-none cursor-pointer p-1 text-brand-primary <%= 'hidden' if rem == 0 %>">
          <svg width="14" height="14" viewBox="0 0 12 12" fill="none"><path d="M9 3L3 9M3 3l6 6" stroke="#933A35" stroke-width="1.5" stroke-linecap="round" /></svg>
        </button>
      </div>

      <hr class="border-brand-primary/50 my-5 mx-5">

      <%# Location row %>
      <% loc = @event.location.present? %>
      <div class="flex items-center gap-3 py-3.5 px-5 cursor-pointer"
           data-action="click->season-modal#openLocation">
        <div data-season-modal-target="locationIconBg" class="w-[39px] h-[38px] rounded-full flex items-center justify-center shrink-0 <%= loc ? 'bg-brand-field' : 'bg-brand-field/50' %>">
          <svg width="20" height="20" fill="none" stroke="#933A35" stroke-width="2" viewBox="0 0 24 24" <%= loc ? '' : 'opacity="0.5"' %>>
            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
          </svg>
        </div>
        <%# Figma's label colour for this row is solid #933a35 whether it's
             set or empty — only the icon/circle behind it dims. %>
        <span data-season-modal-target="locationLabel" class="text-base font-medium tracking-007 flex-1 font-sans text-brand-primary"><%= loc ? @event.location : 'Add location' %></span>
      </div>

      <%# Guests row — before Notes, per Figma %>
      <% guest_list = @event.guests.to_s.split(',').map(&:strip).reject(&:empty?) %>
      <div class="flex items-center gap-3 py-3.5 px-5 cursor-pointer"
           data-action="click->season-modal#openGuests">
        <div data-season-modal-target="guestsIconBg" class="w-[39px] h-[38px] rounded-full flex items-center justify-center shrink-0 <%= guest_list.any? ? 'bg-brand-field' : 'bg-brand-field/50' %>">
          <svg width="20" height="20" fill="none" stroke="#933A35" stroke-width="2" viewBox="0 0 24 24" <%= guest_list.any? ? '' : 'opacity="0.5"' %>>
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <span data-season-modal-target="guestsLabel" class="text-brand-primary text-base font-medium tracking-007 font-sans <%= guest_list.any? ? 'hidden' : '' %>">Invite guests</span>
          <div data-season-modal-target="guestsInlineList" class="<%= guest_list.any? ? '' : 'hidden' %> flex flex-col gap-1">
            <% guest_list.each do |email| %>
              <div class="flex items-center justify-between gap-2">
                <span class="text-brand-primary text-base font-medium tracking-007 font-sans truncate"><%= email %></span>
                <button type="button" data-action="click->season-modal#removeGuest"
                        data-guest-email="<%= email %>"
                        class="shrink-0 bg-transparent border-none cursor-pointer p-0 w-6 h-6 flex items-center justify-center">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M9 3L3 9M3 3l6 6" stroke="#933A35" stroke-width="1.5" stroke-linecap="round" /></svg>
                </button>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <%# Notes row %>
      <% has_notes = @event.notes.present? %>
      <div class="flex items-center gap-3 py-3.5 px-5 cursor-pointer"
           data-action="click->season-modal#openNotes">
        <div data-season-modal-target="notesIconBg" class="w-[39px] h-[38px] rounded-full flex items-center justify-center shrink-0 <%= has_notes ? 'bg-brand-field' : 'bg-brand-field/50' %>">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" <%= has_notes ? '' : 'stroke-opacity="0.5"' %>>
            <path d="M16 4H18C18.5304 4 19.0391 4.21071 19.4142 4.58579C19.7893 4.96086 20 5.46957 20 6V20C20 20.5304 19.7893 21.0391 19.4142 21.4142C19.0391 21.7893 18.5304 22 18 22H6C5.46957 22 4.96086 21.7893 4.58579 21.4142C4.21071 21.0391 4 20.5304 4 20V6C4 5.46957 4.21071 4.96086 4.58579 4.58579C4.96086 4.21071 5.46957 4 6 4H8" stroke="#933A35" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M15 2H9C8.44772 2 8 2.44772 8 3V5C8 5.55228 8.44772 6 9 6H15C15.5523 6 16 5.55228 16 5V3C16 2.44772 15.5523 2 15 2Z" stroke="#933A35" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <span data-season-modal-target="notesLabel" class="text-base font-medium tracking-007 flex-1 font-sans text-brand-primary"><%= has_notes ? @event.notes.truncate(30) : 'Notes...' %></span>
      </div>

      <%# Repeat row %>
      <% repeat_val = @event.repeat_frequency %>
      <% repeat_label = case repeat_val when 'daily' then 'Daily' when 'weekly' then 'Weekly' when 'monthly' then 'Monthly' when 'yearly' then 'Every Year' when 'custom' then 'Custom' else nil end %>
      <div class="flex items-center gap-3 py-3.5 px-5 cursor-pointer"
           data-action="click->season-modal#openRepeat">
        <div data-season-modal-target="repeatIconBg" class="w-[39px] h-[38px] rounded-full flex items-center justify-center shrink-0 <%= repeat_val.present? ? 'bg-brand-field' : 'bg-brand-field/50' %>">
          <svg width="22" height="20" viewBox="0 0 22 20" fill="none" stroke="#933A35" stroke-opacity="<%= repeat_val.present? ? '1' : '0.5' %>" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.996 1.998V7.998h-6" />
            <path d="M18.486 12.998C17.836 14.838 16.606 16.417 14.98 17.497C13.355 18.576 11.422 19.099 9.474 18.985C7.526 18.871 5.668 18.127 4.18 16.865C2.691 15.603 1.653 13.891 1.222 11.988C0.791 10.085 0.99 8.093 1.79 6.313C2.589 4.533 3.946 3.061 5.654 2.119C7.363 1.176 9.332 0.815 11.264 1.089C13.196 1.363 14.987 2.258 16.366 3.638L20.996 7.998" />
          </svg>
        </div>
        <span data-season-modal-target="repeatLabel" class="text-base font-medium tracking-007 flex-1 font-sans text-brand-primary"><%= repeat_label || 'Repeat' %></span>
      </div>

      <%# Buttons %>
      <div class="flex flex-col gap-3 pt-7">
        <%# This form is local: true (Turbo opted out) and the app doesn't
             load rails-ujs, so nothing built-in stops a second tap from
             firing a second POST while the first is still in flight —
             season_modal_controller.js's existing submit listener disables
             this button synchronously to prevent that double-save. %>
        <%= f.submit "Set appointment",
              data: { season_modal_target: "submitBtn" },
              class: "w-full text-white py-3.5 rounded-lg border-none text-22 font-medium font-sans cursor-pointer tracking-003 bg-brand-primary" %>
        <button type="button" data-action="click->season-modal#openNotifyGuests"
                class="w-full bg-transparent text-brand-primary rounded-lg text-22 font-medium font-sans cursor-pointer tracking-003 py-3.5 border-0">
          Delete appointment
        </button>
      </div>

      <%= f.hidden_field :repeat_frequency, value: repeat_val || 'monthly', data: { season_modal_target: 'repeatField' } %>
      <%= f.hidden_field :reminder_minutes, value: @event.reminder_minutes || 15, data: { season_modal_target: 'reminderField' } %>
      <%= f.hidden_field :guests, value: @event.guests, data: { season_modal_target: 'guestsField' } %>
      <%= f.hidden_field :category, value: @event.category, data: { season_modal_target: 'categoryInput' } %>
      <%= f.hidden_field :location, value: @event.location, data: { season_modal_target: 'locationField' } %>
      <%= f.hidden_field :notes, value: @event.notes, data: { season_modal_target: 'notesField' } %>

    <% end %>

    <%# ── Calendar home button (replaces FAB) ── %>
    <%= link_to calendar_path,
          class: "fixed left-1/2 -translate-x-1/2 z-40
                 w-[66px] h-[66px] rounded-full bg-brand-field
                 flex items-center justify-center
                 active:scale-95 transition-all duration-150 shadow-[0px_4px_9px_rgba(0,0,0,0.07)]",
          style: "bottom: calc(2.5rem + env(safe-area-inset-bottom, 0px));",
          aria_label: "Home" do %>
      <%= image_tag "icons/vuesax/linear/calendar-add.svg", class: "w-[33px] h-[33px]", alt: "" %>
    <% end %>

    <%# ── Set Date modal — PROTOTYPE inline morph (tap text → drum) ── %>
    <div data-appointment-date-picker-target="backdrop" class="hidden fixed inset-0 bg-black/40 z-[65]" data-action="click->appointment-date-picker#close"></div>
    <div data-appointment-date-picker-target="modal" role="dialog" aria-modal="true" class="hidden">
      <div data-appointment-date-picker-target="protoCard" class="w-[380px] bg-white rounded-[29px] shadow-[0_24px_64px_rgba(0,0,0,0.16)] relative flex flex-col px-[38px] pt-[22px] pb-[22px] gap-0">
        <button type="button" data-action="click->appointment-date-picker#close" class="absolute right-[13px] top-[13px] w-[37px] h-[37px] bg-transparent border-none cursor-pointer p-0">
          <svg width="37" height="37" viewBox="0 0 53 53" fill="none"><path d="M35.8 16.2L36 16.4C36.2 16.6 36.4 17 36.4 17.4C36.4 17.7 36.3 18.1 36.1 18.4L36 18.5L28.3 26.2L36 33.8C36.2 34.1 36.4 34.4 36.4 34.8C36.4 35.2 36.3 35.5 36.1 35.8L36 36C35.7 36.2 35.4 36.4 35 36.4C34.6 36.4 34.2 36.3 33.9 36.1L33.8 36L26.2 28.3L18.5 36C18.3 36.2 17.9 36.4 17.5 36.4C17.2 36.4 16.8 36.3 16.5 36.1L16.4 36C16.1 35.7 16 35.4 15.9 35C15.9 34.6 16 34.2 16.2 33.9L16.4 33.8L24 26.2L16.4 18.5C16.1 18.3 16 17.9 15.9 17.5C15.9 17.2 16 16.8 16.2 16.5L16.4 16.4C16.6 16.1 17 16 17.4 15.9C17.7 15.9 18.1 16 18.4 16.2L18.5 16.4L26.2 24L33.8 16.4C34.1 16.1 34.4 16 34.8 15.9C35.2 15.9 35.5 16 35.8 16.2L36 16.4L35.8 16.2Z" fill="#A43600" /></svg>
        </button>
        <span data-appointment-date-picker-target="dateTitle" class="font-medium text-22 leading-[27px] tracking-003 text-brand-primary text-center pt-2"></span>
        <hr class="border-none h-px bg-black opacity-20 w-[132px] self-center mt-3 mb-5">
        <%# From row — inline morph: label itself becomes drum %>
        <div data-appointment-date-picker-target="slot1Row" class="flex items-center justify-between py-2 min-h-[30px]">
          <button type="button" data-action="click->appointment-date-picker#editDate1" data-appointment-date-picker-target="slot1Btn" class="bg-transparent border-none cursor-pointer p-0 flex items-center gap-2 text-left flex-1 min-w-0">
            <span class="text-11 font-semibold tracking-[0.08em] text-brand-primary opacity-50 uppercase w-9 shrink-0">From</span>
            <span data-appointment-date-picker-target="slot1Label" class="font-medium text-base tracking-007 text-brand-primary truncate"></span>
            <span data-appointment-date-picker-target="slot1InlineDate" class="hidden flex items-center gap-1"></span>
          </button>
          <button type="button" data-action="click->appointment-date-picker#editTime1" class="bg-transparent border-none cursor-pointer p-0 flex items-center gap-1 shrink-0 ml-3">
            <span data-appointment-date-picker-target="slot1Time" class="font-medium text-base tracking-007 text-brand-primary"></span>
            <span data-appointment-date-picker-target="slot1InlineTime" class="hidden flex items-center gap-1"></span>
          </button>
        </div>
        <%# To row — inline morph %>
        <div data-appointment-date-picker-target="slot2Row" class="flex items-center justify-between py-2 min-h-[30px]">
          <button type="button" data-action="click->appointment-date-picker#editDate2" data-appointment-date-picker-target="slot2Btn" class="bg-transparent border-none cursor-pointer p-0 flex items-center gap-2 text-left flex-1 min-w-0">
            <span class="text-11 font-semibold tracking-[0.08em] text-brand-primary opacity-50 uppercase w-9 shrink-0">To</span>
            <span data-appointment-date-picker-target="slot2Label" class="font-medium text-base tracking-007 text-brand-primary truncate"></span>
            <span data-appointment-date-picker-target="slot2InlineDate" class="hidden flex items-center gap-1"></span>
          </button>
          <button type="button" data-action="click->appointment-date-picker#editTime2" class="bg-transparent border-none cursor-pointer p-0 flex items-center gap-1 shrink-0 ml-3">
            <span data-appointment-date-picker-target="slot2Time" class="font-medium text-base tracking-007 text-brand-primary"></span>
            <span data-appointment-date-picker-target="slot2InlineTime" class="hidden flex items-center gap-1"></span>
          </button>
        </div>
        <%# Shared drums — single instance, moved into active row picker via JS %>
        <div class="hidden">
          <div data-appointment-date-picker-target="protoDatePicker" data-picker="date" class="w-full h-[80px] flex items-center justify-center gap-1.5 relative">
            <div class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-7 bg-brand-field rounded-lg pointer-events-none"></div>
            <div data-appointment-date-picker-target="dayScroll" data-action="scroll->appointment-date-picker#onDayScroll" class="overflow-y-auto snap-y snap-mandatory h-full w-12 [scrollbar-width:none] relative z-[1]">
              <% (1..31).each do |d| %><div data-value="<%= d %>" class="h-7 flex items-center justify-center text-base tracking-007 text-brand-primary"><%= format('%02d', d) %></div><% end %>
            </div>
            <span class="text-base text-brand-primary relative z-[1]">/</span>
            <div data-appointment-date-picker-target="monthScroll" data-action="scroll->appointment-date-picker#onMonthScroll" class="overflow-y-auto snap-y snap-mandatory h-full w-12 [scrollbar-width:none] relative z-[1]">
              <% (1..12).each do |m| %><div data-value="<%= m %>" class="h-7 flex items-center justify-center text-base tracking-007 text-brand-primary"><%= format('%02d', m) %></div><% end %>
            </div>
            <span class="text-base text-brand-primary relative z-[1]">/</span>
            <div data-appointment-date-picker-target="yearScroll" data-action="scroll->appointment-date-picker#onYearScroll" class="overflow-y-auto snap-y snap-mandatory h-full w-16 [scrollbar-width:none] relative z-[1]">
              <% ((Time.zone.today.year - 5)..(Time.zone.today.year + 5)).each do |y| %><div data-value="<%= y %>" class="h-7 flex items-center justify-center text-base tracking-007 text-brand-primary"><%= y %></div><% end %>
            </div>
          </div>
          <div data-appointment-date-picker-target="protoTimePicker" data-picker="time" class="w-full h-[80px] hidden items-center justify-center gap-1 relative">
            <div class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-7 bg-brand-field rounded-lg pointer-events-none"></div>
            <div data-appointment-date-picker-target="hourScroll" data-action="scroll->appointment-date-picker#onHourScroll" class="overflow-y-auto snap-y snap-mandatory h-full w-[50px] [scrollbar-width:none] relative z-[1]">
              <% (0..23).each do |h| %><div data-value="<%= h %>" class="h-7 flex items-center justify-center text-base tracking-007 text-brand-primary"><%= format('%02d', h) %></div><% end %>
            </div>
            <span class="font-bold text-base text-brand-primary relative z-[1]">:</span>
            <div data-appointment-date-picker-target="minuteScroll" data-action="scroll->appointment-date-picker#onMinuteScroll" class="overflow-y-auto snap-y snap-mandatory h-full w-14 [scrollbar-width:none] relative z-[1]">
              <% [0, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55].each do |m| %><div data-value="<%= m %>" class="h-7 flex items-center justify-center text-base tracking-007 text-brand-primary"><%= format('%02d', m) %></div><% end %>
            </div>
          </div>
        </div>
        <hr class="border-none h-px bg-black opacity-10 mt-3">
        <div class="flex items-center justify-between py-3">
          <span class="font-medium text-base tracking-007 text-brand-primary">All day</span>
          <button type="button" data-action="click->appointment-date-picker#toggleAllDay" data-appointment-date-picker-target="allDayToggle" class="w-[63px] h-[34px] rounded-[17px] bg-brand-lightgray border-none cursor-pointer relative p-0">
            <span class="absolute left-[3px] top-[2px] w-[30px] h-[30px] bg-white rounded-full shadow-[0_1px_4px_rgba(0,0,0,0.2)] transition-transform duration-200"></span>
          </button>
        </div>
        <button type="button" data-action="click->appointment-date-picker#confirm" class="w-full h-12 bg-brand-primary rounded-lg border-none cursor-pointer font-medium text-22 leading-[27px] tracking-003 text-white text-center mt-1">Set date</button>
      </div>
    </div>

    <%# ── Category icon picker modal ── %>
    <div data-season-modal-target="backdrop" class="hidden fixed inset-0 bg-black/40 z-[65]"></div>
    <div data-season-modal-target="modal" role="dialog" aria-modal="true" aria-labelledby="edit-choose-icon-title"
         class="hidden fixed inset-0 z-[70] flex items-center justify-center">
      <div class="w-[310px] max-h-[92vh] bg-white rounded-[29px] shadow-[0_24px_64px_rgba(0,0,0,0.16)] px-6 py-8 relative flex flex-col">
        <%# Close button sits high in the card's own top-right corner, not
             centered against the title row — measured off the Figma node
             directly (close glyph center y=19.5, title top y=41; the two
             aren't aligned there either). z-[2] lifts it above the
             position:relative header row below, which otherwise paints over
             it (same fix the location/notes/reminder modals use) and makes
             the whole button unclickable. %>
        <button type="button" data-season-modal-target="closeBtn" data-action="click->season-modal#close"
                class="absolute top-4 right-4 z-[2] bg-transparent border-none text-brand-primary text-[34px] w-11 h-11 flex items-center justify-center cursor-pointer font-sans">×</button>
        <div class="flex justify-center items-center relative mb-8">
          <h2 id="edit-choose-icon-title" class="text-22 font-medium text-brand-primary text-center font-sans leading-[45px]">Choose an icon</h2>
        </div>
        <hr class="border-brand-field mb-4">
        <div class="flex-1 min-h-0 overflow-y-auto [scrollbar-width:none] py-4 flex flex-col gap-2.5">
          <% items = [
            { label: 'Friends', icon: 'family.svg' },
            { label: 'Dinner', icon: 'dinner.svg' },
            { label: 'Date', icon: 'date.svg' },
            { label: 'Sport', icon: 'sport.svg' },
            { label: 'Medical', icon: 'medical.svg' },
            { label: 'Birthday', icon: 'birthday.svg' },
            { label: 'Work', icon: 'work.svg' },
            { label: 'Coffee', icon: 'coffee.svg' },
            { label: 'Shopping', icon: 'shopping.svg' }
          ] %>
          <% items.each do |item| %>
            <% selected = @event.category.present? && @event.category == item[:label] %>
            <% pale_src = "icons/appointment/#{item[:icon]}" %>
            <% selected_src = "icons/appointment/#{item[:icon].sub(".svg", "-selected.svg")}" %>
            <button type="button"
                    data-action="click->season-modal#selectCategory"
                    data-category-name-value="<%= item[:label] %>"
                    data-season-modal-target="categoryOption"
                    class="w-full h-[52px] flex items-center gap-4 pl-6 pr-3 border-none bg-transparent text-left font-medium text-lg font-sans leading-[52px] cursor-pointer"
                    style="color:<%= selected ? '#933A35' : '#EDE1D5' %>;">
              <%# Fixed-width slot, icon centered inside it — not left-aligned
                   with a flat gap to the label. Checked directly against the
                   Figma node: every one of the nine icons has a different
                   natural width (26.5 to 63), but their horizontal centers
                   all land on the exact same x — a fixed icon column with
                   each icon centered in it, while the label always starts at
                   one fixed x regardless of icon width. A plain flex gap
                   left-aligns the icon instead, so narrower icons (Dinner,
                   Work) would sit visibly left of where wider ones (Friends)
                   do, instead of lining up together. w-10 fits the widest
                   icon post-crop (Friends renders ~40px wide at max-h-9). %>
              <span class="w-10 h-9 flex items-center justify-center shrink-0">
                <%= image_tag(selected ? selected_src : pale_src, alt: item[:label], class: "max-h-9 w-auto",
                              data: { icon_pale_src: image_path(pale_src), icon_selected_src: image_path(selected_src) }) %>
              </span>
              <span><%= item[:label] %></span>
            </button>
          <% end %>
        </div>
        <div class="flex flex-col gap-2.5 mt-auto">
          <button type="button" data-action="click->season-modal#close"
                  class="w-full h-[52px] bg-brand-primary text-white rounded-lg border-none font-medium text-lg font-sans text-center cursor-pointer">Add icon</button>
          <button type="button" data-action="click->season-modal#deleteCategory click->season-modal#close"
                  class="w-full bg-transparent text-brand-primary border-none font-medium text-lg font-sans cursor-pointer leading-[45px]">Delete icon</button>
        </div>
      </div>
    </div>

