        <div class="absolute left-[37px] top-[285px] w-[281px] h-[52px] bg-brand-primary rounded-lg"></div>
        <button type="button" data-action="click->season-modal#confirmCustomReminder"
                class="absolute left-[37px] top-[285px] w-[281px] h-[52px] bg-transparent border-none cursor-pointer p-0 flex items-center justify-center font-medium text-base leading-5 tracking-007 text-white">Add reminder</button>
      </div>
    </div>

    <%# ── Guests modal ── %>
    <div data-season-modal-target="guestsBackdrop" class="hidden fixed inset-0 bg-black/40 z-[65]"></div>
    <div data-season-modal-target="guestsModal" role="dialog" aria-modal="true" aria-label="Invite guests"
         class="hidden fixed inset-0 z-[70] flex items-center justify-center">
      <div data-season-modal-target="guestsCard"
           class="w-[348px] h-[331px] bg-white rounded-[29px] shadow-[0_24px_64px_rgba(0,0,0,0.16)] relative transition-[height] duration-[250ms] ease-in-out overflow-hidden">
        <button type="button" data-action="click->season-modal#closeGuests"
                class="absolute left-[290px] top-[5px] w-[37px] h-[37px] bg-transparent border-none cursor-pointer p-0 z-[2]">
