            <% [['minutes','Minutes'],['hours','Hours'],['days','Days']].each_with_index do |(val,label),i| %>
              <div data-value="<%= val %>" class="h-11 flex items-center justify-center text-base tracking-007 text-brand-primary snap-center" style="font-weight:<%= i == 0 ? '700' : '400' %>;opacity:<%= i == 0 ? '1' : '0.4' %>"><%= label %></div>
