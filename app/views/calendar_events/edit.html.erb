            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
          </svg>
        </div>
        <div class="absolute left-[18px] top-[101px] w-[320px] h-0 border border-brand-field"></div>
        <%# Figma's fixed preset list is only these four — no "6 hours"
             preset exists. A custom value (set via "Setting my own timer")
             gets its own inserted pill with a clear "X", further down;
             that's a distinct, bigger behaviour change tracked separately
             in docs/M4.md rather than guessed at here. %>
        <% edit_reminder_options = [[15, '15 minutes earlier'], [60, '1 h earlier'], [1440, '1 day earlier'], [10080, '1 week earlier'], [-1, 'Setting my own timer']] %>
        <% edit_sel_min = @event.reminder_minutes || 15 %>
        <% edit_positions = [140, 185, 230, 276, 354] %>
        <% edit_heights = [39, 38, 38, 38, 39] %>
        <% edit_reminder_options.each_with_index do |(min_val, label), idx| %>
          <%# "Setting my own timer" (min_val -1, a sentinel that opens the
               custom picker rather than ever being a stored value) is always
               rendered solid in Figma, not conditionally on selection. %>
          <% active = min_val == -1 || edit_sel_min == min_val %>
          <div data-season-modal-target="reminderOption"
               data-reminder-minutes-value="<%= min_val %>"
               data-action="click->season-modal#selectReminder"
               class="absolute left-[37px] w-[281px] rounded-[10px] cursor-pointer flex items-center justify-center transition-colors duration-[150ms]"
               style="top:<%= edit_positions[idx] %>px;height:<%= edit_heights[idx] %>px;background:<%= active ? '#EDE1D5' : 'rgba(237,225,213,0.5)' %>">
            <span class="font-medium text-base leading-[45px] text-center <%= active ? 'text-brand-primary' : 'text-brand-primary/50' %>"><%= label %></span>
          </div>
        <% end %>
        <div class="absolute left-[37px] top-[430px] w-[281px] h-[52px] bg-brand-primary rounded-lg"></div>
        <button type="button" data-action="click->season-modal#confirmReminder"
                class="absolute left-[37px] top-[430px] w-[281px] h-[52px] bg-transparent border-none cursor-pointer p-0 flex items-center justify-center font-medium text-base leading-5 tracking-007 text-white">Set reminder</button>
      </div>
    </div>

