<% content_for(:page_title) { "Appointment" } %>
<% content_for(:header_left) do %>
  <%= link_to forecast_path,
        class: "inline-flex items-center justify-center w-10 h-10 rounded-xl text-brand-primary" do %>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
      <path d="M3 18H21V16H3V18ZM3 13H21V11H3V13ZM3 6V8H21V6H3Z" fill="#933A35" />
    </svg>
  <% end %>
<% end %>

<div class="bg-white min-h-screen pb-32 font-sans">
  <div class="max-w-app mx-auto px-4 pt-5">

    <%= form_with model: @event, url: calendar_event_path(@event), method: :patch, local: true do |f| %>

      <%# Title input %>
      <div class="relative">
        <div class="pr-14">
          <%= f.text_field :title,
                placeholder: "Enter title",
                required: true,
                value: @event.title,
                class: "w-full bg-transparent border-none text-[22px] font-medium text-brand-primary p-0 outline-none font-sans" %>
        </div>
        <button type="submit" class="absolute top-0 right-0 w-11 h-11 rounded-full bg-brand-field flex items-center justify-center border-0 p-0 cursor-pointer">
          <svg width="27" height="27" viewBox="0 0 27 27" fill="none">
            <path d="M4.308 4.744C4.308 3.339 5.381 2.189 6.693 2.189C8.005 2.189 9.078 3.339 9.078 4.744C9.078 6.149 8.005 7.298 6.693 7.298C5.381 7.298 4.308 6.149 4.308 4.744ZM15.041 25.18C14.373 25.18 13.825 24.618 13.789 23.903L13.252 12.407L9.078 11.13H1.922C1.266 11.13 0.73 10.555 0.73 9.853C0.73 9.15 1.266 8.576 1.922 8.576H7.885L15.351 2.866C15.852 2.483 16.544 2.573 16.949 3.071C17.402 3.646 17.307 4.501 16.735 4.936L12.823 7.937H16.234L24.689 2.713C24.945 2.544 25.253 2.487 25.548 2.554C25.842 2.622 26.101 2.808 26.27 3.075C26.439 3.342 26.506 3.668 26.456 3.987C26.406 4.305 26.243 4.59 26.001 4.782L16.83 12.407L16.293 23.903C16.257 24.618 15.709 25.18 15.041 25.18Z" fill="#933A35"/>
          </svg>
        </button>
      </div>

      <hr class="border-brand-primary mx-0 my-8" style="width:304px;">

      <%# Reminder rows %>
      <% if @event.reminder_minutes.present? && @event.reminder_minutes > 0 %>
        <div class="flex items-center gap-3 py-3.5 px-0">
          <div class="w-[39px] h-[38px] rounded-full bg-brand-field flex items-center justify-center shrink-0">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#933A35" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 8C18 6.4087 17.3679 4.88258 16.2426 3.75736C15.1174 2.63214 13.5913 2 12 2C10.4087 2 8.88258 2.63214 7.75736 3.75736C6.63214 4.88258 6 6.4087 6 8C6 15 3 17 3 17H21C21 17 18 15 18 8Z" />
              <path d="M13.73 21C13.5537 21.3031 13.3014 21.5547 12.9978 21.7295C12.6941 21.9044 12.3499 21.9965 11.9995 21.9965C11.6492 21.9965 11.3049 21.9044 11.0013 21.7295C10.6977 21.5547 10.4453 21.3031 10.2695 21" />
            </svg>
          </div>
          <% mins = @event.reminder_minutes %>
          <span class="text-brand-primary text-base font-medium tracking-[0.07em] flex-1 font-sans"><%= case mins when 1440 then '1 day before' when 120 then '2 hours before' when 60 then '1 hour before' else "#{mins} minutes before" end %></span>
          <span class="text-brand-primary text-base font-bold font-sans cursor-pointer">X</span>
        </div>
      <% else %>
        <div class="flex items-center gap-3 py-3.5 px-0">
          <div class="w-[39px] h-[38px] rounded-full bg-brand-field flex items-center justify-center shrink-0">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#933A35" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 8C18 6.4087 17.3679 4.88258 16.2426 3.75736C15.1174 2.63214 13.5913 2 12 2C10.4087 2 8.88258 2.63214 7.75736 3.75736C6.63214 4.88258 6 6.4087 6 8C6 15 3 17 3 17H21C21 17 18 15 18 8Z" />
              <path d="M13.73 21C13.5537 21.3031 13.3014 21.5547 12.9978 21.7295C12.6941 21.9044 12.3499 21.9965 11.9995 21.9965C11.6492 21.9965 11.3049 21.9044 11.0013 21.7295C10.6977 21.5547 10.4453 21.3031 10.2695 21" />
            </svg>
          </div>
          <span class="text-brand-primary text-base font-medium tracking-[0.07em] flex-1 font-sans">15 minutes before</span>
        </div>
      <% end %>

      <hr class="border-brand-primary/50 mx-0 my-8">

      <%# Location row %>
      <% loc = @event.location.present? %>
      <div class="flex items-center gap-3 py-3.5 px-0">
        <div class="w-[39px] h-[38px] rounded-full flex items-center justify-center shrink-0 <%= loc ? 'bg-brand-field' : 'bg-brand-field/50' %>">
          <svg width="24" height="25" viewBox="0 0 24 25" fill="none" stroke="#933A35" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11.999 22.197L6.339 16.301C5.22 15.136 4.457 13.651 4.148 12.035C3.839 10.418 3.997 8.743 4.603 7.22C5.208 5.696 6.233 4.395 7.549 3.479C8.865 2.563 10.412 2.074 11.994 2.074C13.577 2.074 15.124 2.563 16.439 3.479C17.755 4.395 18.78 5.696 19.386 7.22C19.991 8.743 20.149 10.418 19.84 12.035C19.531 13.651 18.769 15.136 17.649 16.301L11.999 22.197Z" />
            <path d="M12 13.75C13.657 13.75 15 12.519 15 11C15 9.481 13.657 8.25 12 8.25C10.343 8.25 9 9.481 9 11C9 12.519 10.343 13.75 12 13.75Z" stroke="#933A35" stroke-width="2" />
          </svg>
        </div>
        <span class="text-base font-medium tracking-[0.07em] flex-1 font-sans <%= loc ? 'text-brand-primary' : 'text-[#AFAFAF]' %>"><%= loc ? @event.location : 'Add location' %></span>
      </div>

      <%# Guests row %>
      <% guest_list = @event.guests.to_s.split(',').map(&:strip).reject(&:empty?) %>
      <div class="flex items-start gap-3 py-3.5 px-0">
        <div class="w-[39px] h-[38px] rounded-full flex items-center justify-center shrink-0 mt-0.5 <%= guest_list.any? ? 'bg-brand-field' : 'bg-brand-field/50' %>">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#933A35" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21V19C20 17.939 19.579 16.922 18.828 16.172C18.078 15.421 17.061 15 16 15H8C6.939 15 5.922 15.421 5.172 16.172C4.421 16.922 4 17.939 4 19V21" />
            <path d="M12 11C14.209 11 16 9.209 16 7C16 4.791 14.209 3 12 3C9.791 3 8 4.791 8 7C8 9.209 9.791 11 12 11Z" />
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <% if guest_list.any? %>
            <div class="flex flex-col gap-1">
              <% guest_list.each do |email| %>
                <div class="flex items-center justify-between gap-2">
                  <span class="text-brand-primary text-base font-medium tracking-[0.07em] font-sans"><%= email %></span>
                  <span class="text-brand-primary text-base font-bold font-sans cursor-pointer">X</span>
                </div>
              <% end %>
            </div>
          <% else %>
            <span class="text-[#AFAFAF] text-base font-medium tracking-[0.07em] font-sans">Invite guests</span>
          <% end %>
        </div>
      </div>

      <%# Notes row %>
      <% has_notes = @event.notes.present? %>
      <div class="flex items-start gap-3 py-3.5 px-0">
        <div class="w-[39px] h-[38px] rounded-full flex items-center justify-center shrink-0 <%= has_notes ? 'bg-brand-field' : 'bg-brand-field/50' %>">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#933A35" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 4H18C18.53 4 19.039 4.211 19.414 4.586C19.789 4.961 20 5.47 20 6V20C20 20.53 19.789 21.039 19.414 21.414C19.039 21.789 18.53 22 18 22H6C5.47 22 4.961 21.789 4.586 21.414C4.211 21.039 4 20.53 4 20V6C4 5.47 4.211 4.961 4.586 4.586C4.961 4.211 5.47 4 6 4H8" />
            <path d="M15 2H9C8.448 2 8 2.448 8 3V5C8 5.552 8.448 6 9 6H15C15.552 6 16 5.552 16 5V3C16 2.448 15.552 2 15 2Z" />
          </svg>
        </div>
        <span class="text-base font-medium tracking-[0.07em] flex-1 font-sans <%= has_notes ? 'text-brand-primary' : 'text-[#AFAFAF]' %>"><%= has_notes ? @event.notes.truncate(40) : 'Notes...' %></span>
      </div>

      <%# Repeat row %>
      <% repeat_val = @event.repeat_frequency %>
      <% repeat_label = case repeat_val when 'daily' then 'Daily' when 'weekly' then 'Weekly' when 'monthly' then 'Monthly' when 'yearly' then 'Every Year' when 'custom' then 'Custom' else nil end %>
      <div class="flex items-center gap-3 py-3.5 px-0">
        <div class="w-[39px] h-[38px] rounded-full flex items-center justify-center shrink-0 <%= repeat_val.present? ? 'bg-brand-field' : 'bg-brand-field/50' %>">
          <svg width="22" height="20" viewBox="0 0 22 20" fill="none" stroke="#933A35" stroke-opacity="0.5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.996 1.998V7.998h-6" />
            <path d="M18.486 12.998C17.836 14.838 16.606 16.417 14.98 17.497C13.355 18.576 11.422 19.099 9.474 18.985C7.526 18.871 5.668 18.127 4.18 16.865C2.691 15.603 1.653 13.891 1.222 11.988C0.791 10.085 0.99 8.093 1.79 6.313C2.589 4.533 3.946 3.061 5.654 2.119C7.363 1.176 9.332 0.815 11.264 1.089C13.196 1.363 14.987 2.258 16.366 3.638L20.996 7.998" />
          </svg>
        </div>
        <span class="text-base font-medium tracking-[0.07em] flex-1 font-sans <%= repeat_label.present? ? 'text-brand-primary' : 'text-[#AFAFAF]' %>"><%= repeat_label || 'Repeat' %></span>
      </div>

      <%# ── Buttons ── %>
      <div class="flex flex-col gap-3 pt-7">
        <%= f.submit "Change appointment",
              class: "w-full text-white py-3.5 rounded-lg border-none text-[22px] font-medium font-sans cursor-pointer tracking-[0.03em] bg-brand-primary" %>
        <%= button_to "Delete appointment",
              calendar_event_path(@event),
              method: :delete,
              class: "w-full bg-transparent text-brand-primary rounded-lg text-[22px] font-medium font-sans cursor-pointer tracking-[0.03em] py-3.5 border-0" %>
      </div>

    <% end %>

  </div>
</div>
