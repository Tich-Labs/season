<% content_for(:page_title) { "Edit Appointment" } %>
<% content_for(:header_left) do %>
  <%= link_to daily_view_path(date: @event.date.to_s),
        class: "inline-flex items-center justify-center w-10 h-10 rounded-xl text-brand-primary" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
      <polyline points="15 18 9 12 15 6" />
    </svg>
  <% end %>
<% end %>

<%
  phase     = current_user.current_phase
  phase_col = CycleCalculatorService::PHASE_META[phase]&.dig(:colour) || "#933a35"
%>

<div class="bg-brand-background min-h-screen pb-24">
  <div class="max-w-app mx-auto">

    <div class="relative">
      <div class="h-20 bg-brand-field"></div>
      <div class="absolute inset-0 flex items-center px-4">
        <%= content_for :header_left %>
        <div class="flex-1 text-center">
          <h1 class="text-lg font-semibold text-brand-primary">Appointment</h1>
        </div>
        <div class="w-10"></div>
      </div>
    </div>

    <%= form_with model: @event, url: calendar_event_path(@event), method: :patch, local: true do |f| %>
      <div class="px-4 pt-5 space-y-4">

        <div class="rounded-[32px] overflow-hidden" style="background: <%= phase_col %>33;">
          <div class="px-5 pt-5 pb-4">
            <%= f.text_field :title,
                  required: true,
                  placeholder: "Appointment title",
                  class: "w-full bg-transparent border-0 border-b border-white/40 pb-2 text-3xl font-semibold text-white placeholder-white/70 outline-none" %>
          </div>

          <div class="mx-4 mb-[-24px]">
            <div class="rounded-[30px] bg-white p-5 shadow-sm">
              <p class="text-sm font-semibold text-brand-primary"><%= @event.date.strftime("%A, %B %-d %Y") %></p>
              <p class="mt-3 text-xl font-semibold text-brand-primary">
                <%= @event.start_time ? @event.start_time.strftime("%-H:%M") : "All day" %>
                <% if @event.end_time.present? %>- <%= @event.end_time.strftime("%-H:%M") %><% end %>
              </p>
            </div>
          </div>
        </div>

        <div class="rounded-[28px] bg-white p-4 shadow-sm space-y-3">
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <div class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-field text-brand-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 8v4l3 3" />
                  <path d="M19.4 15a7.5 7.5 0 1 0-1.4 1.4" />
                </svg>
              </div>
              <span class="text-sm font-medium text-brand-primary">15 Minutes before</span>
            </div>
            <button type="button" class="text-brand-primary text-base font-bold">X</button>
          </div>

          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <div class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-field text-brand-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 12h16" />
                  <path d="M8 8l-4 4 4 4" />
                  <path d="M16 8l4 4-4 4" />
                </svg>
              </div>
              <span class="text-sm font-medium text-brand-primary">6 hours before</span>
            </div>
            <button type="button" class="text-brand-primary text-base font-bold">X</button>
          </div>
        </div>

        <div class="rounded-[28px] bg-white p-4 shadow-sm space-y-3">
          <div class="flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-field text-brand-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z" />
                <path d="M6 21c0-3.31 2.69-6 6-6s6 2.69 6 6" />
              </svg>
            </div>
            <span class="text-sm font-medium text-brand-primary">Münster</span>
          </div>

          <div class="flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-field text-brand-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M8 7a4 4 0 1 1 8 0" />
                <path d="M12 14c-4.418 0-8 1.79-8 4v1h16v-1c0-2.21-3.582-4-8-4z" />
              </svg>
            </div>
            <span class="text-sm font-medium text-brand-primary">Shanel@season.vision</span>
            <button type="button" class="text-brand-primary text-base font-bold">X</button>
          </div>

          <div class="flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-field text-brand-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M8 7a4 4 0 1 1 8 0" />
                <path d="M16 14a4 4 0 0 1 0-8" />
                <path d="M4 20c0-3.31 2.69-6 6-6" />
              </svg>
            </div>
            <span class="text-sm font-medium text-brand-primary">Celine@season.vision</span>
            <button type="button" class="text-brand-primary text-base font-bold">X</button>
          </div>
        </div>

        <div class="rounded-[28px] bg-white p-4 shadow-sm">
          <div class="flex items-start gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-field text-brand-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 6h16" />
                <path d="M4 12h16" />
                <path d="M4 18h16" />
              </svg>
            </div>
            <div class="min-w-0">
              <p class="text-sm font-medium text-brand-primary">Note</p>
              <%= f.text_area :notes,
                    placeholder: "Pack Tampon! And don't wear light-colored pants!",
                    rows: 3,
                    class: "mt-2 w-full resize-none rounded-2xl border border-brand-field bg-brand-field/70 px-4 py-3 text-sm text-brand-primary placeholder:text-brand-secondary outline-none" %>
            </div>
          </div>
        </div>

        <div class="rounded-[28px] bg-white p-4 shadow-sm">
          <div class="flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-field text-brand-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 6v6l4 2" />
                <path d="M21 12a9 9 0 1 1-9-9" />
              </svg>
            </div>
            <span class="text-sm font-medium text-brand-primary">Repeat</span>
          </div>
        </div>

        <div class="space-y-3">
          <%= f.submit "Change appointment",
                class: "w-full rounded-xl bg-brand-primary px-5 py-4 text-center text-base font-semibold text-white hover:bg-[#7a2f2a] transition-colors" %>
        </div>
      </div>
    <% end %>

    <div class="px-4 pt-4">
      <%= button_to "Delete appointment",
            calendar_event_path(@event),
            method: :delete,
            class: "w-full rounded-xl bg-white text-brand-primary border border-brand-primary px-5 py-4 text-base font-semibold hover:bg-brand-background transition-colors" %>
    </div>

  </div>
</div>
