            <button type="button" data-action="click->appointment-date-picker#toggleAllDay" data-appointment-date-picker-target="allDayToggle" style="width:63px;height:34px;border-radius:17px;background:#D9D9D9;border:none;cursor:pointer;position:relative;padding:0;">
