            </button>
          </div>
          <button type="button" data-action="click->appointment-date-picker#confirmTime" data-stage2-button style="position:absolute;left:38px;top:440px;width:257px;height:48px;background:#933a35;border-radius:8px;border:none;cursor:pointer;font-family:Montserrat;font-weight:500;font-size:22px;line-height:27px;letter-spacing:0.03em;color:white;text-align:center;">Set date</button>
        </div>
      </div>
