            <span data-appointment-date-picker-target="slot1Time" style="font-family:Montserrat;font-weight:500;font-size:16px;letter-spacing:0.07em;color:#933a35;"></span>
          </div>
          <hr style="position:absolute;left:110px;top:170px;width:132px;border:none;height:1px;background:black;opacity:0.2;">
          <div data-picker="date" style="position:absolute;left:38px;top:195px;width:256px;height:60px;display:flex;align-items:center;justify-content:center;gap:6px;">
            <div style="position:absolute;inset:0;margin:12px 0;background:#EDE1D5;border-radius:8px;"></div>
            <div data-appointment-date-picker-target="monthScroll" data-action="scroll->appointment-date-picker#onMonthScroll" style="overflow-y:auto;scroll-snap-type:y mandatory;height:100%;width:48px;scrollbar-width:none;position:relative;z-index:1;">
              <% (1..12).each do |m| %><div data-value="<%= m %>" style="height:20px;display:flex;align-items:center;justify-content:center;font-family:Montserrat;font-size:16px;letter-spacing:0.07em;color:#933a35;"><%= format('%02d', m) %></div><% end %>
            </div>
            <span style="font-family:Montserrat;font-size:16px;color:#933a35;position:relative;z-index:1;">/</span>
            <div data-appointment-date-picker-target="dayScroll" data-action="scroll->appointment-date-picker#onDayScroll" style="overflow-y:auto;scroll-snap-type:y mandatory;height:100%;width:48px;scrollbar-width:none;position:relative;z-index:1;">
              <% (1..31).each do |d| %><div data-value="<%= d %>" style="height:20px;display:flex;align-items:center;justify-content:center;font-family:Montserrat;font-size:16px;letter-spacing:0.07em;color:#933a35;"><%= format('%02d', d) %></div><% end %>
            </div>
            <span style="font-family:Montserrat;font-size:16px;color:#933a35;position:relative;z-index:1;">/</span>
            <div data-appointment-date-picker-target="yearScroll" data-action="scroll->appointment-date-picker#onYearScroll" style="overflow-y:auto;scroll-snap-type:y mandatory;height:100%;width:64px;scrollbar-width:none;position:relative;z-index:1;">
              <% ((Time.zone.today.year - 5)..(Time.zone.today.year + 5)).each do |y| %><div data-value="<%= y %>" style="height:20px;display:flex;align-items:center;justify-content:center;font-family:Montserrat;font-size:16px;letter-spacing:0.07em;color:#933a35;"><%= y %></div><% end %>
            </div>
          </div>
          <div data-picker="time" style="position:absolute;left:38px;top:195px;width:256px;height:60px;display:none;align-items:center;justify-content:center;gap:4px;">
            <div style="position:absolute;inset:0;margin:12px 0;background:#EDE1D5;border-radius:8px;"></div>
            <div data-appointment-date-picker-target="hourScroll" data-action="scroll->appointment-date-picker#onHourScroll" style="overflow-y:auto;scroll-snap-type:y mandatory;height:100%;width:50px;scrollbar-width:none;position:relative;z-index:1;">
              <% (0..23).each do |h| %><div data-value="<%= h %>" style="height:20px;display:flex;align-items:center;justify-content:center;font-family:Montserrat;font-size:16px;letter-spacing:0.07em;color:#933a35;"><%= format('%02d', h) %></div><% end %>
            </div>
            <span style="font-family:Montserrat;font-weight:700;font-size:16px;color:#933a35;position:relative;z-index:1;">:</span>
            <div data-appointment-date-picker-target="minuteScroll" data-action="scroll->appointment-date-picker#onMinuteScroll" style="overflow-y:auto;scroll-snap-type:y mandatory;height:100%;width:56px;scrollbar-width:none;position:relative;z-index:1;">
              <% [0, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55].each do |m| %><div data-value="<%= m %>" style="height:20px;display:flex;align-items:center;justify-content:center;font-family:Montserrat;font-size:16px;letter-spacing:0.07em;color:#933a35;"><%= format('%02d', m) %></div><% end %>
