    <div data-season-modal-target="repeatUntilBackdrop" class="hidden fixed inset-0 bg-black/40 z-50" data-action="click->season-modal#closeRepeatUntil"></div>
    <div data-season-modal-target="repeatUntilModal" role="dialog" aria-modal="true" aria-label="Repeat until"
         class="hidden fixed inset-0 z-50 flex items-center justify-center">
      <div style="width:361px;height:438px;background:#fff;border-radius:29px;box-shadow:0 24px 64px rgba(0,0,0,0.16);position:relative;">

        <%# Close button %>
        <button type="button" data-action="click->season-modal#closeRepeatUntil"
                style="position:absolute;left:304px;top:13px;width:37px;height:37px;background:transparent;border:none;cursor:pointer;padding:0;z-index:2;">
          <svg width="37" height="37" viewBox="0 0 53 53" fill="none"><path d="M35.8 16.2L36 16.4C36.2 16.6 36.4 17 36.4 17.4C36.4 17.7 36.3 18.1 36.1 18.4L36 18.5L28.3 26.2L36 33.8C36.2 34.1 36.4 34.4 36.4 34.8C36.4 35.2 36.3 35.5 36.1 35.8L36 36C35.7 36.2 35.4 36.4 35 36.4C34.6 36.4 34.2 36.3 33.9 36.1L33.8 36L26.2 28.3L18.5 36C18.3 36.2 17.9 36.4 17.5 36.4C17.2 36.4 16.8 36.3 16.5 36.1L16.4 36C16.1 35.7 16 35.4 15.9 35C15.9 34.6 16 34.2 16.2 33.9L16.4 33.8L24 26.2L16.4 18.5C16.1 18.3 16 17.9 15.9 17.5C15.9 17.2 16 16.8 16.2 16.5L16.4 16.4C16.6 16.1 17 16 17.4 15.9C17.7 15.9 18.1 16 18.4 16.2L18.5 16.4L26.2 24L33.8 16.4C34.1 16.1 34.4 16 34.8 15.9C35.2 15.9 35.5 16 35.8 16.2L36 16.4L35.8 16.2Z" fill="#A43600" /></svg>
        </button>

        <%# Title %>
        <% until_date = evt_date + 30 %>
        <% days_count = (until_date - evt_date).to_i %>
        <% day_names = %w[Su Mo Tu We Th Fr Sa] %>
        <% d = until_date.day; m = until_date.month; y = until_date.year %>
        <% date_label = "#{day_names[until_date.wday]} #{format('%02d', d)}.#{format('%02d', m)}.#{y}" %>
        <p style="position:absolute;left:50%;transform:translateX(-50%);top:34px;font-family:Montserrat;font-weight:500;font-size:22px;line-height:27px;letter-spacing:0.03em;color:#933A35;white-space:nowrap;">Repeat until day <%= days_count %></p>
        <div style="position:absolute;left:36px;top:100px;width:287px;height:0;border:1px solid #EDE1D5;"></div>

        <%# Selected date display above scrollers %>
        <p style="position:absolute;left:50%;transform:translateX(-50%);top:136px;font-family:Montserrat;font-weight:700;font-size:16px;letter-spacing:0.07em;color:#933A35;white-space:nowrap;"><%= date_label %></p>

        <%# Date scroll picker — 3 vertical columns with center highlight %>
        <div style="position:absolute;left:36px;top:176px;width:287px;height:100px;background:#fff;border-radius:8px;display:flex;align-items:center;justify-content:center;gap:12px;position:relative;overflow:hidden;">
          <%# Center highlight bar (behind selected row) %>
          <div style="position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);height:44px;background:#EDE1D5;border-radius:8px;pointer-events:none;"></div>
          <%# Day column %>
          <div style="overflow-y:auto;scroll-snap-type:y mandatory;height:100%;width:44px;scrollbar-width:none;text-align:center;position:relative;z-index:1;"
               onscroll="const t=this;t.querySelectorAll('div').forEach(el=>{const r=el.getBoundingClientRect(),p=t.getBoundingClientRect(),c=r.top-p.top+r.height/2-t.clientHeight/2;el.style.opacity=Math.abs(c)<22?'1':'0.35';el.style.fontWeight=Math.abs(c)<22?'700':'400';el.style.color=Math.abs(c)<22?'#933A35':'#933A35'})">
            <% (1..31).each do |day| %>
              <div style="height:44px;display:flex;align-items:center;justify-content:center;font-family:Montserrat;font-size:16px;color:#933A35;scroll-snap-align:center;font-weight:<%= day == d ? '700' : '400' %>;opacity:<%= day == d ? '1' : '0.35' %>"><%= format('%02d', day) %></div>
            <% end %>
          </div>
          <%# Month column %>
          <% months = %w[Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec] %>
          <div style="overflow-y:auto;scroll-snap-type:y mandatory;height:100%;width:52px;scrollbar-width:none;text-align:center;position:relative;z-index:1;"
               onscroll="const t=this;t.querySelectorAll('div').forEach(el=>{const r=el.getBoundingClientRect(),p=t.getBoundingClientRect(),c=r.top-p.top+r.height/2-t.clientHeight/2;el.style.opacity=Math.abs(c)<22?'1':'0.35';el.style.fontWeight=Math.abs(c)<22?'700':'400'})">
            <% months.each_with_index do |mon, mi| %>
              <% mo = mi + 1 %>
              <div style="height:44px;display:flex;align-items:center;justify-content:center;font-family:Montserrat;font-size:16px;color:#933A35;scroll-snap-align:center;font-weight:<%= mo == m ? '700' : '400' %>;opacity:<%= mo == m ? '1' : '0.35' %>"><%= mon %></div>
            <% end %>
          </div>
          <%# Year column %>
          <div style="overflow-y:auto;scroll-snap-type:y mandatory;height:100%;width:60px;scrollbar-width:none;text-align:center;position:relative;z-index:1;"
               onscroll="const t=this;t.querySelectorAll('div').forEach(el=>{const r=el.getBoundingClientRect(),p=t.getBoundingClientRect(),c=r.top-p.top+r.height/2-t.clientHeight/2;el.style.opacity=Math.abs(c)<22?'1':'0.35';el.style.fontWeight=Math.abs(c)<22?'700':'400'})">
            <% (2025..2035).each do |yr| %>
              <div style="height:44px;display:flex;align-items:center;justify-content:center;font-family:Montserrat;font-size:16px;color:#933A35;scroll-snap-align:center;font-weight:<%= yr == y ? '700' : '400' %>;opacity:<%= yr == y ? '1' : '0.35' %>"><%= yr %></div>
            <% end %>
          </div>
        </div>

        <%# Save button %>
        <div style="position:absolute;left:36px;top:341px;width:287px;height:52px;background:#933A35;border-radius:8px;"></div>
        <button type="button" data-action="click->season-modal#confirmRepeatUntil"
                style="position:absolute;left:36px;top:341px;width:287px;height:52px;background:transparent;border:none;cursor:pointer;padding:0;display:flex;align-items:center;justify-content:center;font-family:Montserrat;font-weight:500;font-size:16px;line-height:20px;letter-spacing:0.07em;color:#fff;">Save</button>
      </div>
    </div>

  </div>
</div>
