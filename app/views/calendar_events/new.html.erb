<% content_for(:page_title) { "Appointment" } %>
<% content_for(:header_left) do %>
  <%= link_to (params[:date] ? daily_view_path(date: params[:date]) : user_root_path),
        class: "inline-flex items-center justify-center w-10 h-10 rounded-xl text-brand-primary" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
      <polyline points="15 18 9 12 15 6" />
    </svg>
  <% end %>
<% end %>

<%
  phase     = current_user.current_phase
  phase_col = CycleCalculatorService::PHASE_META[phase]&.dig(:colour) || "#933a35"
  evt_date  = params[:date] ? Date.parse(params[:date]) : Time.zone.today
  default_start = @event.start_time || Time.zone.now.change(hour: 19, min: 0)
  default_end   = @event.end_time   || Time.zone.now.change(hour: 20, min: 0)
%>

<div class="bg-white min-h-screen pb-32 font-sans" data-controller="season-modal">
  <div class="max-w-app mx-auto px-4 pt-5">

    <% category_icons = {
      'Friends' => 'family.svg', 'Dinner' => 'dinner.svg', 'Date' => 'date.svg',
      'Sports' => 'sport.svg', 'Medical' => 'medical.svg', 'Birthday' => 'birthday.svg',
      'Work' => 'work.svg', 'Coffee' => 'coffee.svg', 'Shopping' => 'shopping.svg'
    } %>
    <%= form_with model: @event, url: calendar_events_path, local: true do |f| %>

      <div class="relative">

        <%# Trigger button — shows + or selected category icon %>
        <% has_category = @event.category.present? && category_icons.key?(@event.category) %>
        <button type="button" data-action="click->season-modal#open"
                data-season-modal-target="triggerButton"
                aria-label="Choose event type"
                class="absolute top-0 right-0 w-11 h-11 rounded-full bg-brand-field flex items-center justify-center border-0 p-0 cursor-pointer">
          <% if has_category %>
            <%= image_tag "icons/appointment/#{category_icons[@event.category]}", alt: @event.category, style: "width:30px;height:30px;" %>
          <% else %>
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24">
              <path d="M12 5v14M5 12h14" stroke="#A43600" stroke-width="2.5" stroke-linecap="round"></path>
            </svg>
          <% end %>
        </button>

        <%# Title input %>
        <div class="bg-white rounded-3xl px-4 pt-4 pb-3 pr-12">
          <%= f.text_field :title,
                placeholder: "Enter title",
                required: true,
                class: "w-full bg-transparent border-none text-[22px] font-medium text-brand-primary p-0 outline-none font-sans" %>
        </div>

        <%# Date + time — phase-colored block %>
        <div class="mt-4 px-4 py-5 text-center rounded-3xl"
             style="background:<%= phase_col %>;">
          <span class="text-white text-[22px] font-medium tracking-wide block font-sans">
            <%= evt_date.strftime("%a. %B ") %><%= evt_date.day.ordinalize %><%= evt_date.strftime(" %Y") %>
          </span>
          <div class="mt-4 flex items-center justify-center gap-1">
            <%= f.time_field :start_time,
                  value: default_start.strftime("%H:%M"),
                  class: "bg-transparent border-none text-white text-[22px] font-medium font-sans outline-none w-[60px] text-center p-0 appearance-none" %>
            <span class="text-white text-[22px] font-light font-sans">-</span>
            <%= f.time_field :end_time,
                  value: default_end.strftime("%H:%M"),
                  class: "bg-transparent border-none text-white text-[22px] font-medium font-sans outline-none w-[60px] text-center p-0 appearance-none" %>
          </div>
          <%= f.hidden_field :date, value: evt_date %>
        </div>
      </div>

      <%# ── Divider ── %>
      <hr class="border-brand-primary/20 my-10 mx-1.5">

      <%# ── Reminder row (bell) ── %>
      <div class="flex items-center gap-3 py-3.5 px-0">
        <div class="w-[39px] h-[38px] rounded-full bg-brand-field flex items-center justify-center shrink-0">
          <svg width="20" height="20" fill="none" stroke="#933A35" stroke-width="2" viewBox="0 0 24 24">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
          </svg>
        </div>
        <span class="text-brand-primary text-base font-medium tracking-[0.07em] flex-1 font-sans">15 minutes before</span>
        <svg width="16" height="16" fill="none" stroke="#AFAFAF" stroke-width="2" viewBox="0 0 24 24">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </div>

      <hr class="border-brand-primary/20 mx-1.5">

      <%# ── Location row (droplet) ── %>
      <div class="flex items-center gap-3 py-3.5 px-0">
        <div class="w-[39px] h-[38px] rounded-full bg-brand-field/50 flex items-center justify-center shrink-0">
          <svg width="20" height="20" fill="none" stroke="#933A35" stroke-width="2" viewBox="0 0 24 24" opacity="0.5">
            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
          </svg>
        </div>
        <span class="text-[#AFAFAF] text-base font-medium tracking-[0.07em] flex-1 font-sans">Add location</span>
        <svg width="16" height="16" fill="none" stroke="#AFAFAF" stroke-width="2" viewBox="0 0 24 24">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </div>

      <%# ── Notes row (eye) — with textarea ── %>
      <div class="flex items-start gap-3 py-3.5 px-0">
        <div class="w-[39px] h-[38px] rounded-full bg-brand-field/50 flex items-center justify-center shrink-0 mt-0.5">
          <svg width="20" height="20" fill="none" stroke="#933A35" stroke-width="2" viewBox="0 0 24 24" opacity="0.5">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
            <circle cx="12" cy="12" r="3" />
          </svg>
        </div>
        <%= f.text_area :notes,
              placeholder: "Notes",
              rows: 2,
              class: "flex-1 bg-transparent border-none text-base font-medium tracking-[0.07em] text-brand-primary font-sans outline-none resize-none p-0" %>
      </div>

      <%# ── Guests row (user) ── %>
      <div class="flex items-center gap-3 py-3.5 px-0">
        <div class="w-[39px] h-[38px] rounded-full bg-brand-field/50 flex items-center justify-center shrink-0">
          <svg width="20" height="20" fill="none" stroke="#933A35" stroke-width="2" viewBox="0 0 24 24" opacity="0.5">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
          </svg>
        </div>
        <span class="text-[#AFAFAF] text-base font-medium tracking-[0.07em] flex-1 font-sans">Invite guests</span>
        <svg width="16" height="16" fill="none" stroke="#AFAFAF" stroke-width="2" viewBox="0 0 24 24">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </div>

      <%# ── Repeat row (clipboard) ── %>
      <div class="flex items-center gap-3 py-3.5 px-0">
        <div class="w-[39px] h-[38px] rounded-full bg-brand-field/50 flex items-center justify-center shrink-0">
          <svg width="20" height="20" fill="none" stroke="#933A35" stroke-width="2" viewBox="0 0 24 24" opacity="0.5">
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
            <rect x="8" y="2" width="8" height="4" rx="1" />
          </svg>
        </div>
        <span class="text-[#AFAFAF] text-base font-medium tracking-[0.07em] flex-1 font-sans">Repeat</span>
        <svg width="16" height="16" fill="none" stroke="#AFAFAF" stroke-width="2" viewBox="0 0 24 24">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </div>

      <%# ── Submit button ── %>
      <div class="flex justify-center pt-7">
        <%= f.submit "Set appointment",
              class: "w-80 text-white py-3.5 rounded-lg border-none text-[22px] font-medium font-sans cursor-pointer tracking-[0.03em]",
              style: "background:#{phase_col};" %>
      </div>

      <%= f.hidden_field :category, value: @event.category, data: { season_modal_target: 'categoryInput' } %>

      <% if @event&.persisted? %>
        <div class="flex justify-center pt-3">
          <%= button_to "Delete appointment",
                calendar_event_path(@event),
                method: :delete,
                class: "w-80 bg-transparent text-brand-primary border border-brand-primary rounded-lg text-[22px] font-medium font-sans cursor-pointer tracking-[0.03em] py-3.5" %>
        </div>
      <% end %>

    <% end %>

    <%# ── Icon picker modal ── %>
    <div data-season-modal-target="backdrop" class="hidden fixed inset-0 bg-black/40 z-50"></div>
    <div data-season-modal-target="modal" role="dialog" aria-modal="true" aria-labelledby="choose-icon-modal-title"
         class="hidden fixed inset-0 z-50 flex items-center justify-center">
      <div class="w-[351px] h-[845px] bg-white rounded-[29px] p-6 relative" style="box-shadow:0 24px 64px rgba(0,0,0,0.16);">

        <%# Modal header %>
        <div class="flex justify-center items-center relative mb-4">
          <h2 id="choose-icon-modal-title" class="text-[22px] font-medium text-brand-primary text-center font-sans leading-[45px]">Choose an icon.</h2>
          <button type="button" data-season-modal-target="closeBtn" data-action="click->season-modal#close"
                  class="absolute right-0 top-1/2 -translate-y-1/2 bg-transparent border-none text-brand-primary text-[26px] w-9 h-9 flex items-center justify-center cursor-pointer font-sans">×</button>
        </div>

        <hr class="border-brand-field mb-4">

        <%# Category list %>
        <div class="relative" style="height:660px;">
          <% items = [
            { label: 'Friends', icon: 'family.svg', top: 0 },
            { label: 'Dinner', icon: 'dinner.svg', top: 62 },
            { label: 'Date', icon: 'date.svg', top: 125 },
            { label: 'Sports', icon: 'sport.svg', top: 187 },
            { label: 'Medical', icon: 'medical.svg', top: 249 },
            { label: 'Birthday', icon: 'birthday.svg', top: 311 },
            { label: 'Work', icon: 'work.svg', top: 371 },
            { label: 'Coffee', icon: 'coffee.svg', top: 435 },
            { label: 'Shopping', icon: 'shopping.svg', top: 499 }
          ] %>
          <% items.each do |item| %>
            <% selected = @event.category.present? && @event.category == item[:label] %>
            <button type="button"
                    data-action="click->season-modal#selectCategory"
                    data-category-name-value="<%= item[:label] %>"
                    data-season-modal-target="categoryOption"
                    class="absolute left-0 w-full h-[45px] flex items-center gap-3 border-none bg-transparent text-left font-medium text-[22px] font-sans leading-[45px] cursor-pointer p-0"
                    style="top:<%= item[:top] %>px; color:<%= selected ? '#933A35' : '#EDE1D5' %>;">
              <%= image_tag "icons/appointment/#{item[:icon]}", alt: item[:label], class: "w-[47px] h-[45px]" %>
              <span><%= item[:label] %></span>
            </button>
          <% end %>
        </div>

        <%# Modal footer %>
        <div class="flex flex-col gap-2.5 mt-auto">
          <button type="button" data-action="click->season-modal#close"
                  class="w-full h-[52px] bg-brand-primary text-white rounded-lg border-none font-medium text-[22px] font-sans leading-[45px] text-center cursor-pointer">Add Icon</button>
          <button type="button" data-action="click->season-modal#close"
                  class="w-full bg-transparent text-brand-primary border-none font-medium text-[22px] font-sans leading-[45px] cursor-pointer">Delete Icon</button>
        </div>
      </div>
    </div>

  </div>
</div>
