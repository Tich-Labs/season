<% content_for(:page_title) { "Appointment" } %>
<% content_for(:header_left) do %>
  <%= link_to (params[:date] ? daily_view_path(date: params[:date]) : user_root_path),
        class: "inline-flex items-center justify-center w-10 h-10 rounded-xl text-brand-primary" do %>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
      <path d="M3 18H21V16H3V18ZM3 13H21V11H3V13ZM3 6V8H21V6H3Z" fill="#933A35" />
    </svg>
  <% end %>
<% end %>

<%
  evt_date  = params[:date] ? Date.parse(params[:date]) : Time.zone.tomorrow.to_date
  now = Time.zone.now
  default_start = @event.start_time || now.change(min: 0) + 1.hour
  default_end   = @event.end_time   || default_start + 1.hour
%>

<div class="bg-white min-h-screen pb-32 font-sans" data-controller="season-modal appointment-date-picker"
     data-appointment-date-picker-selected-date-value="<%= evt_date %>">
  <div class="max-w-app mx-auto px-4 pt-5">

    <% category_icons = {
      'Friends' => 'family.svg', 'Dinner' => 'dinner.svg', 'Date' => 'date.svg',
      'Sports' => 'sport.svg', 'Medical' => 'medical.svg', 'Birthday' => 'birthday.svg',
      'Work' => 'work.svg', 'Coffee' => 'coffee.svg', 'Shopping' => 'shopping.svg'
    } %>
    <%= form_with model: @event, url: calendar_events_path, local: true do |f| %>

      <div class="relative">

        <%# Trigger button — shows + or selected category icon %>
        <% has_category = @event.category.present? && category_icons.key?(@event.category) %>
        <button type="button" data-action="click->season-modal#open"
                data-season-modal-target="triggerButton"
                aria-label="Choose event type"
                class="absolute top-0 right-0 w-11 h-11 rounded-full bg-brand-field flex items-center justify-center border-0 p-0 cursor-pointer">
          <% if has_category %>
            <%= image_tag "icons/appointment/#{category_icons[@event.category]}", alt: @event.category, style: "width:30px;height:30px;" %>
          <% else %>
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24">
              <path d="M12 5v14M5 12h14" stroke="#A43600" stroke-width="2.5" stroke-linecap="round"></path>
            </svg>
          <% end %>
        </button>

        <%# Title input %>
        <div class="bg-white rounded-3xl px-4 pt-4 pb-3 pr-12">
          <%= f.text_field :title,
                placeholder: "Enter title",
                required: true,
                class: "w-full bg-transparent border-none text-[22px] font-medium text-brand-primary p-0 outline-none font-sans" %>
        </div>

        <div class="mx-5 my-8" style="width:304px;height:1px;background:#933A35;"></div>

        <%# Date + time — SVG block %>
        <div class="py-8">
          <div class="mx-auto relative" style="width:360px;height:125px;">
          <svg width="360" height="125" viewBox="0 0 360 125" fill="none" xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 pointer-events-none">
            <path d="M0 19C0 8.50659 8.50659 0 19 0H341C351.493 0 360 8.50659 360 19V106C360 116.493 351.493 125 341 125H19C8.50659 125 0 116.493 0 106V19Z" fill="#933A35" />
          </svg>
          <div class="relative z-10 flex flex-col justify-center items-center gap-2 h-full text-center">
            <button type="button" data-action="click->appointment-date-picker#open"
                    data-appointment-date-picker-target="dateDisplay"
                    class="text-white text-[22px] font-medium tracking-wide font-sans bg-transparent border-none cursor-pointer p-0">
              <%= evt_date.strftime("%a. %B ") %><%= evt_date.day.ordinalize %><%= evt_date.strftime(" %Y") %>
            </button>
          <%
            st_h = default_start.hour > 12 ? default_start.hour - 12 : (default_start.hour == 0 ? 12 : default_start.hour)
            st_m = (default_start.min / 5).round * 5
            st_ampm = default_start.hour >= 12 ? 'PM' : 'AM'
            et_h = default_end.hour > 12 ? default_end.hour - 12 : (default_end.hour == 0 ? 12 : default_end.hour)
            et_m = (default_end.min / 5).round * 5
            et_ampm = default_end.hour >= 12 ? 'PM' : 'AM'
          %>
          <div class="flex items-center justify-center gap-1">
            <div data-controller="time-picker"
                 data-time-picker-hour-value="<%= st_h %>"
                 data-time-picker-minute-value="<%= st_m %>"
                 data-time-picker-ampm-value="<%= st_ampm %>"
                 data-time-picker-field-name-value="calendar_event[start_time]"
                 class="inline-flex items-center gap-0">
              <button type="button" data-action="click->time-picker#open"
                      data-time-picker-target="display"
                      class="text-white text-[22px] font-medium tracking-wide font-sans bg-transparent border-none cursor-pointer p-0 min-w-[44px] min-h-[44px] select-none"><%= st_h %>:<%= format('%02d', st_m) %> <%= st_ampm %></button>
              <div data-time-picker-target="edit" class="hidden items-center gap-0">
                <select data-time-picker-target="hourSelect" data-action="change->time-picker#update" class="tp-select">
                  <% (1..12).each do |h| %><option value="<%= h %>" <%= 'selected' if h == st_h %>><%= h %></option><% end %>
                </select>
                <span class="text-white text-[22px] font-light font-sans w-[8px] text-center">:</span>
                <select data-time-picker-target="minuteSelect" data-action="change->time-picker#update" class="tp-select">
                  <% [0, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55].each do |m| %><option value="<%= m %>" <%= 'selected' if m == st_m %>><%= format('%02d', m) %></option><% end %>
                </select>
                <select data-time-picker-target="ampmSelect" data-action="change->time-picker#updateAmPm" class="tp-select">
                  <option value="AM" <%= 'selected' if st_ampm == 'AM' %>>AM</option>
                  <option value="PM" <%= 'selected' if st_ampm == 'PM' %>>PM</option>
                </select>
                <button type="button" data-action="click->time-picker#close" class="tp-done">&check;</button>
              </div>
              <input type="hidden" name="calendar_event[start_time]" data-time-picker-target="field" data-appointment-date-picker-target="startField" value="<%= default_start.strftime('%H:%M') %>">
            </div>
            <span class="text-white text-[22px] font-light font-sans">-</span>
            <div data-controller="time-picker"
                 data-time-picker-hour-value="<%= et_h %>"
                 data-time-picker-minute-value="<%= et_m %>"
                 data-time-picker-ampm-value="<%= et_ampm %>"
                 data-time-picker-field-name-value="calendar_event[end_time]"
                 class="inline-flex items-center gap-0">
              <button type="button" data-action="click->time-picker#open"
                      data-time-picker-target="display"
                      class="text-white text-[22px] font-medium tracking-wide font-sans bg-transparent border-none cursor-pointer p-0 min-w-[44px] min-h-[44px] select-none"><%= et_h %>:<%= format('%02d', et_m) %> <%= et_ampm %></button>
              <div data-time-picker-target="edit" class="hidden items-center gap-0">
                <select data-time-picker-target="hourSelect" data-action="change->time-picker#update" class="tp-select">
                  <% (1..12).each do |h| %><option value="<%= h %>" <%= 'selected' if h == et_h %>><%= h %></option><% end %>
                </select>
                <span class="text-white text-[22px] font-light font-sans w-[8px] text-center">:</span>
                <select data-time-picker-target="minuteSelect" data-action="change->time-picker#update" class="tp-select">
                  <% [0, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55].each do |m| %><option value="<%= m %>" <%= 'selected' if m == et_m %>><%= format('%02d', m) %></option><% end %>
                </select>
                <select data-time-picker-target="ampmSelect" data-action="change->time-picker#updateAmPm" class="tp-select">
                  <option value="AM" <%= 'selected' if et_ampm == 'AM' %>>AM</option>
                  <option value="PM" <%= 'selected' if et_ampm == 'PM' %>>PM</option>
                </select>
                <button type="button" data-action="click->time-picker#close" class="tp-done">&check;</button>
              </div>
              <input type="hidden" name="calendar_event[end_time]" data-time-picker-target="field" data-appointment-date-picker-target="endField" value="<%= default_end.strftime('%H:%M') %>">
            </div>
          </div>
          <%= f.hidden_field :date, value: evt_date, data: { appointment_date_picker_target: 'dateField' } %>
          <%= f.hidden_field :end_date, value: nil, data: { appointment_date_picker_target: 'endDateField' } %>
          </div>
        </div>
        </div>
      </div>

      <%# hr %>
      <hr class="border-brand-primary/50 my-8 mx-5">

      <%# Reminder row %>
      <% rem = @event.reminder_minutes || 15 %>
      <% rem_label = case rem when 0 then 'No reminder' when -1 then 'Custom timer' when 10080 then '1 week before' when 1440 then '1 day before' when 60 then '1 hour before' else "#{rem} minutes before" end %>
      <div class="flex items-center gap-3 py-3.5 px-5 cursor-pointer"
           data-action="click->season-modal#openReminder">
        <div data-season-modal-target="reminderIconBg" class="w-[39px] h-[38px] rounded-full flex items-center justify-center shrink-0 <%= rem == 0 ? 'bg-brand-field/50' : 'bg-brand-field' %>">
          <svg width="20" height="20" fill="none" stroke="#933A35" stroke-width="2" viewBox="0 0 24 24" <%= rem == 0 ? 'opacity="0.5"' : '' %>>
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
          </svg>
        </div>
        <span data-season-modal-target="reminderLabel" class="text-base font-medium tracking-[0.07em] flex-1 font-sans <%= rem == 0 ? 'text-[#AFAFAF]' : 'text-brand-primary' %>"><%= rem_label %></span>
      </div>

      <hr class="border-brand-primary/50 my-8 mx-5">

      <%# Location row %>
      <% loc = @event.location.present? %>
      <div class="flex items-center gap-3 py-3.5 px-5 cursor-pointer"
           data-action="click->season-modal#openLocation">
        <div data-season-modal-target="locationIconBg" class="w-[39px] h-[38px] rounded-full flex items-center justify-center shrink-0 <%= loc ? 'bg-brand-field' : 'bg-brand-field/50' %>">
          <svg width="20" height="20" fill="none" stroke="#933A35" stroke-width="2" viewBox="0 0 24 24" <%= loc ? '' : 'opacity="0.5"' %>>
            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
          </svg>
        </div>
        <span data-season-modal-target="locationLabel" class="text-base font-medium tracking-[0.07em] flex-1 font-sans <%= loc ? 'text-brand-primary' : 'text-[#AFAFAF]' %>"><%= loc ? @event.location : 'Add location' %></span>
      </div>

      <%# Notes row %>
      <% has_notes = @event.notes.present? %>
      <div class="flex items-center gap-3 py-3.5 px-5 cursor-pointer"
           data-action="click->season-modal#openNotes">
        <div data-season-modal-target="notesIconBg" class="w-[39px] h-[38px] rounded-full flex items-center justify-center shrink-0 <%= has_notes ? 'bg-brand-field' : 'bg-brand-field/50' %>">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" <%= has_notes ? '' : 'stroke-opacity="0.5"' %>>
            <path d="M16 4H18C18.5304 4 19.0391 4.21071 19.4142 4.58579C19.7893 4.96086 20 5.46957 20 6V20C20 20.5304 19.7893 21.0391 19.4142 21.4142C19.0391 21.7893 18.5304 22 18 22H6C5.46957 22 4.96086 21.7893 4.58579 21.4142C4.21071 21.0391 4 20.5304 4 20V6C4 5.46957 4.21071 4.96086 4.58579 4.58579C4.96086 4.21071 5.46957 4 6 4H8" stroke="#933A35" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M15 2H9C8.44772 2 8 2.44772 8 3V5C8 5.55228 8.44772 6 9 6H15C15.5523 6 16 5.55228 16 5V3C16 2.44772 15.5523 2 15 2Z" stroke="#933A35" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <span data-season-modal-target="notesLabel" class="text-base font-medium tracking-[0.07em] flex-1 font-sans <%= has_notes ? 'text-brand-primary' : 'text-[#AFAFAF]' %>"><%= has_notes ? @event.notes.truncate(30) : 'Notes...' %></span>
      </div>

      <%# Guests row %>
      <% guest_list = @event.guests.to_s.split(',').map(&:strip).reject(&:empty?) %>
      <div class="flex items-center gap-3 py-3.5 px-5 cursor-pointer"
           data-action="click->season-modal#openGuests">
        <div data-season-modal-target="guestsIconBg" class="w-[39px] h-[38px] rounded-full flex items-center justify-center shrink-0 <%= guest_list.any? ? 'bg-brand-field' : 'bg-brand-field/50' %>">
          <svg width="20" height="20" fill="none" stroke="#933A35" stroke-width="2" viewBox="0 0 24 24" <%= guest_list.any? ? '' : 'opacity="0.5"' %>>
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <span data-season-modal-target="guestsLabel" class="text-[#AFAFAF] text-base font-medium tracking-[0.07em] font-sans <%= guest_list.any? ? 'hidden' : '' %>">Invite guests</span>
          <div data-season-modal-target="guestsInlineList" class="<%= guest_list.any? ? '' : 'hidden' %> flex flex-col gap-1">
            <% guest_list.each do |email| %>
              <div class="flex items-center justify-between gap-2">
                <span class="text-brand-primary text-base font-medium tracking-[0.07em] font-sans truncate"><%= email %></span>
                <button type="button" data-action="click->season-modal#removeGuest"
                        data-guest-email="<%= email %>"
                        class="shrink-0 bg-transparent border-none cursor-pointer p-0 w-6 h-6 flex items-center justify-center">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M9 3L3 9M3 3l6 6" stroke="#933A35" stroke-width="1.5" stroke-linecap="round" /></svg>
                </button>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <%# Repeat row %>
      <div class="flex items-center gap-3 py-3.5 px-5 cursor-pointer"
           data-action="click->season-modal#openRepeat">
        <div data-season-modal-target="repeatIconBg" class="w-[39px] h-[38px] rounded-full bg-brand-field/50 flex items-center justify-center shrink-0">
          <svg width="22" height="20" viewBox="0 0 22 20" fill="none" stroke="#933A35" stroke-opacity="0.5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.996 1.998V7.998h-6" />
            <path d="M18.486 12.998C17.836 14.838 16.606 16.417 14.98 17.497C13.355 18.576 11.422 19.099 9.474 18.985C7.526 18.871 5.668 18.127 4.18 16.865C2.691 15.603 1.653 13.891 1.222 11.988C0.791 10.085 0.99 8.093 1.79 6.313C2.589 4.533 3.946 3.061 5.654 2.119C7.363 1.176 9.332 0.815 11.264 1.089C13.196 1.363 14.987 2.258 16.366 3.638L20.996 7.998" />
          </svg>
        </div>
        <span data-season-modal-target="repeatLabel" class="text-[#AFAFAF] text-base font-medium tracking-[0.07em] flex-1 font-sans">Repeat</span>
      </div>

      <%# ── Submit button ── %>
      <div class="flex justify-center pt-7">
        <%= f.submit "Set appointment",
              class: "w-full text-white py-3.5 rounded-lg border-none text-[22px] font-medium font-sans cursor-pointer tracking-[0.03em] bg-brand-primary" %>
      </div>

      <%= f.hidden_field :repeat_frequency, value: 'monthly', data: { season_modal_target: 'repeatField' } %>
      <%= f.hidden_field :reminder_minutes, value: @event.reminder_minutes || 15, data: { season_modal_target: 'reminderField' } %>
      <%= f.hidden_field :guests, value: @event.guests, data: { season_modal_target: 'guestsField' } %>
      <%= f.hidden_field :category, value: @event.category, data: { season_modal_target: 'categoryInput' } %>
      <%= f.hidden_field :location, value: @event.location, data: { season_modal_target: 'locationField' } %>
      <%= f.hidden_field :notes, value: @event.notes, data: { season_modal_target: 'notesField' } %>

      <% if @event&.persisted? %>
        <div class="flex justify-center pt-3">
          <%= button_to "Delete appointment",
                calendar_event_path(@event),
                method: :delete,
                class: "w-full bg-transparent text-brand-primary rounded-lg text-[22px] font-medium font-sans cursor-pointer tracking-[0.03em] py-3.5 border-0" %>
        </div>
      <% end %>

    <% end %>

    <%# ── Set Date modal ── %>
    <div data-appointment-date-picker-target="backdrop" class="hidden fixed inset-0 bg-black/40 z-50" data-action="click->appointment-date-picker#close"></div>
    <div data-appointment-date-picker-target="modal" role="dialog" aria-modal="true" class="hidden">
      <div style="width:333px;height:406px;background:#fff;border-radius:29px;box-shadow:0 24px 64px rgba(0,0,0,0.16);position:relative;">

        <%# ── Stage 1 ── %>
        <div data-appointment-date-picker-target="stage1">
          <span data-appointment-date-picker-target="dateTitle" style="position:absolute;left:54px;top:65px;width:228px;font-family:Montserrat;font-weight:500;font-size:22px;line-height:27px;letter-spacing:0.03em;color:#933a35;text-align:center;"></span>
          <button type="button" data-action="click->appointment-date-picker#close" style="position:absolute;left:278px;top:13px;width:37px;height:37px;background:transparent;border:none;cursor:pointer;padding:0;">
            <svg width="37" height="37" viewBox="0 0 53 53" fill="none"><path d="M35.8 16.2L36 16.4C36.2 16.6 36.4 17 36.4 17.4C36.4 17.7 36.3 18.1 36.1 18.4L36 18.5L28.3 26.2L36 33.8C36.2 34.1 36.4 34.4 36.4 34.8C36.4 35.2 36.3 35.5 36.1 35.8L36 36C35.7 36.2 35.4 36.4 35 36.4C34.6 36.4 34.2 36.3 33.9 36.1L33.8 36L26.2 28.3L18.5 36C18.3 36.2 17.9 36.4 17.5 36.4C17.2 36.4 16.8 36.3 16.5 36.1L16.4 36C16.1 35.7 16 35.4 15.9 35C15.9 34.6 16 34.2 16.2 33.9L16.4 33.8L24 26.2L16.4 18.5C16.1 18.3 16 17.9 15.9 17.5C15.9 17.2 16 16.8 16.2 16.5L16.4 16.4C16.6 16.1 17 16 17.4 15.9C17.7 15.9 18.1 16 18.4 16.2L18.5 16.4L26.2 24L33.8 16.4C34.1 16.1 34.4 16 34.8 15.9C35.2 15.9 35.5 16 35.8 16.2L36 16.4L35.8 16.2Z" fill="#A43600" /></svg>
          </button>
          <hr style="position:absolute;left:110px;top:107px;width:132px;border:none;height:1px;background:black;opacity:0.2;">
          <div style="position:absolute;left:38px;right:38px;top:122px;height:30px;display:flex;align-items:center;justify-content:space-between;">
            <button type="button" data-action="click->appointment-date-picker#editDate1" data-appointment-date-picker-target="slot1Btn" style="background:transparent;border:none;cursor:pointer;padding:0;">
              <span data-appointment-date-picker-target="slot1Label" style="font-family:Montserrat;font-weight:500;font-size:16px;letter-spacing:0.07em;color:#933a35;"></span>
            </button>
            <button type="button" data-action="click->appointment-date-picker#editTime1" style="background:transparent;border:none;cursor:pointer;padding:0;">
              <span data-appointment-date-picker-target="slot1Time" style="font-family:Montserrat;font-weight:500;font-size:16px;letter-spacing:0.07em;color:#933a35;"></span>
            </button>
          </div>
          <div style="position:absolute;left:38px;right:38px;top:168px;height:30px;display:flex;align-items:center;justify-content:space-between;">
            <button type="button" data-action="click->appointment-date-picker#editDate2" data-appointment-date-picker-target="slot2Btn" style="background:transparent;border:none;cursor:pointer;padding:0;">
              <span data-appointment-date-picker-target="slot2Label" style="font-family:Montserrat;font-weight:500;font-size:16px;letter-spacing:0.07em;color:#933a35;"></span>
            </button>
            <button type="button" data-action="click->appointment-date-picker#editTime2" style="background:transparent;border:none;cursor:pointer;padding:0;">
              <span data-appointment-date-picker-target="slot2Time" style="font-family:Montserrat;font-weight:500;font-size:16px;letter-spacing:0.07em;color:#933a35;"></span>
            </button>
          </div>
          <div style="position:absolute;left:38px;right:38px;top:228px;display:flex;align-items:center;justify-content:space-between;">
            <span style="font-family:Montserrat;font-weight:500;font-size:16px;letter-spacing:0.07em;color:#933a35;">All day</span>
            <button type="button" data-action="click->appointment-date-picker#toggleAllDay" data-appointment-date-picker-target="allDayToggle" style="width:63px;height:34px;border-radius:17px;background:#D9D9D9;border:none;cursor:pointer;position:relative;padding:0;">
              <span style="position:absolute;left:3px;top:2px;width:30px;height:30px;background:white;border-radius:50%;box-shadow:0 1px 4px rgba(0,0,0,0.2);transition:transform 0.2s;"></span>
            </button>
          </div>
          <button type="button" data-action="click->appointment-date-picker#confirm" style="position:absolute;left:38px;top:313px;width:257px;height:48px;background:#933a35;border-radius:8px;border:none;cursor:pointer;font-family:Montserrat;font-weight:500;font-size:22px;line-height:27px;letter-spacing:0.03em;color:white;text-align:center;">Set date</button>
        </div>

        <%# ── Stage 2 ── %>
        <div data-appointment-date-picker-target="stage2" class="hidden">
          <span data-appointment-date-picker-target="stage2Title" style="position:absolute;left:54px;top:65px;width:228px;font-family:Montserrat;font-weight:500;font-size:22px;line-height:27px;letter-spacing:0.03em;color:#933a35;text-align:center;"></span>
          <button type="button" data-action="click->appointment-date-picker#close" style="position:absolute;left:278px;top:13px;width:37px;height:37px;background:transparent;border:none;cursor:pointer;padding:0;">
