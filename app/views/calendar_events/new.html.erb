<% content_for(:page_title) { "Appointment" } %>
<% content_for(:header_left) do %>
  <%= link_to (params[:date] ? daily_view_path(date: params[:date]) : user_root_path),
        style: "color:#933a35; font-size:15px; font-weight:500; text-decoration:none; padding:8px 4px; font-family:'Montserrat',sans-serif;" do %>
    &lt; back
  <% end %>
<% end %>

<%
  phase     = current_user.current_phase
  phase_col = CycleCalculatorService::PHASE_META[phase]&.dig(:colour) || "#933a35"
  evt_date  = params[:date] ? Date.parse(params[:date]) : Time.zone.today
  default_start = @event.start_time || Time.zone.now.change(hour: 19, min: 0)
  default_end   = @event.end_time   || Time.zone.now.change(hour: 20, min: 0)
%>

<div style="background:#FAF7F4; min-height:100vh; padding-bottom:40px; font-family:'Montserrat',sans-serif;">
  <div style="max-width:430px; margin:0 auto;">

    <%= form_with model: @event, url: calendar_events_path, local: true do |f| %>

      <%# ── Phase-coloured title + date/time block ── %>
      <div style="background:<%= phase_col %>; padding:18px 16px 0; position:relative; border-radius:12px; margin-top:18px;">

        <%# Add (+) button — circle at top-right %>
        <div style="position:absolute; top:18px; right:18px; width:48px; height:48px; border-radius:50%; background:#EDE1D5; display:flex; align-items:center; justify-content:center; box-shadow: 0 2px 6px rgba(0,0,0,0.08);">
          <svg width="24" height="24" fill="none" viewBox="0 0 24 24">
            <path d="M12 5v14M5 12h14" stroke="#A43600" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
        </div>

        <%# Title input %>
          <%= f.text_field :title,
            placeholder: "Titel eingeben",
            required: true,
            style: "width:100%; background:transparent; border:none; color:rgba(237,225,213,0.95); font-size:22px; font-weight:600; font-family:'Montserrat',sans-serif; padding:10px 0 6px; outline:none; box-sizing:border-box;" %>

        <%# Separator line %>
        <div style="height:1px; background:rgba(237,225,213,0.4); margin:0;"></div>

        <%# Date — formatted display + hidden field %>
        <div style="padding-top:18px; text-align:center;">
          <div style="background:rgba(0,0,0,0.08); border-radius:12px; padding:18px 12px; display:inline-block; width:100%; box-sizing:border-box;">
            <span style="color:#FFFFFF; display:block; font-size:20px; font-weight:600; font-family:'Montserrat',sans-serif;">
              <%= evt_date.strftime("%a. %B ") %><%= evt_date.day.ordinalize %><%= evt_date.strftime(" %Y") %>
            </span>
          </div>
          <%= f.hidden_field :date, value: evt_date %>
        </div>

        <%# Time — compact inputs + dash separator %>
        <div style="padding:10px 0 20px; display:flex; align-items:center; justify-content:center; gap:8px;">
          <%= f.time_field :start_time,
                value: default_start.strftime("%H:%M"),
          style: "background:transparent; border:none; color:#FFFFFF; font-size:20px; font-weight:600; font-family:'Montserrat',sans-serif; outline:none; width:68px; text-align:center; padding:0; -webkit-appearance:none;" %>
          <span style="color:#FFFFFF; font-size:22px; font-weight:300;">-</span>
          <%= f.time_field :end_time,
                value: default_end.strftime("%H:%M"),
          style: "background:transparent; border:none; color:#FFFFFF; font-size:20px; font-weight:600; font-family:'Montserrat',sans-serif; outline:none; width:68px; text-align:center; padding:0; -webkit-appearance:none;" %>
        </div>
      </div>

      <%# ── Divider 1 ── %>
      <div style="height:1px; background:rgba(147,58,53,0.18); margin:6px 12px;"></div>

      <%# ── Reminder row (bell) ── %>
      <div style="background:#FFFFFF; padding:12px 20px; display:flex; align-items:center; gap:12px;">
        <div style="width:36px; height:36px; border-radius:50%; background:#EDE1D5; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
          <svg width="20" height="20" fill="none" stroke="#933A35" stroke-width="2" viewBox="0 0 24 24">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
          </svg>
        </div>
        <span style="color:#3d2b28; font-size:15px; font-weight:500; letter-spacing:0.06em; flex:1;">15 Minutes before</span>
        <svg width="16" height="16" fill="none" stroke="#AFAFAF" stroke-width="2" viewBox="0 0 24 24">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </div>

      <%# ── Divider 2 ── %>
      <div style="height:1px; background:rgba(147,58,53,0.18); margin:6px 12px;"></div>

      <%# ── Location row (droplet) ── %>
      <div style="background:#FFFFFF; padding:12px 20px; display:flex; align-items:center; gap:12px;">
        <div style="width:36px; height:36px; border-radius:50%; background:rgba(237,225,213,0.5); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
          <svg width="20" height="20" fill="none" stroke="#933A35" stroke-width="2" viewBox="0 0 24 24" opacity="0.5">
            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
          </svg>
        </div>
        <span style="color:#AFAFAF; font-size:16px; font-weight:500; letter-spacing:0.07em; flex:1;">Add location</span>
        <svg width="16" height="16" fill="none" stroke="#AFAFAF" stroke-width="2" viewBox="0 0 24 24">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </div>

      <%# ── Notes row (eye) — with textarea ── %>
      <div style="background:#FFFFFF; padding:12px 20px; display:flex; align-items:flex-start; gap:12px;">
        <div style="width:39px; height:38px; border-radius:50%; background:rgba(237,225,213,0.5); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
          <svg width="20" height="20" fill="none" stroke="#933A35" stroke-width="2" viewBox="0 0 24 24" opacity="0.5">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
        </div>
          <%= f.text_area :notes,
            placeholder: "Notes...",
            rows: 2,
            style: "flex:1; background:transparent; border:none; font-size:15px; font-weight:500; letter-spacing:0.06em; color:#3d2b28; font-family:'Montserrat',sans-serif; outline:none; resize:none; padding:0;" %>
      </div>

      <%# ── Guests row (user) ── %>
      <div style="background:#FFFFFF; padding:14px 20px; display:flex; align-items:center; gap:12px;">
        <div style="width:39px; height:38px; border-radius:50%; background:rgba(237,225,213,0.5); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
          <svg width="20" height="20" fill="none" stroke="#933A35" stroke-width="2" viewBox="0 0 24 24" opacity="0.5">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </div>
        <span style="color:#AFAFAF; font-size:16px; font-weight:500; letter-spacing:0.07em; flex:1;">Invite guests</span>
        <svg width="16" height="16" fill="none" stroke="#AFAFAF" stroke-width="2" viewBox="0 0 24 24">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </div>

      <%# ── Repeat row (clipboard) ── %>
      <div style="background:#FFFFFF; padding:14px 20px; display:flex; align-items:center; gap:12px;">
        <div style="width:39px; height:38px; border-radius:50%; background:rgba(237,225,213,0.5); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
          <svg width="20" height="20" fill="none" stroke="#933A35" stroke-width="2" viewBox="0 0 24 24" opacity="0.5">
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
            <rect x="8" y="2" width="8" height="4" rx="1"/>
          </svg>
        </div>
        <span style="color:#AFAFAF; font-size:16px; font-weight:500; letter-spacing:0.07em; flex:1;">Repeat</span>
        <svg width="16" height="16" fill="none" stroke="#AFAFAF" stroke-width="2" viewBox="0 0 24 24">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </div>

      <%# ── Submit button (322px, centered, 8px radius) ── %>
      <div style="display:flex; justify-content:center; padding:28px 20px 8px;">
        <%= f.submit "Set appointment",
          style: "width:300px; background:#{phase_col}; color:#FFFFFF; padding:14px 0; border-radius:12px; border:none; font-size:20px; font-weight:600; font-family:'Montserrat',sans-serif; cursor:pointer; letter-spacing:0.03em; box-shadow: 0 4px 10px rgba(0,0,0,0.08);" %>
      </div>

    <% end %>

    <%# ── Delete appointment (edit mode only) ── %>
    <% if @event&.persisted? %>
      <div style="text-align:center; padding-top:12px;">
        <%= button_to "Delete appointment",
              calendar_event_path(@event),
              method: :delete,
              style: "background:none; border:none; color:#933A35; font-size:22px; font-weight:500; font-family:'Montserrat',sans-serif; cursor:pointer; letter-spacing:0.03em; padding:8px 20px;" %>
      </div>
    <% end %>

  </div>
</div>
