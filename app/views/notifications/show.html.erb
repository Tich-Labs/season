<% content_for(:page_title) { @notification.title } %>
<% content_for(:header_left) do %>
  <%= link_to notifications_path,
        class: "inline-flex items-center justify-center w-10 h-10 rounded-xl text-brand-primary" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
      <polyline points="15 18 9 12 15 6" />
    </svg>
  <% end %>
<% end %>

<div class="bg-brand-background min-h-screen pb-24">
  <div class="max-w-app mx-auto">

    <div class="relative">
      <div class="h-20 bg-brand-field"></div>
      <div class="absolute inset-0 flex items-center px-4">
        <%= content_for :header_left %>
        <div class="flex-1 text-center">
          <h1 class="text-lg font-semibold text-brand-primary">Notification</h1>
        </div>
        <div class="w-10"></div>
      </div>
    </div>

    <div class="px-4 pt-5 space-y-4">
      <div class="rounded-2xl bg-white p-5">
        <div class="flex items-start justify-between">
          <div>
            <h2 class="text-xl font-semibold text-brand-dark">
              <%= @notification.title %>
            </h2>
            <p class="text-xs text-brand-secondary mt-1">
              <%= @notification.notification_type.capitalize %>
            </p>
          </div>
          <% if @notification.unread? %>
            <div class="w-3 h-3 rounded-full bg-brand-primary flex-shrink-0"></div>
          <% end %>
        </div>

        <% if @notification.description.present? %>
          <p class="text-sm text-brand-dark mt-4 leading-relaxed">
            <%= simple_format(@notification.description) %>
          </p>
        <% end %>

        <p class="text-xs text-brand-secondary mt-5">
          <%= @notification.created_at.strftime("%B %-d, %Y at %-I:%M %p") %>
        </p>
      </div>

      <div class="space-y-2">
        <% if @notification.unread? %>
          <%= button_to "Mark as read", notification_mark_read_path(@notification),
                method: :patch,
                class: "w-full bg-brand-primary text-white rounded-xl py-3 font-semibold" %>
        <% end %>

        <%= button_to "Delete",
              notification_path(@notification),
              method: :delete,
              form: { data: { turbo_confirm: "Are you sure?" } },
              class: "w-full bg-transparent text-brand-primary border border-brand-primary rounded-xl py-3 font-semibold" %>
      </div>
    </div>
  </div>
</div>
