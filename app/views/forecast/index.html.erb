<% page_title = @selected_date.strftime("%-d %B") %>
<% content_for(:page_title) { page_title } %>
<% content_for(:header_color) { @phase_colour } %>
<% content_for(:header_dark) { "true" } %>
<%# Only the calendar button belongs here, not the "+" quick-actions FAB — and
     not the shared _calendar_home_fab partial either, which is a smaller
     white circle with a different icon. This page gets its own
     brand-field-coloured version instead, matching tracking/index.html.erb's
     "Go to calendar" button pattern. %>
<% content_for(:hide_quick_actions) { "true" } %>
<% content_for(:hide_calendar_fab) { "true" } %>
<% phase_color(@phase_colour) %>

<%
  card_config = [
    { key: "superpower",    title: t("forecast.index.superpower") },
    { key: "watch_out_for", title: t("forecast.index.watch_out") },
    { key: "mood",          title: t("forecast.index.mood") },
    { key: "sport",         title: t("forecast.index.sport") },
    { key: "nutrition",     title: t("forecast.index.nutrition") },
    # { key: "fertility",     title: t("forecast.index.fertility") },
  ]
  pc = @phase_colour
  phase_name = CycleCalculatorService::PHASE_META[@phase][:season]
%>

<div class="bg-white min-h-screen pb-32" data-controller="forecast-tabs forecast-modal"
     data-forecast-tabs-colour-value="<%= pc %>"
     data-forecast-tabs-default-value="<%= params[:tab] == "forecast" ? "forecast" : "appointments" %>">
  <div class="max-w-app mx-auto px-4">

    <%# ── Back ────────────────────────────────────────────────────────── %>
    <div class="pt-4">
      <a href="<%= calendar_path %>"
         onclick="if (window.history.length > 1) { window.history.back(); return false; }"
         class="text-sm font-medium no-underline font-sans"
         style="color:var(--phase-color)">&lt; back</a>
    </div>

    <%# ── Greeting ─────────────────────────────────────────────────────── %>
    <div class="pt-2 pb-2">
      <p class="italic font-medium text-4xl leading-[44px] font-sans m-0" style="color:var(--phase-color)">
        <%= t("forecast.index.greeting", name: current_user.name&.split&.first || "there") %>
      </p>
      <p class="font-medium text-2xl leading-[29px] font-sans m-0 mt-1" style="color:var(--phase-color)">
        <%= t("forecast.index.phase_prefix") %> <%= phase_name %>
      </p>
    </div>

    <%# ── Dynamic label ── phase-coloured, like the rest of this page's text
         (was hardcoded text-brand-primary, so it never matched the phase). ── %>
    <p data-forecast-tabs-target="label" class="font-normal text-base font-sans m-0 mt-2" style="color:var(--phase-color)">
      <%= t("forecast.index.and_this") %>
    </p>

    <%# ── Progress bar toggle ──────────────────────────────────────────── %>
    <div class="flex gap-0 mt-3 mb-6 rounded-lg overflow-hidden cursor-pointer" style="height:5px;">
      <button data-action="click->forecast-tabs#showAppointments"
              data-forecast-tabs-target="leftBar"
              class="h-full border-0 p-0 cursor-pointer"
              style="width:50%;background:var(--phase-color)">
      </button>
      <button data-action="click->forecast-tabs#showForecast"
              data-forecast-tabs-target="rightBar"
              class="h-full border-0 p-0 cursor-pointer"
              style="width:50%;background:color-mix(in srgb, var(--phase-color) 20%, transparent)">
      </button>
    </div>

    <%# ── Appointments view ────────────────────────────────────────────── %>
    <div data-forecast-tabs-target="appointments">
      <% if @events&.any? %>
        <div class="flex flex-col gap-3">
          <% @events.each do |event| %>
            <%= link_to edit_calendar_event_path(event), class: "block no-underline", data: { turbo_action: "replace" } do %>
              <div class="rounded-lg p-4 relative" style="background:rgba(147,58,53,0.1);<%= 'padding-bottom:12px;' unless event.notes.present? %>">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <p class="text-xl font-semibold text-brand-primary leading-tight font-sans"><%= event.title %></p>
                    <p class="mt-2 text-sm font-medium text-brand-secondary font-sans">
                      <% if event.start_time.present? %>
                        <%= event.start_time.strftime("%H:%M") %><%= event.end_time ? " - #{event.end_time.strftime("%H:%M")}" : "" %>
                      <% end %>
                    </p>
                  </div>
                  <% if event.category.present? %>
                    <% icon_map = { 'Friends'=>'family.svg','Dinner'=>'dinner.svg','Date'=>'date.svg','Sport'=>'sport.svg','Medical'=>'medical.svg','Birthday'=>'birthday.svg','Work'=>'work.svg','Coffee'=>'coffee.svg','Shopping'=>'shopping.svg' } %>
                    <% if icon_map[event.category].present? %>
                      <div class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-primary/10 shrink-0">
                        <%= image_tag "icons/appointment/#{icon_map[event.category]}", alt: event.category, class: "w-8 h-8", style: "filter:brightness(0) saturate(100%) invert(28%) sepia(84%) saturate(1607%) hue-rotate(342deg) brightness(63%) contrast(94%);" %>
                      </div>
                    <% end %>
                  <% end %>
                </div>
                <% if event.notes.present? %>
                  <p class="mt-3 text-sm leading-relaxed text-brand-secondary font-sans">Note:<br><%= event.notes.truncate(60) %></p>
                <% end %>
                <div class="absolute bottom-4 right-4 flex h-10 w-10 items-center justify-center rounded-full bg-white shadow-sm">
                  <svg width="20" height="20" viewBox="0 0 23 23" fill="none">
                    <path d="M10.538 1.917H8.621C3.83 1.917 1.913 3.834 1.913 8.625v5.75c0 4.792 1.917 6.709 6.708 6.709h5.75c4.792 0 6.709-1.917 6.709-6.709v-1.916" stroke="#933A35" stroke-width="2.02" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M15.37 2.894L7.818 10.446c-.287.287-.575.853-.632 1.265l-.412 2.884c-.154 1.045.584 1.773 1.629 1.63l2.884-.413c.403-.057.968-.345 1.265-.632l7.552-7.552c1.303-1.303 1.917-2.817 0-4.734-1.917-1.917-3.431-1.303-4.734 0z" stroke="#933A35" stroke-width="2.02" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M14.285 3.978a5.75 5.75 0 014.734 4.734" stroke="#933A35" stroke-width="2.02" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-8">
          <div class="flex justify-center mb-6">
            <%= image_tag "avatars/no-appointments.svg", alt: t("forecast.index.no_appointments"), class: "w-[220px] h-[220px] object-contain" %>
          </div>
          <p class="font-medium text-2xl leading-[29px] font-sans m-0 mb-8" style="color:var(--phase-color)">
            <%= t("forecast.index.no_appointments_text") %>
          </p>
              <%= link_to t("forecast.index.create_appointment"), new_calendar_event_path(date: @selected_date),
                class: "inline-block w-[253px] rounded-lg py-[14px] text-white text-xl font-medium font-sans no-underline",
                style: "background:var(--phase-color)" %>
        </div>
      <% end %>
    </div>

    <%# ── Forecast cards view ──────────────────────────────────────────── %>
    <div data-forecast-tabs-target="forecast" class="hidden">
      <div class="flex flex-col gap-4">
        <% card_config.each do |card| %>
          <%
            content = @cards[card[:key]]
            mood_icon = nil
            if card[:key] == "mood" && content&.short_text.present?
              first = content.short_text.split(",").first.strip
              mood = MoodPickerService.find_by_name(first)
              unless mood
                match = content.short_text.split(/[\s,]+/).find { |w| MoodPickerService.find_by_name(w) }
                mood = match ? MoodPickerService.find_by_name(match) : nil
              end
              mood_icon = mood ? inline_emoji_svg(mood[:svg], size: 48) : nil
            end
          %>
          <button type="button"
                  data-action="<%= card[:key] == 'mood' ? '' : 'click->forecast-modal#open' %>"
                  data-forecast-modal-title="<%= card[:key] == 'mood' ? '' : card[:title] %>"
                  data-forecast-modal-body="<%= card[:key] == 'mood' ? '' : h(content&.long_text || 'No content yet for this day.') %>"
                  data-forecast-modal-food="<%= card[:key] == 'mood' || card[:key] != 'nutrition' || !content&.food_items.present? ? '' : h(content.food_items.to_json) %>"
                  class="rounded-xl p-4 text-center w-full <%= card[:key] == 'mood' ? '' : 'cursor-pointer hover:shadow-md' %> transition-shadow border-0"
                  style="min-height:95px;background:color-mix(in srgb, var(--phase-color) 10%, transparent)">
            <div class="flex items-start gap-3">
              <% if mood_icon %>
                <div class="flex-1 flex flex-col items-center gap-1">
                  <p class="font-medium text-2xl leading-[29px] font-sans m-0" style="color:var(--phase-color)">
                    <%= card[:title] %>
                  </p>
                  <p class="text-sm leading-5 font-sans m-0" style="color:var(--phase-color)">
                    <%= content&.short_text || t("forecast.index.no_content") %>
                  </p>
                </div>
              <% else %>
                <div class="flex-1 min-w-0">
                  <p class="font-medium text-2xl leading-[29px] font-sans m-0" style="color:var(--phase-color)">
                    <%= card[:title] %>
                  </p>
                  <p class="text-sm leading-5 font-sans m-0 mt-2" style="color:var(--phase-color)">
                    <%= content&.short_text || t("forecast.index.no_content") %>
                  </p>
                </div>
              <% end %>
              <% unless card[:key] == "mood" %>
                <svg class="shrink-0 mt-1" width="16" height="16" fill="none" stroke="var(--phase-color)" stroke-width="2" viewBox="0 0 24 24">
                  <polyline points="9 18 15 12 9 6" />
                </svg>
              <% end %>
            </div>
          </button>
        <% end %>
      </div>
    </div>

    <%# ── Modal ─────────────────────────────────────────────────────────── %>
    <div class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/40"
         data-forecast-modal-target="modal"
         data-action="click->forecast-modal#overlayClick">
      <div class="relative bg-white rounded-[29px] mx-4 p-6 pt-10 overflow-y-auto" style="width:337px; max-height:80vh;">
        <button data-action="click->forecast-modal#close" aria-label="Close"
                class="absolute top-3 right-3 w-[44px] h-[44px] rounded-full flex items-center justify-center border-0 cursor-pointer"
                style="background:#EDE1D5;">
          <span class="text-2xl font-medium leading-none font-sans" style="color:var(--phase-color)">&times;</span>
        </button>
        <p data-forecast-modal-target="title" class="font-medium text-2xl text-center font-sans m-0 mb-4" style="color:var(--phase-color)"></p>
        <div data-forecast-modal-target="body" class="text-base leading-5 text-center font-sans" style="color:var(--phase-color)"></div>
        <div data-forecast-modal-target="food" class="mt-4 flex flex-col gap-4"></div>
      </div>
    </div>

  </div>
</div>

<%# ── Calendar button — fixed bottom-centre, replaces the quick-actions FAB and the
     shared calendar-home FAB on this page ── %>
<%= link_to user_root_path,
      class: "fixed left-1/2 -translate-x-1/2 z-[60]
             w-[66px] h-[66px] rounded-full bg-brand-field
             flex items-center justify-center
             active:scale-95 transition-all duration-150 shadow-[0px_4px_9px_rgba(0,0,0,0.07)]",
      style: "bottom: calc(2.5rem + env(safe-area-inset-bottom, 0px));",
      data: { turbo_action: "replace" },
      aria: { label: "Go to calendar" } do %>
  <svg width="42" height="42" viewBox="0 0 42 42" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M14.001 3.5V8.75" stroke="#933A35" stroke-width="3" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M28 3.5V8.75" stroke="#933A35" stroke-width="3" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M6.125 15.9072H35.875" stroke="#933A35" stroke-width="3" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M36.75 14.875V29.75C36.75 35 34.125 38.5 28 38.5H14C7.875 38.5 5.25 35 5.25 29.75V14.875C5.25 9.625 7.875 6.125 14 6.125H28C34.125 6.125 36.75 9.625 36.75 14.875Z" stroke="#933A35" stroke-width="3" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M27.464 23.9756H27.4797" stroke="#933A35" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M27.464 29.2256H27.4797" stroke="#933A35" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M20.9914 23.9756H21.0071" stroke="#933A35" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M20.9914 29.2256H21.0071" stroke="#933A35" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M14.5168 23.9756H14.5325" stroke="#933A35" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M14.5168 29.2256H14.5325" stroke="#933A35" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
<% end %>
