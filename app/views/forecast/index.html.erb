<% content_for(:page_title) { "Forecast" } %>
<% content_for(:header_color) { @phase_colour } %>

<%
  card_config = [
    { key: "superpower",    title: "Super Power",   emoji: "⚡" },
    { key: "watch_out_for", title: "Watch Out For", emoji: "⚠️" },
    { key: "mood",          title: "Mood",          emoji: "😊" },
    { key: "sport",         title: "Sport",         emoji: "🏃" },
    { key: "nutrition",     title: "Nutrition",     emoji: "🥗" },
    { key: "fertility",     title: "Fertility",     emoji: "🌸" },
  ]
  pc = @phase_colour
%>

<div class="bg-brand-background min-h-screen pb-32">
  <div class="max-w-app mx-auto px-4">

    <%# ── Greeting ─────────────────────────────────────────────────────── %>
    <div class="pt-8 pb-2">
      <p class="italic font-medium text-[36px] leading-[44px] font-['Montserrat'] m-0" style="color:<%= pc %>;">
        Hello <%= current_user.name&.split&.first || "there" %>
      </p>
      <p class="font-light text-2xl leading-[29px] font-['Montserrat'] m-0 mt-1" style="color:<%= pc %>; max-width:333px;">
        <%= @selected_date.strftime("%-d %B %Y") %>
      </p>
    </div>

    <%# ── Section bar ──────────────────────────────────────────────────── %>
    <div class="flex gap-0 mt-4 mb-6 rounded-lg overflow-hidden" style="height:5px;">
      <div class="h-full" style="width:<%= ((@cycle_day - 1).to_f / 35 * 100).round(1) %>%; background:rgba(209,141,132,0.2);"></div>
      <div class="h-full" style="width:<%= (100.0 / 35).round(1) %>%; background:<%= pc %>;"></div>
    </div>

    <%# ── Cards ────────────────────────────────────────────────────────── %>
    <div class="flex flex-col gap-4" data-controller="forecast-modal">
      <% card_config.each do |card| %>
        <%
          content = @cards[card[:key]]
        %>
        <button data-action="click->forecast-modal#open"
                data-forecast-modal-title="<%= card[:title] %>"
                data-forecast-modal-body="<%= content&.long_text&.gsub('"', '&quot;') || 'No content yet for this day.' %>"
                data-forecast-modal-food="<%= card[:key] == 'nutrition' && content&.food_items.present? ? content.food_items.to_json.gsub('"', '&quot;') : '' %>"
                class="rounded-xl p-4 text-left w-full cursor-pointer hover:shadow-md transition-shadow border-0"
                style="min-height:95px; background:<%= pc %>1A;">
          <div class="flex items-start gap-3">
            <span class="text-2xl"><%= card[:emoji] %></span>
            <div class="flex-1 min-w-0">
              <p class="font-medium text-2xl leading-[29px] font-['Montserrat'] m-0" style="color:<%= pc %>;">
                <%= card[:title] %>
              </p>
              <p class="text-sm leading-5 font-['Montserrat'] m-0 mt-2" style="color:<%= pc %>;">
                <%= content&.short_text || "No content yet for this day." %>
              </p>
            </div>
            <svg class="shrink-0 mt-1" width="16" height="16" fill="none" stroke="<%= pc %>" stroke-width="2" viewBox="0 0 24 24">
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </div>
        </button>
      <% end %>
    </div>

    <%# ── Modal ─────────────────────────────────────────────────────────── %>
    <div class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/60"
         data-forecast-modal-target="modal"
         data-action="click->forecast-modal#overlayClick">
      <div class="relative bg-white rounded-[29px] mx-4 p-6 pt-10 overflow-y-auto" style="width:337px; max-height:80vh;">
        <button data-action="click->forecast-modal#close" aria-label="Close"
                class="absolute top-3 right-3 w-[44px] h-[44px] rounded-full flex items-center justify-center border-0 cursor-pointer"
                style="background:#EDE1D5;">
          <span class="text-2xl font-medium leading-none font-['Montserrat']" style="color:<%= pc %>;">&times;</span>
        </button>
        <p data-forecast-modal-target="title" class="font-medium text-2xl text-center font-['Montserrat'] m-0 mb-4" style="color:<%= pc %>;"></p>
        <div data-forecast-modal-target="body" class="text-base leading-5 text-center font-['Montserrat']" style="color:<%= pc %>;"></div>
        <div data-forecast-modal-target="food" class="mt-4 flex flex-col gap-4"></div>
      </div>
    </div>

  </div>
</div>
