<!DOCTYPE html>
<html class="h-full"<%= " data-hotwire-native" if turbo_native_app? %>>
  <head>
    <title>Season Admin</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Season Admin">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <%= tag.link rel: "manifest", href: pwa_manifest_path %>
    <meta name="theme-color" content="#933a35">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <% if turbo_native_app? %>
      <%= stylesheet_link_tag "native", "data-turbo-track": "reload" %>
    <% end %>
  </head>
  <body class="h-full bg-[#FAF7F4] font-['Montserrat'] flex items-center justify-center">
    <%= yield %>
  </body>
</html>
