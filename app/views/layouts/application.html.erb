<!DOCTYPE html>
<html class="h-full" lang="<%= I18n.locale %>"<%= " data-ruby-native" if native_app? %>>
  <head>
    <title><%= content_for(:title) || "Season" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Season">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path %>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="apple-touch-icon" href="/icon.png">
    <meta name="theme-color" content="#933a35">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;900&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <% if native_app? %>
      <%= stylesheet_link_tag "native", "data-turbo-track": "reload" %>
      <%= stylesheet_link_tag :ruby_native, "data-turbo-track": "reload" %>
    <% end %>
    <%= javascript_importmap_tags %>
    <script nonce="<%= content_security_policy_nonce %>">
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function() {
          navigator.serviceWorker.register('/service-worker.js').then(function(reg) {
            reg.update();
          }).catch(function() {});
        });
      }
      </script>
  </head>

  <%# Logic check: Only show App Bar/Menu if user is logged in and past the splash/auth screens %>
  <% is_authenticated_view = authenticated? && !controller_name.in?(%w[sessions registrations home onboarding]) %>

  <%# Pages that keep the shared "+" quick-actions FAB. Everything else hides it
       (settings, calendar, tracking, etc.) and owns its own bottom FAB, so only
       these pages need <main> to reserve 8rem of clearance below the content. %>
  <% render_quick_actions = is_authenticated_view && !content_for?(:hide_quick_actions) && !controller_name.in?(%w[information]) %>

  <% app_lock_enabled = authenticated? && current_user.pin_set? %>
  <% phase_hex = @current_phase ? (CycleCalculatorService::PHASE_META.dig(@current_phase, :colour) || "#933a35") : "#933a35" %>
  <body class="bg-brand-background font-sans antialiased h-full overflow-x-hidden"
        data-controller="update-prompt install haptic<%= ' app-lock' if app_lock_enabled %>"
        <%= "data-app-lock-timeout-value=\"#{PinProtection::PIN_TIMEOUT.to_i * 1000}\"".html_safe if app_lock_enabled %>
        style="--phase-color:<%= phase_hex %>">

    <% if is_authenticated_view %>
    <div data-controller="menu">
      <%# Views can pass content_for(:header_color) with a hex string for a phase-specific bg color, %>
      <%# or content_for(:header_dark) to force dark theme on non-settings pages. %>
      <%# controller_path (not controller_name) so namespaced controllers like
           Settings::LanguageController ("settings/language") count as settings
           too — controller_name alone would just return "language" and miss
           the dark header + gear/"Settings" title every sibling page gets. %>
      <% is_settings = controller_name == "settings" || controller_path.start_with?("settings/") %>
      <% dark_header = is_settings || content_for?(:header_dark) %>
      <% hdr_bg      = dark_header ? "bg-brand-primary" : "bg-brand-field" %>
      <% bar_color   = dark_header ? "bg-white"     : "bg-brand-primary" %>
      <% hdr_fg      = dark_header ? "text-white"   : "text-brand-primary" %>
      <header class="fixed top-0 left-1/2 -translate-x-1/2 w-full max-w-app <%= hdr_bg %> <%= hdr_fg %> z-40 flex items-center px-4" style="padding-top: env(safe-area-inset-top, 0px); min-height: calc(3.5rem + env(safe-area-inset-top, 0px));<%= content_for?(:header_color) ? " background:#{yield(:header_color)};" : '' %>">

        <div class="flex-none flex items-center min-w-0">
          <%# Left: custom back-arrow OR default hamburger %>
          <% if content_for?(:header_left) %>
            <%= yield(:header_left) %>
          <% else %>
            <button class="min-w-11 min-h-11 flex flex-col items-center justify-center" data-action="click->menu#open">
              <div class="w-6 h-0.5 <%= bar_color %> mb-1.5 pointer-events-none"></div>
              <div class="w-6 h-0.5 <%= bar_color %> mb-1.5 pointer-events-none"></div>
              <div class="w-6 h-0.5 <%= bar_color %> pointer-events-none"></div>
            </button>
          <% end %>
        </div>

        <div class="flex-1 flex justify-center items-center gap-1 min-w-0">
          <%# Centre: custom title OR settings default (gear + "Settings") %>
          <% if content_for?(:page_title) %>
            <span class="<%= hdr_fg %> inline-flex items-center gap-1.5 text-22 font-medium font-sans truncate"><%= yield(:page_title) %></span>
          <% elsif is_settings %>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24" class="shrink-0">
              <circle cx="12" cy="12" r="3" />
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
            </svg>
            <span class="text-white text-22 font-medium font-sans truncate">Settings</span>
          <% end %>
        </div>

        <div class="flex-none flex items-center min-w-0">
          <%# Right: custom content OR blank spacer %>
          <% if content_for?(:header_right) %>
            <%= yield(:header_right) %>
          <% else %>
            <div class="w-10"></div>
          <% end %>
        </div>
      </header>

      <%= render "layouts/burger_menu" %>
    </div>
    <% end %>

    <%# PWA update banner — shown by update_prompt_controller when a new SW is waiting %>
    <% unless native_app? %>
    <div data-update-prompt-target="banner"
         class="fixed left-1/2 -translate-x-1/2 w-full max-w-app px-4 z-50 hidden" style="bottom: calc(6rem + env(safe-area-inset-bottom, 0px));">
      <div class="bg-brand-dark text-white rounded-2xl px-4 py-3 flex items-center justify-between shadow-xl">
        <span class="text-sm font-medium">New version of Season available</span>
        <button data-action="click->update-prompt#updateApp"
                class="bg-brand-primary text-white text-sm font-semibold min-w-11 min-h-11 flex items-center justify-center px-4 rounded-xl ml-3 shrink-0">
          Refresh
        </button>
      </div>
    </div>

    <%# PWA install banner — shown by install_controller when app is installable %>
    <div data-install-target="banner"
         class="fixed left-1/2 -translate-x-1/2 w-full max-w-app px-4 z-50 hidden" style="bottom: calc(6rem + env(safe-area-inset-bottom, 0px));">
      <div class="bg-white border border-brand-field rounded-2xl px-4 py-3 flex items-center justify-between shadow-xl">
        <span class="text-sm font-medium text-brand-dark">Add Season to your home screen</span>
        <div class="flex gap-2 ml-3 shrink-0">
          <button data-action="click->install#install"
                  data-install-target="button"
                  class="bg-brand-primary text-white text-sm font-semibold min-w-11 min-h-11 flex items-center justify-center px-4 rounded-xl">
            Add
          </button>
          <button data-action="click->install#dismiss"
                  class="text-brand-secondary text-sm min-w-11 min-h-11 flex items-center justify-center">✕</button>
        </div>
      </div>
      <div data-install-target="iosHint"
           class="hidden mt-2 bg-white border border-brand-field rounded-xl px-4 py-3 text-sm text-brand-dark">
        Tap <strong>Share</strong> then <strong>"Add to Home Screen"</strong>
      </div>
    </div>
    <% end %>

    <%# Bottom padding only for pages that keep the shared "+" quick-actions FAB.
         Pages that hide it render their own bottom FAB (or none) inside their own
         wrapper, so a blanket padding here just leaves a band of dead space below
         the content. When native_app? is true, the "native-inset" class below
         already injects an ::after spacer sized to env(safe-area-inset-bottom)
         (see the ruby_native gem's CSS), so adding env() again here would
         double-count that inset on native builds. %>
    <main class="w-full flex-1 overscroll-contain <%= 'native-inset' if native_app? %>" data-controller="pull-to-refresh" style="<%= is_authenticated_view ? (native_app? ? "padding-top: 3.5rem;" : "padding-top: calc(3.5rem + env(safe-area-inset-top, 0px));") : '' %><%= render_quick_actions ? "padding-bottom: #{native_app? ? "8rem" : "calc(8rem + env(safe-area-inset-bottom, 0px))"};" : '' %><%= ";--phase-color:#{yield(:phase_color)}" if content_for?(:phase_color) %>">
      <div class="max-w-app mx-auto h-full">
        <%= render "shared/flash" %>
        <%= yield %>
      </div>
    </main>

    <% if render_quick_actions %>
      <%= render "shared/quick_actions" %>
      <% unless native_app? %>
        <%= render "shared/feedback_modal" %>
        <%= render "shared/support_modal" %>
      <% end %>
    <% end %>

    <%# Calendar "home" FAB — every authenticated screen except the monthly
        calendar itself (already home), the Settings section (M1: those
        screens should show only the "+" quick-actions FAB, not this one
        too), and screens that render their own calendar button in-page
        (opt out via content_for(:hide_calendar_fab)). %>
    <% unless (controller_name == "calendar" && action_name == "index") || controller_name == "settings" || content_for?(:hide_calendar_fab) %>
      <%= render "shared/calendar_home_fab" if is_authenticated_view %>
    <% end %>

    <%= render "pin/unlock_modal", pin_unlock_required: @pin_unlock_required %>

  </body>
</html>
