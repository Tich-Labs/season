<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Season" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Season">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <% if turbo_native_app? && authenticated? %>
      <meta name="native-auth-token" content="<%= current_user.native_auth_token %>">
      <div data-bridge--native-auth-token data-token="<%= current_user.native_auth_token %>" style="display:none"></div>
    <% end %>
    <%= yield :head %>
    <%= stylesheet_link_tag :ruby_native, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload", preload_links_header: false %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-brand-background font-['Montserrat'] antialiased h-full overflow-x-hidden"
        data-controller="native">
    <main class="w-full flex-1 native-inset">
      <div class="max-w-app mx-auto h-full">
        <%= yield %>
      </div>
    </main>
    <%= native_tabs_tag if authenticated? %>
    <%= render "shared/feedback_modal" %>
    <%= render "shared/support_modal" %>
    <%= render "shared/weekly_feedback_modal" %>
  </body>
</html>
