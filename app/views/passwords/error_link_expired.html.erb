<div class="bg-white min-h-screen min-h-dvh flex flex-col items-center justify-between px-8 max-w-app mx-auto" style="padding-top:calc(4rem + env(safe-area-inset-top,0px));padding-bottom:calc(4rem + env(safe-area-inset-bottom,0px))">

  <div></div>

  <div class="w-full flex flex-col items-center">
    <div class="w-56 h-56 rounded-full bg-brand-field overflow-hidden mb-10">
      <%= image_tag("error_screens_login/errorscreen-already-reset.png", alt: t('passwords.error_link_expired.image_alt'), class: "w-full h-full object-contain") %>
    </div>

    <p class="text-brand-primary text-lg font-normal tracking-wide text-center max-w-xs mb-12">
      <%= t('passwords.error_link_expired.message') %>
    </p>

    <div class="w-full mb-4">
      <%= link_to t('passwords.error_link_expired.request_new_link'), new_user_password_path,
          class: "block w-full bg-brand-primary text-white text-center text-xl font-medium tracking-wide rounded-xl py-3.5 no-underline" %>
    </div>

    <%= link_to t('passwords.error_link_expired.back_to_login'), new_session_path, class: "text-brand-primary text-base font-normal no-underline" %>
  </div>

  <div></div>

</div>
