<div class="bg-white min-h-screen min-h-dvh flex flex-col items-center justify-between px-8 max-w-app mx-auto" style="padding-top:calc(4rem + env(safe-area-inset-top,0px));padding-bottom:calc(3rem + env(safe-area-inset-bottom,0px))">

  <div></div>

  <div class="w-full flex flex-col items-center">
    <div class="w-[219px] h-[219px] rounded-full bg-brand-field overflow-hidden mb-10">
      <%= image_tag("error_screens_login/errorscreen-inbox-full.png", alt: t('passwords.error_inbox_full.image_alt'), class: "w-full h-full object-contain") %>
    </div>

    <p class="text-brand-primary text-lg font-normal tracking-[1.62px] text-center max-w-[290px] mb-12">
      <%= t('passwords.error_inbox_full.message') %>
    </p>

    <div class="w-full">
      <%= link_to t('passwords.error_inbox_full.go_back'), new_session_path, class: "block w-[322px] h-[52px] bg-brand-primary text-white text-center leading-[52px] text-22 font-medium tracking-p66 no-underline rounded-lg mx-auto" %>
    </div>
  </div>

  <div></div>

</div>
