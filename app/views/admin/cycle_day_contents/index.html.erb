<% content_for(:page_title) { "Cycle Day Content" } %>

<div class="max-w-4xl mx-auto px-4 py-6">
  <div class="flex justify-between items-center mb-4">
    <h1 class="text-xl font-bold text-brand-primary">Cycle Day Content (1-35)</h1>
    <%= link_to "New", new_admin_cycle_day_content_path, class: "bg-brand-primary text-white px-4 py-2 rounded-lg text-sm" %>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-sm text-left">
      <thead>
        <tr class="border-b">
          <th class="py-2 px-1">Day</th>
          <th class="py-2 px-1">Card</th>
          <th class="py-2 px-1">Short Text</th>
          <th class="py-2 px-1"></th>
        </tr>
      </thead>
      <tbody>
        <% @contents.each do |c| %>
          <tr class="border-b hover:bg-gray-50">
            <td class="py-2 px-1 font-mono"><%= c.cycle_day %></td>
            <td class="py-2 px-1"><%= c.card_type %></td>
            <td class="py-2 px-1 text-xs text-gray-600 max-w-xs truncate"><%= c.short_text&.truncate(60) %></td>
            <td class="py-2 px-1">
              <%= link_to "Edit", edit_admin_cycle_day_content_path(c), class: "text-brand-primary text-xs" %>
              <%= link_to "Delete", admin_cycle_day_content_path(c), data: { turbo_method: :delete, turbo_confirm: "Delete?" }, class: "text-red-600 text-xs ml-2" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
