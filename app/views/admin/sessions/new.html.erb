<div class="w-full max-w-sm mx-auto px-4">

  <%# Wordmark %>
  <div class="text-center mb-8">
    <span class="text-brand-primary text-3xl font-bold tracking-widest uppercase">Season</span>
    <span class="block text-brand-secondary text-sm font-medium tracking-widest uppercase mt-1">Admin</span>
  </div>

  <%# Card %>
  <div class="bg-white rounded-2xl shadow-sm p-8">

    <% if @error == :rate_limited %>
      <div class="bg-brand-error rounded-xl px-4 py-3 mb-6 text-sm text-brand-primary flex items-center gap-2">
        <span class="font-bold text-base">!</span>
        Too many login attempts. Please try again in 15 minutes.
      </div>
    <% elsif @error %>
      <div class="bg-brand-error rounded-xl px-4 py-3 mb-6 text-sm text-brand-primary flex items-center gap-2">
        <span class="font-bold text-base">!</span>
        Invalid email or password, or account is not an admin.
      </div>
    <% end %>

    <%= form_with url: admin_login_path, method: :post, local: true do |f| %>

      <div class="mb-4">
        <label class="block text-xs font-semibold text-brand-secondary uppercase tracking-wider mb-1" for="email">Email</label>
        <%= f.email_field :email,
            id: "email",
            autofocus: true,
            autocomplete: "username",
            placeholder: "admin@example.com",
            class: "w-full bg-brand-field rounded-xl px-4 py-3 text-brand-dark text-sm outline-none border-0" %>
      </div>

      <div class="mb-6">
        <label class="block text-xs font-semibold text-brand-secondary uppercase tracking-wider mb-1" for="password">Password</label>
        <div class="relative" data-controller="password-visibility">
          <%= f.password_field :password,
              id: "password",
              autocomplete: "current-password",
              placeholder: "••••••••",
              data: { "password-visibility-target": "input" },
              class: "w-full bg-brand-field rounded-xl px-4 py-3 text-brand-dark text-sm outline-none border-0 pr-10" %>
          <button type="button" data-action="click->password-visibility#toggle" aria-label="Toggle password visibility" class="absolute right-3 top-1/2 -translate-y-1/2 cursor-pointer bg-transparent border-0 p-0">
            <svg data-password-visibility-target="eyeOpen" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="rgba(147,58,53,0.5)" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
            <svg data-password-visibility-target="eyeClosed" class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="rgba(147,58,53,0.5)" stroke-width="1.5"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" /><line x1="1" y1="1" x2="23" y2="23" /></svg>
          </button>
        </div>
      </div>

      <%= f.submit "Sign in to Admin",
          class: "w-full bg-brand-primary text-white font-semibold rounded-xl py-3 text-sm cursor-pointer border-0 hover:bg-[#7a2f2a] transition-colors" %>

    <% end %>
  </div>

  <p class="text-center text-xs text-brand-secondary mt-6">
    <%= link_to "← Back to app", root_path, class: "text-brand-primary hover:underline" %>
  </p>

</div>
