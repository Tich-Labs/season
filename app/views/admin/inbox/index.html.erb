<% content_for :page_title, "Inbox" %>

<%# Breadcrumbs %>
<% breadcrumb_items = [] %>
<% breadcrumb_items << { label: "Admin", url: admin_root_path } %>
<% breadcrumb_items << { label: "Inbox", url: admin_inbox_path } %>
<% case action_name %>
<% when "feedback" %>
  <% breadcrumb_items << { label: "Feedback", url: nil } %>
<% when "bugs" %>
  <% breadcrumb_items << { label: "Bugs", url: nil } %>
<% when "support" %>
  <% breadcrumb_items << { label: "Support", url: nil } %>
<% when "archived" %>
  <% breadcrumb_items << { label: "Archived", url: nil } %>
<% end %>

<div class="mb-4 flex items-center gap-2 text-sm">
  <% breadcrumb_items.each_with_index do |item, idx| %>
    <% if idx > 0 %><span class="text-gray-400">/</span><% end %>
    <% if item[:url] %>
      <a href="<%= item[:url] %>" class="text-brand-primary hover:underline"><%= item[:label] %></a>
    <% else %>
      <span class="text-gray-600 font-medium"><%= item[:label] %></span>
    <% end %>
  <% end %>
</div>

<%# Stats always visible %>
<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 px-5 py-4">
    <p class="text-xs text-gray-500 uppercase tracking-wide">Total</p>
    <p class="text-2xl font-bold text-brand-primary mt-1"><%= @stats[:total] %></p>
  </div>
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 px-5 py-4">
    <p class="text-xs text-gray-500 uppercase tracking-wide">Feedback</p>
    <p class="text-2xl font-bold text-blue-600 mt-1"><%= @stats[:feedback] %></p>
  </div>
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 px-5 py-4">
    <p class="text-xs text-gray-500 uppercase tracking-wide">Bugs</p>
    <p class="text-2xl font-bold text-red-600 mt-1"><%= @stats[:bugs] %></p>
  </div>
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 px-5 py-4">
    <p class="text-xs text-gray-500 uppercase tracking-wide">Support</p>
    <p class="text-2xl font-bold text-purple-600 mt-1"><%= @stats[:support] %></p>
  </div>
</div>

<% viewing_archived = action_name == "archived" %>
<% current_filter = action_name == "overview" ? nil : action_name %>

<%# Bulk archive + CSV export (open messages only) %>
<% unless viewing_archived %>
  <div class="flex items-center justify-between gap-3 flex-wrap mb-6">
    <%= form_with url: admin_inbox_archive_before_path, method: :post, class: "flex items-center gap-2 text-xs text-gray-600",
          data: { turbo_confirm: "Archive every message in this view created before the chosen date?" } do %>
      <%= hidden_field_tag :filter, current_filter %>
      <label for="before">Archive everything created before</label>
      <%= date_field_tag :before, nil, required: true, autocomplete: "off",
            class: "bg-gray-100 rounded-lg px-2 py-1.5 text-sm border-0 focus:ring-2 focus:ring-brand-primary focus:outline-none" %>
      <%= submit_tag "Archive",
            class: "px-3 py-1.5 rounded-full text-xs font-medium bg-brand-primary text-white hover:bg-brand-primary-dark cursor-pointer transition-colors" %>
    <% end %>
    <a class="px-3 py-1.5 rounded-full text-xs font-medium bg-green-700 text-white hover:bg-green-800 transition-colors"
       href="<%= admin_inbox_export_csv_path(filter: current_filter) %>">↓ CSV</a>
  </div>
<% end %>

<%# Data table %>
<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date / time</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">User ID</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Media</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Message</th>
        <% if viewing_archived %>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Archived</th>
        <% end %>
        <th class="px-6 py-3"></th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% if @messages.any? %>
        <% @messages.each do |msg| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
              <%= msg.created_at.strftime("%Y-%m-%d %H:%M") %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              <%= admin_user_id_link(msg.user) %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% badge = case msg.type
                         when 'feedback'  then { label: 'Feedback', bg: 'bg-blue-100',        text: 'text-blue-700' }
                         when 'bug_report' then { label: 'Bug',      bg: 'bg-red-100',         text: 'text-red-700' }
                         when 'support'   then { label: 'Support',   bg: 'bg-brand-field',       text: 'text-brand-primary' }
                         end %>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-medium <%= badge[:bg] %> <%= badge[:text] %>"><%= badge[:label] %></span>
            </td>
            <td class="px-6 py-4">
              <% if msg.media.attached? %>
                <% if msg.media.image? %>
                  <%= link_to admin_inbox_message_path(msg), title: msg.media.filename.to_s do %>
                    <%= image_tag msg.media.variant(resize_to_limit: [128, 128]), alt: msg.media.filename.to_s,
                          class: "w-16 h-16 object-cover rounded-lg border border-gray-200 bg-gray-100" %>
                  <% end %>
                <% else %>
                  <%= link_to rails_blob_path(msg.media, disposition: "attachment"),
                        class: "text-xs text-brand-primary hover:underline break-all",
                        title: msg.media.filename.to_s do %>
                    <%= msg.media.filename.to_s.truncate(20) %>
                  <% end %>
                <% end %>
              <% else %>
                <span class="text-gray-300">—</span>
              <% end %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-600">
              <%= link_to msg.message, admin_inbox_message_path(msg),
                    class: "hover:text-brand-primary whitespace-pre-wrap wrap-break-word" %>
            </td>
            <% if viewing_archived %>
              <td class="px-6 py-4 whitespace-nowrap text-xs text-gray-500">
                <%= msg.archived_at&.strftime("%Y-%m-%d %H:%M") || "—" %>
                <% if msg.archived_by %><br>by <%= msg.archived_by.email %><% end %>
              </td>
            <% end %>
            <td class="px-6 py-4 whitespace-nowrap text-right">
              <div class="flex items-center justify-end gap-2">
                <%= link_to "View", admin_inbox_message_path(msg),
                      class: "px-2.5 py-1 rounded text-xs font-medium bg-white text-brand-primary border border-brand-field hover:bg-brand-field transition-colors" %>
                <% if msg.archived? %>
                  <%= button_to "Restore", admin_inbox_unarchive_path(msg), method: :patch,
                        class: "px-2.5 py-1 rounded text-xs font-medium bg-brand-field text-brand-primary hover:bg-brand-warm transition-colors" %>
                <% else %>
                  <%= button_to "Archive", admin_inbox_archive_path(msg), method: :patch,
                        class: "px-2.5 py-1 rounded text-xs font-medium bg-brand-field text-brand-primary hover:bg-brand-warm transition-colors" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="<%= viewing_archived ? 7 : 6 %>" class="px-6 py-8 text-center text-sm text-gray-500">
            <%= viewing_archived ? "Nothing archived" : "No messages yet" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
