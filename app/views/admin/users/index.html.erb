<% content_for :page_title, "Users" %>
<% filter_params = request.query_parameters.except("page") %>

<div class="space-y-4">

  <%# ── Toolbar ── %>
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
    <div class="flex items-center gap-3 flex-wrap">
      <%= search_form_for @q, url: admin_users_path, html: { class: "flex gap-2 flex-1 min-w-[260px]" } do |f| %>
        <%= f.search_field :public_id_cont,
            placeholder: "Search User ID…",
            class: "flex-1 bg-gray-100 rounded-lg px-3 py-2 text-sm border-0 focus:ring-2 focus:ring-brand-primary focus:outline-none" %>
        <label class="flex items-center gap-1 text-xs text-gray-500">
          Signed up from
          <%= date_field_tag :signed_up_from, @signed_up_from, autocomplete: "off",
              class: "bg-gray-100 rounded-lg px-2 py-2 text-sm border-0 focus:ring-2 focus:ring-brand-primary focus:outline-none" %>
        </label>
        <label class="flex items-center gap-1 text-xs text-gray-500">
          to
          <%= date_field_tag :signed_up_to, @signed_up_to, autocomplete: "off",
              class: "bg-gray-100 rounded-lg px-2 py-2 text-sm border-0 focus:ring-2 focus:ring-brand-primary focus:outline-none" %>
        </label>
        <%= f.submit "Search",
            class: "bg-brand-primary text-white px-4 py-2 rounded-lg text-sm font-medium cursor-pointer hover:bg-brand-primary-dark transition-colors" %>
      <% end %>

      <div class="flex items-center gap-2 flex-wrap">
        <%= link_to "All", admin_users_path,
            class: "px-3 py-1.5 rounded-full text-xs font-medium bg-brand-field text-brand-primary hover:bg-brand-field transition-colors" %>
        <%= link_to "English", admin_users_path(q: { language_eq: "en" }),
            class: "px-3 py-1.5 rounded-full text-xs font-medium bg-brand-field text-brand-primary hover:bg-brand-field transition-colors" %>
        <%= link_to "German", admin_users_path(q: { language_eq: "de" }),
            class: "px-3 py-1.5 rounded-full text-xs font-medium bg-brand-field text-brand-primary hover:bg-brand-field transition-colors" %>
        <%= link_to "Secret testers", admin_users_path(q: { secret_tester_eq: true }),
            class: "px-3 py-1.5 rounded-full text-xs font-medium bg-brand-field text-brand-primary hover:bg-brand-field transition-colors" %>
        <%= link_to "↓ CSV", admin_users_path(filter_params.merge(format: :csv)),
            class: "px-3 py-1.5 rounded-full text-xs font-medium bg-green-700 text-white hover:bg-green-800 transition-colors" %>
      </div>
    </div>
  </div>

  <%# ── Stats bar ── %>
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 px-5 py-4">
      <p class="text-xs text-gray-500 uppercase tracking-wide">Total Users</p>
      <p class="text-2xl font-bold text-brand-primary mt-1"><%= @total_count %></p>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 px-5 py-4">
      <p class="text-xs text-gray-500 uppercase tracking-wide">Onboarded</p>
      <p class="text-2xl font-bold text-green-700 mt-1"><%= User.where(onboarding_completed: true).count %></p>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 px-5 py-4">
      <p class="text-xs text-gray-500 uppercase tracking-wide">English</p>
      <p class="text-2xl font-bold text-gray-700 mt-1"><%= User.where(language: "en").count %></p>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 px-5 py-4">
      <p class="text-xs text-gray-500 uppercase tracking-wide">German</p>
      <p class="text-2xl font-bold text-gray-700 mt-1"><%= User.where(language: "de").count %></p>
    </div>
  </div>

  <%# ── Users table ── %>
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-brand-field text-left">
          <th class="px-4 py-3 text-xs font-semibold text-brand-primary uppercase tracking-wide">User ID</th>
          <th class="px-4 py-3 text-xs font-semibold text-brand-primary uppercase tracking-wide">Language</th>
          <th class="px-4 py-3 text-xs font-semibold text-brand-primary uppercase tracking-wide">Onboarding</th>
          <th class="px-4 py-3 text-xs font-semibold text-brand-primary uppercase tracking-wide">Signed Up</th>
          <th class="px-4 py-3 text-xs font-semibold text-brand-primary uppercase tracking-wide">Streak</th>
          <th class="px-4 py-3 text-xs font-semibold text-brand-primary uppercase tracking-wide">Secret Tester</th>
          <th class="px-4 py-3 text-xs font-semibold text-brand-primary uppercase tracking-wide">Admin</th>
          <th class="px-4 py-3 text-xs font-semibold text-brand-primary uppercase tracking-wide"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @users.each do |user| %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-4 py-3 font-medium text-brand-primary">
              <%= admin_user_id_link(user) %>
            </td>
            <td class="px-4 py-3 text-gray-600 uppercase text-xs"><%= user.language || "en" %></td>
            <td class="px-4 py-3">
              <% if user.onboarding_completed? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">Complete</span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-50 text-brand-primary">Pending</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-gray-600"><%= user.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td class="px-4 py-3 text-brand-primary font-medium"><%= user.streak&.current_streak || 0 %> 🔥</td>
            <td class="px-4 py-3">
              <% if user.secret_tester? %>
                <span class="inline-flex items-center gap-1">
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-brand-muted text-white">Secret Tester</span>
                  <%= button_to "Untag",
                        admin_user_path(user, user: { secret_tester: false }),
                        method: :patch,
                        class: "text-xs text-gray-400 hover:text-brand-primary underline" %>
                </span>
              <% else %>
                <%= button_to "Tag",
                      admin_user_path(user, user: { secret_tester: true }),
                      method: :patch,
                      class: "px-2 py-0.5 rounded text-xs font-medium bg-brand-field text-brand-primary hover:bg-brand-warm transition-colors" %>
              <% end %>
            </td>
            <td class="px-4 py-3">
              <% if user.admin? %>
                <span class="inline-flex items-center gap-1">
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-brand-primary text-white">Admin</span>
                  <%= button_to "Demote",
                        admin_user_path(user, user: { admin: false }),
                        method: :patch,
                        data: { turbo_confirm: "Remove admin from user #{user.public_id}?" },
                        class: "text-xs text-gray-400 hover:text-brand-primary underline" %>
                </span>
              <% else %>
                <%= button_to "Promote",
                      admin_user_path(user, user: { admin: true }),
                      method: :patch,
                      data: { turbo_confirm: "Make user #{user.public_id} an admin?" },
                      class: "px-2 py-0.5 rounded text-xs font-medium bg-brand-field text-brand-primary hover:bg-brand-warm transition-colors" %>
              <% end %>
            </td>
            <td class="px-4 py-3">
              <% unless user.admin? %>
                <%= link_to "Delete", admin_user_path(user),
                      data: { turbo_method: :delete, turbo_confirm: "Delete user #{user.public_id}? This cannot be undone." },
                      class: "text-red-600 text-xs hover:underline" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%# Simple pagination (controller uses offset/limit, no pagy gem) %>
    <div class="px-4 py-3 flex items-center justify-between border-t border-gray-100 text-sm text-gray-500">
      <span>Showing <%= @users.length %> of <%= @total_count %> users</span>
      <div class="flex gap-2">
        <% if @page > 1 %>
          <%= link_to "← Prev", admin_users_path(filter_params.merge(page: @page - 1)),
              class: "px-3 py-1.5 bg-white border border-gray-200 rounded-lg text-brand-primary hover:bg-gray-50 transition-colors" %>
        <% end %>
        <span class="px-3 py-1.5">Page <%= @page %></span>
        <% if @users.length == 20 %>
          <%= link_to "Next →", admin_users_path(filter_params.merge(page: @page + 1)),
              class: "px-3 py-1.5 bg-white border border-gray-200 rounded-lg text-brand-primary hover:bg-gray-50 transition-colors" %>
        <% end %>
      </div>
    </div>
  </div>

</div>
