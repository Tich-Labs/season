<% content_for :page_title, "Beta Testers" %>

<div class="space-y-4">

  <%# Stat + actions %>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap gap-3">
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 px-5 py-4">
        <p class="text-xs text-gray-500 uppercase tracking-wide">Total</p>
        <p class="text-2xl font-bold text-brand-primary mt-1"><%= @total_count %></p>
      </div>
      <% BetaTester::PLATFORMS.each do |platform| %>
        <% active = @platform == platform %>
        <%= link_to admin_beta_testers_path(platform: active ? nil : platform, status: @status, q: @q.presence),
              class: "bg-white rounded-xl shadow-sm border px-5 py-4 hover:bg-gray-50 #{active ? 'border-brand-primary ring-1 ring-brand-primary' : 'border-gray-200'}" do %>
          <p class="text-xs text-gray-500 uppercase tracking-wide"><%= platform %></p>
          <p class="text-2xl font-bold mt-1 <%= active ? 'text-brand-primary' : 'text-gray-400' %>"><%= @counts_by_platform[platform].to_i %></p>
        <% end %>
      <% end %>
    </div>

    <div class="flex items-center gap-2">
      <%= link_to "Edit page copy", edit_admin_beta_tester_setting_path,
            class: "px-3 py-1.5 rounded-full text-xs font-medium bg-brand-field text-brand-primary hover:bg-brand-primary hover:text-white transition-colors" %>
      <%= link_to "↓ CSV", admin_beta_testers_export_csv_path(platform: @platform, status: @status, q: @q.presence),
            class: "px-3 py-1.5 rounded-full text-xs font-medium bg-green-700 text-white hover:bg-green-800 transition-colors" %>
    </div>
  </div>

  <%# Search + filters %>
  <%= form_with url: admin_beta_testers_path, method: :get, local: true, class: "bg-white rounded-xl shadow-sm border border-gray-200 p-4 flex flex-wrap items-end gap-3" do %>
    <div class="flex-1 min-w-[200px]">
      <label for="beta_q" class="block text-xs font-medium text-gray-600 mb-1">Search</label>
      <%= text_field_tag :q, @q, placeholder: "Name or email…", autocomplete: "off",
            class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-brand-primary focus:outline-none focus:ring-1 focus:ring-brand-primary/30" %>
    </div>
    <div>
      <label for="beta_platform" class="block text-xs font-medium text-gray-600 mb-1">Platform</label>
      <%= select_tag :platform,
            options_for_select([["All", ""]] + BetaTester::PLATFORMS.map { |p| [p.capitalize, p] }, @platform),
            class: "rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-brand-primary focus:outline-none focus:ring-1 focus:ring-brand-primary/30" %>
    </div>
    <div>
      <label for="beta_status" class="block text-xs font-medium text-gray-600 mb-1">Status</label>
      <%= select_tag :status,
            options_for_select([["All", ""]] + BetaTester::STATUSES.map { |s| [s.capitalize, s] }, @status),
            class: "rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-brand-primary focus:outline-none focus:ring-1 focus:ring-brand-primary/30" %>
    </div>
    <%= submit_tag "Filter", class: "px-4 py-2 rounded-lg bg-brand-primary text-white text-sm font-medium hover:bg-brand-primary-dark cursor-pointer" %>
    <% if @platform || @status || @q.present? %>
      <%= link_to "Clear", admin_beta_testers_path, class: "px-3 py-2 text-sm text-gray-500 hover:text-brand-primary" %>
    <% end %>
  <% end %>

  <%# Table %>
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Platform</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Consent</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Registered</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if @beta_testers.any? %>
          <% @beta_testers.each do |t| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 whitespace-nowrap text-sm font-medium text-brand-dark">
                <%= link_to t.name, admin_beta_tester_path(t), class: "text-brand-primary hover:underline" %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600"><%= t.email %></td>
              <td class="px-4 py-3 whitespace-nowrap">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold uppercase tracking-wide
                             <%= case t.platform
                                 when "ios" then "bg-gray-800 text-white"
                                 when "android" then "bg-green-100 text-green-800"
                                 else "bg-blue-100 text-blue-800"
                                 end %>"><%= t.platform %></span>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600"><%= t.status.capitalize %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm"><%= t.beta_consent? ? "✓" : "—" %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500"><%= t.created_at.strftime("%Y-%m-%d") %></td>
              <td class="px-4 py-3 whitespace-nowrap text-right text-sm">
                <%= link_to "View", admin_beta_tester_path(t), class: "text-brand-primary hover:underline" %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="7" class="px-4 py-8 text-center text-sm text-gray-400">
              <%= @platform || @status || @q.present? ? "No beta testers match these filters." : "No beta testers yet." %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Pagination — @current_page / @total_pages come from the controller, which
      already clamps to >= 1. Re-deriving here from params[:page].to_i gives 0
      on page one, which linked "Next" back to page one and trapped the user. %>
  <% if @total_pages > 1 %>
    <div class="flex items-center justify-between text-sm text-gray-500">
      <span>Showing <%= @beta_testers.size %> of <%= @total_count %> (page <%= @current_page %> of <%= @total_pages %>)</span>
      <div class="flex gap-2">
        <% if @current_page > 1 %>
          <%= link_to "← Prev", admin_beta_testers_path(platform: @platform, status: @status, q: @q.presence, page: @current_page - 1), class: "px-3 py-1.5 rounded-lg border border-gray-300 hover:bg-gray-50" %>
        <% end %>
        <% if @current_page < @total_pages %>
          <%= link_to "Next →", admin_beta_testers_path(platform: @platform, status: @status, q: @q.presence, page: @current_page + 1), class: "px-3 py-1.5 rounded-lg border border-gray-300 hover:bg-gray-50" %>
        <% end %>
      </div>
    </div>
  <% end %>

</div>
