<% content_for :page_title, "Beta Tester" %>

<div class="space-y-4">

  <%# Header %>
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-xl font-semibold text-brand-primary"><%= @beta_tester.name %></h1>
      <p class="text-sm text-gray-500"><%= @beta_tester.email %></p>
    </div>
    <%= link_to "← All beta testers", admin_beta_testers_path, class: "text-sm text-gray-500 hover:text-brand-primary" %>
  </div>

  <%# Details %>
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <dl class="grid grid-cols-2 gap-6">
      <div>
        <dt class="text-xs text-gray-500 uppercase tracking-wide">Platform</dt>
        <dd class="mt-1 text-sm font-medium text-brand-dark capitalize"><%= @beta_tester.platform %></dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500 uppercase tracking-wide">Status</dt>
        <dd class="mt-1 text-sm font-medium text-brand-dark capitalize"><%= @beta_tester.status %></dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500 uppercase tracking-wide">Beta consent</dt>
        <dd class="mt-1 text-sm font-medium text-brand-dark"><%= @beta_tester.beta_consent? ? "Yes" : "No" %></dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500 uppercase tracking-wide">Registered</dt>
        <dd class="mt-1 text-sm font-medium text-brand-dark"><%= @beta_tester.created_at.strftime("%Y-%m-%d %H:%M") %></dd>
      </div>
    </dl>
  </div>

  <%# Linked app account + activity %>
  <% user = @beta_tester.user %>
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-sm font-semibold text-brand-primary uppercase tracking-wide">App account &amp; activity</h2>
      <% if user %>
        <%= link_to "Open user →", admin_user_path(user), class: "text-xs font-medium text-brand-primary hover:underline" %>
      <% end %>
    </div>

    <% if user %>
      <dl class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-gray-50 rounded-lg px-4 py-3">
          <dt class="text-xs text-gray-500">Onboarding</dt>
          <dd class="mt-0.5">
            <% if user.onboarding_completed? %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">Complete</span>
            <% else %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-50 text-brand-primary">Pending</span>
            <% end %>
          </dd>
        </div>
        <div class="bg-gray-50 rounded-lg px-4 py-3">
          <dt class="text-xs text-gray-500">Joined</dt>
          <dd class="text-sm font-semibold text-gray-700 mt-0.5"><%= user.created_at.strftime("%Y-%m-%d") %></dd>
        </div>
        <div class="bg-gray-50 rounded-lg px-4 py-3">
          <dt class="text-xs text-gray-500">Streak</dt>
          <dd class="text-sm font-bold text-brand-primary mt-0.5"><%= user.streak&.current_streak || 0 %> 🔥</dd>
        </div>
        <div class="bg-gray-50 rounded-lg px-4 py-3">
          <dt class="text-xs text-gray-500">Cycle entries</dt>
          <dd class="text-sm font-bold text-brand-primary mt-0.5"><%= user.cycle_entries.count %></dd>
        </div>
        <div class="bg-gray-50 rounded-lg px-4 py-3">
          <dt class="text-xs text-gray-500">Symptom logs</dt>
          <dd class="text-sm font-bold text-brand-primary mt-0.5"><%= user.symptom_logs.count %></dd>
        </div>
        <div class="bg-gray-50 rounded-lg px-4 py-3">
          <dt class="text-xs text-gray-500">Period entries</dt>
          <dd class="text-sm font-bold text-brand-primary mt-0.5"><%= user.period_starts.count %></dd>
        </div>
        <div class="bg-gray-50 rounded-lg px-4 py-3">
          <dt class="text-xs text-gray-500">Superpower logs</dt>
          <dd class="text-sm font-bold text-brand-primary mt-0.5"><%= user.superpower_logs.count %></dd>
        </div>
        <div class="bg-gray-50 rounded-lg px-4 py-3">
          <dt class="text-xs text-gray-500">Weekly surveys</dt>
          <dd class="text-sm font-bold text-brand-primary mt-0.5"><%= user.weekly_feedback_responses.count %></dd>
        </div>
      </dl>

      <h3 class="text-xs font-medium text-gray-500 uppercase tracking-wide mt-6 mb-2">
        Feedback (<%= user.feedbacks.active.count %>)
      </h3>
      <% recent = user.feedbacks.active.order(created_at: :desc).limit(5) %>
      <% if recent.any? %>
        <ul class="space-y-2">
          <% recent.each do |fb| %>
            <li class="flex items-start gap-3 text-sm">
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-11 font-semibold uppercase tracking-wide shrink-0
                           <%= case fb.type
                               when "bug_report" then "bg-red-100 text-red-700"
                               when "support" then "bg-amber-100 text-amber-800"
                               else "bg-blue-100 text-blue-800"
                               end %>"><%= fb.type.humanize %></span>
              <span class="text-gray-600 flex-1"><%= truncate(fb.message, length: 180) %></span>
              <span class="text-gray-400 text-xs shrink-0"><%= fb.created_at.strftime("%Y-%m-%d") %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-gray-400">No feedback yet.</p>
      <% end %>
    <% else %>
      <p class="text-sm text-gray-400">Not linked to an app account yet — no user has signed up with this email.</p>
    <% end %>
  </div>

  <%# Change status %>
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <h2 class="text-sm font-semibold text-brand-primary mb-4">Change status</h2>
    <%= form_with model: @beta_tester, url: admin_beta_tester_path(@beta_tester), method: :patch, local: true, class: "flex flex-wrap items-end gap-3" do |f| %>
      <div>
        <%= f.label :status, class: "block text-xs font-medium text-gray-600 mb-1" %>
        <%= f.select :status,
              options_for_select(BetaTester::STATUSES.map { |s| [s.capitalize, s] }, @beta_tester.status),
              class: "rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-brand-primary focus:outline-none focus:ring-1 focus:ring-brand-primary/30" %>
      </div>
      <%= f.submit "Update", class: "px-4 py-2 rounded-lg bg-brand-primary text-white text-sm font-medium hover:bg-brand-primary-dark cursor-pointer" %>
    <% end %>
  </div>

</div>
