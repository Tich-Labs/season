<div class="onboarding-layout overflow-y-auto bg-white flex flex-col max-w-[430px] mx-auto px-8" style="min-height:100dvh;padding-top:calc(20px + env(safe-area-inset-top,0px));padding-bottom:calc(3rem + env(safe-area-inset-bottom,0px))">

  <%# ── Back button + step progress indicator ──────────────────────── %>
  <div class="relative flex items-center justify-center pt-6 pb-12">
    <% if @step > 1 %>
      <%= link_to onboarding_path(@step - 1),
            class: "absolute left-0 top-1/2 -translate-y-1/2 w-9 h-9 flex items-center justify-center",
            aria: { label: "Back" } do %>
        <svg width="20" height="20" fill="none" stroke="#933a35" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg>
      <% end %>
    <% end %>

    <div class="flex items-center gap-1.5">
      <% (1..10).each do |s| %>
        <% if s == @step %>
          <div class="h-2 w-6 rounded-full bg-brand-primary transition-all duration-300"></div>
        <% elsif s < @step %>
          <div class="h-2 w-2 rounded-full bg-brand-primary transition-all duration-300"></div>
        <% else %>
          <div class="h-2 w-2 rounded-full bg-brand-primary opacity-25 transition-all duration-300"></div>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @error %>
    <div class="bg-brand-error rounded-xl px-4 py-3 text-sm text-brand-primary mb-4">
      <%= @error %>
    </div>
  <% end %>

  <%# ── Step 1: Name ──────────────────────────────────────────────── %>
  <% case @step when 1 %>
    <div class="flex-1 flex flex-col justify-center">
      <h2 class="text-brand-primary text-xl font-medium leading-7 tracking-wider mb-[41px]">
        <%= t('onboarding.step1.heading') %>
      </h2>

      <%= form_with url: onboarding_path(1), method: :patch, id: "step1-form", local: true do |f| %>
        <label for="onboarding_name" class="sr-only"><%= t('onboarding.step1.heading') %></label>
        <%= f.text_field :name,
            id: "onboarding_name",
            name: "user[name]",
            placeholder: t('onboarding.step1.name_placeholder'),
            autocomplete: "name",
            class: "w-80 h-12 bg-brand-field rounded-lg px-4 text-brand-primary text-xl font-medium placeholder:text-brand-primary/40 tracking-wide" %>
        <%= f.submit t('onboarding.step1.submit'),
            class: "w-80 h-12 bg-brand-primary text-white rounded-lg text-xl font-medium tracking-wide mt-10" %>
      <% end %>
    </div>

  <%# ── Step 2: Birthday ──────────────────────────────────────────── %>
  <% when 2 %>
    <div class="flex-1 flex flex-col justify-center">
      <h2 class="text-brand-primary text-22 font-medium leading-[27px] tracking-[1.32px] mb-[43px]">
        <%= t('onboarding.step2.heading_html', name: current_user.first_name) %>
      </h2>

      <%= form_with url: onboarding_path(2), method: :patch, id: "step2-form", local: true do |f| %>
        <div class="flex justify-center gap-3">
          <div class="flex flex-col items-center gap-2">
            <span class="text-brand-primary text-xs font-normal tracking-wide"><%= t('onboarding.step2.label_day') %></span>
            <div data-controller="scroll-picker"
                 data-scroll-picker-min-value="1"
                 data-scroll-picker-max-value="31"
                 data-scroll-picker-step-value="1"
                 data-scroll-picker-placeholder="<%= t('onboarding.step2.placeholder_day') %>">
              <div class="relative" style="width:56px; height:180px;">
                <div class="sp-highlight" style="top:69px; height:42px;"></div>
                <div data-scroll-picker-target="display" class="sp-display" style="top:69px; height:42px;"></div>
                <div data-scroll-picker-target="track" class="sp-track"
                     style="height:180px; padding:69px 0;"
                     data-action="scroll->scroll-picker#scroll click->scroll-picker#click keydown->scroll-picker#keydown"
                     role="listbox" aria-label="<%= t('onboarding.step2.label_day') %>" tabindex="0">
                </div>
              </div>
              <input type="hidden" data-scroll-picker-target="input" name="birthday_day" value="">
            </div>
          </div>
          <div class="flex flex-col items-center gap-2">
            <span class="text-brand-primary text-xs font-normal tracking-wide"><%= t('onboarding.step2.label_month') %></span>
            <div data-controller="scroll-picker"
                 data-scroll-picker-min-value="1"
                 data-scroll-picker-max-value="12"
                 data-scroll-picker-step-value="1"
                 data-scroll-picker-placeholder="<%= t('onboarding.step2.placeholder_month') %>">
              <div class="relative" style="width:56px; height:180px;">
                <div class="sp-highlight" style="top:69px; height:42px;"></div>
                <div data-scroll-picker-target="display" class="sp-display" style="top:69px; height:42px;"></div>
                <div data-scroll-picker-target="track" class="sp-track"
                     style="height:180px; padding:69px 0;"
                     data-action="scroll->scroll-picker#scroll click->scroll-picker#click keydown->scroll-picker#keydown"
                     role="listbox" aria-label="<%= t('onboarding.step2.label_month') %>" tabindex="0">
                </div>
              </div>
              <input type="hidden" data-scroll-picker-target="input" name="birthday_month" value="">
            </div>
          </div>
          <div class="flex flex-col items-center gap-2">
            <span class="text-brand-primary text-xs font-normal tracking-wide"><%= t('onboarding.step2.label_year') %></span>
            <div data-controller="scroll-picker"
                 data-scroll-picker-min-value="1946"
                 data-scroll-picker-max-value="<%= Time.zone.today.year %>"
                 data-scroll-picker-step-value="1"
                 data-scroll-picker-placeholder="<%= t('onboarding.step2.placeholder_year') %>">
              <div class="relative" style="width:72px; height:180px;">
                <div class="sp-highlight" style="top:69px; height:42px;"></div>
                <div data-scroll-picker-target="display" class="sp-display" style="top:69px; height:42px;"></div>
                <div data-scroll-picker-target="track" class="sp-track"
                     style="height:180px; padding:69px 0;"
                     data-action="scroll->scroll-picker#scroll click->scroll-picker#click keydown->scroll-picker#keydown"
                     role="listbox" aria-label="<%= t('onboarding.step2.label_year') %>" tabindex="0">
                </div>
              </div>
              <input type="hidden" data-scroll-picker-target="input" name="birthday_year" value="">
            </div>
          </div>
        </div>
        <%= f.submit t('onboarding.step2.submit'),
            class: "w-[322px] h-[52px] bg-brand-primary text-white rounded-lg text-22 font-medium tracking-p66 mt-[77px]" %>
      <% end %>
    </div>

  <%# ── Step 3: First & last day of last period (single range picker) ── %>
  <% when 3 %>
    <%
      today      = Time.zone.today
      cal_year   = (params[:cal_year] || today.year).to_i
      cal_month_num = (params[:cal_month] || today.month).to_i
      cal_start  = Date.new(cal_year, cal_month_num, 1)
      cal_end    = cal_start.end_of_month
      start_pad  = (cal_start.wday - 1) % 7
      end_pad    = (7 - cal_end.wday) % 7
      cal_days   = (cal_start - start_pad)..(cal_end + end_pad)
      step3_start_heading = t('onboarding.step3.heading', name: current_user.first_name)
      step3_end_heading   = t('onboarding.step3.heading_end')
    %>

    <div class="flex-1 flex flex-col justify-center"
         data-controller="onboarding-calendar"
         data-onboarding-calendar-start-heading-value="<%= step3_start_heading %>"
         data-onboarding-calendar-end-heading-value="<%= step3_end_heading %>">
      <h2 class="text-brand-primary text-22 font-medium leading-tight mb-6"
          data-onboarding-calendar-target="heading">
        <%= step3_start_heading %>
      </h2>

      <%= form_with url: onboarding_path(3), method: :patch, local: true do |f| %>
        <%= f.hidden_field :last_period_start, value: "",
            data: { onboarding_calendar_target: "startInput" } %>
        <%= f.hidden_field :last_period_end, value: "",
            data: { onboarding_calendar_target: "endInput" } %>

        <div class="flex items-center justify-between mb-2">
          <a href="<%= onboarding_path(3, cal_year: (cal_start - 1.month).year, cal_month: (cal_start - 1.month).month) %>"
             class="text-brand-primary text-sm font-medium px-1">&lt;</a>
          <span class="text-brand-primary text-sm font-medium">
            <%= cal_start.strftime("%B %Y") %>
          </span>
          <a href="<%= onboarding_path(3, cal_year: (cal_start + 1.month).year, cal_month: (cal_start + 1.month).month) %>"
             class="text-brand-primary text-sm font-medium px-1">&gt;</a>
        </div>

        <%# Weekday headers — matches the main /calendar month view %>
        <div class="grid grid-cols-7 gap-0 mb-1.5">
          <% weekday_initials.each do |d| %>
            <div class="text-center text-brand-secondary text-xs font-semibold tracking-wider py-1"><%= d %></div>
          <% end %>
        </div>

        <%# Calendar grid — gap-y-2, no row-divider lines, matches the main calendar's rhythm %>
        <div class="grid grid-cols-7 gap-x-0 gap-y-2">
          <% cal_days.each do |day| %>
            <%
              in_month = day.month == cal_start.month
              is_today = day == today
            %>
            <button type="button"
                 data-action="click->onboarding-calendar#select"
                 data-onboarding-calendar-target="day"
                 data-date="<%= day.iso8601 %>"
                 data-in-month="<%= in_month %>"
                 data-today="<%= is_today %>"
                 class="cal-day flex flex-col items-center cursor-pointer select-none bg-transparent border-none p-0 w-full">
              <span data-onboarding-calendar-target="band" class="h-[11px] w-full block"></span>
              <span data-onboarding-calendar-target="number"
                    class="text-sm w-8 h-8 flex items-center justify-center cal-day-label mt-1 rounded-full
                           <%= is_today ? 'bg-brand-primary text-white font-semibold' : (in_month ? 'text-brand-primary' : 'text-brand-month') %>">
                <%= day.day %>
              </span>
            </button>
          <% end %>
        </div>

        <a href="#" data-action="click->onboarding-calendar#clear"
           data-onboarding-calendar-target="clear"
           class="block text-center text-brand-primary text-sm hidden mt-4"><%= t('onboarding.step3.clear') %></a>

        <%= f.submit t('onboarding.step3.submit'),
            data: { onboarding_calendar_target: "submit" },
            class: "w-full h-[52px] bg-brand-primary text-white rounded-lg text-22 font-medium tracking-p66 hidden mt-2" %>
      <% end %>

      <%= form_with url: onboarding_path(3), method: :patch, local: true do |f| %>
        <%= f.hidden_field :skip_last_period, value: "1" %>
        <%= f.submit t('onboarding.step3.unsure'),
            class: "w-full h-[52px] bg-brand-primary text-white rounded-lg text-22 font-medium tracking-p66 mt-2" %>
      <% end %>
    </div>

  <%# ── Step 4: Regular cycle? ────────────────────────────────────── %>
  <% when 4 %>
    <div class="flex-1 flex flex-col justify-center">
      <h2 class="text-brand-primary text-22 font-medium leading-[27px] tracking-[1.32px] mb-10">
        <%= t('onboarding.step4.heading') %>
      </h2>

      <div class="flex flex-col gap-3 items-center">
        <%= form_with url: onboarding_path(4), method: :patch, local: true do |f| %>
          <%= f.hidden_field :has_regular_cycle, value: "true" %>
          <%= f.submit t('onboarding.step4.yes'),
              class: "w-[322px] h-[52px] bg-brand-primary text-white rounded-lg text-22 font-medium tracking-p66 cursor-pointer" %>
        <% end %>

        <%= form_with url: onboarding_path(4), method: :patch, local: true do |f| %>
          <%= f.hidden_field :has_regular_cycle, value: "false" %>
          <%= f.submit t('onboarding.step4.no'),
              class: "w-[322px] bg-transparent text-brand-primary py-4 text-22 font-medium tracking-p66 cursor-pointer border-none" %>
        <% end %>
      </div>
    </div>

  <%# ── Step 5: Cycle length (scroll picker) ──────────────────────── %>
  <% when 5 %>
    <%# "contents" keeps this wrapper out of the flex layout below (the step's
         content div must stay a direct flex child of the page's flex column)
         while still giving the modal, the picker, and the "Not sure" button a
         shared Stimulus scope. Auto-shows when the user already said their
         cycle is irregular (step 4 "No"); also opened by clicking "Not sure"
         below, in which case confirming also submits the skip
         (see no_problem_modal_controller.js for the two-path logic). %>
    <div data-controller="no-problem-modal" data-no-problem-modal-auto-show-value="<%= @no_regular_cycle ? 'true' : 'false' %>" class="contents">
      <div data-no-problem-modal-target="modal" role="dialog" aria-modal="true" aria-labelledby="no-problem-title"
           class="hidden fixed inset-0 bg-black/40 flex items-center justify-center z-50 px-8">
        <div class="bg-brand-background rounded-2xl px-8 py-10 text-center max-w-[340px] w-full">
          <h3 id="no-problem-title" class="text-brand-primary text-2xl font-medium mb-4"><%= t('onboarding.step5.no_problem_title') %></h3>
          <p class="text-brand-primary text-sm leading-relaxed mb-8">
            <%= t('onboarding.step5.no_problem_body') %>
          </p>
          <button type="button" data-action="click->no-problem-modal#confirm"
                  class="w-full h-12 bg-brand-primary text-white rounded-lg text-xl font-medium">
            <%= t('onboarding.step5.no_problem_ok') %>
          </button>
        </div>
      </div>

      <div class="flex-1 flex flex-col justify-center">
        <h2 class="text-brand-primary text-22 font-medium leading-[27px] tracking-[1.32px] mb-1">
          <%= t('onboarding.step5.heading') %>
        </h2>
        <p class="text-brand-secondary text-sm mb-10"><%= t('onboarding.step5.note') %></p>

        <%= form_with url: onboarding_path(5), method: :patch, id: "step5-form", local: true,
            data: { controller: "onboarding-picker" } do |f| %>
          <%= f.hidden_field :cycle_length, id: "cycle_length_value", value: "28",
              data: { onboarding_picker_target: "input" } %>

          <div class="relative flex justify-center overflow-hidden" style="height:210px;">
            <div class="absolute left-0 right-0 bg-brand-field rounded-lg pointer-events-none"
                 style="top:84px; height:42px;"></div>

            <div data-onboarding-picker-target="track"
                 role="listbox" aria-label="Cycle length in days" aria-activedescendant="cycle-day-28"
                 tabindex="0"
                 class="relative overflow-y-scroll flex flex-col items-center"
                 style="height:210px; scroll-snap-type:y mandatory; -webkit-overflow-scrolling:touch; scrollbar-width:none;">
              <div style="min-height:84px; flex-shrink:0;"></div>
              <% (20..45).each do |d| %>
                <div id="cycle-day-<%= d %>"
                     role="option" aria-selected="<%= d == 28 ? 'true' : 'false' %>"
                     data-days="<%= d %>"
                     class="cycle-day-item flex items-center justify-center text-brand-primary font-medium cursor-pointer shrink-0"
                     style="height:42px; min-height:42px; scroll-snap-align:center; font-size:16px; opacity:0.45;">
                  <%= d %> <%= t('onboarding.step5.days_suffix') %>
                </div>
              <% end %>
              <div style="min-height:84px; flex-shrink:0;"></div>
            </div>
          </div>

          <%= f.submit t('onboarding.step5.submit'),
              class: "w-[322px] h-[52px] bg-brand-primary text-white rounded-lg text-22 font-medium tracking-p66 mt-10" %>
        <% end %>

        <div class="w-full flex flex-col gap-3 items-center mt-3">
          <%# TODO: Auto-calculate cycle length from user's tracking data over time %>
          <%= form_with url: onboarding_path(5), method: :patch, local: true, data: { no_problem_modal_target: "skipForm" } do |f| %>
            <%= f.hidden_field :skip_cycle_length, value: "1" %>
            <button type="button" data-action="click->no-problem-modal#open"
                    class="w-[322px] bg-transparent text-brand-primary py-3 text-22 font-medium tracking-p66 cursor-pointer border-none">
              <%= t('onboarding.step5.not_sure') %>
            </button>
          <% end %>
        </div>
      </div>
    </div>
    </div>

  <%# ── Step 6: Hormonal birth control? ───────────────────────────── %>
  <% when 6 %>
    <div class="flex-1 flex flex-col justify-center">
      <h2 class="text-brand-primary text-22 font-medium leading-[27px] tracking-[1.32px] mb-10">
        <%= t('onboarding.step6.heading') %>
      </h2>

      <div class="flex flex-col gap-3 items-center">
        <%= form_with url: onboarding_path(6), method: :patch, local: true do |f| %>
          <%= f.hidden_field :uses_hormonal_birth_control, value: "true" %>
          <%= f.submit t('onboarding.step6.yes'),
              class: "w-[322px] h-[52px] bg-brand-primary text-white rounded-lg text-22 font-medium tracking-p66 cursor-pointer" %>
        <% end %>

        <%= form_with url: onboarding_path(6), method: :patch, local: true do |f| %>
          <%= f.hidden_field :uses_hormonal_birth_control, value: "false" %>
          <%= f.submit t('onboarding.step6.no'),
              class: "w-[322px] bg-transparent text-brand-primary py-4 text-22 font-medium tracking-p66 cursor-pointer border-none" %>
        <% end %>
      </div>

      <div class="w-full max-w-80 mx-auto mt-10">
        <p class="text-brand-primary text-sm leading-relaxed">
          <%= t('onboarding.step6.info') %>
        </p>
      </div>
    </div>

  <%# ── Step 7: Birth control reminder ────────────────────────────── %>
  <% when 7 %>
    <div class="flex-1 flex flex-col justify-center">
      <h2 class="text-brand-primary text-22 font-medium leading-[27px] tracking-[1.32px] mb-10">
        <%= t('onboarding.step7.heading') %>
      </h2>

      <div class="flex flex-col gap-3 items-center">
        <%= form_with url: onboarding_path(7), method: :patch, local: true do |f| %>
          <%= f.hidden_field :birth_control_reminder, value: "true" %>
          <%= f.submit t('onboarding.step7.yes'),
              class: "w-[322px] h-[52px] bg-brand-primary text-white rounded-lg text-22 font-medium tracking-p66 cursor-pointer" %>
        <% end %>

        <%= form_with url: onboarding_path(7), method: :patch, local: true do |f| %>
          <%= f.hidden_field :birth_control_reminder, value: "false" %>
          <%= f.submit t('onboarding.step7.no'),
              class: "w-[322px] bg-transparent text-brand-primary py-4 text-22 font-medium tracking-p66 cursor-pointer border-none" %>
        <% end %>
      </div>
    </div>

  <%# ── Step 8: Birth control method ──────────────────────────────── %>
  <%# TODO: On submit, redirect to Settings for reminder setup instead of next step %>
  <% when 8 %>
    <div class="flex-1 flex flex-col justify-center">
      <h2 class="text-brand-primary text-22 font-medium leading-[27px] tracking-[1.32px] mb-[43px]">
        <%= t('onboarding.step8.heading') %>
      </h2>

      <div class="flex flex-col gap-3 items-center">
        <% t('onboarding.step8.methods').each_with_index do |method_label, idx| %>
          <%= form_with url: onboarding_path(8), method: :patch, local: true do |f| %>
            <%= f.hidden_field :birth_control_method, value: method_label %>
            <%= f.submit method_label,
                class: "w-[322px] h-[52px] bg-brand-field text-brand-primary rounded-lg text-22 font-medium tracking-p66 cursor-pointer" %>
          <% end %>
        <% end %>
      </div>
    </div>

  <%# ── Step 9: Cycle stage reminder ─────────────────────────────── %>
  <% when 9 %>
    <div class="flex-1 flex flex-col justify-center">
      <div class="flex justify-center mb-6">
        <svg class="w-14 h-14 text-brand-primary" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
        </svg>
      </div>

      <h2 class="text-brand-primary text-22 font-medium leading-[27px] tracking-[1.32px] mb-[43px]">
        <%= t('onboarding.step9.heading') %>
      </h2>
      <p class="text-brand-primary text-sm leading-relaxed">
        <%= t('onboarding.step9.body') %>
      </p>

      <div class="w-full flex flex-col gap-3 items-center mt-10">
        <%= form_with url: onboarding_path(9), method: :patch, local: true do |f| %>
          <%= f.submit t('onboarding.step9.submit'),
              class: "w-[322px] h-[52px] bg-brand-primary text-white rounded-lg text-22 font-medium tracking-p66 cursor-pointer" %>
        <% end %>

        <%= form_with url: onboarding_path(9), method: :patch, local: true do |f| %>
          <%= f.hidden_field :skip_reminder, value: "1" %>
          <%= f.submit t('onboarding.step9.maybe_later'),
              class: "w-[322px] bg-transparent text-brand-primary py-3 text-22 font-medium tracking-p66 cursor-pointer border-none" %>
        <% end %>
      </div>
    </div>

  <%# ── Step 10: Food preferences ─────────────────────────────────── %>
  <% when 10 %>
    <div class="flex-1 flex flex-col justify-center">
      <h2 class="text-brand-primary text-22 font-medium leading-[27px] tracking-[1.32px] mb-[43px]">
        <%= t('onboarding.step10.heading_html', name: current_user.first_name) %>
      </h2>

      <div class="flex flex-col gap-3 items-center">
        <% t('onboarding.step10.foods').each do |pref| %>
          <%= form_with url: onboarding_path(10), method: :patch, local: true do |f| %>
            <%= f.hidden_field :food_preference, value: pref %>
            <%= f.submit pref,
                class: "w-[322px] h-[52px] bg-brand-field text-brand-primary rounded-lg text-22 font-medium tracking-p66 cursor-pointer" %>
          <% end %>
        <% end %>
      </div>
    </div>

  <% end %>
</div>
