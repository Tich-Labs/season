<div class="onboarding-layout h-dvh overflow-y-auto bg-white flex flex-col max-w-[430px] mx-auto px-8" style="padding-top:calc(20px + env(safe-area-inset-top,0px));padding-bottom:calc(3rem + env(safe-area-inset-bottom,0px))">

  <% if @error %>
    <div class="bg-brand-error rounded-xl px-4 py-3 text-sm text-brand-primary mb-4">
      <%= @error %>
    </div>
  <% end %>

  <%# ── Step 1: Name ──────────────────────────────────────────────── %>
  <% case @step when 1 %>
    <div class="mt-[113px]">
      <h2 class="text-brand-primary text-xl font-medium leading-7 tracking-wider mb-[41px]">
        <%= t('onboarding.step1.heading') %>
      </h2>

      <%= form_with url: onboarding_path(1), method: :patch, id: "step1-form", local: true do |f| %>
        <label for="onboarding_name" class="sr-only"><%= t('onboarding.step1.heading') %></label>
        <%= f.text_field :name,
            id: "onboarding_name",
            name: "user[name]",
            placeholder: t('onboarding.step1.name_placeholder'),
            autocomplete: "name",
            class: "w-80 h-12 bg-brand-field opacity-50 rounded-lg px-4 text-brand-primary text-xl font-medium placeholder-brand-primary/50 tracking-wide" %>
      <% end %>

      <%= button_tag t('onboarding.step1.submit'),
          form: "step1-form", type: "submit",
          class: "w-80 h-12 bg-brand-primary text-white rounded-lg text-xl font-medium tracking-wide mt-[81px]" %>
    </div>
    <div class="flex-1"></div>

  <%# ── Step 2: Birthday ──────────────────────────────────────────── %>
  <% when 2 %>
    <div class="mt-[113px]">
      <h2 class="text-brand-primary text-[22px] font-medium leading-[27px] tracking-[1.32px] mb-[43px]">
        <%= t('onboarding.step2.heading_html', name: current_user.first_name) %>
      </h2>

      <%= form_with url: onboarding_path(2), method: :patch, id: "step2-form", local: true do |f| %>
        <div class="flex gap-3">
          <div class="flex flex-col items-start gap-2">
            <label for="birthday_day" class="text-brand-primary text-xs font-normal tracking-wide"><%= t('onboarding.step2.label_day') %></label>
            <input type="number" name="birthday_day" id="birthday_day" min="1" max="31" placeholder="<%= t('onboarding.step2.placeholder_day') %>" autocomplete="bday-day"
                   class="w-16 h-[52px] bg-brand-field opacity-50 rounded-lg px-3 text-brand-primary text-[22px] font-medium text-center placeholder-brand-primary/50 tracking-[0.66px]">
          </div>
          <div class="flex flex-col items-start gap-2">
            <label for="birthday_month" class="text-brand-primary text-xs font-normal tracking-wide"><%= t('onboarding.step2.label_month') %></label>
            <input type="number" name="birthday_month" id="birthday_month" min="1" max="12" placeholder="<%= t('onboarding.step2.placeholder_month') %>" autocomplete="bday-month"
                   class="w-16 h-[52px] bg-brand-field opacity-50 rounded-lg px-3 text-brand-primary text-[22px] font-medium text-center placeholder-brand-primary/50 tracking-[0.66px]">
          </div>
          <div class="flex flex-col items-start gap-2">
            <label for="birthday_year" class="text-brand-primary text-xs font-normal tracking-wide"><%= t('onboarding.step2.label_year') %></label>
            <input type="number" name="birthday_year" id="birthday_year" min="1900" max="<%= Time.zone.today.year %>" placeholder="<%= t('onboarding.step2.placeholder_year') %>" autocomplete="bday-year"
                   class="w-24 h-[52px] bg-brand-field opacity-50 rounded-lg px-3 text-brand-primary text-[22px] font-medium text-center placeholder-brand-primary/50 tracking-[0.66px]">
          </div>
        </div>
      <% end %>

      <%= button_tag t('onboarding.step2.submit'),
          form: "step2-form", type: "submit",
          class: "w-[322px] h-[52px] bg-brand-primary text-white rounded-lg text-[22px] font-medium tracking-[0.66px] mt-[77px]" %>
    </div>
    <div class="flex-1"></div>

  <%# ── Step 3: First day of last period ──────────────────────────── %>
  <% when 3 %>
    <%
      today      = Time.zone.today
      cal_year   = (params[:cal_year] || today.year).to_i
      cal_month_num = (params[:cal_month] || today.month).to_i
      cal_start  = Date.new(cal_year, cal_month_num, 1)
      cal_end    = cal_start.end_of_month
      start_pad  = (cal_start.wday - 1) % 7
      end_pad    = (7 - cal_end.wday) % 7
      cal_days   = (cal_start - start_pad)..(cal_end + end_pad)
    %>

    <div class="pt-4">
      <h2 class="text-brand-primary text-[22px] font-medium leading-tight mb-6">
        <%= t('onboarding.step3.heading', name: current_user.first_name) %>
      </h2>
    </div>

    <div class="flex-1">
      <%= form_with url: onboarding_path(3), method: :patch, local: true,
          data: { controller: "onboarding-calendar" } do |f| %>
        <%= f.hidden_field :last_period_start, value: "",
            data: { onboarding_calendar_target: "input" } %>

        <div class="flex items-center justify-between mb-2">
          <a href="<%= onboarding_path(3, cal_year: (cal_start - 1.month).year, cal_month: (cal_start - 1.month).month) %>"
             class="text-brand-primary text-sm font-medium px-1">&lt;</a>
          <span class="text-brand-primary text-sm font-medium">
            <%= cal_start.strftime("%B %Y") %>
          </span>
          <a href="<%= onboarding_path(3, cal_year: (cal_start + 1.month).year, cal_month: (cal_start + 1.month).month) %>"
             class="text-brand-primary text-sm font-medium px-1">&gt;</a>
        </div>

        <%# Weekday headers %>
        <div class="grid grid-cols-7 mb-1">
          <% %w[Mo Tu We Th Fr Sa Su].each do |d| %>
            <div class="text-center text-brand-secondary text-xs font-semibold tracking-wider py-1"><%= d %></div>
          <% end %>
        </div>

        <div>
          <% cal_days.each_slice(7).each do |week| %>
            <div class="border-t border-brand-field"></div>
            <div class="grid grid-cols-7">
              <% week.each do |day| %>
                <%
                  in_month = day.month == cal_start.month
                  is_today = day == today
                %>
                <button type="button"
                     data-action="click->onboarding-calendar#select"
                     data-onboarding-calendar-target="day"
                     data-date="<%= day.iso8601 %>"
                     data-in-month="<%= in_month %>"
                     data-today="<%= is_today %>"
                     class="cal-day flex flex-col items-center py-3 cursor-pointer select-none bg-transparent border-none p-0">
                  <span class="text-sm w-8 h-8 flex items-center justify-center cal-day-label
                               <%= is_today ? 'bg-brand-primary text-white font-semibold rounded-sm' : (in_month ? 'text-brand-primary' : 'text-[#C8A49A]') %>">
                    <%= day.day %>
                  </span>
                </button>
              <% end %>
            </div>
          <% end %>
          <div class="border-t border-brand-field"></div>
        </div>

        <a href="#" data-action="click->onboarding-calendar#clear"
           data-onboarding-calendar-target="clear"
           class="block text-center text-brand-primary text-sm hidden mt-4"><%= t('onboarding.step3.clear') %></a>

        <%= f.submit t('onboarding.step3.submit'),
            data: { onboarding_calendar_target: "submit" },
            class: "w-full h-[52px] bg-brand-primary text-white rounded-lg text-[22px] font-medium tracking-[0.66px] hidden mt-2" %>
      <% end %>

      <%= form_with url: onboarding_path(3), method: :patch, local: true do |f| %>
        <%= f.hidden_field :skip_last_period, value: "1" %>
        <%= f.submit t('onboarding.step3.unsure'),
            data: { onboarding_calendar_target: "skip" },
            class: "w-full h-[52px] bg-brand-primary text-white rounded-lg text-[22px] font-medium tracking-[0.66px] mt-2" %>
      <% end %>
    </div>

  <%# ── Step 4: Last day of last period ───────────────────────────── %>
  <% when 4 %>
    <%
      today      = Time.zone.today
      cal_year   = (params[:cal_year] || today.year).to_i
      cal_month_num = (params[:cal_month] || today.month).to_i
      cal_start  = Date.new(cal_year, cal_month_num, 1)
      cal_end    = cal_start.end_of_month
      start_pad  = (cal_start.wday - 1) % 7
      end_pad    = (7 - cal_end.wday) % 7
      cal_days   = (cal_start - start_pad)..(cal_end + end_pad)
    %>

    <div class="pt-4">
      <h2 class="text-brand-primary text-[22px] font-medium leading-tight mb-6">
        <%= t('onboarding.step4.heading', name: current_user.first_name) %>
      </h2>
    </div>

    <div class="flex-1">
      <%= form_with url: onboarding_path(4), method: :patch, local: true,
          data: { controller: "onboarding-calendar" } do |f| %>
        <%= f.hidden_field :last_period_end, value: "",
            data: { onboarding_calendar_target: "input" } %>

        <div class="flex items-center justify-between mb-2">
          <a href="<%= onboarding_path(4, cal_year: (cal_start - 1.month).year, cal_month: (cal_start - 1.month).month) %>"
             class="text-brand-primary text-sm font-medium px-1">&lt;</a>
          <span class="text-brand-primary text-sm font-medium">
            <%= cal_start.strftime("%B %Y") %>
          </span>
          <a href="<%= onboarding_path(4, cal_year: (cal_start + 1.month).year, cal_month: (cal_start + 1.month).month) %>"
             class="text-brand-primary text-sm font-medium px-1">&gt;</a>
        </div>

        <%# Weekday headers %>
        <div class="grid grid-cols-7 mb-1">
          <% %w[Mo Tu We Th Fr Sa Su].each do |d| %>
            <div class="text-center text-brand-secondary text-xs font-semibold tracking-wider py-1"><%= d %></div>
          <% end %>
        </div>

        <div>
          <% cal_days.each_slice(7).each do |week| %>
            <div class="border-t border-brand-field"></div>
            <div class="grid grid-cols-7">
              <% week.each do |day| %>
                <%
                  in_month = day.month == cal_start.month
                  is_today = day == today
                %>
                <button type="button"
                     data-action="click->onboarding-calendar#select"
                     data-onboarding-calendar-target="day"
                     data-date="<%= day.iso8601 %>"
                     data-in-month="<%= in_month %>"
                     data-today="<%= is_today %>"
                     class="cal-day flex flex-col items-center py-3 cursor-pointer select-none bg-transparent border-none p-0">
                  <span class="text-sm w-8 h-8 flex items-center justify-center cal-day-label
                               <%= is_today ? 'bg-brand-primary text-white font-semibold rounded-sm' : (in_month ? 'text-brand-primary' : 'text-[#C8A49A]') %>">
                    <%= day.day %>
                  </span>
                </button>
              <% end %>
            </div>
          <% end %>
          <div class="border-t border-brand-field"></div>
        </div>

        <a href="#" data-action="click->onboarding-calendar#clear"
           data-onboarding-calendar-target="clear"
           class="block text-center text-brand-primary text-sm hidden mt-4"><%= t('onboarding.step4.clear') %></a>

        <%= f.submit t('onboarding.step4.submit'),
            data: { onboarding_calendar_target: "submit" },
            class: "w-full h-[52px] bg-brand-primary text-white rounded-lg text-[22px] font-medium tracking-[0.66px] hidden mt-2" %>
      <% end %>

      <%= form_with url: onboarding_path(4), method: :patch, local: true do |f| %>
        <%= f.hidden_field :skip_last_period, value: "1" %>
        <%= f.submit t('onboarding.step4.unsure'),
            data: { onboarding_calendar_target: "skip" },
            class: "w-full h-[52px] bg-brand-primary text-white rounded-lg text-[22px] font-medium tracking-[0.66px] mt-2" %>
      <% end %>
    </div>

  <%# ── Step 5: Regular cycle? ────────────────────────────────────── %>
  <% when 5 %>
    <div class="mt-[113px]">
      <h2 class="text-brand-primary text-[22px] font-medium leading-[27px] tracking-[1.32px] mb-[43px]">
        <%= t('onboarding.step5.heading') %>
      </h2>

      <div class="flex flex-col gap-3 items-center">
        <%= form_with url: onboarding_path(5), method: :patch, local: true do |f| %>
          <%= f.hidden_field :has_regular_cycle, value: "true" %>
          <%= f.submit t('onboarding.step5.yes'),
              class: "w-[322px] h-[52px] bg-brand-primary text-white rounded-lg text-[22px] font-medium tracking-[0.66px] cursor-pointer" %>
        <% end %>

        <%= form_with url: onboarding_path(5), method: :patch, local: true do |f| %>
          <%= f.hidden_field :has_regular_cycle, value: "false" %>
          <%= f.submit t('onboarding.step5.no'),
              class: "w-[322px] bg-transparent text-brand-primary py-4 text-[22px] font-medium tracking-[0.66px] cursor-pointer border-none" %>
        <% end %>
      </div>
    </div>
    <div class="flex-1"></div>

  <%# ── Step 6: Cycle length (scroll picker) ──────────────────────── %>
  <% when 6 %>
    <% if @no_regular_cycle %>
      <div id="no-problem-modal" role="dialog" aria-modal="true" aria-labelledby="no-problem-title"
           class="fixed inset-0 bg-black/40 flex items-center justify-center z-50 px-8">
        <div class="bg-brand-background rounded-2xl px-8 py-10 text-center max-w-[340px] w-full">
          <h3 id="no-problem-title" class="text-brand-primary text-2xl font-medium mb-4"><%= t('onboarding.step6.no_problem_title') %></h3>
          <p class="text-brand-primary text-sm leading-relaxed mb-8">
            <%= t('onboarding.step6.no_problem_body') %>
          </p>
          <button id="no-problem-ok" onclick="document.getElementById('no-problem-modal').remove()"
                  class="w-full h-12 bg-brand-primary text-white rounded-lg text-xl font-medium">
            <%= t('onboarding.step6.no_problem_ok') %>
          </button>
        </div>
      </div>
      <script nonce="<%= content_security_policy_nonce %>">
        (function() {
          var modal = document.getElementById('no-problem-modal');
          if (!modal) return;
          var btn = document.getElementById('no-problem-ok');
          if (btn) btn.focus();
          modal.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') modal.remove();
          });
        })();
      </script>
    <% end %>

    <div class="mt-[113px]">
      <h2 class="text-brand-primary text-[22px] font-medium leading-[27px] tracking-[1.32px] mb-1">
        <%= t('onboarding.step6.heading') %>
      </h2>
      <p class="text-brand-secondary text-sm mb-10"><%= t('onboarding.step6.note') %></p>

      <%= form_with url: onboarding_path(6), method: :patch, id: "step6-form", local: true,
          data: { controller: "onboarding-picker" } do |f| %>
        <%= f.hidden_field :cycle_length, id: "cycle_length_value", value: "28",
            data: { onboarding_picker_target: "input" } %>

        <div class="relative flex justify-center overflow-hidden" style="height:210px;">
          <div class="absolute left-0 right-0 bg-brand-field rounded-lg pointer-events-none"
               style="top:84px; height:42px;"></div>

          <div data-onboarding-picker-target="track"
               role="listbox" aria-label="Cycle length in days" aria-activedescendant="cycle-day-28"
               tabindex="0"
               class="relative overflow-y-scroll flex flex-col items-center"
               style="height:210px; scroll-snap-type:y mandatory; -webkit-overflow-scrolling:touch; scrollbar-width:none;">
            <div style="min-height:84px; flex-shrink:0;"></div>
            <% (20..45).each do |d| %>
              <div id="cycle-day-<%= d %>"
                   role="option" aria-selected="<%= d == 28 ? 'true' : 'false' %>"
                   data-days="<%= d %>"
                   class="cycle-day-item flex items-center justify-center text-brand-primary font-medium cursor-pointer flex-shrink-0"
                   style="height:42px; min-height:42px; scroll-snap-align:center; font-size:16px; opacity:0.45;">
                <%= d %> <%= t('onboarding.step6.days_suffix') %>
              </div>
            <% end %>
            <div style="min-height:84px; flex-shrink:0;"></div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="flex-1"></div>

    <div class="w-full flex flex-col gap-3 items-center">
      <%= button_tag t('onboarding.step6.submit'), form: "step6-form", type: "submit",
          class: "w-[322px] h-[52px] bg-brand-primary text-white rounded-lg text-[22px] font-medium tracking-[0.66px]" %>

      <%# TODO: Auto-calculate cycle length from user's tracking data over time %>
      <%= form_with url: onboarding_path(6), method: :patch, local: true do |f| %>
        <%= f.hidden_field :skip_cycle_length, value: "1" %>
        <%= f.submit t('onboarding.step6.not_sure'),
            class: "w-[322px] bg-transparent text-brand-primary py-3 text-[22px] font-medium tracking-[0.66px] cursor-pointer border-none" %>
      <% end %>
    </div>

  <%# ── Step 7: Hormonal birth control? ───────────────────────────── %>
  <% when 7 %>
    <div class="mt-[113px]">
      <h2 class="text-brand-primary text-[22px] font-medium leading-[27px] tracking-[1.32px] mb-[43px]">
        <%= t('onboarding.step7.heading') %>
      </h2>

      <div class="flex flex-col gap-3 items-center">
        <%= form_with url: onboarding_path(7), method: :patch, local: true do |f| %>
          <%= f.hidden_field :uses_hormonal_birth_control, value: "true" %>
          <%= f.submit t('onboarding.step7.yes'),
              class: "w-[322px] h-[52px] bg-brand-primary text-white rounded-lg text-[22px] font-medium tracking-[0.66px] cursor-pointer" %>
        <% end %>

        <%= form_with url: onboarding_path(7), method: :patch, local: true do |f| %>
          <%= f.hidden_field :uses_hormonal_birth_control, value: "false" %>
          <%= f.submit t('onboarding.step7.no'),
              class: "w-[322px] bg-transparent text-brand-primary py-4 text-[22px] font-medium tracking-[0.66px] cursor-pointer border-none" %>
        <% end %>
      </div>

    </div>
    <div class="flex-1"></div>

    <div class="w-full max-w-80">
      <p class="text-brand-primary text-sm leading-relaxed">
        <%= t('onboarding.step7.info') %>
      </p>
    </div>

  <%# ── Step 8: Birth control reminder ────────────────────────────── %>
  <% when 8 %>
    <div class="mt-[113px]">
      <h2 class="text-brand-primary text-[22px] font-medium leading-[27px] tracking-[1.32px] mb-[43px]">
        <%= t('onboarding.step8.heading') %>
      </h2>

      <div class="flex flex-col gap-3 items-center">
        <%= form_with url: onboarding_path(8), method: :patch, local: true do |f| %>
          <%= f.hidden_field :birth_control_reminder, value: "true" %>
          <%= f.submit t('onboarding.step8.yes'),
              class: "w-[322px] h-[52px] bg-brand-primary text-white rounded-lg text-[22px] font-medium tracking-[0.66px] cursor-pointer" %>
        <% end %>

        <%= form_with url: onboarding_path(8), method: :patch, local: true do |f| %>
          <%= f.hidden_field :birth_control_reminder, value: "false" %>
          <%= f.submit t('onboarding.step8.no'),
              class: "w-[322px] bg-transparent text-brand-primary py-4 text-[22px] font-medium tracking-[0.66px] cursor-pointer border-none" %>
        <% end %>
      </div>
    </div>
    <div class="flex-1"></div>

  <%# ── Step 9: Birth control method ──────────────────────────────── %>
  <%# TODO: On submit, redirect to Settings for reminder setup instead of next step %>
  <% when 9 %>
    <div class="mt-[113px]">
      <h2 class="text-brand-primary text-[22px] font-medium leading-[27px] tracking-[1.32px] mb-[43px]">
        <%= t('onboarding.step9.heading') %>
      </h2>

      <div class="flex flex-col gap-3 items-center">
        <% t('onboarding.step9.methods').each_with_index do |method_label, idx| %>
          <%= form_with url: onboarding_path(9), method: :patch, local: true do |f| %>
            <%= f.hidden_field :birth_control_method, value: method_label %>
            <%= f.submit method_label,
                class: "w-[322px] h-[52px] bg-brand-field text-brand-primary rounded-lg text-[22px] font-medium tracking-[0.66px] cursor-pointer" %>
          <% end %>
        <% end %>
      </div>
    </div>

  <%# ── Step 10: Cycle stage reminder ─────────────────────────────── %>
  <% when 10 %>
    <div class="mt-[113px]">
      <div class="flex justify-center mb-6">
        <svg class="w-14 h-14 text-brand-primary" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
        </svg>
      </div>

      <h2 class="text-brand-primary text-[22px] font-medium leading-[27px] tracking-[1.32px] mb-[43px]">
        <%= t('onboarding.step10.heading') %>
      </h2>
      <p class="text-brand-primary text-sm leading-relaxed">
        <%= t('onboarding.step10.body') %>
      </p>
    </div>

    <div class="flex-1"></div>

    <div class="w-full flex flex-col gap-3 items-center">
      <%= form_with url: onboarding_path(10), method: :patch, local: true do |f| %>
        <%= f.submit t('onboarding.step10.submit'),
            class: "w-[322px] h-[52px] bg-brand-primary text-white rounded-lg text-[22px] font-medium tracking-[0.66px] cursor-pointer" %>
      <% end %>

      <%= form_with url: onboarding_path(10), method: :patch, local: true do |f| %>
        <%= f.hidden_field :skip_reminder, value: "1" %>
        <%= f.submit t('onboarding.step10.maybe_later'),
            class: "w-[322px] bg-transparent text-brand-primary py-3 text-[22px] font-medium tracking-[0.66px] cursor-pointer border-none" %>
      <% end %>
    </div>

  <%# ── Step 11: Food preferences ─────────────────────────────────── %>
  <% when 11 %>
    <div class="mt-[113px]">
      <h2 class="text-brand-primary text-[22px] font-medium leading-[27px] tracking-[1.32px] mb-[43px]">
        <%= t('onboarding.step11.heading_html', name: current_user.first_name) %>
      </h2>

      <div class="flex flex-col gap-3 items-center">
        <% t('onboarding.step11.foods').each do |pref| %>
          <%= form_with url: onboarding_path(11), method: :patch, local: true do |f| %>
            <%= f.hidden_field :food_preference, value: pref %>
            <%= f.submit pref,
                class: "w-[322px] h-[52px] bg-brand-field text-brand-primary rounded-lg text-[22px] font-medium tracking-[0.66px] cursor-pointer" %>
          <% end %>
        <% end %>
      </div>
    </div>

  <% end %>
</div>
