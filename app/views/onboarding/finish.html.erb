<meta name="turbo-cache-control" content="no-cache">

<div class="min-h-screen bg-white flex flex-col items-center justify-center px-6">
  <div class="w-80 h-96">
    <%= image_tag 'ef5a97eb1ce5997f5ce9b1a64aeafe4e00026251.gif',
        class: 'w-full h-full object-contain',
        alt: t('.animation_alt') %>
  </div>

  <p class="mt-10 text-center text-brand-primary text-22 leading-[32px] font-medium tracking-wide max-w-[320px]">
    <%= t('.message') %>
  </p>
</div>

<script nonce="<%= content_security_policy_nonce %>">
  // This page is always reached via a Turbo Drive visit (redirected from the
  // final onboarding step's form submission), so 'DOMContentLoaded' never
  // fires here — Turbo swaps the body without a full page load. 'turbo:load'
  // fires on every Turbo-driven visit (and on a true fresh load too).
  document.addEventListener('turbo:load', function() {
    setTimeout(function() {
      window.location.href = <%= raw calendar_path.to_json %>;
    }, 1500);
  }, { once: true });
</script>
