<% content_for(:page_title) do %>
  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="white" stroke-width="1.5" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="9" />
    <line x1="12" y1="11" x2="12" y2="16" />
    <circle cx="12" cy="7.5" r="0.75" fill="white" stroke="none" />
  </svg>
  Information
<% end %>
<% content_for(:hide_quick_actions) { "true" } %>
<%# Every non-settings sub-page gets the centred calendar button (see
     shared/_calendar_center_fab.html.erb) instead of the default
     bottom-right one. %>
<% content_for(:hide_calendar_fab) { "true" } %>
<% content_for(:header_dark) { "true" } %>
<% phase_colour = @meta[:colour] %>
<% content_for(:header_color) { phase_colour || "#933a35" } %>

<div class="bg-white min-h-screen pb-20">
  <div class="max-w-app mx-auto px-4 pt-6 pb-10">

    <div class="mb-6">
      <%# Falls back to the phase list when there's no in-app history to go back to
          (deep link, native push into a fresh WebView, opened in a new tab, etc.) %>
      <a href="<%= information_path %>"
         onclick="if (window.history.length > 1) { window.history.back(); return false; }"
         class="text-brand-primary no-underline text-base font-normal">
        &lt; back
      </a>
    </div>

    <%# Section 1: Phase title + hormone note %>
    <div class="mb-12">
      <div class="flex items-center justify-between gap-4 mb-3">
        <h1 class="text-base font-bold" style="color: <%= phase_colour %>;">
          <%= @phase == "menstrual" ? "Menstruation" : @phase.capitalize %> / <%= @meta[:season] %>
        </h1>
        <p class="text-sm font-normal shrink-0" style="color: <%= phase_colour %>; opacity: 0.7;">
          <%= @meta[:days] %>
        </p>
      </div>
      <div class="border-t border-gray-200 mb-4"></div>
      <% hormone_text = @meta[:note].presence %>
      <% if hormone_text %>
        <p class="text-base font-medium leading-relaxed" style="color: <%= phase_colour %>;">
          <%= hormone_text %>
        </p>
      <% end %>
    </div>

    <%# Section 2: Emotional world %>
    <div class="mb-12">
      <h2 class="text-base font-bold mb-3" style="color: <%= phase_colour %>;">Emotional world</h2>
      <div class="border-t border-gray-200 mb-4"></div>
      <% if @content&.mood_text.present? %>
        <p class="text-base font-medium leading-relaxed" style="color: <%= phase_colour %>;">
          <%= @content.mood_text %>
        </p>
      <% end %>
    </div>

    <%# Section 3: That will do you good %>
    <div class="mb-12">
      <h2 class="text-base font-bold mb-3" style="color: <%= phase_colour %>;">That will do you good</h2>
      <div class="border-t border-gray-200 mb-4"></div>
      <% if @content&.take_care_text.present? %>
        <p class="text-base font-medium leading-relaxed" style="color: <%= phase_colour %>;">
          <%= @content.take_care_text %>
        </p>
      <% end %>
    </div>

  </div>
</div>

<%= render "shared/calendar_center_fab", bg: "bg-brand-field" %>
