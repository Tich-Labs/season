<% content_for(:page_title) do %>
  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="white" stroke-width="1.5" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="9" />
    <line x1="12" y1="11" x2="12" y2="16" />
    <circle cx="12" cy="7.5" r="0.75" fill="white" stroke="none" />
  </svg>
  Information
<% end %>
<% content_for(:hide_quick_actions) { true } %>
<% content_for(:header_dark) { "true" } %>
<% content_for(:header_color) { "#933a35" } %>

<div class="bg-brand-background min-h-screen pb-20">
  <div class="max-w-app mx-auto px-4 pt-6 pb-10">

    <div class="mb-6">
      <%# Falls back to the calendar when there's no in-app history to go back to
          (deep link, native push into a fresh WebView, opened in a new tab, etc.) %>
      <a href="<%= user_root_path %>"
         onclick="if (window.history.length > 1) { window.history.back(); return false; }"
         class="text-brand-primary no-underline text-base font-normal">
        &lt; back
      </a>
    </div>

    <%# Header %>
    <div class="mb-6">
      <h1 class="text-3xl font-semibold text-brand-primary tracking-tight">Your cycle phases</h1>
      <p class="mt-2 text-sm text-brand-secondary max-w-xl">Learn about each phase of your cycle and how it affects your body and mind.</p>
    </div>

    <%# Phase cards %>
    <div class="space-y-4">
      <% @phases.each do |item| %>
        <% meta    = item[:meta] %>
        <% content = item[:content] %>

        <%= link_to information_phase_path(item[:phase]), class: "block rounded-[26px] overflow-hidden bg-white border border-gray-200 shadow-sm transition hover:shadow-md" do %>
          <div class="p-5" style="background:<%= meta[:colour] %>;">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <p class="text-11 font-semibold uppercase tracking-[0.24em] text-white/85 mb-2"><%= meta[:days] %></p>
                <h2 class="text-xl font-bold text-white mb-1"><%= meta[:season] %></h2>
                <p class="text-sm text-white/90 capitalize"><%= item[:phase] %> phase</p>
              </div>
              <span class="text-4xl leading-none"><%= meta[:emoji] %></span>
            </div>
          </div>

          <div class="border-t border-gray-100 p-5 flex justify-end">
            <span class="text-xs font-semibold uppercase tracking-[0.24em] text-brand-primary">Read more →</span>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
