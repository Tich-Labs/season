<%# GDPR Consent screen - Article 9 %>
<% content_for(:header_left) do %>
  <%= link_to user_root_path, class: "p-2 flex items-center" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
      <line x1="19" y1="12" x2="5" y2="12" />
      <polyline points="12 19 5 12 12 5" />
    </svg>
  <% end %>
<% end %>

<div class="bg-white min-h-screen">
  <div class="max-w-app mx-auto px-2 pb-20">

    <%# Header %>
    <div class="py-5 border-b border-brand-divider mb-4">
      <h2 class="text-brand-primary text-lg font-bold"><%= t("consent.show.title") %></h2>
    </div>

    <%# Intro %>
    <div class="bg-brand-error rounded-xl p-4 mb-5">
      <p class="text-brand-primary text-sm font-medium m-0">
        <%= t("consent.show.intro") %>
      </p>
    </div>

    <%# Consent Form %>
    <%= form_with url: consent_settings_path, method: :post, local: true do %>
      <%# Health Data Processing %>
      <label class="flex items-start gap-3 p-4 bg-white border border-brand-divider rounded-xl mb-3 cursor-pointer">
        <input type="checkbox" name="consents[health_data_processing]"
               <%= current_user.consent?("health_data_processing") ? "checked" : "" %>
               class="w-5 h-5 accent-brand-primary mt-0.5 shrink-0">
        <div class="flex-1">
          <span class="block text-brand-primary text-sm font-semibold"><%= t("consent.show.health_data") %></span>
          <span class="block text-brand-secondary text-xs mt-1">
            <%= t("consent.show.health_data_desc") %>
          </span>
        </div>
      </label>

      <%# Symptom Tracking %>
      <label class="flex items-start gap-3 p-4 bg-white border border-brand-divider rounded-xl mb-3 cursor-pointer">
        <input type="checkbox" name="consents[symptom_tracking]"
               <%= current_user.consent?("symptom_tracking") ? "checked" : "" %>
               class="w-5 h-5 accent-brand-primary mt-0.5 shrink-0">
        <div class="flex-1">
          <span class="block text-brand-primary text-sm font-semibold"><%= t("consent.show.symptom_tracking") %></span>
          <span class="block text-brand-secondary text-xs mt-1">
            <%= t("consent.show.symptom_tracking_desc") %>
          </span>
        </div>
      </label>

      <%# Cycle Tracking %>
      <label class="flex items-start gap-3 p-4 bg-white border border-brand-divider rounded-xl mb-3 cursor-pointer">
        <input type="checkbox" name="consents[cycle_tracking]"
               <%= current_user.consent?("cycle_tracking") ? "checked" : "" %>
               class="w-5 h-5 accent-brand-primary mt-0.5 shrink-0">
        <div class="flex-1">
          <span class="block text-brand-primary text-sm font-semibold"><%= t("consent.show.cycle_tracking") %></span>
          <span class="block text-brand-secondary text-xs mt-1">
            <%= t("consent.show.cycle_tracking_desc") %>
          </span>
        </div>
      </label>

      <%# Menstrual Data %>
      <label class="flex items-start gap-3 p-4 bg-white border border-brand-divider rounded-xl mb-5 cursor-pointer">
        <input type="checkbox" name="consents[menstrual_data]"
               <%= current_user.consent?("menstrual_data") ? "checked" : "" %>
               class="w-5 h-5 accent-brand-primary mt-0.5 shrink-0">
        <div class="flex-1">
          <span class="block text-brand-primary text-sm font-semibold"><%= t("consent.show.menstrual_data") %></span>
          <span class="block text-brand-secondary text-xs mt-1">
            <%= t("consent.show.menstrual_data_desc") %>
          </span>
        </div>
      </label>

      <button type="submit" class="w-full bg-brand-primary text-white rounded-xl p-4 text-base font-medium">
        <%= t("consent.show.save_preferences") %>
      </button>
    <% end %>

    <%# Info text %>
    <div class="mt-6 p-4 bg-brand-background rounded-xl">
      <p class="text-brand-secondary text-xs leading-relaxed m-0">
        <strong class="text-brand-primary"><%= t("consent.show.your_rights") %></strong><br>
        <%= t("consent.show.rights_text") %>
      </p>
    </div>

    <%# Link to Privacy Policy %>
    <%= link_to t("consent.show.view_privacy"), privacy_legal_path,
          class: "block text-center text-brand-primary text-sm mt-4 underline" %>

  </div>
</div>
