<%#
   Locals:
     date            — the Date for this cell
     current_month   — Integer month of the displayed grid
     events_by_date  — Hash<Date, Array<CalendarEvent>>
     tracked_days_set— Set<Date>
     cycle_by_date   — Hash<Date, Hash> with keys :colour, :phase, etc.
     mode            — String "all"|"events"|"tracking"|"cycle"
     show_moonphases — Boolean from user preference
     show_holidays   — Boolean from user preference
     show_week_numbers— Boolean from user preference

   Layout (matches Figma node 12055:13821):
     1. Full-bleed 11px phase band at the very top (no padding)
     2. Day number below — coloured by cycle phase, or white pill for today
     3. Event label pills (named, truncated) below the number
     4. Tracking dot at bottom if tracked
     Column gap on parent grid MUST be 0 so adjacent phase bands merge.
%>

<% is_today     = date == Time.zone.today %>
<% in_month     = date.month == current_month %>
<% has_event    = events_by_date.key?(date) %>
<% events_today = events_by_date[date] || [] %>
<% is_tracked   = tracked_days_set.include?(date) %>
<% cycle_data   = cycle_by_date[date] %>
<% phase_colour = cycle_data&.dig(:colour) %>
<% cycle_day    = cycle_data&.dig(:cycle_day) %>
<% lunar        = moon_phase(date) if local_assigns[:show_moonphases] %>
<% holiday_name = local_assigns[:show_holidays] ? local_assigns[:holidays_by_date]&.dig(date) : nil %>
<% week_num     = local_assigns[:show_week_numbers] && date.cwday == 1 ? date.cweek : nil %>

<%# ── Phase band colour (full-bleed top strip) ── %>
<% band_colour =
     case mode
     when "cycle"    then phase_colour
     when "tracking" then is_tracked ? "#2E6B3E" : nil
     when "events"   then nil
     else                 phase_colour   # "all": show cycle phase
     end %>

<%# ── Day number colour ── %>
<% num_colour = if !in_month     then "#C4B8B8"
               elsif phase_colour then phase_colour
               else                    "#1A1A1A"
               end %>
<% num_weight = in_month ? "600" : "400" %>

<% show_events   = mode == "all" || mode == "events" %>
<% show_tracking = mode == "all" || mode == "tracking" %>

<a href="<%= forecast_path(date: date.to_s) %>"
   style="display:flex; flex-direction:column; text-decoration:none; height:100%; overflow:hidden;<%= in_month ? '' : ' opacity:0.45;' %>">

  <%# ── Phase band: full-bleed, 14px, #EDE1D5 fallback bg ── %>
  <div style="height:14px; flex-shrink:0; display:flex; align-items:center; justify-content:center; background:<%= band_colour || '#EDE1D5' %>;">
    <% if local_assigns[:show_cycle_day_on_band] && cycle_day %>
      <span style="color:#FFFFFF; font-size:9px; font-weight:700; line-height:1; letter-spacing:0.03em;"><%= cycle_day %></span>
    <% end %>
  </div>

  <%# ── Cell content ── %>
  <div style="flex:1; padding:<%= is_today ? '0' : '1px' %> 4px 3px; display:flex; flex-direction:column; gap:1px; overflow:hidden;">

    <%# Week number (top-left, small text) %>
    <% if week_num %>
      <span style="font-size:6px; color:#999; line-height:1; font-weight:500;"><%= week_num %></span>
    <% end %>

    <%# Day number — today gets a half-pill merging with phase band above %>
    <div style="display:flex; align-items:center; justify-content:center; gap:2px; flex-shrink:0;">
      <% if show_tracking && is_tracked %>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;">
          <circle cx="6.58203" cy="6.58203" r="6.58203" fill="<%= phase_colour || '#933a35' %>" />
          <line x1="2.50692" y1="7.25601" x2="4.86225" y2="9.61134" stroke="white" stroke-width="1.35512" stroke-linecap="round" />
          <line x1="5.02649" y1="9.54056" x2="10.6954" y2="3.8717" stroke="white" stroke-width="1.35512" stroke-linecap="round" />
        </svg>
      <% end %>
      <% if is_today %>
        <span style="display:inline-flex; align-items:center; justify-content:center; min-width:24px; height:24px; padding:0 4px; border-radius:0 0 12px 12px; background:<%= phase_colour || '#933a35' %>; color:#FFFFFF; font-size:12px; font-weight:700; line-height:1; box-sizing:border-box; flex-shrink:0;">
          <%= date.day %>
        </span>
      <% else %>
        <span style="display:block; text-align:center; font-size:13px; font-weight:<%= num_weight %>; color:<%= num_colour %>; line-height:1; flex-shrink:0;">
          <%= date.day %>
        </span>
      <% end %>
    </div>

    <%# Holiday dot indicator (localStorage overlay) — filled by holiday_controller via holidays:loaded %>
    <div data-holiday-date="<%= date.iso8601 %>"
         style="display:flex; align-items:center; justify-content:center; gap:2px; min-height:5px; flex-shrink:0;"></div>

    <%# Holiday indicator %>
    <% if holiday_name %>
      <div style="background:#FFD700; border-radius:2px; padding:1px 3px; overflow:hidden;">
        <span style="color:#333; font-size:6px; font-weight:600; white-space:nowrap; display:block; overflow:hidden; text-overflow:ellipsis; line-height:8px;"><%= holiday_name %></span>
      </div>
    <% end %>

    <%# Event labels — up to 2, rest collapsed to +N %>
    <% if show_events && has_event %>
      <% evt_colour = phase_colour || "#933a35" %>
      <div style="display:flex; flex-direction:column; gap:2px; margin-top:1px;">
        <% events_today.first(2).each do |evt| %>
          <div style="background:<%= evt_colour %>; border-radius:2px; padding:1px 3px; overflow:hidden;">
            <span style="color:#FFF; font-size:7px; font-weight:500; white-space:nowrap; display:block; overflow:hidden; text-overflow:ellipsis; line-height:9px;"><%= evt.title %></span>
          </div>
        <% end %>
        <% if events_today.size > 2 %>
          <span style="font-size:7px; font-weight:600; line-height:1; color:<%= evt_colour %>;">+<%= events_today.size - 2 %></span>
        <% end %>
      </div>
    <% end %>

    <%# Moon phase at bottom — small two-tone SVG icon, not a flat dot %>
    <div style="display:flex; align-items:center; justify-content:center; margin-top:auto; flex-shrink:0;">
      <% if local_assigns[:show_moonphases] && lunar == :full_moon %>
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Full moon" style="flex-shrink:0;">
          <circle cx="5" cy="5" r="4.5" fill="#F5D786" stroke="#B8933A" stroke-width="0.8" />
          <circle cx="6.3" cy="5.9" r="0.9" fill="#DCB765" />
        </svg>
      <% elsif local_assigns[:show_moonphases] && lunar == :new_moon %>
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="New moon" style="flex-shrink:0;">
          <path d="M6.5 1A4.5 4.5 0 1 0 6.5 9 3.6 3.6 0 0 1 6.5 1Z" fill="#4D4D4C" />
        </svg>
      <% end %>
    </div>

  </div>

</a>
