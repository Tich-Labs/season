<%
  app_page_title = @date.strftime("%B")
  app_phase_colour = CycleCalculatorService::PHASE_META[@current_phase]&.dig(:colour) || "#933a35"
%>
<% content_for(:page_title) { app_page_title } %>
<% content_for(:hide_calendar_fab) { "true" } %>
<% phase_color(app_phase_colour) %>
<% content_for(:header_left) do %>
  <button class="p-2" data-action="click->menu#open">
    <svg class="w-6 h-6 text-brand-primary" viewBox="0 0 24 24" fill="currentColor">
      <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" />
    </svg>
  </button>
<% end %>
<% content_for(:header_right) do %>
  <div class="flex items-center gap-1">
    <% if @cycle_by_date.present? %>
      <% today_data = @cycle_by_date[Time.zone.today] %>
      <% cycle_day = today_data&.dig(:cycle_day) %>
      <% if cycle_day %>
        <div class="flex items-center gap-1 bg-white px-2.5 py-1.5 rounded-full shrink-0">
          <svg width="14" height="17" viewBox="0 0 49 59" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M22.3284 2.02183C22.4593 1.94131 22.6147 1.94955 22.7381 2.04107C23.7366 2.78121 28.2868 6.32067 32.4203 12.2611C32.5759 12.4847 32.9074 12.4911 33.0716 12.2738C34.4048 10.5102 35.5312 9.40879 36.0088 8.97024C36.1489 8.84154 36.3557 8.83933 36.4959 8.96797C38.0496 10.3935 46.5386 18.8945 46.5387 34.4666V35.2733C46.5387 35.4128 46.5236 35.5498 46.5026 35.6834C46.3654 38.1946 45.8051 40.668 44.8405 42.9969C43.7206 45.7004 42.0795 48.1572 40.0104 50.2264C37.941 52.2957 35.4836 53.9375 32.7799 55.0575C30.0762 56.1773 27.178 56.7537 24.2516 56.7537C21.3251 56.7537 18.4269 56.1773 15.7233 55.0575C13.0196 53.9375 10.5631 52.2957 8.49377 50.2264C6.4245 48.1571 4.78266 45.7005 3.66272 42.9969C2.61276 40.4621 2.04069 37.7562 1.97327 35.0164L1.96643 34.4686C1.9671 15.121 20.1647 3.35268 22.3284 2.02183Z" fill="#933A35"/>
            <path fill-rule="evenodd" clip-rule="evenodd" d="M24.0291 26.0535C24.1635 25.9525 24.3325 25.9526 24.4669 26.0537C26.0719 27.2602 35.9631 35.0647 36.2401 44.3519C36.2443 44.4838 36.2479 44.6163 36.2479 44.7493C36.2479 51.3767 30.8752 56.7493 24.2479 56.7493C17.6206 56.7493 12.2479 51.3766 12.2479 44.7493C12.2479 44.6163 12.2504 44.4838 12.2547 44.3519C12.5316 35.0646 22.4239 27.2601 24.0291 26.0535Z" fill="#EDE1D5"/>
          </svg>
          <span class="text-brand-primary text-[10px] font-normal"><%= cycle_day %> Day</span>
        </div>
      <% end %>
    <% end %>

    <a class="w-6 h-6 flex items-center justify-center rounded-lg border border-brand-primary text-brand-primary text-[9px] font-semibold shrink-0" href="/settings/language">
      EN
    </a>

    <div data-controller="calendar-menu" class="relative">
      <button data-action="click->calendar-menu#toggle"
            class="w-6 h-6 flex items-center justify-center rounded-lg border border-brand-primary shrink-0">
        <svg class="w-3 h-3 text-brand-primary" viewBox="0 0 23 23" fill="none" stroke="currentColor" stroke-width="1.4375" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16.4348 13.2442L13.5214 16.1575" />
          <path d="M6.56415 13.2442H16.435" />
          <path d="M6.56439 9.7555L9.47773 6.84216" />
          <path d="M16.4349 9.75557H6.56409" />
        </svg>
      </button>

      <div data-calendar-menu-target="backdrop"
           class="hidden fixed inset-0 z-50"
           data-action="click->calendar-menu#close">
        <div data-calendar-menu-target="panel"
             class="absolute shadow-xl"
             style="right:0; top:calc(3.5rem + env(safe-area-inset-top, 0px)); width:268px; background:#EDE1D5; border-radius:0 0 0 40px; transform:translateX(100%); transition:transform 250ms ease-out;">
          <div class="py-2">
            <%= link_to calendar_appointments_path,
                  class: "flex items-center gap-4 px-6 py-3 hover:bg-brand-primary/5 no-underline",
                  data: { turbo_action: "replace", action: "click->calendar-menu#close" } do %>
              <div class="flex flex-col gap-[1.5px] shrink-0" style="width:20px;">
                <div class="flex gap-[1px] items-center"><div class="w-[3px] h-[4px] bg-brand-primary rounded-[0.8px]"></div><div class="w-[15px] h-[4px] bg-brand-primary rounded-[0.8px]"></div></div>
                <div class="flex gap-[1px] items-center"><div class="w-[3px] h-[4.5px] bg-brand-primary rounded-[0.8px]"></div><div class="w-[15px] h-[4.5px] bg-brand-primary rounded-[0.8px]"></div></div>
                <div class="flex gap-[1px] items-center"><div class="w-[3px] h-[4px] bg-brand-primary rounded-[0.8px]"></div><div class="w-[15px] h-[4px] bg-brand-primary rounded-[0.8px]"></div></div>
              </div>
              <span class="text-brand-primary text-base font-medium"><%= t("nav.menu.schedule_overview") %></span>
            <% end %>

            <%= link_to daily_view_path(Time.zone.today),
                  class: "flex items-center gap-4 px-6 py-3 hover:bg-brand-primary/5 no-underline",
                  data: { turbo_action: "replace", action: "click->calendar-menu#close" } do %>
              <div class="flex flex-col gap-[1px] shrink-0" style="width:20px;">
                <div class="w-[19px] h-[2.5px] bg-brand-primary rounded-[0.8px]"></div>
                <div class="w-[19px] h-[8px] bg-brand-primary rounded-[0.8px]"></div>
                <div class="w-[19px] h-[2.5px] bg-brand-primary rounded-[0.8px]"></div>
              </div>
              <span class="text-brand-primary text-base font-medium"><%= t("nav.menu.day_view") %></span>
            <% end %>

            <%= link_to calendar_weekly_path,
                  class: "flex items-center gap-4 px-6 py-3 hover:bg-brand-primary/5 no-underline",
                  data: { turbo_action: "replace", action: "click->calendar-menu#close" } do %>
              <div class="flex gap-[1.4px] shrink-0" style="width:20px; height:16px;">
                <div class="w-[5.5px] h-[16px] bg-brand-primary rounded-[0.8px]"></div>
                <div class="w-[5.5px] h-[16px] bg-brand-primary rounded-[0.8px]"></div>
                <div class="w-[5.5px] h-[16px] bg-brand-primary rounded-[0.8px]"></div>
              </div>
              <span class="text-brand-primary text-base font-medium"><%= t("nav.menu.weekly_view") %></span>
            <% end %>

            <%= link_to user_root_path,
                  class: "flex items-center gap-4 px-6 py-3 hover:bg-brand-primary/5 no-underline",
                  data: { turbo_action: "replace", action: "click->calendar-menu#close" } do %>
              <div class="grid grid-cols-2 gap-[2px] shrink-0" style="width:19px; height:16px;">
                <div class="border border-brand-primary rounded-[0.8px]"></div>
                <div class="border border-brand-primary rounded-[0.8px]"></div>
                <div class="border border-brand-primary rounded-[0.8px]"></div>
                <div class="border border-brand-primary rounded-[0.8px]"></div>
              </div>
              <span class="text-brand-primary text-base font-medium"><%= t("nav.menu.monthly_view") %></span>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%= link_to information_path, class: "w-6 h-6 flex items-center justify-center rounded-full border border-brand-primary shrink-0 text-brand-primary" do %>
      <svg class="w-3.5 h-3.5" viewBox="0 0 25 25" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12.4998 8.33344V13.5418" stroke-width="1.7" />
        <path d="M12.4957 16.6667H12.5051" stroke-width="2" />
      </svg>
    <% end %>
  </div>
<% end %>

<% category_icon = ->(cat) {
  case cat&.downcase
  when /gym|exercise|sport|run|fitness|train|workout/
    '<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M13.49 5.48a2 2 0 100-4 2 2 0 000 4zm-3.6 13.9 1-4.4 2.1 2v6h2v-7.5l-2.1-2 .6-3c1.3 1.5 3.3 2.5 5.5 2.5v-2c-1.9 0-3.5-1-4.3-2.4l-1-1.6c-.4-.6-1-1-1.7-1-.3 0-.5.1-.8.1l-5.2 2.2v4.7h2v-3.4l1.8-.7-1.6 8.1-4.9-1-.4 2 7 1.4z"/></svg>'
  when /date|love|romantic|partner|couple|night|sex|intimate/
    '<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09A5.99 5.99 0 0 1 16.5 3C19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>'
  when /food|lunch|dinner|eat|restaurant|cafe|brunch|meal/
    '<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.66 3.84 3.75 3.97V22h2.5v-9.03C11.34 12.84 13 11.12 13 9V2h-2v7zm5-3v8h2.5v8H21V2c-2.76 0-5 2.24-5 4z"/></svg>'
  when /call|phone|meeting|video/
    '<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57A1 1 0 0121 16.5v3.49A1 1 0 0120 21 17 17 0 013 4a1 1 0 011-.99h3.5A1 1 0 018.5 4c0 1.25.2 2.45.57 3.57.11.35.03.74-.24 1.02l-2.21 2.2z"/></svg>'
  when /affirm|meditat|reflect|journal|mind/
    '<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>'
  else
    '<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 12a5 5 0 100-10 5 5 0 000 10zm0 2c-5.33 0-8 2.67-8 4v2h16v-2c0-1.33-2.67-4-8-4z"/></svg>'
  end
} %>

<div class="bg-white pb-32">
  <div class="max-w-app mx-auto pt-6 px-5">

    <% if @events_by_date.empty? %>
      <div class="flex flex-col items-center gap-3 py-40">
        <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="#EDE1D5" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg">
          <rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" />
        </svg>
        <p class="text-brand-muted text-base font-medium m-0">No appointments this month</p>
        <%= link_to new_calendar_event_path(date: @date), class: "mt-2 inline-flex items-center justify-center rounded-full bg-brand-primary px-4 py-2 text-white text-sm font-semibold no-underline" do %>
          + Add appointment
        <% end %>
      </div>
    <% else %>
      <div class="space-y-12 px-5">
        <% @events_by_date.each_with_index do |(date, events), day_idx| %>
          <% cycle_data   = @cycle_by_date[date] %>
          <% day_colour   = cycle_data&.dig(:colour) || "#933a35" %>

          <div class="day-group">
            <h2 class="text-[1.5rem] leading-[1.15] font-semibold font-sans mb-5" style="color:<%= day_colour %>">
              <%= date.strftime("%A, %-d. %B") %>
            </h2>

            <div class="flex gap-3">
              <div class="w-3 shrink-0 rounded-none" style="background:<%= day_colour %>"></div>

              <div class="flex-1 min-w-0">
                <% events.each_with_index do |event, idx| %>
                  <%= link_to edit_calendar_event_path(event), class: "block no-underline" do %>
                    <div class="flex items-center gap-5 py-2">
                      <div class="w-7 shrink-0 flex justify-center" style="color:<%= day_colour %>">
                        <%== category_icon.(event.category) %>
                      </div>
                      <div class="flex-1 min-w-0">
                        <p class="text-[1.125rem] leading-[1.2] font-medium font-sans truncate" style="color:<%= day_colour %>"><%= event.title %></p>
                      </div>
                      <div class="shrink-0">
                        <p class="text-base leading-[1.2] font-medium font-sans whitespace-nowrap" style="color:<%= day_colour %>;opacity:0.65">
                          <% if event.start_time %>
                            <%= event.start_time.strftime("%-H:%M") %><%= event.end_time ? " – #{event.end_time.strftime('%-H:%M')}" : "" %>
                          <% else %>
                            Ganztägig
                          <% end %>
                        </p>
                      </div>
                    </div>
                  <% end %>
                  <% if idx < events.length - 1 %>
                    <div class="ml-0 w-[337px] h-0 border-t" style="border-color:#000;opacity:0.5"></div>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
