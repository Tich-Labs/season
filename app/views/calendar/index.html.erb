<% cal_index_title = @date.strftime("%B") %>
<% content_for(:page_title) { cal_index_title } %>
<% content_for(:header_left) do %>
  <button class="p-2" data-action="click->menu#open">
    <svg class="w-6 h-6 text-brand-primary" viewBox="0 0 24 24" fill="currentColor">
      <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" />
    </svg>
  </button>
<% end %>
<% content_for(:header_right) do %>
  <div class="flex items-center gap-1">
    <% if @streak > 0 %>
      <div class="flex items-center gap-1 bg-white px-2.5 py-1.5 rounded-full shrink-0">
        <svg width="14" height="17" viewBox="0 0 49 59" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M22.3284 2.02183C22.4593 1.94131 22.6147 1.94955 22.7381 2.04107C23.7366 2.78121 28.2868 6.32067 32.4203 12.2611C32.5759 12.4847 32.9074 12.4911 33.0716 12.2738C34.4048 10.5102 35.5312 9.40879 36.0088 8.97024C36.1489 8.84154 36.3557 8.83933 36.4959 8.96797C38.0496 10.3935 46.5386 18.8945 46.5387 34.4666V35.2733C46.5387 35.4128 46.5236 35.5498 46.5026 35.6834C46.3654 38.1946 45.8051 40.668 44.8405 42.9969C43.7206 45.7004 42.0795 48.1572 40.0104 50.2264C37.941 52.2957 35.4836 53.9375 32.7799 55.0575C30.0762 56.1773 27.178 56.7537 24.2516 56.7537C21.3251 56.7537 18.4269 56.1773 15.7233 55.0575C13.0196 53.9375 10.5631 52.2957 8.49377 50.2264C6.4245 48.1571 4.78266 45.7005 3.66272 42.9969C2.61276 40.4621 2.04069 37.7562 1.97327 35.0164L1.96643 34.4686C1.9671 15.121 20.1647 3.35268 22.3284 2.02183Z" fill="#933A35" />
          <path fill-rule="evenodd" clip-rule="evenodd" d="M24.0291 26.0535C24.1635 25.9525 24.3325 25.9526 24.4669 26.0537C26.0719 27.2602 35.9631 35.0647 36.2401 44.3519C36.2443 44.4838 36.2479 44.6163 36.2479 44.7493C36.2479 51.3767 30.8752 56.7493 24.2479 56.7493C17.6206 56.7493 12.2479 51.3766 12.2479 44.7493C12.2479 44.6163 12.2504 44.4838 12.2547 44.3519C12.5316 35.0646 22.4239 27.2601 24.0291 26.0535Z" fill="#EDE1D5" />
        </svg>
        <span class="text-brand-primary text-[10px] font-normal"><%= @streak %> <%= t("calendar.index.streak_days", count: @streak) %></span>
      </div>
    <% end %>

    <%= link_to settings_language_path,
          class: "w-6 h-6 flex items-center justify-center rounded-lg border border-brand-primary text-brand-primary text-[9px] font-semibold shrink-0" do %>
      <%= I18n.locale.to_s.upcase %>
    <% end %>

    <!-- <%= link_to calendar_appointments_path,
          class: "w-9 h-9 flex items-center justify-center shrink-0" do %>
      <svg width="23" height="23" viewBox="0 0 23 23" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M8.62517 21.0834H14.3752C19.1668 21.0834 21.0835 19.1668 21.0835 14.3751V8.6251C21.0835 3.83343 19.1668 1.91676 14.3752 1.91676H8.62517C3.83351 1.91676 1.91684 3.83343 1.91684 8.6251V14.3751C1.91684 19.1668 3.83351 21.0834 8.62517 21.0834Z" stroke="#933A35" stroke-width="1.4375" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    <% end %> -->

    <div data-controller="calendar-menu" class="relative">
      <button data-action="click->calendar-menu#toggle"
            class="w-6 h-6 flex items-center justify-center rounded-lg border border-brand-primary shrink-0">
        <svg class="w-3 h-3 text-brand-primary" viewBox="0 0 23 23" fill="none" stroke="currentColor" stroke-width="1.4375" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16.4348 13.2442L13.5214 16.1575" />
          <path d="M6.56415 13.2442H16.435" />
          <path d="M6.56439 9.7555L9.47773 6.84216" />
          <path d="M16.4349 9.75557H6.56409" />
        </svg>
      </button>

      <div data-calendar-menu-target="backdrop"
           class="hidden fixed inset-0 z-50"
           data-action="click->calendar-menu#close">
        <div data-calendar-menu-target="panel"
             class="absolute shadow-xl"
             data-action="click->calendar-menu#stopPropagation"
             style="right:0; top:calc(3.5rem + env(safe-area-inset-top, 0px)); width:268px; background:#EDE1D5; border-radius:0 0 0 40px; transform:translateX(100%); transition:transform 250ms ease-out;">
          <div class="py-2">
            <%= link_to calendar_appointments_path,
                  class: "flex items-center gap-4 px-6 py-3 hover:bg-brand-primary/5 no-underline",
                  data: { turbo_action: "replace", action: "click->calendar-menu#close" } do %>
              <div class="flex flex-col gap-[1.5px] shrink-0" style="width:20px;">
                <div class="flex gap-[1px] items-center"><div class="w-[3px] h-[4px] bg-brand-primary rounded-[0.8px]"></div><div class="w-[15px] h-[4px] bg-brand-primary rounded-[0.8px]"></div></div>
                <div class="flex gap-[1px] items-center"><div class="w-[3px] h-[4.5px] bg-brand-primary rounded-[0.8px]"></div><div class="w-[15px] h-[4.5px] bg-brand-primary rounded-[0.8px]"></div></div>
                <div class="flex gap-[1px] items-center"><div class="w-[3px] h-[4px] bg-brand-primary rounded-[0.8px]"></div><div class="w-[15px] h-[4px] bg-brand-primary rounded-[0.8px]"></div></div>
              </div>
              <span class="text-brand-primary text-base font-medium"><%= t("nav.menu.schedule_overview") %></span>
            <% end %>

            <%= link_to daily_view_path(Time.zone.today),
                  class: "flex items-center gap-4 px-6 py-3 hover:bg-brand-primary/5 no-underline",
                  data: { turbo_action: "replace", action: "click->calendar-menu#close" } do %>
              <div class="flex flex-col gap-[1px] shrink-0" style="width:20px;">
                <div class="w-[19px] h-[2.5px] bg-brand-primary rounded-[0.8px]"></div>
                <div class="w-[19px] h-[8px] bg-brand-primary rounded-[0.8px]"></div>
                <div class="w-[19px] h-[2.5px] bg-brand-primary rounded-[0.8px]"></div>
              </div>
              <span class="text-brand-primary text-base font-medium"><%= t("nav.menu.day_view") %></span>
            <% end %>

            <%= link_to calendar_weekly_path,
                  class: "flex items-center gap-4 px-6 py-3 hover:bg-brand-primary/5 no-underline",
                  data: { turbo_action: "replace", action: "click->calendar-menu#close" } do %>
              <div class="flex gap-[1.4px] shrink-0" style="width:20px; height:16px;">
                <div class="w-[5.5px] h-[16px] bg-brand-primary rounded-[0.8px]"></div>
                <div class="w-[5.5px] h-[16px] bg-brand-primary rounded-[0.8px]"></div>
                <div class="w-[5.5px] h-[16px] bg-brand-primary rounded-[0.8px]"></div>
              </div>
              <span class="text-brand-primary text-base font-medium"><%= t("nav.menu.weekly_view") %></span>
            <% end %>

            <%= link_to user_root_path,
                  class: "flex items-center gap-4 px-6 py-3 hover:bg-brand-primary/5 no-underline",
                  data: { turbo_action: "replace", action: "click->calendar-menu#close" } do %>
              <%# table-fixed + border-collapse guarantees genuinely equal cells —
                  percentage-based absolute dividers don't, since left-1/3 resolves
                  against the padding box (inside the border), not the full width. %>
              <table class="table-fixed border-collapse rounded-[1px] shrink-0" style="width:18px; height:18px;">
                <tr><td class="border-[1.5px] border-brand-primary"></td><td class="border-[1.5px] border-brand-primary"></td><td class="border-[1.5px] border-brand-primary"></td></tr>
                <tr><td class="border-[1.5px] border-brand-primary"></td><td class="border-[1.5px] border-brand-primary"></td><td class="border-[1.5px] border-brand-primary"></td></tr>
                <tr><td class="border-[1.5px] border-brand-primary"></td><td class="border-[1.5px] border-brand-primary"></td><td class="border-[1.5px] border-brand-primary"></td></tr>
              </table>
              <span class="text-brand-primary text-base font-medium"><%= t("nav.menu.monthly_view") %></span>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%= link_to information_path, class: "w-6 h-6 flex items-center justify-center rounded-full border border-brand-primary shrink-0" do %>
      <svg class="w-3.5 h-3.5 text-brand-primary" viewBox="0 0 25 25" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12.4998 8.33344V13.5418" stroke-width="1.7" />
        <path d="M12.4957 16.6667H12.5051" stroke-width="2" />
      </svg>
    <% end %>
  </div>
<% end %>

<%# ── No-cycle banner (shown when user has no period data) ── %>
    <% if current_user.onboarding_completed? && current_user.last_period_start.nil? && current_user.period_starts.empty? %>
  <div class="bg-brand-error px-4 py-3 text-center border-b border-brand-primary">
      <p class="text-brand-primary text-sm mb-2">
        <%= t("calendar.index.no_period_data") %>
      </p>
      <a href="/tracking/period"
         class="inline-block bg-brand-primary text-white rounded-full px-4 py-2 text-sm font-semibold">
        <%= t("calendar.index.log_period_start") %>
      </a>
  </div>
<% end %>

<div class="bg-white min-h-screen pb-20">
  <div class="max-w-app mx-auto px-4 pt-3">

    <%# ── Greeting ── %>
    <div class="mb-3.5">
      <p class="text-brand-primary text-4xl font-medium m-0 leading-tight">
        <%= t("calendar.index.hello") %> <%= current_user.first_name || "there" %>
      </p>
      <p class="text-brand-primary text-base font-medium m-0">
        <%= t("calendar.index.subheading") %>
      </p>
    </div>

    <%# ── Filter chips (no JS — plain GET links). Each pill sizes to its own
         label (flex, not equal-width grid columns) so "Appointments" isn't
         squeezed against padding sized for "All"/"Cycle"; wraps if needed. ── %>
    <div class="flex flex-wrap gap-2 mb-4">
      <% [["all", t("calendar.index.filter_all")], ["events", t("calendar.index.filter_events")], ["tracking", t("calendar.index.filter_tracked")], ["cycle", t("calendar.index.filter_cycle")]].each do |value, label| %>
        <% active = @mode == value %>
        <%= link_to label,
              user_root_path(date: @date.to_s, mode: value),
              class: "text-center px-3 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap no-underline " +
                     (active ? "bg-brand-primary text-white" : "bg-white text-brand-primary border border-brand-primary") %>
      <% end %>
    </div>

    <%# ── Phase Legend ── %>
    <% if @cycle_by_date.present? %>
      <div class="flex gap-3 justify-start flex-wrap mb-3" data-controller="auto-hide" data-auto-hide-delay-value="50">
        <% CycleCalculatorService::PHASE_META.each do |phase, meta| %>
          <div class="flex items-center gap-1">
            <span class="w-2.5 h-2.5 rounded-full" style="background: <%= meta[:colour] %>;"></span>
            <span class="text-xs text-brand-secondary"><%= phase.titleize %></span>
          </div>
        <% end %>

      </div>
    <% end %>
  </div>

  <%# ── Day-of-week headers + calendar grid: full-bleed edge-to-edge, no horizontal padding ── %>
  <%# data-controller="holiday-dots": headless, paints dots per the Settings > Calendar preference %>
  <div class="max-w-app mx-auto" data-controller="holiday-dots">
    <% week_number_grid_style = "display:grid; grid-template-columns:#{@show_week_numbers ? "auto repeat(7, 1fr)" : "repeat(7, 1fr)"};" %>
    <div class="gap-0" style="<%= week_number_grid_style %>">
      <% if @show_week_numbers %>
        <div class="text-center py-1" style="min-width:18px;"></div>
      <% end %>
      <% %w[Mo Tu We Th Fr Sa Su].each do |d| %>
        <div class="text-center text-brand-secondary text-xs font-semibold tracking-wider py-1">
          <%= d %>
        </div>
      <% end %>
    </div>

    <%# ── Calendar grid: 85px rows, 0 column-gap so phase bands merge ── %>
    <%
      cols = @show_week_numbers ? 8 : 7
      cell_idx = 0
    %>
    <div class="auto-rows-calendar gap-x-0 gap-y-2" style="<%= week_number_grid_style %>">

      <%# All day cells — prev month tail + current month %>
      <% @calendar_dates.each do |date| %>
        <%# Week number column %>
        <% if @show_week_numbers && (cell_idx == 0 || (cell_idx > 0 && cell_idx % cols == 0)) %>
          <div style="display:flex; align-items:flex-start; height:100%; min-width:18px;"><div style="width:100%; height:14px; display:flex; align-items:center; justify-content:center; background:#EDE1D5; box-sizing:border-box; padding:0 2px;"><span style="color:#933A35; font-size:9px; font-weight:700; line-height:1; letter-spacing:0.03em;"><%= date.cweek %></span></div></div>
          <% cell_idx += 1 %>
        <% end %>
        <%= render "calendar/day_cell",
              date:                date,
              current_month:       @month,
              events_by_date:      @events_by_date,
              tracked_days_set:    @tracked_days_set,
              cycle_by_date:       @cycle_by_date,
              mode:                @mode,
              show_moonphases:     @show_moonphases,
              show_holidays:       @show_holidays,
              show_week_numbers:   false,
              show_cycle_day_on_band: @show_cycle_day_on_band %>
        <% cell_idx += 1 %>
      <% end %>

    </div>
  </div>
</div>

<%# Season Info Modal %>
<%
  phase = @current_phase
  season = @current_season || CycleCalculatorService::SEASON_NAMES[phase]
  cycle_day = current_user.streak&.current_streak

  # Colours come from CycleCalculatorService::PHASE_META (the single source
  # of truth, shared with the calendar bands/legend) rather than a second
  # hardcoded copy — a prior hardcoded copy here drifted to a stale palette
  # that no longer matched the rest of the calendar.
  season_info = case season
  when "Winter"
    { title: "Winter", colour: CycleCalculatorService::PHASE_META["menstrual"][:colour], emoji: "❄️",
      description: "This is your menstruation phase — a time for rest and reflection.",
      tips: ["Rest and prioritize sleep", "Gentle movement like yoga", "Stay hydrated"] }
  when "Spring"
    { title: "Spring", colour: CycleCalculatorService::PHASE_META["follicular"][:colour], emoji: "🌸",
      description: "You're in the follicular phase — energy and creativity are rising!",
      tips: ["Start new projects", "High energy workouts", "Social activities"] }
  when "Summer"
    { title: "Summer", colour: CycleCalculatorService::PHASE_META["ovulation"][:colour], emoji: "☀️",
      description: "You're ovulating — peak energy and confidence!",
      tips: ["Network and collaborate", "Creative brainstorming", "Focus on relationships"] }
  when "Autumn"
    { title: "Autumn", colour: CycleCalculatorService::PHASE_META["luteal"][:colour], emoji: "🍂",
      description: "You're in the luteal phase — time for introspection and planning.",
      tips: ["Organize and plan", "Self-care routines", "Reflect on goals"] }
  else
    { title: "Your Cycle", colour: CycleCalculatorService::PHASE_META["menstrual"][:colour], emoji: "🌙",
      description: "Track your cycle to see your phase.",
      tips: [] }
  end
%>

<div id="season-info-modal"
     role="dialog"
     aria-modal="true"
     aria-labelledby="season-modal-title"
     class="fixed inset-0 z-50 flex items-center justify-center hidden"
     data-controller="season-modal">
  <div data-season-modal-target="backdrop"
       class="fixed inset-0 bg-black/30 z-0"
       data-action="click->season-modal#close"></div>
  <div data-season-modal-target="modal" class="relative z-10 bg-brand-background rounded-2xl p-6 w-11/12 max-w-sm">
    <div class="text-center mb-4">
      <div class="w-16 h-16 rounded-full inline-flex items-center justify-center text-2xl mb-3" style="background: <%= season_info[:colour] %>;">
        <span aria-label="<%= season_info[:title].downcase %> phase emoji"><%= season_info[:emoji] %></span>
      </div>
      <h2 id="season-modal-title" class="text-brand-primary text-xl font-semibold m-0"><%= season_info[:title] %></h2>
      <p class="text-brand-secondary text-sm mt-1 mb-0"><%= t("forecast.index.you_are_in", phase: season_info[:title].downcase) %></p>
    </div>

      <p class="text-brand-primary text-sm leading-relaxed m-0 mb-4 text-center">
        <%= season_info[:description] %>
      </p>

      <% if season_info[:tips].any? %>
        <div class="bg-white rounded-lg p-3 mb-4">
          <p class="text-brand-primary text-xs font-semibold m-0 mb-2"><%= t("calendar.index.season_modal_tips") %></p>
        <ul class="m-0 pl-4">
          <% season_info[:tips].each do |tip| %>
            <li class="text-brand-secondary text-xs mb-1"><%= tip %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <button data-season-modal-target="closeBtn"
            data-action="click->season-modal#close"
            class="w-full bg-brand-primary text-white border-none rounded-lg px-4 py-3.5 text-base font-medium cursor-pointer focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-primary">
      <%= t("calendar.index.season_modal_got_it") %>
    </button>
  </div>
</div>
