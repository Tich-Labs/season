<% cal_index_phase_colour = @current_phase ? (CycleCalculatorService::PHASE_META[@current_phase]&.dig(:colour) || "#933a35") : "#933a35" %>
<% cal_index_text_colour = @current_phase ? (CycleCalculatorService::PHASE_META[@current_phase]&.dig(:text_colour) || "#FFFFFF") : "#FFFFFF" %>
<% cal_index_title = @date.strftime("%B") %>
<% content_for(:page_title) { cal_index_title } %>
<% content_for(:header_color) { cal_index_phase_colour } %>
<% content_for(:header_dark) { "true" } %>
<% content_for(:header_left) do %>
  <button class="p-2" data-action="click->menu#open">
    <svg class="w-6 h-6" style="color: <%= cal_index_text_colour %>;" viewBox="0 0 24 24" fill="currentColor">
      <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" />
    </svg>
  </button>
<% end %>
<% content_for(:header_center_dropdown) do %>
  <div class="relative" id="view-dropdown" data-controller="calendar-index">
    <button type="button" class="p-2" data-action="click->calendar-index#toggleDropdown">
      <svg class="w-5 h-5 text-brand-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 9l6 6 6-6" />
      </svg>
    </button>
    <div class="absolute left-0 top-full mt-1 w-40 bg-white rounded-lg shadow-lg hidden z-50"
         id="view-dropdown-menu">
      <%= link_to t("calendar.index.day_view"), daily_view_path(Time.zone.today), class: "block px-4 py-2 text-sm text-brand-primary hover:bg-brand-field", data: { turbo_action: "replace" } %>
      <%= link_to t("calendar.index.week_view"), calendar_weekly_path, class: "block px-4 py-2 text-sm text-brand-primary hover:bg-brand-field", data: { turbo_action: "replace" } %>
      <%= link_to t("calendar.index.month_view"), user_root_path, class: "block px-4 py-2 text-sm text-brand-primary hover:bg-brand-field", data: { turbo_action: "replace" } %>
    </div>
  </div>
<% end %>
<% content_for(:header_right) do %>
  <div class="flex items-center gap-2">
    <% if @streak > 0 %>
      <div class="flex items-center gap-1.5 bg-white px-3 py-1.5 rounded-full shrink-0">
        <span class="text-base leading-none">🔥</span>
        <span class="text-brand-primary text-xs font-semibold whitespace-nowrap"><%= @streak %> <%= t("calendar.index.day_streak") %></span>
      </div>
    <% end %>

    <%= link_to settings_language_path,
          class: "w-8 h-8 flex items-center justify-center rounded-md border text-xs font-semibold shrink-0",
          style: "border-color: #{cal_index_text_colour}; color: #{cal_index_text_colour};" do %>
      <%= I18n.locale.to_s.upcase %>
    <% end %>

    <%= link_to calendar_settings_path,
          class: "w-8 h-8 flex items-center justify-center shrink-0" do %>
      <svg class="w-5 h-5" style="color: <%= cal_index_text_colour %>;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17 2.1l4 4-4 4" />
        <path d="M3 12.6v-1a4 4 0 0 1 4-4h14" />
        <path d="M7 21.9l-4-4 4-4" />
        <path d="M21 11.4v1a4 4 0 0 1-4 4H3" />
      </svg>
    <% end %>

    <%= link_to informations_path, class: "w-8 h-8 flex items-center justify-center shrink-0" do %>
      <svg class="w-6 h-6" style="color: <%= cal_index_text_colour %>;" viewBox="0 0 25 25" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12.4998 22.9168C18.2289 22.9168 22.9164 18.2293 22.9164 12.5001C22.9164 6.77094 18.2289 2.08344 12.4998 2.08344C6.7706 2.08344 2.0831 6.77094 2.0831 12.5001C2.0831 18.2293 6.7706 22.9168 12.4998 22.9168Z" />
        <path d="M12.4998 8.33344V13.5418" stroke-width="1.7" />
        <path d="M12.4957 16.6667H12.5051" stroke-width="2" />
      </svg>
    <% end %>
  </div>
<% end %>

<%# ── No-cycle banner (shown when user has no period data) ── %>
<% if current_user.onboarding_completed? && current_user.last_period_start.nil? %>
  <div class="bg-brand-error px-4 py-3 text-center border-b border-brand-primary">
      <p class="text-brand-primary text-sm mb-2">
        <%= t("calendar.index.no_period_data") %>
      </p>
      <a href="/tracking/period"
         class="inline-block bg-brand-primary text-white rounded-full px-4 py-2 text-sm font-semibold">
        <%= t("calendar.index.log_period_start") %>
      </a>
  </div>
<% end %>

<div class="bg-white min-h-screen pb-20">
  <div class="max-w-app mx-auto px-4 pt-3">

    <%# ── Greeting ── %>
    <div class="mb-3.5">
      <p class="text-brand-primary text-4xl font-medium m-0 leading-tight font-montserrat">
        <%= t("calendar.index.hello") %> <%= current_user.first_name || "there" %>
      </p>
    </div>

    <%# ── Filter chips (no JS — plain GET links) ── %>
    <div class="flex gap-2 flex-wrap mb-4">
      <% [["all", t("calendar.index.filter_all")], ["events", t("calendar.index.filter_events")], ["tracking", t("calendar.index.filter_tracked")], ["cycle", t("calendar.index.filter_cycle")]].each do |value, label| %>
        <% active = @mode == value %>
        <%= link_to label,
              user_root_path(date: @date.to_s, mode: value),
              class: "px-3.5 py-1.5 rounded-full text-xs font-semibold no-underline " +
                     (active ? "bg-brand-primary text-white" : "bg-white text-brand-primary border border-brand-primary") %>
      <% end %>
    </div>

    <%# ── Day-of-week headers ── %>
    <div class="grid gap-0 mb-1.5 <%= @show_week_numbers ? 'grid-cols-8' : 'grid-cols-7' %>">
      <% if @show_week_numbers %>
        <div class="text-center text-brand-secondary text-xs font-semibold tracking-wider py-1"><%= t("calendar.index.wk") %></div>
      <% end %>
      <% %w[Mo Tu We Th Fr Sa Su].each do |d| %>
        <div class="text-center text-brand-secondary text-xs font-semibold tracking-wider py-1">
          <%= d %>
        </div>
      <% end %>
    </div>

    <%# ── Phase Legend ── %>
    <% if @cycle_by_date.present? %>
      <div class="flex gap-3 justify-center flex-wrap mb-3" data-controller="auto-hide" data-auto-hide-delay-value="50">
        <% CycleCalculatorService::PHASE_META.each do |phase, meta| %>
          <div class="flex items-center gap-1">
            <span class="w-2.5 h-2.5 rounded-full" style="background: <%= meta[:colour] %>;"></span>
            <span class="text-xs text-brand-secondary"><%= phase.titleize %></span>
          </div>
        <% end %>

      </div>
    <% end %>

    <%# ── Calendar grid: 85px rows, 0 column-gap so phase bands merge ── %>
    <%
      cols = @show_week_numbers ? 8 : 7
      cell_idx = 0
    %>
    <div class="grid auto-rows-calendar gap-x-0 gap-y-2 <%= cols == 8 ? 'grid-cols-8' : 'grid-cols-7' %>">

      <%# All day cells — prev month tail + current month %>
      <% @calendar_dates.each do |date| %>
        <%# Week number column %>
        <% if @show_week_numbers && (cell_idx == 0 || (cell_idx > 0 && cell_idx % cols == 0)) %>
          <div class="h-[18px] flex items-center justify-center text-[9px] font-semibold text-brand-secondary"><%= date.cweek %></div>
          <% cell_idx += 1 %>
        <% end %>
        <%= render "calendar/day_cell",
              date:                date,
              current_month:       @month,
              events_by_date:      @events_by_date,
              tracked_days_set:    @tracked_days_set,
              cycle_by_date:       @cycle_by_date,
              mode:                @mode,
              show_moonphases:     @show_moonphases,
              show_holidays:       @show_holidays,
              show_week_numbers:   false,
              show_cycle_day_on_band: @show_cycle_day_on_band %>
        <% cell_idx += 1 %>
      <% end %>

    </div>

  </div>
</div>

<%# Season Info Modal %>
<%
  phase = @current_phase
  season = @current_season || CycleCalculatorService::SEASON_NAMES[phase]
  cycle_day = current_user.streak&.current_streak

  season_info = case season
  when "Winter"
    { title: "Winter", colour: "#933a35", emoji: "❄️",
      description: "This is your menstruation phase — a time for rest and reflection.",
      tips: ["Rest and prioritize sleep", "Gentle movement like yoga", "Stay hydrated"] }
  when "Spring"
    { title: "Spring", colour: "#D18D83", emoji: "🌸",
      description: "You're in the follicular phase — energy and creativity are rising!",
      tips: ["Start new projects", "High energy workouts", "Social activities"] }
  when "Summer"
    { title: "Summer", colour: "#F5C6AD", emoji: "☀️",
      description: "You're ovulating — peak energy and confidence!",
      tips: ["Network and collaborate", "Creative brainstorming", "Focus on relationships"] }
  when "Autumn"
    { title: "Autumn", colour: "#EDE1D5", emoji: "🍂",
      description: "You're in the luteal phase — time for introspection and planning.",
      tips: ["Organize and plan", "Self-care routines", "Reflect on goals"] }
  else
    { title: "Your Cycle", colour: "#933a35", emoji: "🌙",
      description: "Track your cycle to see your phase.",
      tips: [] }
  end
%>

<div id="season-info-modal"
     role="dialog"
     aria-modal="true"
     aria-labelledby="season-modal-title"
     class="fixed inset-0 z-50 flex items-center justify-center hidden"
     data-controller="season-modal">
  <div data-season-modal-target="backdrop"
       class="fixed inset-0 bg-black/30 z-0"
       data-action="click->season-modal#close"></div>
  <div data-season-modal-target="modal" class="relative z-10 bg-brand-background rounded-2xl p-6 w-11/12 max-w-sm">
    <div class="text-center mb-4">
      <div class="w-16 h-16 rounded-full inline-flex items-center justify-center text-2xl mb-3" style="background: <%= season_info[:colour] %>;">
        <span aria-label="<%= season_info[:title].downcase %> phase emoji"><%= season_info[:emoji] %></span>
      </div>
      <h2 id="season-modal-title" class="text-brand-primary text-xl font-semibold m-0"><%= season_info[:title] %></h2>
      <p class="text-brand-secondary text-sm mt-1 mb-0"><%= t("forecast.index.you_are_in", phase: season_info[:title].downcase) %></p>
    </div>

      <p class="text-brand-primary text-sm leading-relaxed m-0 mb-4 text-center">
        <%= season_info[:description] %>
      </p>

      <% if season_info[:tips].any? %>
        <div class="bg-white rounded-lg p-3 mb-4">
          <p class="text-brand-primary text-xs font-semibold m-0 mb-2"><%= t("calendar.index.season_modal_tips") %></p>
        <ul class="m-0 pl-4">
          <% season_info[:tips].each do |tip| %>
            <li class="text-brand-secondary text-xs mb-1"><%= tip %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <button data-season-modal-target="closeBtn"
            data-action="click->season-modal#close"
            class="w-full bg-brand-primary text-white border-none rounded-lg px-4 py-3.5 text-base font-medium cursor-pointer focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-primary">
      <%= t("calendar.index.season_modal_got_it") %>
    </button>
  </div>
</div>
