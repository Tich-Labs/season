<%# Settings - My Calendar screen %>
<%# Renders its own notice toast below, so opt out of the shared flash banner. %>
<% content_for(:hide_flash) { "true" } %>
<%# Every settings page/sub-page gets the centred calendar button (see
     settings/edit.html.erb) instead of the default FABs. %>
<% content_for(:hide_quick_actions) { "true" } %>
<% content_for(:hide_calendar_fab) { "true" } %>
<% content_for(:header_left) do %>
  <%= link_to edit_settings_path, class: "p-2 flex items-center" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
      <line x1="19" y1="12" x2="5" y2="12" />
      <polyline points="12 19 5 12 12 5" />
    </svg>
  <% end %>
<% end %>

<div class="bg-white min-h-screen">
  <div class="max-w-app mx-auto px-4 pb-28">

    <%# Flash message toast — this page opts out of the shared flash
         partial (content_for(:hide_flash)) and renders its own, but it
         only ever checked `notice` — an `alert` (e.g. a rejected iCloud/
         Google connect attempt) silently vanished with no feedback at
         all. Handles both now. %>
    <% if notice.present? %>
      <div class="fixed top-4 left-4 right-4 bg-green-50 border border-green-200 rounded-lg px-4 py-3 text-sm text-green-700 z-50" role="status" data-notification="success">
        <%= notice %>
      </div>
      <script nonce="<%= content_security_policy_nonce %>">
        setTimeout(() => {
          const toast = document.querySelector('[data-notification="success"]');
          if (toast) {
            toast.style.opacity = '0';
            toast.style.transition = 'opacity 0.3s ease-out';
            setTimeout(() => toast.remove(), 300);
          }
        }, 3000);
      </script>
    <% elsif alert.present? %>
      <div class="fixed top-4 left-4 right-4 bg-brand-error border border-brand-muted rounded-lg px-4 py-3 text-sm text-brand-primary z-50" role="alert" data-notification="error">
        <%= alert %>
      </div>
      <script nonce="<%= content_security_policy_nonce %>">
        setTimeout(() => {
          const toast = document.querySelector('[data-notification="error"]');
          if (toast) {
            toast.style.opacity = '0';
            toast.style.transition = 'opacity 0.3s ease-out';
            setTimeout(() => toast.remove(), 300);
          }
        }, 4000);
      </script>
    <% end %>

    <%# My Calendar title %>
    <div class="flex items-center gap-4 pt-5 pb-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#933a35" stroke-width="1.5" viewBox="0 0 24 24">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
        <line x1="16" y1="2" x2="16" y2="6" />
        <line x1="8" y1="2" x2="8" y2="6" />
        <line x1="3" y1="10" x2="21" y2="10" />
      </svg>
      <span class="text-brand-primary text-lg font-bold"><%= t("settings.calendar.title") %></span>
    </div>
    <a href="<%= edit_settings_path %>"
       onclick="if (window.history.length > 1) { window.history.back(); return false; }"
       class="inline-block text-sm font-medium no-underline font-sans text-brand-primary mb-2"><%= t("shared.back") %></a>
    <div class="border-b border-brand-divider"></div>

    <%# Links & Syncs (first per Figma) %>
    <div class="flex items-center gap-3 pt-5 pb-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#933a35" stroke-width="1.5" viewBox="0 0 24 24">
        <path d="M21 12A9 9 0 0 1 12 21" stroke-dasharray="3 3" />
        <path d="M3 12a9 9 0 0 1 9-9" />
      </svg>
      <span class="text-brand-primary text-base font-medium"><%= t("settings.calendar.links_and_syncs") %></span>
    </div>

    <div>
      <%# Google Calendar — connect flow opens the direction sheet; connected
           state persists direction changes via the sync-direction controller. %>
      <div data-controller="calendar-sync-sheet">
        <% if @user.google_calendar_connected? %>
          <div class="flex items-center justify-between gap-3 py-3">
            <div class="flex flex-col gap-0.5">
              <span class="text-green-700 text-base font-semibold"><%= t("settings.calendar.connected") %></span>
              <span class="text-brand-secondary text-sm"><%= t("settings.calendar.google_calendar") %> · <%= @user.google_calendar_email %></span>
            </div>
            <%= button_to disconnect_google_calendar_settings_path, method: :post,
                  class: "min-h-12 px-5 rounded-xl border-2 border-brand-primary bg-white text-brand-primary text-base font-semibold" do %>
              <%= t("settings.calendar.disconnect") %>
            <% end %>
          </div>
          <div class="pt-1"
               data-controller="calendar-sync-direction"
               data-selected="<%= @user.calendar_sync_level == "two_way" ? "two_way" : "one_way" %>"
               data-calendar-sync-direction-save-url="<%= update_google_calendar_sync_settings_path %>">
            <div class="text-sm font-semibold text-brand-dark mb-3"><%= t("settings.calendar.sync_direction") %></div>
            <%= render "settings/sync_direction_options" %>
            <p class="text-xs text-brand-secondary mt-3"><%= t("settings.calendar.sync_direction_hint") %></p>
            <%= button_to sync_google_calendar_settings_path, method: :post,
                  class: "mt-2 min-h-11 px-2 rounded-xl border-0 bg-transparent text-brand-primary text-base font-semibold" do %>
              <%= t("settings.calendar.sync_now") %>
            <% end %>
          </div>
        <% else %>
          <div class="flex items-center justify-between gap-3 py-3">
            <div class="flex flex-col gap-0.5">
              <span class="text-brand-secondary text-base font-semibold"><%= t("settings.calendar.not_connected") %></span>
              <span class="text-brand-secondary text-sm"><%= t("settings.calendar.google_calendar") %></span>
            </div>
            <button type="button"
                    data-action="click->calendar-sync-sheet#open"
                    class="min-h-12 px-5 rounded-xl bg-brand-primary text-white text-base font-semibold">
              <%= t("settings.calendar.connect") %>
            </button>
          </div>
        <% end %>
        <%= render "settings/calendar_sync_sheet", provider: "google" %>
      </div>

      <%# Apple Calendar — native iOS connects via EventKit (a permission
           prompt, no password); web falls back to CalDAV with an Apple ID +
           app-specific password because Apple offers no calendar OAuth. %>
      <div data-controller="calendar-sync-sheet">
        <% if @user.icloud_connected? %>
          <div class="py-3">
            <div class="flex items-center justify-between gap-3">
              <div class="flex flex-col gap-0.5">
                <span class="text-green-700 text-base font-semibold"><%= t("settings.calendar.connected") %></span>
                <span class="text-brand-secondary text-sm"><%= @user.icloud_email %> · <%= t("settings.calendar.icloud_sync") %></span>
              </div>
              <div class="flex items-center gap-2">
                <%= button_to sync_icloud_calendar_settings_path, method: :post,
                      class: "min-h-11 px-2 rounded-xl border-0 bg-transparent text-brand-primary text-base font-semibold" do %>
                  <%= t("settings.calendar.sync_now") %>
                <% end %>
                <%= button_to disconnect_icloud_calendar_settings_path, method: :post,
                      class: "min-h-11 px-2 rounded-xl border-0 bg-transparent text-brand-primary text-base font-semibold" do %>
                  <%= t("settings.calendar.disconnect") %>
                <% end %>
              </div>
            </div>
          </div>
        <% elsif ios_native? %>
          <div class="flex items-center justify-between gap-3 py-3">
            <div class="flex flex-col gap-0.5">
              <span class="text-brand-secondary text-base font-semibold"><%= t("settings.calendar.not_connected") %></span>
              <span class="text-brand-secondary text-sm"><%= t("settings.calendar.icloud_sync") %></span>
            </div>
            <button type="button"
                    data-action="click->calendar-sync-sheet#open"
                    class="min-h-12 px-5 rounded-xl bg-brand-primary text-white text-base font-semibold">
              <%= t("settings.calendar.connect") %>
            </button>
          </div>
        <% else %>
          <%= form_with url: connect_icloud_calendar_settings_path, method: :post, local: true,
                html: {autocomplete: "off", data: {lpignore: "true", "1p-ignore": "true", "form-type": "other"}},
                class: "py-3" do %>
            <div class="flex items-center justify-between gap-3">
              <div class="flex flex-col gap-0.5">
                <span class="text-brand-secondary text-base font-semibold"><%= t("settings.calendar.not_connected") %></span>
                <span class="text-brand-secondary text-sm"><%= t("settings.calendar.icloud_sync") %></span>
              </div>
              <button type="submit" class="min-h-12 px-5 rounded-xl bg-brand-primary text-white text-base font-semibold shrink-0">
                <%= t("settings.calendar.connect") %>
              </button>
            </div>
            <div class="mt-2 space-y-2">
              <input type="email" name="icloud_email" placeholder="<%= t("settings.calendar.icloud_email_placeholder") %>"
                     required autocomplete="off" spellcheck="false"
                     data-lpignore="true" data-1p-ignore="true" data-form-type="other"
                     class="w-full min-h-12 bg-brand-field rounded-xl px-4 text-base text-brand-dark placeholder:text-brand-primary/50">
              <input type="password" name="icloud_app_password" placeholder="<%= t("settings.calendar.icloud_password_placeholder") %>"
                     required autocomplete="new-password" spellcheck="false"
                     data-lpignore="true" data-1p-ignore="true" data-form-type="other"
                     class="w-full min-h-12 bg-brand-field rounded-xl px-4 text-base text-brand-dark placeholder:text-brand-primary/50">
              <a href="https://appleid.apple.com" target="_blank" rel="noopener" class="inline-block text-brand-primary/60 text-xs underline">
                <%= t("settings.calendar.icloud_get_password") %>
              </a>
            </div>
          <% end %>
        <% end %>
        <% if ios_native? %>
          <%= render "settings/calendar_sync_sheet", provider: "apple" %>
        <% end %>
      </div>

      <%# Microsoft — grayed out, coming soon (below the supported providers) %>
      <div class="py-3 opacity-40 pointer-events-none">
        <div class="flex items-center justify-between gap-3">
          <div class="flex flex-col gap-0.5">
            <span class="text-brand-muted text-base font-semibold">user@outlook.com</span>
            <span class="text-brand-secondary text-sm"><%= t("settings.calendar.microsoft_sync") %></span>
          </div>
          <div class="flex items-center gap-2">
            <span class="bg-brand-field rounded-full px-2.5 py-1 text-brand-primary text-xs font-semibold"><%= t("settings.edit.coming_soon") %></span>
            <div class="toggle-btn">
              <div class="toggle-track"><div class="toggle-thumb"></div></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="border-b border-brand-divider my-2"></div>

    <%= form_with url: update_calendar_settings_path, method: :patch, local: true, data: { controller: "calendar-toggle" }, class: "w-full" do %>
    <%# Show features title %>
    <div class="flex items-center gap-3 pt-5 pb-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#933a35" stroke-width="2" viewBox="0 0 24 24">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
        <line x1="12" y1="8" x2="12" y2="16" />
        <line x1="8" y1="12" x2="16" y2="12" />
      </svg>
      <span class="text-brand-primary text-base font-medium"><%= t("settings.calendar.show_features") %></span>
    </div>

    <%# Toggle items %>
    <div class="space-y-0">
      <div class="flex items-center justify-between py-3">
        <span class="text-brand-muted text-sm font-medium"><%= t("settings.calendar.appointments") %></span>
        <button type="button" class="toggle-btn <%= "active" if @user.show_appointments? %>" data-action="click->calendar-toggle#toggle" data-field="show_appointments">
          <div class="toggle-track"><div class="toggle-thumb"></div></div>
        </button>
      </div>

      <div class="flex items-center justify-between py-3">
        <span class="text-brand-muted text-sm font-medium"><%= t("settings.calendar.tracking_reminder") %></span>
        <button type="button" class="toggle-btn <%= "active" if @user.show_tracked_days? %>" data-action="click->calendar-toggle#toggle" data-field="show_tracked_days">
          <div class="toggle-track"><div class="toggle-thumb"></div></div>
        </button>
      </div>

      <%# Moon phases — coming soon (functionality disabled for now, re-enable below) %>
      <% if false %>
        <div class="flex items-center justify-between py-3">
          <span class="text-brand-muted text-sm font-medium"><%= t("settings.calendar.moon_phases") %></span>
          <button type="button" class="toggle-btn <%= "active" if @user.show_moonphases? %>" data-action="click->calendar-toggle#toggle" data-field="show_moonphases">
            <div class="toggle-track"><div class="toggle-thumb"></div></div>
          </button>
        </div>
      <% end %>

      <%# Moon phases — grayed out, coming soon %>
      <div class="flex items-center justify-between py-3 opacity-40 pointer-events-none">
        <span class="text-brand-muted text-sm font-medium flex items-center gap-2">
          <%= t("settings.calendar.moon_phases") %>
          <span class="bg-brand-field rounded-full px-2 py-0.5 text-brand-primary text-xs"><%= t("settings.edit.coming_soon") %></span>
        </span>
        <div class="toggle-btn">
          <div class="toggle-track"><div class="toggle-thumb"></div></div>
        </div>
      </div>

      <%= render "shared/holiday_settings" %>

      <div class="flex items-center justify-between py-3">
        <span class="text-brand-muted text-sm font-medium"><%= t("settings.calendar.week_numbers") %></span>
        <button type="button" class="toggle-btn <%= "active" if @user.show_week_numbers? %>" data-action="click->calendar-toggle#toggle" data-field="show_week_numbers">
          <div class="toggle-track"><div class="toggle-thumb"></div></div>
        </button>
      </div>

      <div class="flex items-center justify-between py-3">
        <span class="text-brand-muted text-sm font-medium"><%= t("settings.calendar.cycle_day_on_band") %></span>
        <button type="button" class="toggle-btn <%= "active" if @user.show_cycle_day_on_band? %>" data-action="click->calendar-toggle#toggle" data-field="show_cycle_day_on_band">
          <div class="toggle-track"><div class="toggle-thumb"></div></div>
        </button>
      </div>
    </div>

    <%# Hidden form inputs for toggles %>
    <input type="hidden" name="show_appointments" value="<%= @user.show_appointments ? "1" : "0" %>">
    <input type="hidden" name="show_tracked_days" value="<%= @user.show_tracked_days ? "1" : "0" %>">
    <input type="hidden" name="show_moonphases" value="<%= @user.show_moonphases ? "1" : "0" %>">
    <input type="hidden" name="show_week_numbers" value="<%= @user.show_week_numbers ? "1" : "0" %>">
    <input type="hidden" name="show_cycle_day_on_band" value="<%= @user.show_cycle_day_on_band ? "1" : "0" %>">

    <div class="border-b border-brand-divider my-2"></div>

    <%# Day of the Week %>
    <div class="flex items-center gap-3 pt-5 pb-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#933a35" stroke-width="1.5" viewBox="0 0 24 24">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
        <line x1="16" y1="2" x2="16" y2="6" />
        <line x1="8" y1="2" x2="8" y2="6" />
        <line x1="3" y1="10" x2="21" y2="10" />
        <polyline points="14 14 17 17 20 13" />
      </svg>
      <span class="text-brand-primary text-base font-medium"><%= t("settings.calendar.day_of_week") %></span>
    </div>
    <div class="py-3">
      <select name="week_start_day" data-action="change->calendar-toggle#submitForm" class="w-full min-h-12 bg-brand-field rounded-xl px-4 text-base text-brand-primary font-medium">
        <option value="monday" <%= "selected" if @user.week_start_day == "monday" || @user.week_start_day.nil? %>><%= t("settings.calendar.monday") %></option>
        <option value="sunday" <%= "selected" if @user.week_start_day == "sunday" %>><%= t("settings.calendar.sunday") %></option>
        <option value="saturday" <%= "selected" if @user.week_start_day == "saturday" %>><%= t("settings.calendar.saturday") %></option>
      </select>
    </div>

    <div class="border-b border-brand-divider my-2"></div>

    <%# Time Zone %>
    <div class="flex items-center gap-3 pt-5 pb-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="24" fill="none" stroke="#933a35" stroke-width="1.5" viewBox="0 0 24 24">
        <rect x="5" y="2" width="14" height="20" rx="2" ry="2" />
        <line x1="9" y1="6" x2="15" y2="6" />
        <line x1="9" y1="10" x2="15" y2="10" />
        <line x1="9" y1="14" x2="12" y2="14" />
        <line x1="9" y1="18" x2="12" y2="18" />
      </svg>
      <span class="text-brand-primary text-base font-medium"><%= t("settings.calendar.timezone") %></span>
    </div>
    <div class="py-3">
      <select name="timezone" class="w-full min-h-12 bg-brand-field rounded-xl px-4 text-base text-brand-primary font-medium">
        <option value="UTC" selected><%= t("settings.calendar.timezone_utc") %></option>
        <option value="CET"><%= t("settings.calendar.timezone_cet") %></option>
        <option value="EST"><%= t("settings.calendar.timezone_est") %></option>
        <option value="PST"><%= t("settings.calendar.timezone_pst") %></option>
        <option value="IST"><%= t("settings.calendar.timezone_ist") %></option>
        <option value="JST"><%= t("settings.calendar.timezone_jst") %></option>
        <option value="AEST"><%= t("settings.calendar.timezone_aest") %></option>
      </select>
    </div>

    <%# Auto-save status %>
    <div class="mt-8 pt-4 text-center text-xs text-gray-400" data-notification="auto-save" style="display:none;">
      <%= t("settings.calendar.saving") %>
    </div>

    <% end %>

  </div>
</div>

<%= render "shared/calendar_center_fab", bg: "bg-brand-field" %>

<%= javascript_import_module_tag "controllers/calendar_toggle_controller" %>
