<%# Settings - My Calendar screen %>
<%# Renders its own notice toast below, so opt out of the shared flash banner. %>
<% content_for(:hide_flash) { "true" } %>
<%# Every settings page/sub-page gets the centred calendar button (see
     settings/edit.html.erb) instead of the default FABs. %>
<% content_for(:hide_quick_actions) { "true" } %>
<% content_for(:hide_calendar_fab) { "true" } %>
<% content_for(:header_left) do %>
  <%= link_to edit_settings_path, class: "p-2 flex items-center" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
      <line x1="19" y1="12" x2="5" y2="12" />
      <polyline points="12 19 5 12 12 5" />
    </svg>
  <% end %>
<% end %>

<div class="bg-white min-h-screen">
  <div class="max-w-app mx-auto px-4 pb-28">

    <%# Flash message toast %>
    <% if notice.present? %>
      <div class="fixed top-4 left-4 right-4 bg-green-50 border border-green-200 rounded-lg px-4 py-3 text-sm text-green-700 z-50" role="status" data-notification="success">
        <%= notice %>
      </div>
      <script>
        setTimeout(() => {
          const toast = document.querySelector('[data-notification="success"]');
          if (toast) {
            toast.style.opacity = '0';
            toast.style.transition = 'opacity 0.3s ease-out';
            setTimeout(() => toast.remove(), 300);
          }
        }, 3000);
      </script>
    <% end %>

    <%= form_with url: update_calendar_settings_path, method: :patch, local: true, data: { controller: "calendar-toggle" }, class: "w-full" do %>

    <%# My Calendar title %>
    <div class="flex items-center gap-4 pt-5 pb-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#933a35" stroke-width="1.5" viewBox="0 0 24 24">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
        <line x1="16" y1="2" x2="16" y2="6" />
        <line x1="8" y1="2" x2="8" y2="6" />
        <line x1="3" y1="10" x2="21" y2="10" />
      </svg>
      <span class="text-brand-primary text-lg font-bold"><%= t("settings.calendar.title") %></span>
    </div>
    <div class="border-b border-brand-divider"></div>

    <%# Links & Syncs (first per Figma) %>
    <div class="flex items-center gap-3 pt-5 pb-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#933a35" stroke-width="1.5" viewBox="0 0 24 24">
        <path d="M21 12A9 9 0 0 1 12 21" stroke-dasharray="3 3" />
        <path d="M3 12a9 9 0 0 1 9-9" />
      </svg>
      <span class="text-brand-primary text-base font-medium"><%= t("settings.calendar.links_and_syncs") %></span>
    </div>

    <div>
      <%# Google Calendar — coming soon (functionality disabled for now, re-enable below) %>
      <% if false %>
        <%# Google Calendar — fully functional %>
        <div class="py-3">
          <% if @user.google_calendar_connected? %>
            <span class="text-brand-muted text-sm font-medium"><%= @user.google_calendar_email %></span>
          <% else %>
            <span class="text-brand-muted text-sm font-medium"><%= t("settings.calendar.not_connected", default: "Not connected") %></span>
          <% end %>
          <span class="block text-brand-primary/60 text-xs"><%= t("settings.calendar.gmail") %></span>
        </div>
        <div class="flex items-center justify-between py-2">
          <% if @user.google_calendar_connected? %>
            <div class="flex items-center gap-2">
              <svg width="16" height="16" fill="none" stroke="#2E6B3E" stroke-width="2.5" viewBox="0 0 24 24">
                <polyline points="20 6 9 17 4 12" />
              </svg>
              <span class="text-brand-primary/60 text-xs"><%= t("settings.calendar.connected", default: "Connected") %></span>
            </div>
            <div class="flex items-center gap-3">
              <%= button_to sync_google_calendar_settings_path, method: :post,
                    class: "px-4 py-2 bg-brand-primary text-white text-xs font-semibold rounded-lg" do %>
                <%= t("settings.calendar.sync_now", default: "Sync now") %>
              <% end %>
              <%= button_to disconnect_google_calendar_settings_path, method: :post,
                    class: "text-brand-muted text-xs underline" do %>
                <%= t("settings.calendar.disconnect", default: "Disconnect") %>
              <% end %>
            </div>
          <% else %>
            <span class="text-brand-primary/60 text-xs"><%= t("settings.calendar.gmail_sync") %></span>
            <%= link_to connect_google_calendar_settings_path,
                  class: "px-4 py-2 bg-brand-primary text-white text-xs font-semibold rounded-lg no-underline" do %>
              <%= t("settings.calendar.connect", default: "Connect") %>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <%# Gmail — grayed out, coming soon %>
      <div class="opacity-40 pointer-events-none">
        <div class="py-3 flex items-center gap-2">
          <span class="text-brand-muted text-sm font-medium"><%= t("settings.calendar.not_connected", default: "Not connected") %></span>
          <span class="bg-brand-field rounded-full px-2 py-0.5 text-brand-primary text-xs"><%= t("settings.edit.coming_soon") %></span>
        </div>
        <div class="flex items-center justify-between py-2">
          <span class="text-brand-primary/60 text-xs"><%= t("settings.calendar.gmail_sync") %></span>
          <div class="toggle-btn">
            <div class="toggle-track"><div class="toggle-thumb"></div></div>
          </div>
        </div>
      </div>

      <%# Microsoft — grayed out, coming soon %>
      <div class="opacity-40 pointer-events-none">
        <div class="py-3 flex items-center gap-2">
          <span class="text-brand-muted text-sm font-medium">user@outlook.com</span>
          <span class="bg-brand-field rounded-full px-2 py-0.5 text-brand-primary text-xs"><%= t("settings.edit.coming_soon") %></span>
        </div>
        <div class="flex items-center justify-between py-2">
          <span class="text-brand-primary/60 text-xs"><%= t("settings.calendar.microsoft_sync") %></span>
          <div class="toggle-btn">
            <div class="toggle-track"><div class="toggle-thumb"></div></div>
          </div>
        </div>
      </div>

      <%# iCloud — grayed out, coming soon %>
      <div class="opacity-40 pointer-events-none">
        <div class="py-3 flex items-center gap-2">
          <span class="text-brand-muted text-sm font-medium">user@icloud.com</span>
          <span class="bg-brand-field rounded-full px-2 py-0.5 text-brand-primary text-xs"><%= t("settings.edit.coming_soon") %></span>
        </div>
        <div class="flex items-center justify-between py-2">
          <span class="text-brand-primary/60 text-xs"><%= t("settings.calendar.icloud_sync") %></span>
          <div class="toggle-btn">
            <div class="toggle-track"><div class="toggle-thumb"></div></div>
          </div>
        </div>
      </div>
    </div>

    <div class="border-b border-brand-divider my-2"></div>

    <%# Show features title %>
    <div class="flex items-center gap-3 pt-5 pb-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#933a35" stroke-width="2" viewBox="0 0 24 24">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
        <line x1="12" y1="8" x2="12" y2="16" />
        <line x1="8" y1="12" x2="16" y2="12" />
      </svg>
      <span class="text-brand-primary text-base font-medium"><%= t("settings.calendar.show_features") %></span>
    </div>

    <%# Toggle items %>
    <div class="space-y-0">
      <div class="flex items-center justify-between py-3">
        <span class="text-brand-muted text-sm font-medium"><%= t("settings.calendar.appointments") %></span>
        <button type="button" class="toggle-btn <%= "active" if @user.show_appointments? %>" data-action="click->calendar-toggle#toggle" data-field="show_appointments">
          <div class="toggle-track"><div class="toggle-thumb"></div></div>
        </button>
      </div>

      <div class="flex items-center justify-between py-3">
        <span class="text-brand-muted text-sm font-medium"><%= t("settings.calendar.tracking_reminder") %></span>
        <button type="button" class="toggle-btn <%= "active" if @user.show_tracked_days? %>" data-action="click->calendar-toggle#toggle" data-field="show_tracked_days">
          <div class="toggle-track"><div class="toggle-thumb"></div></div>
        </button>
      </div>

      <%# Moon phases — coming soon (functionality disabled for now, re-enable below) %>
      <% if false %>
        <div class="flex items-center justify-between py-3">
          <span class="text-brand-muted text-sm font-medium"><%= t("settings.calendar.moon_phases") %></span>
          <button type="button" class="toggle-btn <%= "active" if @user.show_moonphases? %>" data-action="click->calendar-toggle#toggle" data-field="show_moonphases">
            <div class="toggle-track"><div class="toggle-thumb"></div></div>
          </button>
        </div>
      <% end %>

      <%# Moon phases — grayed out, coming soon %>
      <div class="flex items-center justify-between py-3 opacity-40 pointer-events-none">
        <span class="text-brand-muted text-sm font-medium flex items-center gap-2">
          <%= t("settings.calendar.moon_phases") %>
          <span class="bg-brand-field rounded-full px-2 py-0.5 text-brand-primary text-xs"><%= t("settings.edit.coming_soon") %></span>
        </span>
        <div class="toggle-btn">
          <div class="toggle-track"><div class="toggle-thumb"></div></div>
        </div>
      </div>

      <%= render "shared/holiday_settings" %>

      <div class="flex items-center justify-between py-3">
        <span class="text-brand-muted text-sm font-medium"><%= t("settings.calendar.week_numbers") %></span>
        <button type="button" class="toggle-btn <%= "active" if @user.show_week_numbers? %>" data-action="click->calendar-toggle#toggle" data-field="show_week_numbers">
          <div class="toggle-track"><div class="toggle-thumb"></div></div>
        </button>
      </div>

      <div class="flex items-center justify-between py-3">
        <span class="text-brand-muted text-sm font-medium"><%= t("settings.calendar.cycle_day_on_band") %></span>
        <button type="button" class="toggle-btn <%= "active" if @user.show_cycle_day_on_band? %>" data-action="click->calendar-toggle#toggle" data-field="show_cycle_day_on_band">
          <div class="toggle-track"><div class="toggle-thumb"></div></div>
        </button>
      </div>
    </div>

    <%# Hidden form inputs for toggles %>
    <input type="hidden" name="show_appointments" value="<%= @user.show_appointments ? "1" : "0" %>">
    <input type="hidden" name="show_tracked_days" value="<%= @user.show_tracked_days ? "1" : "0" %>">
    <input type="hidden" name="show_moonphases" value="<%= @user.show_moonphases ? "1" : "0" %>">
    <input type="hidden" name="show_week_numbers" value="<%= @user.show_week_numbers ? "1" : "0" %>">
    <input type="hidden" name="show_cycle_day_on_band" value="<%= @user.show_cycle_day_on_band ? "1" : "0" %>">

    <div class="border-b border-brand-divider my-2"></div>

    <%# Day of the Week %>
    <div class="flex items-center gap-3 pt-5 pb-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#933a35" stroke-width="1.5" viewBox="0 0 24 24">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
        <line x1="16" y1="2" x2="16" y2="6" />
        <line x1="8" y1="2" x2="8" y2="6" />
        <line x1="3" y1="10" x2="21" y2="10" />
        <polyline points="14 14 17 17 20 13" />
      </svg>
      <span class="text-brand-primary text-base font-medium"><%= t("settings.calendar.day_of_week") %></span>
    </div>
    <div class="py-3">
      <select name="week_start_day" data-action="change->calendar-toggle#submitForm" class="w-full bg-brand-field rounded-xl px-4 py-3 text-brand-primary text-sm font-medium">
        <option value="monday" <%= "selected" if @user.week_start_day == "monday" || @user.week_start_day.nil? %>><%= t("settings.calendar.monday") %></option>
        <option value="sunday" <%= "selected" if @user.week_start_day == "sunday" %>><%= t("settings.calendar.sunday") %></option>
        <option value="saturday" <%= "selected" if @user.week_start_day == "saturday" %>><%= t("settings.calendar.saturday") %></option>
      </select>
    </div>

    <div class="border-b border-brand-divider my-2"></div>

    <%# Time Zone %>
    <div class="flex items-center gap-3 pt-5 pb-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="24" fill="none" stroke="#933a35" stroke-width="1.5" viewBox="0 0 24 24">
        <rect x="5" y="2" width="14" height="20" rx="2" ry="2" />
        <line x1="9" y1="6" x2="15" y2="6" />
        <line x1="9" y1="10" x2="15" y2="10" />
        <line x1="9" y1="14" x2="12" y2="14" />
        <line x1="9" y1="18" x2="12" y2="18" />
      </svg>
      <span class="text-brand-primary text-base font-medium"><%= t("settings.calendar.timezone") %></span>
    </div>
    <div class="py-3">
      <select name="timezone" class="w-full bg-brand-field rounded-xl px-4 py-3 text-brand-primary text-sm font-medium">
        <option value="UTC" selected>UTC / GMT</option>
        <option value="CET">Central European Time (CET)</option>
        <option value="EST">Eastern Standard Time (EST)</option>
        <option value="PST">Pacific Standard Time (PST)</option>
        <option value="IST">Indian Standard Time (IST)</option>
        <option value="JST">Japan Standard Time (JST)</option>
        <option value="AEST">Australian Eastern (AEST)</option>
      </select>
    </div>

    <%# Auto-save status %>
    <div class="mt-8 pt-4 text-center text-xs text-gray-400" data-notification="auto-save" style="display:none;">
      <%= t("settings.calendar.saving") %>
    </div>

    <% end %>

  </div>
</div>

<%= render "shared/calendar_center_fab", bg: "bg-brand-field" %>

<%= javascript_import_module_tag "controllers/calendar_toggle_controller" %>
