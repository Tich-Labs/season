<% content_for(:title) { t("settings.pin.title", default: "Access Code") } %>
<% content_for(:header_dark) { true } %>
<%# Every settings page/sub-page gets the centred calendar button (see
     settings/edit.html.erb) instead of the default FABs. %>
<% content_for(:hide_quick_actions) { "true" } %>
<% content_for(:hide_calendar_fab) { "true" } %>
<% content_for(:header_left) do %>
  <%= link_to profile_settings_path, class: "min-w-11 min-h-11 flex items-center justify-center" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
      <polyline points="15 18 9 12 15 6" />
    </svg>
  <% end %>
<% end %>

<div class="px-4 pt-6 pb-28">
  <div class="flex flex-col items-center mb-8">
    <div class="w-16 h-16 rounded-full bg-brand-field flex items-center justify-center mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" stroke="#933a35" stroke-width="1.5" viewBox="0 0 24 24">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
      </svg>
    </div>
    <h1 class="text-xl font-semibold text-brand-primary">
      <%= current_user.pin_set? ? t("settings.pin.change", default: "Change Access Code") : t("settings.pin.set", default: "Set Access Code") %>
    </h1>
    <p class="text-sm text-brand-secondary mt-1"><%= t("settings.pin.description", default: "Enter a 4-6 digit code to lock the app") %></p>
  </div>

  <% unless current_user.pin_set? %>
    <div role="alert" class="bg-brand-error rounded-xl px-4 py-3 mb-6 text-sm text-brand-primary font-medium">
      <%= t("settings.pin.no_pin_warning", default: "You haven't set an access code — anyone with this device can open Season and see your data.") %>
    </div>
  <% end %>

  <%= form_tag pin_settings_path, method: :post, class: "space-y-4", data: { controller: "pin-entry" } do %>
    <div>
      <%= label_tag :pin, t("settings.pin.code", default: "Code"), class: "text-sm font-medium text-brand-primary mb-1 block" %>
      <%= password_field_tag :pin, nil,
            required: true,
            autocomplete: "off",
            inputmode: "numeric",
            pattern: "[0-9]*",
            maxlength: 6,
            class: "w-full px-4 py-3 rounded-xl border border-brand-field bg-white text-gray-800 text-base font-mono text-center text-2xl tracking-widest focus:border-brand-primary focus:ring-1 focus:ring-brand-primary focus:outline-none" %>
    </div>

    <div>
      <%= label_tag :pin_confirmation, t("settings.pin.confirm", default: "Confirm code"), class: "text-sm font-medium text-brand-primary mb-1 block" %>
      <%= password_field_tag :pin_confirmation, nil,
            required: true,
            autocomplete: "off",
            inputmode: "numeric",
            pattern: "[0-9]*",
            maxlength: 6,
            class: "w-full px-4 py-3 rounded-xl border border-brand-field bg-white text-gray-800 text-base font-mono text-center text-2xl tracking-widest focus:border-brand-primary focus:ring-1 focus:ring-brand-primary focus:outline-none" %>
    </div>

    <%= submit_tag t("settings.pin.save", default: "Save"), class: "w-full py-3 bg-brand-primary text-white rounded-xl text-base font-semibold mt-6" %>
  <% end %>

  <% if current_user.pin_set? %>
    <div class="mt-8 pt-6 border-t border-brand-divider">
      <h2 class="text-sm font-medium text-brand-primary mb-3"><%= t("settings.pin.remove_title", default: "Remove access code") %></h2>
      <%= form_tag pin_settings_path, method: :delete, class: "space-y-3" do %>
        <%= password_field_tag :pin, nil,
              required: true,
              autocomplete: "off",
              inputmode: "numeric",
              pattern: "[0-9]*",
              maxlength: 6,
              placeholder: t("settings.pin.enter_current", default: "Enter current code"),
              class: "w-full px-4 py-3 rounded-xl border border-brand-field bg-white text-gray-800 text-base font-mono text-center tracking-widest focus:border-brand-primary focus:ring-1 focus:ring-brand-primary focus:outline-none" %>
        <%= submit_tag t("settings.pin.remove", default: "Remove"),
              class: "w-full py-3 bg-white text-brand-primary border-2 border-brand-primary rounded-xl text-base font-semibold",
              data: { confirm: t("settings.pin.confirm_remove", default: "Are you sure?") } %>
      <% end %>
    </div>
  <% end %>
</div>

<%= render "shared/calendar_center_fab", bg: "bg-brand-field" %>
