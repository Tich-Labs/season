<%# Avatar picker modal — shared by /settings/profile and the /tracking
     avatar (camera icon). Must stay inside a data-controller="profile-modal"
     scope; the modal's buttons call profile-modal actions. The crop step
     below is self-contained (data-controller="avatar-crop" lives right on
     #avatar-modal) so both call sites get it with no changes on their end. %>
<% avatar_return_to = request.path == tracking_index_path ? tracking_index_path : profile_settings_path %>
<div id="avatar-modal" role="dialog" aria-modal="true" aria-labelledby="avatar-modal-title"
     style="top: env(safe-area-inset-top, 0px);" class="hidden fixed inset-0 bg-black/50 z-[100] items-center justify-center"
     data-controller="avatar-crop">
  <div class="bg-brand-background rounded-2xl p-6 w-[90%] max-w-[340px] mx-4">

    <%# ── Step 1: choose a preset, or a file to crop ── %>
    <div data-avatar-crop-target="pickerStep">
      <div class="flex justify-between items-center mb-5">
        <h3 id="avatar-modal-title" class="text-brand-primary text-lg font-semibold m-0"><%= t("settings.profile.profile_picture") %></h3>
        <button data-action="click->profile-modal#closeAvatarModal" class="bg-transparent border-none cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#933a35" stroke-width="2" viewBox="0 0 24 24">
            <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>

      <div class="mb-5">
        <label class="block text-brand-primary text-13 font-medium mb-3"><%= t("settings.profile.choose_cat_avatar") %></label>
        <div class="grid grid-cols-4 gap-3">
          <% AvatarService.all.each do |preset| %>
            <% selected = current_user.avatar_preset == preset[:id] %>
            <button type="button" data-action="click->profile-modal#selectAvatarPreset"
                    data-avatar-preset="<%= preset[:id] %>"
                    title="<%= preset[:name] %>" aria-label="<%= preset[:name] %>" aria-pressed="<%= selected %>"
                    class="<%= selected ? 'border-[3px] border-brand-primary' : 'border border-brand-divider' %> flex items-center justify-center w-full aspect-square bg-white rounded-xl p-2 cursor-pointer transition-all">
              <%= image_tag "avatars/#{preset[:file]}", alt: preset[:name], class: "w-full h-full object-cover rounded-lg" %>
            </button>
          <% end %>
        </div>
      </div>

      <hr class="border-none border-t border-brand-divider my-5">

      <%# Preset selection only highlights the choice (selectAvatarPreset);
           nothing is saved until Add Photo is tapped. Choosing a file skips
           this button entirely and jumps straight to the crop step — nothing
           uploads until "Set picture" there confirms. %>
      <%= form_with url: update_avatar_settings_path, method: :patch, multipart: true,
            data: { turbo: false, avatar_crop_target: "form" }, local: true, id: "avatar-upload-form" do %>
        <input type="hidden" name="return_to" value="<%= avatar_return_to %>">
        <input type="hidden" name="avatar_preset" id="avatar-selected-preset" value="<%= current_user.avatar_preset %>">

        <button type="button" data-action="click->profile-modal#clickAvatarUpload"
                class="flex items-center gap-3 w-full bg-white border border-brand-divider rounded-xl p-4 mb-3 cursor-pointer text-left">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#933a35" stroke-width="1.5" viewBox="0 0 24 24">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <polyline points="21 15 16 10 5 21" />
          </svg>
          <span class="text-brand-primary text-base font-medium"><%= t("settings.profile.upload_from_device") %></span>
        </button>
        <input type="file" id="avatar-file" name="avatar" accept="image/*"
               data-avatar-crop-target="fileInput"
               data-action="change->profile-modal#fileSelected change->avatar-crop#open"
               class="absolute -left-[9999px] w-px h-px opacity-0">

        <button type="submit" class="w-full bg-brand-primary text-white border-none rounded-xl py-3.5 text-base font-medium cursor-pointer">
          <%= t("settings.profile.add_photo") %>
        </button>
      <% end %>

      <button data-action="click->profile-modal#closeAvatarModal"
              class="w-full bg-transparent text-brand-primary border border-brand-divider rounded-xl py-3.5 text-base font-medium cursor-pointer mt-2">
        <%= t("settings.profile.cancel") %>
      </button>
    </div>

    <%# ── Step 2: crop photo — shown after a file is chosen above. Real
         pixel crop: "Set picture" bakes the current pan/zoom into an actual
         cropped image (canvas, no library) before it ever uploads, so what
         gets stored is exactly what was previewed here, not the original
         untouched photo. ── %>
    <div data-avatar-crop-target="cropStep" class="hidden">
      <div class="flex justify-between items-center mb-5">
        <h3 class="text-brand-primary text-lg font-semibold m-0"><%= t("settings.profile.crop_photo") %></h3>
        <button type="button" data-action="click->avatar-crop#cancel" class="bg-transparent border-none cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#933a35" stroke-width="2" viewBox="0 0 24 24">
            <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>

      <%# Square frame, fixed CSS size measured live in JS (clientWidth) so
           the crop math matches whatever this actually renders at — overflow
           hidden clips the panned/zoomed image to the frame; the circular
           shadow overlay on top is just a visual preview of the round avatar
           shape, the exported crop itself is the full square underneath it. %>
      <div class="relative w-full aspect-square rounded-2xl overflow-hidden bg-brand-divider mb-4 touch-none select-none"
           data-avatar-crop-target="frame"
           data-action="pointerdown->avatar-crop#dragStart pointermove->avatar-crop#dragMove pointerup->avatar-crop#dragEnd pointercancel->avatar-crop#dragEnd">
        <%# max-w-none overrides Tailwind Preflight's global `img { max-width:
             100%; height: auto }` reset — without it, the browser caps this
             image's rendered width at the frame's width no matter what JS
             sets style.width to, while style.height grows unconstrained with
             zoom. Net effect: zooming stretched the photo vertically only. %>
        <img data-avatar-crop-target="image" alt="" class="absolute top-0 left-0 max-w-none origin-top-left pointer-events-none opacity-0 transition-opacity duration-150">
        <div class="absolute inset-0 pointer-events-none rounded-full" style="box-shadow: 0 0 0 9999px rgba(0,0,0,0.45);"></div>
      </div>

      <div class="flex items-center gap-3 mb-5">
        <span class="text-brand-primary text-13 font-medium shrink-0"><%= t("settings.profile.zoom") %></span>
        <input type="range" min="1" max="3" step="0.01" value="1" autocomplete="off"
               data-avatar-crop-target="zoom" data-action="input->avatar-crop#zoomChanged"
               class="w-full accent-brand-primary" aria-label="<%= t("settings.profile.zoom") %>">
      </div>

      <div class="flex flex-col items-center gap-1.5 mb-5">
        <div class="w-11 h-11 rounded-full bg-brand-primary flex items-center justify-center" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
            <polyline points="5 9 2 12 5 15" /><polyline points="9 5 12 2 15 5" />
            <polyline points="15 19 12 22 9 19" /><polyline points="19 9 22 12 19 15" />
            <line x1="2" y1="12" x2="22" y2="12" /><line x1="12" y1="2" x2="12" y2="22" />
          </svg>
        </div>
        <span class="text-brand-primary text-13 font-medium"><%= t("settings.profile.positioning") %></span>
      </div>

      <button type="button" data-action="click->avatar-crop#confirm"
              class="w-full bg-brand-primary text-white border-none rounded-xl py-3.5 text-base font-medium cursor-pointer">
        <%= t("settings.profile.set_picture") %>
      </button>
    </div>

  </div>
</div>
