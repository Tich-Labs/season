<%# Settings screen - matches Figma node 12048-37859 %>
<%# Header auto-rendered by layout (controller_name == 'settings') %>
<%= native_navbar_tag("Settings") if native_app? %>

<div class="bg-white min-h-screen">

  <%# Content - max-width 430px centered %>
  <div class="max-w-app mx-auto px-4 pb-20">

    <%# ── Personal Settings ── %>
    <div class="py-5 pb-2">
      <h2 class="text-brand-primary text-base font-bold">Personal Settings</h2>
    </div>
    <div class="border-b border-brand-divider"></div>

    <%# My Profile %>
    <a href="<%= profile_settings_path %>" class="flex items-center gap-4 py-4">
      <%= vuesax_icon "user", size: 24 %>
      <span class="flex-1 text-brand-primary text-base font-medium">My Profile</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-brand-primary">
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </a>

    <%# My Abonnements %>
    <a href="<%= subscriptions_settings_path %>" class="flex items-center gap-4 py-4">
      <%= vuesax_icon "bag", size: 24 %>
      <span class="flex-1 text-brand-primary text-base font-medium">My Abonnements</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-brand-primary">
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </a>
    <%# My Calendar %>
    <a href="<%= calendar_settings_path %>" class="flex items-center gap-4 py-4">
      <%= vuesax_icon "calendar", size: 24 %>
      <span class="flex-1 text-brand-primary text-base font-medium">My Calendar</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-brand-primary">
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </a>

    <%# ── App Settings ── %>
    <div class="py-6 pb-2">
      <h2 class="text-brand-primary text-base font-bold">App Settings</h2>
    </div>
    <div class="border-b border-brand-divider"></div>

    <%# Notifications & Reminders %>
    <a href="<%= notifications_settings_path %>" class="flex items-center gap-4 py-4">
      <%= vuesax_icon "notification", size: 24 %>
      <span class="flex-1 text-brand-primary text-base font-medium">Notifications &amp; reminder</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-brand-primary">
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </a>

    <%# Data & Privacy (GDPR Consent) %>
    <a href="/settings/consent" class="flex items-center gap-4 py-4">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" class="text-brand-primary">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
      </svg>
      <span class="flex-1 text-brand-primary text-base font-medium">Data & Privacy</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-brand-primary">
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </a>

    <%# Language %>
    <a href="/settings/language" data-turbo="false" class="flex items-center gap-4 py-4">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" class="text-brand-primary">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
      </svg>
      <div class="flex-1">
        <span class="text-brand-primary text-base font-medium"><%= t("settings.language.title", default: "Language") %></span>
        <span class="block text-brand-muted text-sm mt-1"><%= current_user.language == "de" ? "Deutsch" : "English" %></span>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-brand-primary">
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </a>

    <%# Darkmode %>
    <div class="flex items-center gap-4 py-4 cursor-pointer" onclick="alert('Dark mode toggle - coming soon!')">
      <svg class="w-6 h-6 text-brand-primary shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
      <span class="flex-1 text-brand-primary text-base font-medium">Darkmode</span>
      <div class="w-10 h-5 bg-brand-primary rounded-[25px] p-0.5">
        <div class="w-4 h-4 bg-white rounded-full ml-auto"></div>
      </div>
    </div>

    <%# ── About Season ── %>
    <div class="pt-6 pb-2">
      <h2 class="text-brand-primary text-base font-bold">About Season</h2>
    </div>
    <div class="border-b border-brand-divider"></div>

    <%# Support %>
    <button type="button"
            data-controller="open-feedback"
            data-open-feedback-type-value="support"
            data-action="click->open-feedback#open"
            class="flex items-center gap-4 p-4 bg-[#899884] rounded-lg mt-4 w-full border-0 cursor-pointer text-left">
      <%= vuesax_icon "message-question", size: 32, colour: "white" %>
      <div class="flex-1">
        <span class="block text-white text-base font-bold">Support</span>
        <span class="text-white text-sm">Contact us!</span>
      </div>
    </button>

    <%# Rate in the App Store %>
    <div class="relative mt-2">
      <a href="#" class="flex items-center gap-4 p-4 bg-[#899884] rounded-lg no-underline">
        <%= vuesax_icon "star", size: 32, colour: "white" %>
        <div class="flex-1">
          <span class="block text-white text-base font-bold">Rate in the App Store</span>
          <span class="text-white text-sm">for even more benefits!</span>
        </div>
      </a>
      <div class="absolute right-2 top-2 bg-brand-field rounded-full px-2.5 py-1">
        <span class="text-brand-primary text-xs">Coming soon</span>
      </div>
    </div>

    <%# Share Season with friends %>
    <div class="relative mt-2 mb-4">
      <a href="#" class="flex items-center gap-4 p-4 bg-[#899884] rounded-lg no-underline">
        <%= vuesax_icon "share", size: 32, colour: "white" %>
        <div class="flex-1">
          <span class="block text-white text-base font-bold">Share Season with friends</span>
          <span class="text-white text-sm">for even more benefits!</span>
        </div>
      </a>
      <div class="absolute right-2 top-2 bg-brand-field rounded-full px-2.5 py-1">
        <span class="text-brand-primary text-xs">Coming soon</span>
      </div>
    </div>

    <%# Logout — row style matching other icons %>
    <div class="border-b border-brand-divider my-2"></div>
    <%= button_to session_path, method: :delete,
          class: "flex items-center gap-4 py-4 w-full text-left cursor-pointer",
          form_class: "contents",
          style: "background:none;border:none;color:#933A35;font:inherit;font-size:16px;font-weight:500;" do %>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-brand-primary shrink-0">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
        <polyline points="16 17 21 12 16 7" />
        <line x1="21" y1="12" x2="9" y2="12" />
      </svg>
      <span class="flex-1 text-brand-primary text-base font-medium">Log out</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-brand-primary">
        <polyline points="9 18 15 12 9 6" />
      </svg>
    <% end %>

    <%# Render support modal inline for iOS Ruby Native modal compatibility %>
    <%= render "shared/support_modal" %>

  </div>
</div>
