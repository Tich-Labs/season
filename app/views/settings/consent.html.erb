<%# GDPR Consent screen - Article 9 %>
<%# This page renders its own styled success notice below, so opt out of the shared flash banner. %>
<% content_for(:hide_flash) { "true" } %>
<%# Every settings page/sub-page gets the centred calendar button (see
     settings/edit.html.erb) instead of the default FABs. %>
<% content_for(:hide_quick_actions) { "true" } %>
<% content_for(:hide_calendar_fab) { "true" } %>
<% content_for(:header_left) do %>
  <%= link_to edit_settings_path, class: "p-2 flex items-center" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
      <line x1="19" y1="12" x2="5" y2="12" />
      <polyline points="12 19 5 12 12 5" />
    </svg>
  <% end %>
<% end %>

<div class="bg-white min-h-dvh min-h-screen">
  <div class="max-w-app mx-auto px-4 pb-28">

    <%# Success notice %>
    <% if flash[:notice].present? %>
      <div class="mt-4 bg-green-50 border border-green-200 rounded-xl px-4 py-3 flex items-center gap-3">
        <svg width="20" height="20" fill="none" stroke="#2E6B3E" stroke-width="2.5" viewBox="0 0 24 24" class="shrink-0">
          <polyline points="20 6 9 17 4 12" />
        </svg>
        <span class="text-green-800 text-sm font-medium"><%= flash[:notice] %></span>
      </div>
    <% end %>

    <%# Header %>
    <div class="py-5 pb-2">
      <h2 class="text-brand-primary text-base font-bold"><%= t("consent.show.title") %></h2>
    </div>
    <div class="border-b border-brand-divider mb-4"></div>

    <%# Intro %>
    <div class="bg-brand-error rounded-xl p-4 mb-5">
      <p class="text-brand-primary text-sm font-medium m-0">
        <%= t("consent.show.intro") %>
      </p>
    </div>

    <%# Consent Form %>
    <%= form_with url: "/settings/consent", method: :post, local: true do %>
      <% consents = [
        { key: "health_data_processing", title: t("consent.show.health_data"), desc: t("consent.show.health_data_desc") },
        { key: "symptom_tracking", title: t("consent.show.symptom_tracking"), desc: t("consent.show.symptom_tracking_desc") },
        { key: "cycle_tracking", title: t("consent.show.cycle_tracking"), desc: t("consent.show.cycle_tracking_desc") },
        { key: "menstrual_data", title: t("consent.show.menstrual_data"), desc: t("consent.show.menstrual_data_desc") }
      ] %>

      <% consents.each do |c| %>
        <label class="flex items-start gap-3 p-4 bg-white border border-brand-field rounded-xl mb-3 cursor-pointer">
          <input type="checkbox" name="consents[<%= c[:key] %>]"
                 <%= current_user.consent?(c[:key]) ? "checked" : "" %>
                 class="w-5 h-5 accent-brand-primary mt-0.5 shrink-0">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <span class="text-brand-primary text-sm font-semibold"><%= c[:title] %></span>
              <button type="button"
                      onclick="document.dispatchEvent(new CustomEvent('consent-info:open', { detail: { type: <%= c[:key].to_json %> } }))"
                      class="bg-none border-none p-0 cursor-pointer text-brand-muted hover:text-brand-primary shrink-0"
                      aria-label="<%= t("consent.show.learn_more", title: c[:title]) %>">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="10" />
                  <line x1="12" y1="16" x2="12" y2="12" />
                  <line x1="12" y1="8" x2="12.01" y2="8" />
                </svg>
              </button>
            </div>
            <span class="block text-brand-muted text-xs mt-1"><%= c[:desc] %></span>
          </div>
        </label>
      <% end %>

      <button type="submit"
              class="w-full h-12 bg-brand-primary text-white rounded-xl text-base font-medium tracking-wide mt-2 cursor-pointer">
        <%= t("consent.show.save_preferences") %>
      </button>
    <% end %>

    <%# Info text %>
    <div class="mt-6 p-4 bg-brand-field rounded-xl">
      <p class="text-brand-muted text-xs leading-relaxed m-0">
        <strong class="text-brand-primary"><%= t("consent.show.your_rights") %></strong><br>
        <%= t("consent.show.rights_text") %>
      </p>
    </div>

    <%# Link to Privacy Policy %>
    <%= link_to t("consent.show.view_privacy"), privacy_path, class: "block text-center text-brand-primary text-sm underline mt-4" %>

  </div>
</div>

<%= render "shared/calendar_center_fab", bg: "bg-brand-field" %>

<%= render "shared/consent_info_modal" %>
