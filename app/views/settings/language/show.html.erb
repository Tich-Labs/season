<%# Language settings - simple list of options, native form submit (reliable on iOS) %>
<%# Two real entry points — the main settings menu, and the "EN" pill on
     /calendar — so "back" must reflect wherever the user actually came from. %>
<% content_for(:header_left) do %>
  <%= link_to safe_back_path(edit_settings_path, allowed: [edit_settings_path, user_root_path]), class: "p-2 flex items-center" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
      <line x1="19" y1="12" x2="5" y2="12" />
      <polyline points="12 19 5 12 12 5" />
    </svg>
  <% end %>
<% end %>
<%# "+" quick-actions FAB hidden here, calendar FAB kept — the opposite of
     every sibling settings page, per explicit request for this one screen. %>
<% content_for(:hide_quick_actions) { "true" } %>

<div class="bg-white min-h-screen">
  <div class="max-w-app mx-auto px-4 pb-20">

    <%# Language title — the app-bar itself just shows the generic gear+"Settings"
         title shared by sibling settings pages, so this gives page-specific context. %>
    <div class="flex items-center gap-4 pt-5 pb-2">
      <%= image_tag "icons/language.svg", alt: "Language", class: "w-6 h-6 shrink-0 object-contain" %>
      <span class="text-brand-primary text-lg font-bold"><%= t("settings.language.title") %></span>
    </div>
    <div class="border-b border-brand-divider"></div>

    <%= form_tag settings_language_path, method: :patch, "data-turbo": false do %>
      <% current_language = @user.language.presence || I18n.default_locale.to_s %>
      <% I18n.available_locales.each do |locale| %>
        <label class="flex items-center justify-between gap-4 py-4 border-b border-brand-divider cursor-pointer">
          <span class="text-brand-primary text-base font-medium">
            <%= I18n.t("language.names.#{locale}", default: locale.to_s.upcase) %>
          </span>
          <input type="radio" name="user[language]" value="<%= locale %>"
                 <%= "checked" if current_language == locale.to_s %>
                 class="w-5 h-5 accent-brand-primary shrink-0">
        </label>
      <% end %>
      <div class="pt-6">
        <%= submit_tag t("settings.language.save", default: "Save Language"),
              class: "w-full bg-brand-primary text-white text-base font-semibold rounded-lg py-3 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
