<%# Notifications & Reminders screen - matches Figma node 12048:16741 %>
<%# Every settings page/sub-page gets the centred calendar button (see
     settings/edit.html.erb) instead of the default FABs. %>
<% content_for(:hide_quick_actions) { "true" } %>
<% content_for(:hide_calendar_fab) { "true" } %>
<% content_for(:header_left) do %>
  <%= link_to edit_settings_path, class: "p-2 flex items-center", aria: { label: "Back to settings" } do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
      <line x1="19" y1="12" x2="5" y2="12" />
      <polyline points="12 19 5 12 12 5" />
    </svg>
  <% end %>
<% end %>

<div class="bg-white min-h-screen">
  <div class="max-w-app mx-auto px-4 pb-20">

    <%# ── Section header ── %>
    <div class="flex items-center gap-3 py-5 pb-2">
      <%= vuesax_icon "sms-notification", size: 24 %>
      <h2 class="text-brand-primary text-base font-bold"><%= t("settings.notifications.heading") %></h2>
    </div>
    <div class="border-b border-brand-divider"></div>

    <%# General Push-Notifications %>
    <% push_on = @notifications.push_notifications %>
    <% prefs = current_user.notification_preferences || {} %>
    <div data-controller="push-subscription"
         data-vapid-key="<%= Rails.application.credentials.dig(:vapid, :public_key) %>"
         class="flex items-center justify-between py-3.5 pb-2">
      <div>
        <span class="text-brand-primary text-base font-medium"><%= t("settings.notifications.general_push") %></span>
        <span data-push-subscription-target="status" class="text-brand-secondary text-xs ml-2"></span>
      </div>
      <button type="button" id="general_push_toggle" role="switch"
              aria-label="General Push-Notifications"
              aria-checked="<%= push_on %>"
              data-action="click->push-subscription#toggle"
              data-push-subscription-target="toggle"
              class="toggle-btn <%= "active" if push_on %>">
        <div class="toggle-track"><div class="toggle-thumb"></div></div>
      </button>
    </div>
    <%# Not yet wired to anything — persisted to notification_preferences but
        nothing in the app reads that column back out. Locked until that
        exists so the toggles don't imply a control that does nothing. %>
    <% [
      ["push_new_appt_synced",   t("settings.notifications.push_new_appt")],
      ["push_tracking_reminder", t("settings.notifications.push_tracking")],
      ["push_new_feedback",      t("settings.notifications.push_new_feedback")],
      ["push_app_updates",       t("settings.notifications.push_app_updates")],
      ["push_appointments",      t("settings.notifications.push_appointments")]
    ].each do |field, label| %>
      <div class="flex items-center justify-between py-1.5 opacity-40 pointer-events-none">
        <div class="flex items-center gap-2">
          <span class="text-brand-secondary text-sm font-medium"><%= label %></span>
          <span class="bg-brand-field rounded-full px-2 py-0.5 text-brand-primary text-xs"><%= t("settings.edit.coming_soon") %></span>
        </div>
        <%= render "shared/toggle_switch",
              field_id: field,
              checked: prefs[field].nil? ? true : prefs[field],
              aria_label: label %>
      </div>
    <% end %>
    <div class="border-b border-brand-divider mt-2"></div>

    <%# Good morning set %>
    <div class="flex items-center justify-between py-3.5 pb-1">
      <span class="text-brand-primary text-base font-medium"><%= t("settings.notifications.good_morning") %></span>
      <%= render "shared/toggle_switch",
            field_id: "cycle_reminder",
            checked: @notifications.cycle_reminder,
            aria_label: "Good morning set" %>
    </div>
    <div class="mb-3">
      <p class="text-brand-muted text-sm font-medium m-0"><%= t("settings.notifications.summary_time") %></p>
      <p class="text-brand-primary text-[10px] font-medium mt-1 leading-relaxed">
        Superpower of the day, pay attention to, mood, sport, nutrition, fertility
      </p>
    </div>
    <div class="border-b border-brand-divider"></div>

    <%# Period reminder %>
    <div class="flex items-center justify-between py-3.5 pb-1">
      <span class="text-brand-primary text-base font-medium"><%= t("settings.notifications.period_reminder") %></span>
      <%= render "shared/toggle_switch",
            field_id: "period_prediction",
            checked: @notifications.period_prediction,
            aria_label: "Period reminder" %>
    </div>
    <div class="flex items-center justify-between mb-3">
      <div class="flex gap-4">
        <p class="text-brand-muted text-sm font-medium m-0"><%= t("settings.notifications.start_time") %></p>
        <p class="text-brand-muted text-sm font-medium m-0"><%= t("settings.notifications.end_time") %></p>
      </div>
      <%= link_to t("settings.notifications.edit"), notification_period_settings_path, class: "text-brand-muted text-sm font-medium no-underline" %>
    </div>
    <div class="border-b border-brand-divider"></div>

    <%# Birth control reminder %>
    <div class="flex items-center justify-between py-3.5 pb-1">
      <span class="text-brand-primary text-base font-medium"><%= t("settings.notifications.birth_control") %></span>
      <%= render "shared/toggle_switch",
            field_id: "ovulation_alert",
            checked: @notifications.ovulation_alert,
            aria_label: "Birth control reminder" %>
    </div>
    <div class="flex items-center justify-between mb-3">
      <div>
        <p class="text-brand-muted text-sm font-medium m-0 mb-0.5">birth control pill</p>
        <p class="text-brand-muted text-sm font-medium m-0 mb-0.5">Daily → 09:00 p.m.</p>
        <p class="text-brand-muted text-sm font-medium m-0 mb-0.5">Taking the pill → 21 Days</p>
        <p class="text-brand-muted text-sm font-medium m-0 mb-0.5">Pillbreak → 7 Days</p>
        <p class="text-brand-primary text-[10px] font-medium m-0 leading-relaxed">
          Keep track of: Today is day 15 of taking the pill
        </p>
      </div>
      <%= link_to t("settings.notifications.edit"), notification_birth_control_settings_path, class: "text-brand-muted text-sm font-medium no-underline self-start" %>
    </div>
    <div class="border-b border-brand-divider"></div>

    <%# Supplement reminder — no SendSupplementRemindersJob exists at all (unlike
        morning/period/birth-control), and "Edit" was never a real link, so
        there's no way to configure this. Locked until the feature is built. %>
    <div class="opacity-40 pointer-events-none">
      <div class="flex items-center justify-between py-3.5 pb-1">
        <div class="flex items-center gap-2">
          <span class="text-brand-primary text-base font-medium"><%= t("settings.notifications.supplement") %></span>
          <span class="bg-brand-field rounded-full px-2 py-0.5 text-brand-primary text-xs"><%= t("settings.edit.coming_soon") %></span>
        </div>
        <%= render "shared/toggle_switch",
              field_id: "newsletter",
              checked: @notifications.newsletter,
              aria_label: "Supplement reminder" %>
      </div>
      <div class="flex items-center justify-between mb-3">
        <p class="text-brand-muted text-sm font-medium m-0"><%= t("settings.notifications.daily_pm") %></p>
        <span class="text-brand-muted text-sm font-medium"><%= t("settings.notifications.edit") %></span>
      </div>
    </div>
    <div class="border-b border-brand-divider"></div>

    <%# In-App Popups — same gap as the push sub-toggles above: nothing reads
        the in_app reminder or notification_preferences back out yet. %>
    <% inapp_on = @notifications.email_notifications %>
    <div class="opacity-40 pointer-events-none">
      <div class="flex items-center justify-between py-3.5 pb-2">
        <div class="flex items-center gap-2">
          <span class="text-brand-primary text-base font-medium"><%= t("settings.notifications.in_app_popups") %></span>
          <span class="bg-brand-field rounded-full px-2 py-0.5 text-brand-primary text-xs"><%= t("settings.edit.coming_soon") %></span>
        </div>
        <%= render "shared/toggle_switch",
              field_id: "email_notifications",
              checked: inapp_on,
              aria_label: "In-App Popups" %>
      </div>
      <% [
        ["in_app_new_appt_synced",   t("settings.notifications.in_app_new_appt")],
        ["in_app_tracking_reminder", t("settings.notifications.in_app_tracking")],
        ["in_app_new_feedback",      t("settings.notifications.in_app_new_feedback")],
        ["in_app_app_updates",       t("settings.notifications.in_app_app_updates")],
        ["in_app_appointments",      t("settings.notifications.in_app_appointments")]
      ].each do |field, label| %>
        <div class="flex items-center justify-between py-1.5">
          <span class="text-brand-secondary text-sm font-medium"><%= label %></span>
          <%= render "shared/toggle_switch",
                field_id: field,
                checked: prefs[field].nil? ? true : prefs[field],
                aria_label: label %>
        </div>
      <% end %>
    </div>

  </div>
</div>

<%= render "shared/calendar_center_fab", bg: "bg-brand-field" %>
