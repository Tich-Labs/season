<%# My Subscriptions screen - matches Figma node 12048:16129 %>
<%# Every settings page/sub-page gets the centred calendar button (see
     settings/edit.html.erb) instead of the default FABs. %>
<% content_for(:hide_quick_actions) { "true" } %>
<% content_for(:hide_calendar_fab) { "true" } %>
<% content_for(:header_left) do %>
  <%= link_to edit_settings_path, class: "p-2 flex items-center" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
      <line x1="19" y1="12" x2="5" y2="12" />
      <polyline points="12 19 5 12 12 5" />
    </svg>
  <% end %>
<% end %>

<div class="bg-white min-h-screen">
  <div class="max-w-app mx-auto px-4 pb-8">

    <%# ── My Subscriptions ── %>
    <div class="flex items-center gap-4 py-5 pb-2">
      <%= vuesax_icon "bag", size: 24 %>
      <h2 class="text-brand-primary text-base font-bold"><%= t("settings.subscriptions.title") %></h2>
    </div>
    <div class="border-b border-brand-divider"></div>

    <%# My Plan %>
    <div class="flex items-center gap-4 py-4">
      <%= image_tag "icons/vuesax/linear/note-2.svg", class: "w-6 h-6" %>
      <span class="flex-1 text-brand-primary text-base font-medium"><%= t("settings.subscriptions.my_plan") %></span>
      <span class="text-brand-muted text-sm"><%= @subscription.plan %></span>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="#933a35" stroke-width="2" viewBox="0 0 24 24">
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </div>

    <%# View invoices %>
    <div class="flex items-center gap-4 py-4">
      <%= image_tag "icons/vuesax/linear/receipt-item.svg", class: "w-6 h-6" %>
      <span class="flex-1 text-brand-primary text-base font-medium"><%= t("settings.subscriptions.view_invoices") %></span>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="#933a35" stroke-width="2" viewBox="0 0 24 24">
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </div>

    <%# Payment method %>
    <div class="flex items-center gap-4 py-4">
      <%= image_tag "icons/vuesax/linear/card-pos.svg", class: "w-6 h-6" %>
      <span class="flex-1 text-brand-primary text-base font-medium"><%= t("settings.subscriptions.payment_method") %></span>
      <span class="text-brand-muted text-sm"><%= @subscription.payment_method %></span>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="#933a35" stroke-width="2" viewBox="0 0 24 24">
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </div>

    <%# Season Premium card (Coming Soon) %>
    <div class="relative mt-8">
      <div class="bg-phase-ovulation rounded-lg p-5 opacity-40 pointer-events-none">
        <span class="text-white text-sm"><%= t("settings.subscriptions.change_to") %></span>
        <div class="mt-2">
          <span class="text-white text-xl font-bold tracking-wide">Season Premium</span>
        </div>
        <div class="border-b border-white/50 mt-2"></div>

        <%# Yearly option %>
        <div id="plan-yearly" class="flex items-center gap-3 mt-4">
          <div class="w-5 h-5 bg-stone-400 rounded-full border-2 border-white flex items-center justify-center">
            <div class="hidden w-2.5 h-2.5 bg-white rounded-full"></div>
          </div>
          <div>
            <span class="text-white text-base font-bold"><%= t("settings.subscriptions.yearly_price") %></span>
            <span class="block text-white text-sm"><%= t("settings.subscriptions.monthly_price") %></span>
          </div>
        </div>

        <%# Monthly option %>
        <div id="plan-monthly" class="flex items-center gap-3 mt-3">
          <div class="w-5 h-5 bg-stone-400 rounded-full border-2 border-white flex items-center justify-center">
            <div class="hidden w-2.5 h-2.5 bg-white rounded-full"></div>
          </div>
          <div>
            <span class="text-white text-base font-bold"><%= t("settings.subscriptions.monthly_label") %></span>
            <span class="block text-white text-sm"><%= t("settings.subscriptions.yearly_total") %></span>
          </div>
        </div>

        <%# Upgrade button %>
        <div class="bg-white rounded-lg p-3 mt-4 text-center">
          <span class="text-brand-secondary text-base font-medium"><%= t("settings.subscriptions.upgrade") %></span>
        </div>

        <%# Student discount %>
        <div class="text-center mt-4 pb-1">
          <a href="#" class="text-white no-underline underline">
            <%= t("settings.subscriptions.student_discount") %> <span class="font-bold"><%= t("settings.subscriptions.discount") %></span>
          </a>
        </div>
      </div>
      <div class="absolute right-2 -top-1 bg-brand-field rounded-full px-2.5 py-1 z-10">
        <span class="text-brand-primary text-xs"><%= t("settings.edit.coming_soon") %></span>
      </div>
    </div>

    <script nonce="<%= content_security_policy_nonce %>">
      function selectPlan(plan) {
        document.getElementById('dot-yearly').classList.add('hidden');
        document.getElementById('dot-monthly').classList.add('hidden');
        if (plan === 'yearly') {
          document.getElementById('dot-yearly').classList.remove('hidden');
        } else if (plan === 'monthly') {
          document.getElementById('dot-monthly').classList.remove('hidden');
        }
      }
    </script>

  </div>
</div>
