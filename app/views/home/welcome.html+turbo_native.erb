<div class="bg-white min-h-screen flex flex-col items-center justify-between px-8 max-w-app mx-auto" style="padding-top:calc(40px+env(safe-area-inset-top,0px));padding-bottom:calc(120px+env(safe-area-inset-bottom,0px))">

  <div class="flex-1 flex flex-col items-center justify-center">
    <%= image_tag "screen1logo.png", class: "w-[180px] h-[196px] object-contain", alt: "Season" %>
    <%= image_tag "season-wortmarke-1.svg", class: "w-[240px] h-auto block mx-auto mt-4", alt: "Season" %>
  </div>

  <div class="w-full text-center">
    <p class="text-brand-primary text-base font-normal mb-8 leading-relaxed">
      <%= t('home.welcome_text', default: 'Welcome to Season! Maximize your productivity with the help of your cycle.') %>
    </p>

    <%= link_to t('home.lets_go', default: 'Lets go'),
        new_registration_path,
        class: "block w-[322px] h-[52px] leading-[52px] bg-brand-primary text-white text-center rounded-lg font-medium text-[22px] no-underline mx-auto mb-5" %>

    <%= link_to t('home.have_account', default: 'I already have an account'),
        new_session_path,
        class: "block text-brand-primary text-center font-medium text-[22px] no-underline" %>
  </div>

</div>
