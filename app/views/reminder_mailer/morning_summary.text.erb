<%
  focus = [
    [t(".superpower"), "⚡", t(".focus.superpower.#{@phase}")],
    [t(".movement"), "🏃", t(".focus.movement.#{@phase}")],
    [t(".nutrition"), "🥗", @content&.nutrition_text.presence || t(".focus.nutrition.#{@phase}")]
  ]
-%>
<%= t(".greeting", name: @user.name.split.first) %>
<%= l(Date.current, format: t("reminder_mailer.common.date_format")) %>

<%= t(".text_heading") %>
<%= "-" * t(".text_heading").length %>

<%= t(".text_cycle_phase", phase: t("phases.#{@phase}"), season: t("seasons.#{@phase_meta[:season].downcase}")) %>
<% if @cycle_day %><%= t("reminder_mailer.common.day_of_cycle", day: @cycle_day) %><% end %>

<%= t(".text_focus") %>
<%= "-" * t(".text_focus").length %>

<% focus.each do |label, icon, tip| -%>
<%= icon %> <%= label %>
<%= tip %>

<% end -%>
---
<%= t("reminder_mailer.common.open_season") %>: <%= root_url %>
<%= t("reminder_mailer.common.manage_reminders") %>: <%= notifications_settings_url %>
