<%= @event_type == "period_start" ? t(".headline_start") : t(".headline_end") %>

<% if @predicted_date %>
<%= @event_type == "period_start" ? t(".expected_start") : t(".expected_end") %>: <%= l(@predicted_date, format: t("reminder_mailer.common.date_format")) %>
<% end %>

<% if @event_type == "period_start" %>
<%= t(".body_start") %>
<% else %>
<%= t(".body_end") %>
<% end %>

