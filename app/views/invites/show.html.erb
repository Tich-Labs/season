<div class="bg-white min-h-dvh flex flex-col items-center justify-between px-8 max-w-app mx-auto" style="padding-top:calc(60px + env(safe-area-inset-top,0px));padding-bottom:calc(3rem + env(safe-area-inset-bottom,0px))">

  <div class="flex-1 flex flex-col items-center justify-center">
    <%= image_tag "screen1logo.png", class: "w-[180px] h-auto", alt: "Season" %>
    <%= image_tag "season-wortmarke-1.svg", class: "w-[200px] h-auto mt-4", alt: "Season" %>
  </div>

  <div class="w-full">
    <p class="text-brand-primary text-[22px] font-medium text-center mb-2">
      <%= t('invites.show.welcome') %>
    </p>
    <p class="text-brand-secondary text-base text-center mb-8">
      <%= t('invites.show.create_password') %>
    </p>

    <%= form_with url: invite_path(params[:token]), method: :patch do |f| %>
      <% if @user&.errors.any? %>
        <div class="bg-brand-error rounded-lg p-3 mb-4">
          <p class="text-brand-primary text-sm"><%= @user.errors.full_messages.join(", ") %></p>
        </div>
      <% end %>

      <div class="relative mb-4" data-controller="password-visibility">
        <%= f.password_field :password,
            placeholder: t('invites.show.password_placeholder'),
            required: true,
            autocomplete: "new-password",
            class: "w-full bg-brand-field rounded-lg py-3.5 pr-[50px] pl-[21px] h-[52px] border-none text-lg text-brand-primary outline-none box-border",
            data: { "password-visibility-target": "input" } %>
        <button type="button" aria-label="Toggle password visibility" data-action="click->password-visibility#toggle" class="absolute right-4 top-1/2 -translate-y-1/2 bg-none border-none p-0 cursor-pointer">
          <svg data-password-visibility-target="eyeOpen" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="rgba(147,58,53,0.5)" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
          <svg data-password-visibility-target="eyeClosed" class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="rgba(147,58,53,0.5)" stroke-width="1.5"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" /><line x1="1" y1="1" x2="23" y2="23" /></svg>
        </button>
      </div>

      <div class="relative mb-6" data-controller="password-visibility">
        <%= f.password_field :password_confirmation,
            placeholder: t('invites.show.confirm_placeholder'),
            required: true,
            autocomplete: "new-password",
            class: "w-full bg-brand-field rounded-lg py-3.5 pr-[50px] pl-[21px] h-[52px] border-none text-lg text-brand-primary outline-none box-border",
            data: { "password-visibility-target": "input" } %>
        <button type="button" aria-label="Toggle password visibility" data-action="click->password-visibility#toggle" class="absolute right-4 top-1/2 -translate-y-1/2 bg-none border-none p-0 cursor-pointer">
          <svg data-password-visibility-target="eyeOpen" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="rgba(147,58,53,0.5)" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
          <svg data-password-visibility-target="eyeClosed" class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="rgba(147,58,53,0.5)" stroke-width="1.5"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" /><line x1="1" y1="1" x2="23" y2="23" /></svg>
        </button>
      </div>

      <%= f.submit t('invites.show.submit'),
          class: "w-full h-[52px] bg-brand-primary text-white text-lg font-medium rounded-lg border-none cursor-pointer" %>
    <% end %>
  </div>

</div>
