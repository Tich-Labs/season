<%= render "beta_onboarding/shared/shell", step: 3 do %>
  <%= render "beta_onboarding/shared/wordmark" %>

  <h1 class="beta-h1 beta-h1--inline">
    <span class="beta-check-mark" aria-hidden="true">✓</span>
    <%= t("beta_onboarding.confirmed.title") %>
  </h1>
  <p class="beta-sub"><%= t("beta_onboarding.confirmed.subtitle") %></p>

  <div class="beta-next">
    <h3 class="beta-next__title"><%= t("beta_onboarding.confirmed.platform.#{@platform.downcase}.title") %></h3>
    <%# iOS points straight at Apple's TestFlight page, which already walks the
        user through installing TestFlight and then Season — so a one-line note
        replaces the step list there instead of duplicating Apple's steps. %>
    <% note = t("beta_onboarding.confirmed.platform.#{@platform.downcase}.note", default: nil) %>
    <% if note.present? %>
      <p class="beta-next__note"><%= note %></p>
    <% else %>
      <%# Show the "tap the button" steps only when a link actually renders below;
          otherwise fall back to the email-invitation steps. %>
      <% steps_key = (@platform.casecmp("Web").zero? || @download_link.present? || @group_link.present?) ? "steps" : "steps_email" %>
      <ol class="beta-next__steps">
        <% t("beta_onboarding.confirmed.platform.#{@platform.downcase}.#{steps_key}").each do |step| %>
          <li><%= step %></li>
        <% end %>
      </ol>
    <% end %>
    <% if @platform.casecmp("Web").zero? %>
      <a class="beta-cta beta-next__cta" href="https://seasonv2.onrender.com/welcome" target="_blank" rel="noopener">
        <%= t("beta_onboarding.confirmed.open_web") %>
      </a>
    <% elsif @platform.casecmp("Android").zero? %>
      <% if @group_link.present? %>
        <a class="beta-cta beta-next__cta" href="<%= @group_link %>" target="_blank" rel="noopener">
          <%= t("beta_onboarding.confirmed.open_group") %>
        </a>
      <% end %>
      <% if @download_link.present? %>
        <a class="beta-cta beta-next__cta" href="<%= @download_link %>" target="_blank" rel="noopener">
          <%= t("beta_onboarding.confirmed.open_android") %>
        </a>
      <% end %>
    <% elsif @download_link.present? %>
      <a class="beta-cta beta-next__cta" href="<%= @download_link %>" target="_blank" rel="noopener">
        <%= t("beta_onboarding.confirmed.open_ios") %>
      </a>
    <% end %>
  </div>

  <p class="beta-hint">
    <%= t("beta_onboarding.confirmed.help") %> shanel@season.vision
  </p>
<% end %>
