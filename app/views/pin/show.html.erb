<% content_for(:title) { "Unlock" } %>
<% content_for(:header_dark) { true } %>

<div class="flex flex-col items-center justify-center min-h-[calc(100dvh - 8rem)] px-4">
  <div class="w-16 h-16 rounded-full bg-brand-field flex items-center justify-center mb-6">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" stroke="#933a35" stroke-width="1.5" viewBox="0 0 24 24">
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
      <path d="M7 11V7a5 5 0 0 1 10 0v4" />
    </svg>
  </div>

  <h1 class="text-2xl font-semibold text-brand-primary mb-2"><%= t("pin.title", default: "Enter Access Code") %></h1>
  <p class="text-sm text-brand-secondary mb-8"><%= t("pin.subtitle", default: "Enter your code to unlock Season") %></p>

  <% if authenticated? && current_user.webauthn_credentials.any? %>
    <button data-controller="webauthn" data-action="webauthn#authenticate"
            class="mb-6 px-6 py-3 bg-white border-2 border-brand-primary text-brand-primary rounded-xl text-base font-semibold flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="#933a35" stroke-width="1.5" viewBox="0 0 24 24">
        <path d="M21 12a28 28 0 0 0-8-1 28 28 0 0 0-8 1" />
        <path d="M3 12v6a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-6" />
        <path d="M12 10a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
      </svg>
      Use Face ID / Touch ID
    </button>
  <% end %>

  <%= form_tag pin_unlock_path, method: :post, class: "w-full max-w-xs", data: { controller: "pin-entry" } do %>
    <div class="flex justify-center gap-3 mb-8 cursor-text" data-pin-entry-target="dots" data-action="click->pin-entry#focusInput">
      <% 4.times do %>
        <div class="w-4 h-4 rounded-full border-2 border-brand-primary" data-pin-entry-target="dot"></div>
      <% end %>
    </div>

    <%= password_field_tag :pin, nil,
          autocomplete: "off",
          inputmode: "numeric",
          pattern: "[0-9]*",
          maxlength: 6,
          class: "opacity-0 absolute -z-10",
          data: { action: "input->pin-entry#input keydown->pin-entry#backspace",
                  pin_entry_target: "input" },
          autofocus: true %>

    <%= submit_tag t("pin.unlock", default: "Unlock"), class: "w-full py-3 bg-brand-primary text-white rounded-xl text-base font-semibold" %>
  <% end %>

  <% if flash[:alert] %>
    <p class="mt-4 text-brand-primary text-sm"><%= flash[:alert] %></p>
  <% end %>

  <button data-action="click->pin-entry#logout" class="mt-6 text-brand-secondary text-sm underline">
    <%= t("pin.logout", default: "Sign out") %>
  </button>
</div>
