<% if @pin_unlock_required %>
<div id="pin-unlock-modal"
     role="dialog"
     aria-modal="true"
     aria-labelledby="pin-unlock-title"
     class="fixed inset-0 z-[100] flex items-center justify-center bg-black/40 backdrop-blur-sm"
     data-controller="pin-entry"
     data-pin-entry-modal-value="true"
     data-pin-entry-show-label-value="<%= t('pin.show_pin', default: 'Show PIN') %>"
     data-pin-entry-hide-label-value="<%= t('pin.hide_pin', default: 'Hide PIN') %>"
     data-pin-entry-target="modal">

  <div class="w-full max-w-xs mx-4 bg-white rounded-[25px] px-6 pt-8 pb-6 shadow-xl cursor-text"
       data-action="click->pin-entry#focusInput">

    <div class="flex flex-col items-center">
      <div class="w-14 h-14 rounded-full bg-brand-field flex items-center justify-center mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#933a35" stroke-width="1.5" viewBox="0 0 24 24">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
          <path d="M7 11V7a5 5 0 0 1 10 0v4" />
        </svg>
      </div>

      <h2 id="pin-unlock-title" class="text-xl font-semibold text-brand-primary mb-1"><%= t("pin.title", default: "Enter Access Code") %></h2>
      <p class="text-sm text-brand-secondary mb-6"><%= t("pin.subtitle", default: "Enter your code to unlock Season") %></p>

      <div class="flex items-center justify-center gap-4 mb-6">
        <div class="flex justify-center gap-3 cursor-text" data-pin-entry-target="dots" data-action="click->pin-entry#focusInput">
          <% 4.times do %>
            <div class="w-4 h-4 rounded-full border-2 border-brand-primary" data-pin-entry-target="dot"></div>
          <% end %>
        </div>

        <div class="hidden min-w-[4ch] text-center text-2xl font-semibold tracking-[6px] text-brand-primary cursor-text"
             data-pin-entry-target="digits" data-action="click->pin-entry#focusInput"></div>

        <button type="button"
                class="shrink-0 text-brand-secondary"
                data-action="click->pin-entry#toggleReveal"
                data-pin-entry-target="revealButton"
                aria-pressed="false"
                aria-label="<%= t('pin.show_pin', default: 'Show PIN') %>">
          <svg data-pin-entry-target="eyeOpen" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
            <circle cx="12" cy="12" r="3" />
          </svg>
          <svg data-pin-entry-target="eyeClosed" class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M3 3l18 18" />
            <path d="M10.58 10.58a2 2 0 0 0 2.83 2.83" />
            <path d="M9.88 5.09A9.77 9.77 0 0 1 12 5c6.5 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68M6.61 6.61A13.13 13.16 0 0 0 2 12s3.5 7 10 7a9.7 9.7 0 0 0 5.06-1.36" />
          </svg>
        </button>
      </div>

      <input type="password" inputmode="numeric" pattern="[0-9]*" maxlength="6" autocomplete="off"
             aria-label="<%= t('pin.input_label', default: 'PIN code') %>"
             class="opacity-0 absolute -z-10"
             data-action="input->pin-entry#input keydown->pin-entry#backspace"
             data-pin-entry-target="input" autofocus>

      <div data-pin-entry-target="error" role="alert" aria-live="polite" class="text-brand-primary text-sm mb-2 hidden"></div>
    </div>

    <div class="flex justify-center mt-4">
      <button data-action="click->pin-entry#logout" class="text-brand-secondary text-sm underline">
        <%= t("pin.logout", default: "Sign out") %>
      </button>
    </div>
  </div>
</div>
<% end %>
