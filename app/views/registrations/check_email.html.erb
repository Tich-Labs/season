<div class="bg-white min-h-dvh flex flex-col items-center justify-between px-8 max-w-app mx-auto" style="padding-top:calc(60px + env(safe-area-inset-top,0px));padding-bottom:calc(3rem + env(safe-area-inset-bottom,0px))">

  <div class="w-full flex justify-center">
    <%= image_tag "screen1logo.png", alt: "Season", class: "w-[234px] h-auto" %>
  </div>

  <div class="w-full text-center">
    <h1 class="text-brand-primary text-[36px] font-bold uppercase tracking-[3.24px] leading-tight mb-6">
      <%= t('registrations.check_email.title') %>
    </h1>
    <p class="text-brand-secondary text-base leading-relaxed">
      <%= t('registrations.check_email.description') %>
    </p>
  </div>

  <div class="w-full text-center space-y-4">
    <%= link_to t('registrations.check_email.resend'), new_user_confirmation_path,
        class: "block text-brand-primary text-base font-normal no-underline underline" %>
    <%= link_to "Back to login", new_session_path,
        class: "block text-brand-secondary text-sm font-normal no-underline" %>
  </div>

</div>
