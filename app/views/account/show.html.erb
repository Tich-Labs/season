<%# Account / Delete Account screen %>
<%# Utility/destructive-confirmation screen, not a primary app screen — no FAB. %>
<% content_for(:hide_quick_actions) { "true" } %>
<% content_for(:hide_calendar_fab) { "true" } %>
<%# AccountController isn't under the settings/ namespace, so it doesn't get
     the dark header for free the way settings/* pages do — was rendering
     light (bg-brand-field) with a white back-arrow icon, nearly invisible
     against it. %>
<% content_for(:header_dark) { "true" } %>
<% content_for(:page_title) { t("accounts.show.title") } %>
<%# Its only real entry point is settings/profile.html.erb's "Delete Account"
     row — was hardcoded to edit_settings_path instead. %>
<% content_for(:header_left) do %>
  <%= link_to safe_back_path(profile_settings_path, allowed: [profile_settings_path]), class: "p-2 flex items-center" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
      <line x1="19" y1="12" x2="5" y2="12" />
      <polyline points="12 19 5 12 12 5" />
    </svg>
  <% end %>
<% end %>

<div class="bg-white min-h-screen">
  <div class="max-w-app mx-auto px-4 pb-20">

    <div class="py-5 pb-2">
      <h2 class="text-brand-primary text-base font-bold"><%= t('accounts.show.title') %></h2>
    </div>
    <div class="border-b border-brand-divider"></div>

    <div class="text-center py-10 px-5">
      <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="none" stroke="#933a35" stroke-width="1.5" viewBox="0 0 24 24" class="mx-auto mb-4">
        <polyline points="3 6 5 6 21 6" />
        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
      </svg>
      <h3 class="text-brand-primary text-xl font-semibold mb-3"><%= t('accounts.show.title') %></h3>
      <p class="text-brand-secondary text-sm leading-relaxed mb-6">
        <%= t('accounts.show.warning') %>
      </p>

      <ul class="text-left text-brand-secondary text-sm leading-loose mb-6 pl-5">
        <li>Cycle tracking history</li>
        <li>Symptom logs</li>
        <li>Superpower entries</li>
        <li>Calendar events</li>
        <li>Reminders</li>
        <li>Streaks & achievements</li>
        <li>Profile picture</li>
      </ul>

      <div class="bg-brand-error rounded-xl px-4 py-3 mb-6">
        <p class="text-brand-primary text-sm font-medium">
          <%= t('accounts.show.irreversible') %>
        </p>
      </div>
    </div>

    <%= form_with url: account_path, method: :delete, data: { turbo_confirm: t('accounts.show.confirm') } do %>
      <button type="submit" class="w-full bg-brand-primary text-white rounded-xl py-4 text-base font-medium cursor-pointer border-none">
        <%= t('accounts.show.delete_button') %>
      </button>
    <% end %>

    <%= link_to t('accounts.show.cancel'), safe_back_path(profile_settings_path, allowed: [profile_settings_path]),
        class: "block w-full text-center text-brand-primary border border-brand-divider rounded-xl py-4 text-base font-medium mt-3 no-underline" %>

  </div>
</div>
