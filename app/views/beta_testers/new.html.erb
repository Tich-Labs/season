<div class="min-h-screen min-h-dvh flex items-center justify-center px-4 py-8 sm:px-6 lg:px-8"
     style="padding-top:calc(2rem + env(safe-area-inset-top, 0px));padding-bottom:calc(2rem + env(safe-area-inset-bottom, 0px))">

  <div class="w-full max-w-5xl overflow-hidden rounded-[2rem] bg-brand-field shadow-sm">

    <div class="grid md:grid-cols-2">

      <%# LEFT: Season visual panel (desktop) %>
      <div class="relative hidden min-h-[620px] flex-col justify-center overflow-hidden bg-brand-light p-10 md:flex lg:p-12">
        <div class="mt-10 flex flex-col items-center">
          <%= image_tag "screen1logo.png", alt: "Season", class: "w-[180px] h-auto object-contain" %>
          <%= image_tag "season-wortmarke-1.svg", alt: "Season", class: "w-[220px] h-auto object-contain mt-4" %>
        </div>

        <div class="relative z-10 mt-12 max-w-sm self-center text-center md:text-left">
          <p class="mb-3 text-sm font-medium uppercase tracking-[0.15em] text-brand-primary/60">Season V2</p>
          <h2 class="text-3xl font-semibold leading-tight text-brand-primary lg:text-4xl">
            Help us shape the next version of Season.
          </h2>
          <p class="mt-5 text-base leading-relaxed text-brand-dark/65">
            Join our beta testing community and help us make Season better through your feedback and real-world experience.
          </p>
        </div>

        <%# Decorative circles %>
        <div class="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-brand-primary/5"></div>
        <div class="absolute -right-24 top-1/3 h-64 w-64 rounded-full bg-white/40"></div>
      </div>

      <%# RIGHT: registration form %>
      <div class="bg-brand-field px-6 py-10 sm:px-10 sm:py-12 lg:px-14 lg:py-14">

        <% if @registered %>
          <%# Confirmation state %>
          <div class="mx-auto max-w-md text-center" data-testid="beta-confirmation">
            <%= render "beta_testers/terminal_icon" %>

            <h1 class="text-balance text-3xl font-semibold leading-tight tracking-tight text-brand-primary sm:text-4xl">
              Thank you for signing up to test Season V2.
            </h1>

            <p class="mx-auto mt-6 text-pretty text-base leading-relaxed text-brand-dark/70">
              We've received your registration. We'll send you the appropriate testing instructions once access is ready.
            </p>

            <div class="mx-auto mt-8 flex items-start gap-3 rounded-2xl bg-brand-primary/5 px-5 py-4 text-left">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-primary/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 8l9 6 9-6" />
              </svg>
              <p class="text-pretty text-sm leading-relaxed text-brand-dark/60">
                Keep an eye on your inbox — and your spam folder, just in case the email gets filtered.
              </p>
            </div>
          </div>

        <% elsif @already_registered %>
          <%# Already-registered state — a terminal outcome, not a form error %>
          <div class="mx-auto max-w-md text-center" data-testid="beta-duplicate">
            <%= render "beta_testers/terminal_icon" %>

            <h1 class="text-balance text-3xl font-semibold leading-tight tracking-tight text-brand-primary sm:text-4xl">
              You're already on the list.
            </h1>

            <p class="mx-auto mt-6 text-pretty text-base leading-relaxed text-brand-dark/70">
              This email address is already registered for the Season beta, so there's nothing more to do here. We'll email your testing instructions once access is ready.
            </p>

            <div class="mx-auto mt-8 flex items-start gap-3 rounded-2xl bg-brand-primary/5 px-5 py-4 text-left">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-primary/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 8l9 6 9-6" />
              </svg>
              <p class="text-pretty text-sm leading-relaxed text-brand-dark/60">
                Already on the list? Nothing to do — just check your inbox and spam folder for your instructions.
              </p>
            </div>
          </div>

        <% else %>
          <%# Mobile logo %>
          <div class="mb-8 flex flex-col items-center md:hidden">
            <%= image_tag "screen1logo.png", alt: "Season", class: "w-[120px] h-auto object-contain" %>
            <%= image_tag "season-wortmarke-1.svg", alt: "Season", class: "w-[180px] h-auto object-contain mt-3" %>
          </div>

          <%# Heading %>
          <div class="mb-8">
            <p class="mb-2 text-sm font-medium uppercase tracking-[0.12em] text-brand-primary/60">Season V2</p>
            <h1 class="text-3xl font-semibold tracking-tight text-brand-primary sm:text-4xl">Become a beta tester</h1>
            <p class="mt-3 max-w-lg text-base leading-relaxed text-brand-dark/65">
              Register for beta access to the Season app and help us shape the next version of Season.
            </p>
          </div>

          <%# Validation summary (the duplicate case now renders as its own state above) %>
          <% if @beta_tester.errors.any? %>
            <div class="mb-6 rounded-xl bg-brand-error px-4 py-3">
              <p class="text-sm text-brand-primary">Please check the highlighted fields and try again.</p>
            </div>
          <% end %>

          <%= form_with model: @beta_tester, url: beta_path, method: :post,
                data: { turbo: false },
                html: { novalidate: true, class: "space-y-6" } do |f| %>

            <%# Name %>
            <div>
              <%= f.label :name, "Name", class: "mb-2 block text-sm font-semibold text-brand-primary" %>
              <%= f.text_field :name,
                    required: true,
                    placeholder: "Your full name",
                    class: "w-full rounded-xl border bg-white px-4 py-3.5 text-base text-brand-dark placeholder:text-brand-dark/35 focus:border-brand-primary focus:outline-none focus:ring-2 focus:ring-brand-primary/15 #{(@beta_tester.errors.include?(:name) ? 'border-brand-primary' : 'border-brand-divider')}" %>
              <% if @beta_tester.errors.include?(:name) %>
                <p class="mt-1.5 text-xs text-brand-primary"><%= @beta_tester.errors.full_messages_for(:name).to_sentence %></p>
              <% end %>
            </div>

            <%# Email %>
            <div>
              <%= f.label :email, "Email", class: "mb-2 block text-sm font-semibold text-brand-primary" %>
              <%= f.email_field :email,
                    required: true,
                    placeholder: "you@example.com",
                    class: "w-full rounded-xl border bg-white px-4 py-3.5 text-base text-brand-dark placeholder:text-brand-dark/35 focus:border-brand-primary focus:outline-none focus:ring-2 focus:ring-brand-primary/15 #{(@beta_tester.errors.include?(:email) ? 'border-brand-primary' : 'border-brand-divider')}" %>
              <% if @beta_tester.errors.include?(:email) && !@already_registered %>
                <p class="mt-1.5 text-xs text-brand-primary"><%= @beta_tester.errors.full_messages_for(:email).to_sentence %></p>
              <% end %>
            </div>

            <%# Platform %>
            <fieldset>
              <legend class="mb-3 block text-sm font-semibold text-brand-primary">Which device will you use to test Season?</legend>
              <div class="grid grid-cols-3 gap-3">
                <% { "ios" => "Apple iOS", "android" => "Android", "web" => "Web" }.each_with_index do |(value, label), i| %>
                  <label class="cursor-pointer">
                    <%= f.radio_button :platform, value,
                          required: i.zero?,
                          class: "peer sr-only" %>
                    <span class="flex min-h-[76px] items-center justify-center rounded-xl border border-brand-divider bg-white px-3 py-3 text-center text-sm font-medium text-brand-dark transition-all hover:border-brand-primary/40 peer-checked:border-brand-primary peer-checked:bg-brand-primary peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-brand-primary/30">
                      <%= label %>
                    </span>
                  </label>
                <% end %>
              </div>
              <% if @beta_tester.errors.include?(:platform) %>
                <p class="mt-1.5 text-xs text-brand-primary"><%= @beta_tester.errors.full_messages_for(:platform).to_sentence %></p>
              <% end %>
            </fieldset>

            <%# Consent %>
            <div class="rounded-xl bg-white/60 p-4">
              <label class="flex cursor-pointer items-start gap-3">
                <%= f.check_box :beta_consent,
                      required: true,
                      class: "mt-0.5 h-5 w-5 shrink-0 rounded border-brand-divider text-brand-primary focus:ring-brand-primary/30" %>
                <span class="text-sm leading-relaxed text-brand-dark/75">
                  <% before, after = @setting.consent_label_parts %>
                  <%= before %>
                  <%= link_to @setting.consent_link_text, @setting.consent_url,
                        target: "_blank", rel: "noopener",
                        class: "font-medium text-brand-primary underline underline-offset-2 hover:text-brand-primary-dark" %>
                  <%= after %>
                </span>
              </label>
              <% if @beta_tester.errors.include?(:beta_consent) %>
                <p class="mt-1.5 text-xs text-brand-primary"><%= @beta_tester.errors.full_messages_for(:beta_consent).to_sentence %></p>
              <% end %>
            </div>

            <%# Submit %>
            <%= f.submit "Let's go",
                  class: "w-full rounded-xl bg-brand-primary px-6 py-4 text-base font-semibold text-white transition-all hover:bg-brand-primary-dark focus:outline-none focus:ring-2 focus:ring-brand-primary/30 focus:ring-offset-2 cursor-pointer" %>
          <% end %>
        <% end %>

      </div>
    </div>
  </div>
</div>
