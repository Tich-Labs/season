<%
  phase_meta   = CycleCalculatorService::PHASE_META[@phase] || {}
  phase_colour = phase_meta[:colour] || "#933a35"
%>
<% content_for(:page_title) { t("symptoms.discharge.page_title") } %>
<% content_for(:header_color) { phase_colour } %>
<% content_for(:header_dark) { "true" } %>
<%# Not under settings/ or calendar#index, so the layout was showing both
     the "+" quick-actions FAB and the default calendar FAB stacked
     together. Keep only the centred calendar FAB (see
     shared/_calendar_center_fab.html.erb) instead of either. %>
<% content_for(:hide_quick_actions) { "true" } %>
<% content_for(:hide_calendar_fab) { "true" } %>
<% content_for(:header_left) do %>
  <%= link_to symptoms_path,
        style: "color:#933a35; font-size:15px; font-weight:500; text-decoration:none; padding:8px 4px; font-family:'Montserrat',sans-serif;" do %>
    <%= t("shared.back") %>
  <% end %>
<% end %>

<% discharge_types = [
    { value: 1, key: "dry", colour: "#D1C5BD" },
    { value: 2, key: "sticky", colour: "#C8B8A8" },
    { value: 3, key: "creamy", colour: "#B8A898" },
    { value: 4, key: "watery", colour: "#899884" },
    { value: 5, key: "egg_white", colour: "#50705b" }
  ]

  current_value = @log&.discharge %>

<div class="min-h-screen pb-28 bg-brand-background"
     data-controller="symptom"
     data-symptom-url-value="<%= symptoms_path %>"
     data-date="<%= Time.zone.today %>">

  <%# ── Phase banner ───────────────────────────────────────────────── %>
  <div class="w-full py-4 px-4" style="background:<%= phase_colour %>;">
    <div class="max-w-app mx-auto">
      <p class="text-white text-lg font-bold"><%= t("symptoms.discharge.title") %></p>
      <p class="text-white text-xs opacity-70 mt-0.5">
        <%= t("symptoms.discharge.cervical_mucus_tracking") %> &mdash; <%= l(Time.zone.today, format: :day_month_year) %>
      </p>
    </div>
  </div>

  <div class="max-w-app mx-auto px-4 pt-5">

    <p class="text-sm mb-5 leading-relaxed text-brand-secondary">
      <%= t("symptoms.discharge.intro") %>
    </p>

    <div class="flex flex-col gap-3">
      <% discharge_types.each do |type| %>
        <%
          selected = current_value == type[:value]
          border_style = selected ? "border:2px solid #{phase_colour};" : "border:2px solid transparent;"
        %>
        <button class="dot dot-group w-full text-left rounded-2xl px-5 py-4 flex items-start gap-4
                       transition-all duration-150"
                data-action="click->symptom#save"
                data-field="discharge"
                data-value="<%= type[:value] %>"
                aria-pressed="<%= selected %>"
                style="background:#ffffff; cursor:pointer; <%= border_style %>">

          <%# Colour swatch %>
          <div class="shrink-0 w-10 h-10 rounded-full mt-0.5"
               style="background:<%= type[:colour] %>;"></div>

          <div class="flex-1">
            <p class="font-semibold text-sm mb-0.5" style="color:#3d2b28;">
              <%= t("symptoms.discharge.types.#{type[:key]}.name") %>
            </p>
            <p class="text-xs leading-relaxed" style="color:#6B6B6B;">
              <%= t("symptoms.discharge.types.#{type[:key]}.description") %>
            </p>
          </div>

          <% if selected %>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none"
                 stroke="<%= phase_colour %>" stroke-width="2.5" viewBox="0 0 24 24"
                 class="shrink-0 mt-0.5" aria-hidden="true">
              <polyline points="20 6 9 17 4 12" />
            </svg>
          <% end %>

        </button>
      <% end %>
    </div>

    <%# Clear selection %>
    <% if current_value %>
      <button class="w-full mt-4 py-3 rounded-xl text-sm font-medium"
              style="background:#FDF0EE; color:#933a35; border:none; cursor:pointer;"
              data-action="click->symptom#save"
              data-field="discharge"
              data-value="">
        <%= t("symptoms.discharge.clear_selection") %>
      </button>
    <% end %>

  </div>
</div>

<%= render "shared/calendar_center_fab", bg: "bg-brand-field" %>
