<%
  phase_meta   = CycleCalculatorService::PHASE_META[@phase] || {}
  phase_colour = phase_meta[:colour] || "#933a35"
  phase_label  = @phase ? @phase.capitalize : "Unknown"
  phase_season = phase_meta[:season]

  # Phase-specific symptom name
  discharge_label = @phase == "menstrual" ? "Bleeding" : "vaginal discharge"

  # Completion flags (for checkmarks)
  mood_done         = @log.moods.present?
  physical_done     = @log.any_physical_symptom?
  mental_done       = @log.any_mental_symptom?
  discharge_done    = @log.discharge.present?
  bleeding_done     = @log.bleeding.present?
  intercourse_list = @log.intercourse_tags.present? ? @log.intercourse_tags.split(',').reject(&:blank?) : []
  intercourse_done  = intercourse_list.any?
  cravings_list    = @log.cravings.present? ? @log.cravings.split(',').reject { |c| c.blank? || c.match?(/\A\d+\z/) } : []
  cravings_done     = cravings_list.any?
  sleep_done        = @log.sleep.present?
  temperature_done  = @log.temperature.present?
  weight_done       = @log.weight.present?
  notes_done        = @log.notes.present?
%>
<% content_for(:page_title) { "My Symptoms" } %>
<% content_for(:header_dark) { "true" } %>
<% content_for(:header_color) { phase_colour } %>

<div class="bg-white min-h-screen pb-24"
     data-controller="symptom"
     data-symptom-url-value="<%= symptoms_path %>"
     data-date="<%= @date %>"
     data-active-moods="<%= (@log.moods || []).to_json %>"
     data-active-cravings="<%= cravings_list.to_json %>"
     data-active-intercourse="<%= intercourse_list.to_json %>"
     data-phase-color="<%= phase_colour %>">

  <%# ── Date picker drum ──────────────────────────────────────────────── %>
  <div class="flex justify-center pt-6 pb-2" data-controller="date-picker">
    <div class="relative bg-brand-field overflow-hidden transition-all duration-300 ease-out"
         style="width:155px; height:31px; border-radius:133px;"
         data-date-picker-target="drum">

      <%# Collapsed pill header %>
      <button class="w-full h-[31px] flex items-center justify-center gap-2 text-brand-primary font-medium text-base font-['Montserrat'] focus:outline-none"
              data-action="click->date-picker#toggle"
              aria-label="Select date">
        <%= @date.strftime("%-d %B") %>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none"
             stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true">
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </button>

      <%# Expanded content %>
      <div class="hidden" data-date-picker-target="content">
        <div class="flex justify-end px-4 pt-3 pb-0">
          <button data-action="click->date-picker#close" aria-label="Close date picker"
                  class="text-brand-primary focus:outline-none">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none"
                 stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true">
              <polyline points="18 15 12 9 6 15" />
            </svg>
          </button>
        </div>
        <ul class="overflow-y-auto text-center pb-3 scrollbar-hide" style="max-height:160px; scroll-snap-type:y mandatory;">
          <% ((Date.today - 29)..Date.today).each do |d| %>
            <li class="<%= d == @date ? 'bg-white/60 rounded-lg mx-2' : '' %>" style="scroll-snap-align:center;">
              <%= link_to d.strftime("%-d %B"), symptoms_path(date: d),
                    class: "block py-2 font-['Montserrat'] #{d == @date ? 'font-bold text-base text-brand-primary' : 'font-normal text-sm text-brand-primary opacity-50'}",
                    data: (d == @date ? { selected: true } : {}) %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>

  <%# ── Phase label ───────────────────────────────────────────────────── %>
  <div class="text-center pt-6 pb-5">
    <p class="text-brand-primary text-lg font-medium font-['Montserrat']">You are in your</p>
    <p class="font-extrabold text-3xl leading-tight font-['Montserrat']" style="color:<%= phase_colour %>;">
      <%= phase_label %> Phase
    </p>
  </div>

  <%# ── Symptom list (flat accordions) ────────────────────────────────── %>
  <div class="px-5">

    <%# Helper: scale dots row — renders 1-5 buttons for a given field %>
    <%# 1. Mood %>
    <details class="group border-b border-brand-field" id="section-mood">
      <summary class="flex items-center justify-between py-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
        <div class="flex items-center gap-3">
          <svg class="transition-transform duration-200 group-open:rotate-90 shrink-0"
               xmlns="http://www.w3.org/2000/svg" width="20" height="20"
               fill="none" stroke="<%= phase_colour %>" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <polyline points="9 18 15 12 9 6" />
          </svg>
          <span class="font-medium text-[22px] tracking-[0.66px]" id="mood-summary-label" style="color:<%= phase_colour %>;">
            Mood<%= " (#{@log.moods.length})" if @log.moods.present? %>
          </span>
        </div>
        <span id="section-mood-check" style="display:<%= mood_done ? '' : 'none' %>"><%= render 'symptoms/bi_check', colour: phase_colour %></span>
      </summary>
      <div class="pb-5 grid grid-cols-3 gap-4" role="group" aria-label="Mood picker">
        <% MoodPickerService.all.each do |mood_opt| %>
          <% selected = @log.moods&.include?(mood_opt[:name]) %>
          <% border_colour = mood_opt[:color] %>
          <button class="flex flex-col items-center justify-center gap-2 transition-all duration-150 focus:outline-none"
                  data-action="click->symptom#toggleMood" data-mood-name="<%= mood_opt[:name] %>"
                  data-value="<%= mood_opt[:name] %>"
                  aria-label="<%= mood_opt[:name] %>" aria-pressed="<%= selected %>"
                  style="cursor:pointer; opacity: <%= selected ? '1' : '0.35' %>; transform: <%= selected ? 'scale(1.08)' : 'scale(1)' %>; filter: <%= selected ? '' : 'grayscale(0.6)' %>;">
            <%# Emoji SVG from icons/emojis folder %>
            <div class="w-16 h-16 flex items-center justify-center">
              <%= image_tag "icons/emojis/#{mood_opt[:svg]}", alt: "", class: "w-full h-full" %>
            </div>
            <span class="text-xs font-medium text-center" style="color: <%= border_colour %>;">
              <%= mood_opt[:name] %>
            </span>
          </button>
        <% end %>
      </div>
    </details>

    <%# 2. Physical %>
    <details class="group border-b border-brand-field" id="section-physical">
      <summary class="flex items-center justify-between py-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
        <div class="flex items-center gap-3">
          <svg class="transition-transform duration-200 group-open:rotate-90 shrink-0"
               xmlns="http://www.w3.org/2000/svg" width="20" height="20"
               fill="none" stroke="<%= phase_colour %>" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <polyline points="9 18 15 12 9 6" />
          </svg>
          <span class="font-medium text-[22px] tracking-[0.66px]" style="color:<%= phase_colour %>;">Physical</span>
        </div>
        <% if physical_done %><%= render 'symptoms/bi_check', colour: phase_colour %><% end %>
      </summary>

      <div class="pb-2" role="group" aria-label="Physical symptoms">
        <% SymptomLog::PHYSICAL_SYMPTOMS.each do |symptom| %>
          <%= render "symptoms/symptom_slider_row",
                symptom: symptom,
                val: (@log.physical_symptoms || {})[symptom[:key]],
                log_url: log_physical_symptom_path %>
        <% end %>
      </div>
    </details>

    <%# 3. Mental %>
    <details class="group border-b border-brand-field" id="section-mental">
      <summary class="flex items-center justify-between py-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
        <div class="flex items-center gap-3">
          <svg class="transition-transform duration-200 group-open:rotate-90 shrink-0"
               xmlns="http://www.w3.org/2000/svg" width="20" height="20"
               fill="none" stroke="<%= phase_colour %>" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <polyline points="9 18 15 12 9 6" />
          </svg>
          <span class="font-medium text-[22px] tracking-[0.66px]" style="color:<%= phase_colour %>;">Mental</span>
        </div>
        <% if mental_done %><%= render 'symptoms/bi_check', colour: phase_colour %><% end %>
      </summary>
      <div class="pb-2" role="group" aria-label="Mental symptoms">
        <% SymptomLog::MENTAL_SYMPTOMS.each do |symptom| %>
          <%= render "symptoms/symptom_slider_row",
                symptom: symptom,
                val: (@log.mental_symptoms || {})[symptom[:key]],
                log_url: log_mental_symptom_path %>
        <% end %>
      </div>
    </details>

    <%# 4. vaginal discharge / Bleeding (menstrual phase) %>
    <details class="group border-b border-brand-field" id="section-discharge">
      <summary class="flex items-center justify-between py-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
        <div class="flex items-center gap-3">
          <svg class="transition-transform duration-200 group-open:rotate-90 shrink-0"
               xmlns="http://www.w3.org/2000/svg" width="20" height="20"
               fill="none" stroke="<%= phase_colour %>" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <polyline points="9 18 15 12 9 6" />
          </svg>
          <span class="font-medium text-[22px] tracking-[0.66px]" style="color:<%= phase_colour %>;"><%= discharge_label %></span>
        </div>
        <span id="section-discharge-check" style="display:<%= (discharge_done || bleeding_done) ? '' : 'none' %>"><%= render 'symptoms/bi_check', colour: phase_colour %></span>
      </summary>
      <div class="pb-5">
        <% if @phase == "menstrual" %>
          <%# Bleeding flow options (Light, Medium, Heavy, Disaster) %>
          <div class="grid grid-cols-4 gap-4 px-2" role="group" aria-label="Bleeding flow">
            <% BleedingService.all.each_with_index do |bleeding_opt, idx| %>
              <%
                selected = @log.bleeding == bleeding_opt[:name]
                num_small_drops = idx  # 0, 1, 2, 3 small drops
              %>
              <button class="bleeding-btn flex flex-col items-center gap-3 p-3 rounded-2xl transition-all duration-200"
                      data-action="click->symptom#saveBleedingFlow"
                      data-flow="<%= bleeding_opt[:name] %>"
                      data-url="<%= log_bleeding_symptom_path %>"
                      aria-label="<%= bleeding_opt[:name] %> bleeding" aria-pressed="<%= selected %>"
                      style="cursor:pointer;
                             opacity: <%= selected ? 1 : 0.35 %>;
                             transform: scale(<%= selected ? 1.08 : 1 %>);
                             filter: <%= selected ? '' : 'grayscale(0.6)' %>;
                             border: none; background: none;">

                <%# Droplet visualization — filled droplets with progressive intensity %>
                <div class="relative w-20 h-20 flex items-center justify-center">
                  <%
                    # Progressive opacity: Light (0.2) → Medium (0.5) → Heavy (0.75) → Disaster (1.0)
                    drop_opacity = [0.2, 0.5, 0.75, 1.0][idx]
                    small_opacity = [0, 0.4, 0.7, 1.0][idx]
                  %>

                  <%# Main droplet — Figma-accurate teardrop shape %>
                  <svg class="absolute" width="48" height="61" viewBox="0 0 48 61" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g style="opacity: <%= drop_opacity %>;">
                      <path d="M24.6445 16.1438C23.9695 15.6188 23.032 15.6188 22.357 16.1438C18.7945 18.8625 8.27576 27.7312 8.33201 38.0625C8.33201 46.425 15.1383 53.25 23.5195 53.25C31.9008 53.25 38.707 46.4438 38.707 38.0812C38.7257 27.9 28.1882 18.8813 24.6445 16.1438Z"
                            fill="<%= bleeding_opt[:color] %>" />
                      <path d="M23.6445 20.1438C22.9695 19.6188 22.032 19.6188 21.357 20.1438C17.7945 22.8625 7.27576 31.7312 7.33201 42.0625C7.33201 50.425 14.1383 57.25 22.5195 57.25C30.9008 57.25 37.707 50.4437 37.707 42.0812C37.7257 31.9 27.1882 22.8813 23.6445 20.1438Z"
                            stroke="<%= bleeding_opt[:color] %>" stroke-width="1.7" stroke-miterlimit="10" />
                    </g>
                  </svg>

                  <%# Small droplet 1 — top right %>
                  <% if num_small_drops >= 1 %>
                    <svg class="absolute" width="32" height="41" viewBox="0 0 48 61" fill="none" xmlns="http://www.w3.org/2000/svg"
                         style="top: -8px; right: -4px; width: 20px; height: 26px; opacity: <%= small_opacity %>;">
                      <path d="M24.6445 16.1438C23.9695 15.6188 23.032 15.6188 22.357 16.1438C18.7945 18.8625 8.27576 27.7312 8.33201 38.0625C8.33201 46.425 15.1383 53.25 23.5195 53.25C31.9008 53.25 38.707 46.4438 38.707 38.0812C38.7257 27.9 28.1882 18.8813 24.6445 16.1438Z"
                            fill="<%= bleeding_opt[:color] %>" />
                      <path d="M23.6445 20.1438C22.9695 19.6188 22.032 19.6188 21.357 20.1438C17.7945 22.8625 7.27576 31.7312 7.33201 42.0625C7.33201 50.425 14.1383 57.25 22.5195 57.25C30.9008 57.25 37.707 50.4437 37.707 42.0812C37.7257 31.9 27.1882 22.8813 23.6445 20.1438Z"
                            stroke="<%= bleeding_opt[:color] %>" stroke-width="1.2" stroke-miterlimit="10" />
                    </svg>
                  <% end %>

                  <%# Small droplet 2 — bottom right %>
                  <% if num_small_drops >= 2 %>
                    <svg class="absolute" width="32" height="41" viewBox="0 0 48 61" fill="none" xmlns="http://www.w3.org/2000/svg"
                         style="bottom: -12px; right: -8px; width: 20px; height: 26px; opacity: <%= small_opacity %>;">
                      <path d="M24.6445 16.1438C23.9695 15.6188 23.032 15.6188 22.357 16.1438C18.7945 18.8625 8.27576 27.7312 8.33201 38.0625C8.33201 46.425 15.1383 53.25 23.5195 53.25C31.9008 53.25 38.707 46.4438 38.707 38.0812C38.7257 27.9 28.1882 18.8813 24.6445 16.1438Z"
                            fill="<%= bleeding_opt[:color] %>" />
                      <path d="M23.6445 20.1438C22.9695 19.6188 22.032 19.6188 21.357 20.1438C17.7945 22.8625 7.27576 31.7312 7.33201 42.0625C7.33201 50.425 14.1383 57.25 22.5195 57.25C30.9008 57.25 37.707 50.4437 37.707 42.0812C37.7257 31.9 27.1882 22.8813 23.6445 20.1438Z"
                            stroke="<%= bleeding_opt[:color] %>" stroke-width="1.2" stroke-miterlimit="10" />
                    </svg>
                  <% end %>

                  <%# Small droplet 3 — bottom left %>
                  <% if num_small_drops >= 3 %>
                    <svg class="absolute" width="32" height="41" viewBox="0 0 48 61" fill="none" xmlns="http://www.w3.org/2000/svg"
                         style="bottom: -12px; left: -8px; width: 20px; height: 26px; opacity: <%= small_opacity %>;">
                      <path d="M24.6445 16.1438C23.9695 15.6188 23.032 15.6188 22.357 16.1438C18.7945 18.8625 8.27576 27.7312 8.33201 38.0625C8.33201 46.425 15.1383 53.25 23.5195 53.25C31.9008 53.25 38.707 46.4438 38.707 38.0812C38.7257 27.9 28.1882 18.8813 24.6445 16.1438Z"
                            fill="<%= bleeding_opt[:color] %>" />
                      <path d="M23.6445 20.1438C22.9695 19.6188 22.032 19.6188 21.357 20.1438C17.7945 22.8625 7.27576 31.7312 7.33201 42.0625C7.33201 50.425 14.1383 57.25 22.5195 57.25C30.9008 57.25 37.707 50.4437 37.707 42.0812C37.7257 31.9 27.1882 22.8813 23.6445 20.1438Z"
                            stroke="<%= bleeding_opt[:color] %>" stroke-width="1.2" stroke-miterlimit="10" />
                    </svg>
                  <% end %>
                </div>

                <%# Label %>
                <span class="text-sm font-semibold text-center w-full leading-tight"
                      style="color:<%= selected ? bleeding_opt[:color] : '#999' %>;
                             letter-spacing: 0.3px;
                             transition: color 200ms;">
                  <%= bleeding_opt[:name] %>
                </span>
              </button>
            <% end %>
          </div>
        <% else %>
          <%# Vaginal discharge icon grid for non-menstrual phases %>
          <%
            discharge_grid = [
              { key: 'dry',           img: 'dry.png',             label: 'Dry' },
              { key: 'creamy-light',  img: 'creamy-light.png',    label: 'Creamy' },
              { key: 'creamy',        img: 'creamy.png',          label: 'Creamy' },
              { key: 'egg-white',     img: 'egg-white.png',       label: 'Egg White' },
              { key: 'stretchy',      img: 'stretchy.png',        label: 'Stretchy' },
              { key: 'thick',         img: 'thick.png',           label: 'Thick' },
              { key: 'watery',        img: 'watery.png',          label: 'Watery' },
              { key: 'spotting',      img: 'spotting.png',        label: 'Spotting' },
              { key: 'period',        img: 'period.png',          label: 'Period' },
            ]
          %>
          <div class="grid grid-cols-3 gap-3" role="group" aria-label="Vaginal discharge type">
            <% discharge_grid.each do |item| %>
              <% sel = @log.discharge == item[:key] %>
              <button class="flex flex-col items-center gap-2 transition-all duration-150 focus:outline-none"
                      data-action="click->symptom#toggleDischarge"
                      data-discharge="<%= item[:key] %>"
                      aria-label="<%= item[:label] %>" aria-pressed="<%= sel %>"
                      style="cursor:pointer; opacity: <%= sel ? 1 : 0.35 %>; transform: scale(<%= sel ? 1.08 : 1 %>); filter: <%= sel ? '' : 'grayscale(0.6)' %>; border: none; background: none;">
                <div class="relative w-[75px] h-[75px] flex items-center justify-center">
                  <%= image_tag "icons/varginal_discharge/#{item[:img]}", alt: item[:label], class: "w-full h-full object-contain rounded-full" %>
                  <span class="discharge-check absolute bottom-0 right-0 w-5 h-5 flex items-center justify-center"
                        style="display:<%= sel ? '' : 'none' %>;">
                    <%= image_tag "icons/varginal_discharge/check-11.png", alt: "", class: "w-full h-full" %>
                  </span>
                </div>
                <span class="text-[11px] font-medium text-center leading-tight text-brand-primary tracking-[0.07em]"
                      style="opacity:<%= sel ? 1 : 0.5 %>;"><%= item[:label] %></span>
              </button>
            <% end %>
          </div>
        <% end %>
      </div>
    </details>

    <%# 5. Sexual intercourse %>
    <details class="group border-b border-brand-field" id="section-intercourse">
      <summary class="flex items-center justify-between py-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
        <div class="flex items-center gap-3">
          <svg class="transition-transform duration-200 group-open:rotate-90 shrink-0"
               xmlns="http://www.w3.org/2000/svg" width="20" height="20"
               fill="none" stroke="<%= phase_colour %>" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <polyline points="9 18 15 12 9 6" />
          </svg>
          <span class="font-medium text-[22px] tracking-[0.66px]" style="color:<%= phase_colour %>;">Sexual Intercourse</span>
        </div>
        <span id="section-intercourse-check" style="display:<%= intercourse_done ? '' : 'none' %>"><%= render 'symptoms/bi_check', colour: phase_colour %></span>
      </summary>
      <div class="pb-5">
        <div class="flex justify-around text-center mb-3">
          <span class="flex-1 text-brand-primary font-medium text-sm tracking-[0.07em]">None</span>
          <span class="flex-1 text-brand-primary font-medium text-sm tracking-[0.07em]">Unprotected</span>
          <span class="flex-1 text-brand-primary font-medium text-sm tracking-[0.07em]">Protected</span>
        </div>
        <div class="flex justify-around mb-4">
          <% sel = intercourse_list.include?('keiner') %>
          <button class="craving-btn" data-intercourse="keiner" data-action="click->symptom#toggleIntercourse"
                  aria-pressed="<%= sel %>" aria-label="No intercourse"
                  style="opacity:<%= sel ? 1 : 0.35 %>;transform:scale(<%= sel ? 1.08 : 1 %>);filter:<%= sel ? '' : 'grayscale(0.6)' %>;">
            <div class="w-14 h-14 flex items-center justify-center">
              <%= image_tag "sexual_intercourse/keiner.png", alt: "No intercourse" %>
            </div>
          </button>
          <% sel = intercourse_list.include?('ungeschuetzt') %>
          <button class="craving-btn" data-intercourse="ungeschuetzt" data-action="click->symptom#toggleIntercourse"
                  aria-pressed="<%= sel %>" aria-label="Unprotected intercourse"
                  style="opacity:<%= sel ? 1 : 0.35 %>;transform:scale(<%= sel ? 1.08 : 1 %>);filter:<%= sel ? '' : 'grayscale(0.6)' %>;">
            <div class="w-14 h-14 flex items-center justify-center">
              <%= image_tag "sexual_intercourse/ungeschuetzt.png", alt: "Unprotected" %>
            </div>
          </button>
          <% sel = intercourse_list.include?('geschuetzt') %>
          <button class="craving-btn" data-intercourse="geschuetzt" data-action="click->symptom#toggleIntercourse"
                  aria-pressed="<%= sel %>" aria-label="Protected intercourse"
                  style="opacity:<%= sel ? 1 : 0.35 %>;transform:scale(<%= sel ? 1.08 : 1 %>);filter:<%= sel ? '' : 'grayscale(0.6)' %>;">
            <div class="w-14 h-14 flex items-center justify-center">
              <%= image_tag "sexual_intercourse/geschuetzt.png", alt: "Protected" %>
            </div>
          </button>
        </div>
        <div class="flex justify-around text-center mb-3">
          <span class="flex-1 text-brand-primary font-medium text-sm tracking-[0.07em]">Orgasm</span>
          <span class="flex-1 text-brand-primary font-medium text-sm tracking-[0.07em]">No Orgasm</span>
          <span class="flex-1 text-brand-primary font-medium text-sm tracking-[0.07em]">Masturbation</span>
        </div>
        <div class="flex justify-around">
          <% sel = intercourse_list.include?('orgasmus') %>
          <button class="craving-btn" data-intercourse="orgasmus" data-action="click->symptom#toggleIntercourse"
                  aria-pressed="<%= sel %>" aria-label="Orgasm"
                  style="opacity:<%= sel ? 1 : 0.35 %>;transform:scale(<%= sel ? 1.08 : 1 %>);filter:<%= sel ? '' : 'grayscale(0.6)' %>;">
            <div class="w-14 h-14 flex items-center justify-center">
              <%= image_tag "sexual_intercourse/orgasmus.png", alt: "Orgasm" %>
            </div>
          </button>
          <% sel = intercourse_list.include?('kein-orgasmus') %>
          <button class="craving-btn" data-intercourse="kein-orgasmus" data-action="click->symptom#toggleIntercourse"
                  aria-pressed="<%= sel %>" aria-label="No orgasm"
                  style="opacity:<%= sel ? 1 : 0.35 %>;transform:scale(<%= sel ? 1.08 : 1 %>);filter:<%= sel ? '' : 'grayscale(0.6)' %>;">
            <div class="w-14 h-14 flex items-center justify-center">
              <%= image_tag "sexual_intercourse/kein-orgasmus.png", alt: "No orgasm" %>
            </div>
          </button>
          <% sel = intercourse_list.include?('masturbation') %>
          <button class="craving-btn" data-intercourse="masturbation" data-action="click->symptom#toggleIntercourse"
                  aria-pressed="<%= sel %>" aria-label="Masturbation"
                  style="opacity:<%= sel ? 1 : 0.35 %>;transform:scale(<%= sel ? 1.08 : 1 %>);filter:<%= sel ? '' : 'grayscale(0.6)' %>;">
            <div class="w-14 h-14 flex items-center justify-center">
              <%= image_tag "sexual_intercourse/masturbation.png", alt: "Vibrator / Masturbation" %>
            </div>
          </button>
        </div>
      </div>
    </details>

    <%# 6. Cravings %>
    <details class="group border-b border-brand-field" id="section-cravings">
      <summary class="flex items-center justify-between py-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
        <div class="flex items-center gap-3">
          <svg class="transition-transform duration-200 group-open:rotate-90 shrink-0"
               xmlns="http://www.w3.org/2000/svg" width="20" height="20"
               fill="none" stroke="<%= phase_colour %>" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <polyline points="9 18 15 12 9 6" />
          </svg>
          <span class="font-medium text-[22px] tracking-[0.66px]" style="color:<%= phase_colour %>;">Cravings</span>
        </div>
        <span id="section-cravings-check" style="display:<%= cravings_done ? '' : 'none' %>"><%= render 'symptoms/bi_check', colour: phase_colour %></span>
      </summary>
      <div class="pb-5">
        <div class="flex justify-around text-center mb-3">
          <span class="flex-1 text-brand-primary font-medium text-base tracking-[0.07em]">Salty</span>
          <span class="flex-1 text-brand-primary font-medium text-base tracking-[0.07em]">Sweet</span>
          <span class="flex-1 text-brand-primary font-medium text-base tracking-[0.07em]">Carbs</span>
        </div>
        <div class="flex justify-around">
          <%# Salty column %>
          <div class="flex-1 flex flex-col items-center gap-3">
            <% sel = cravings_list.include?('salty') %>
            <button class="craving-btn" data-craving="salty" data-action="click->symptom#toggleCravings"
                    aria-pressed="<%= sel %>" aria-label="Salty craving"
                    style="opacity:<%= sel ? 1 : 0.35 %>;transform:scale(<%= sel ? 1.08 : 1 %>);filter:<%= sel ? '' : 'grayscale(0.6)' %>;">
              <div class="w-[65px] h-[65px] flex items-center justify-center">
                <%= image_tag "cravings/fries.svg", alt: "Fries and burger" %>
              </div>
            </button>
          </div>
          <%# Sweet column %>
          <div class="flex-1 flex flex-col items-center gap-3">
            <% sel = cravings_list.include?('sweet-chocolate') %>
            <button class="craving-btn" data-craving="sweet-chocolate" data-action="click->symptom#toggleCravings"
                    aria-pressed="<%= sel %>" aria-label="Chocolate craving"
                    style="opacity:<%= sel ? 1 : 0.35 %>;transform:scale(<%= sel ? 1.08 : 1 %>);filter:<%= sel ? '' : 'grayscale(0.6)' %>;">
              <div class="w-[65px] h-[65px] flex items-center justify-center">
                <%= image_tag "cravings/chocolate.svg", alt: "Chocolate" %>
              </div>
            </button>
            <% sel = cravings_list.include?('sweet-doughnut') %>
            <button class="craving-btn" data-craving="sweet-doughnut" data-action="click->symptom#toggleCravings"
                    aria-pressed="<%= sel %>" aria-label="Doughnut craving"
                    style="opacity:<%= sel ? 1 : 0.35 %>;transform:scale(<%= sel ? 1.08 : 1 %>);filter:<%= sel ? '' : 'grayscale(0.6)' %>;">
              <div class="w-[65px] h-[65px] flex items-center justify-center">
                <%= image_tag "cravings/doughnut.svg", alt: "Doughnut with sprinkles" %>
              </div>
            </button>
            <% sel = cravings_list.include?('sweet-donut') %>
            <button class="craving-btn" data-craving="sweet-donut" data-action="click->symptom#toggleCravings"
                    aria-pressed="<%= sel %>" aria-label="Donut craving"
                    style="opacity:<%= sel ? 1 : 0.35 %>;transform:scale(<%= sel ? 1.08 : 1 %>);filter:<%= sel ? '' : 'grayscale(0.6)' %>;">
              <div class="w-[65px] h-[65px] flex items-center justify-center">
                <%= image_tag "cravings/donut.png", alt: "Donut" %>
              </div>
            </button>
          </div>
          <%# Carbs column %>
          <div class="flex-1 flex flex-col items-center gap-3">
            <% sel = cravings_list.include?('carbs-macarons') %>
            <button class="craving-btn" data-craving="carbs-macarons" data-action="click->symptom#toggleCravings"
                    aria-pressed="<%= sel %>" aria-label="Macarons craving"
                    style="opacity:<%= sel ? 1 : 0.35 %>;transform:scale(<%= sel ? 1.08 : 1 %>);filter:<%= sel ? '' : 'grayscale(0.6)' %>;">
              <div class="w-[65px] h-[65px] flex items-center justify-center">
                <%= image_tag "cravings/macarons.svg", alt: "Macarons" %>
              </div>
            </button>
            <% sel = cravings_list.include?('carbs-snacks') %>
            <button class="craving-btn" data-craving="carbs-snacks" data-action="click->symptom#toggleCravings"
                    aria-pressed="<%= sel %>" aria-label="Snacks craving"
                    style="opacity:<%= sel ? 1 : 0.35 %>;transform:scale(<%= sel ? 1.08 : 1 %>);filter:<%= sel ? '' : 'grayscale(0.6)' %>;">
              <div class="w-[65px] h-[65px] flex items-center justify-center">
                <%= image_tag "cravings/snacks.png", alt: "Snacks" %>
              </div>
            </button>
            <% sel = cravings_list.include?('carbs-noodles') %>
            <button class="craving-btn" data-craving="carbs-noodles" data-action="click->symptom#toggleCravings"
                    aria-pressed="<%= sel %>" aria-label="Noodles craving"
                    style="opacity:<%= sel ? 1 : 0.35 %>;transform:scale(<%= sel ? 1.08 : 1 %>);filter:<%= sel ? '' : 'grayscale(0.6)' %>;">
              <div class="w-[65px] h-[65px] flex items-center justify-center">
                <%= image_tag "cravings/noodles.svg", alt: "Noodles" %>
              </div>
            </button>
          </div>
        </div>
      </div>
    </details>

    <%# 7. Sleep %>
    <details class="group border-b border-brand-field" id="section-sleep">
      <summary class="flex items-center justify-between py-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
        <div class="flex items-center gap-3">
          <svg class="transition-transform duration-200 group-open:rotate-90 shrink-0"
               xmlns="http://www.w3.org/2000/svg" width="20" height="20"
               fill="none" stroke="<%= phase_colour %>" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <polyline points="9 18 15 12 9 6" />
          </svg>
          <span class="font-medium text-[22px] tracking-[0.66px]" style="color:<%= phase_colour %>;">Sleep</span>
        </div>
        <% if sleep_done %><%= render 'symptoms/bi_check', colour: phase_colour %><% end %>
      </summary>
      <div class="pb-5" data-controller="vertical-picker"
           data-vertical-picker-min-value="1"
           data-vertical-picker-max-value="12"
           data-vertical-picker-step-value="1"
           data-vertical-picker-value-value="<%= @log.sleep || 8 %>"
           data-vertical-picker-unit-value="h"
           data-vertical-picker-field-value="sleep"
           data-action="vertical-picker:change->symptom#saveFromPicker">
        <div class="flex justify-center items-baseline gap-1 mb-3">
          <span data-vertical-picker-target="display" class="vp-display">8h</span>
        </div>
        <div class="relative mx-auto w-[100px] h-[150px]">
          <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-[40px] vp-bg pointer-events-none"></div>
          <div data-vertical-picker-target="track" class="vp-track h-full py-[55px]"
               data-action="scroll->vertical-picker#scroll"></div>
        </div>
      </div>
    </details>

    <%# 8. Temperature %>
    <details class="group border-b border-brand-field" id="section-temperature">
      <summary class="flex items-center justify-between py-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
        <div class="flex items-center gap-3">
          <svg class="transition-transform duration-200 group-open:rotate-90 shrink-0"
               xmlns="http://www.w3.org/2000/svg" width="20" height="20"
               fill="none" stroke="<%= phase_colour %>" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <polyline points="9 18 15 12 9 6" />
          </svg>
          <span class="font-medium text-[22px] tracking-[0.66px]" style="color:<%= phase_colour %>;">Temperature</span>
        </div>
        <% if temperature_done %><%= render 'symptoms/bi_check', colour: phase_colour %><% end %>
      </summary>
      <div class="pb-5" data-controller="vertical-picker"
           data-vertical-picker-min-value="35.0"
           data-vertical-picker-max-value="42.0"
           data-vertical-picker-step-value="0.1"
           data-vertical-picker-value-value="<%= @log.temperature || 36.5 %>"
           data-vertical-picker-unit-value="°C"
           data-vertical-picker-field-value="temperature"
           data-action="vertical-picker:change->symptom#saveFromPicker">
        <div class="flex justify-center items-baseline gap-1 mb-3">
          <span data-vertical-picker-target="display" class="vp-display">36.5°C</span>
        </div>
        <div class="relative mx-auto w-[100px] h-[150px]">
          <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-[40px] vp-bg pointer-events-none"></div>
          <div data-vertical-picker-target="track" class="vp-track h-full py-[55px]"
               data-action="scroll->vertical-picker#scroll"></div>
        </div>
      </div>
    </details>

    <%# 9. Weight %>
    <details class="group border-b border-brand-field" id="section-weight">
      <summary class="flex items-center justify-between py-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
        <div class="flex items-center gap-3">
          <svg class="transition-transform duration-200 group-open:rotate-90 shrink-0"
               xmlns="http://www.w3.org/2000/svg" width="20" height="20"
               fill="none" stroke="<%= phase_colour %>" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <polyline points="9 18 15 12 9 6" />
          </svg>
          <span class="font-medium text-[22px] tracking-[0.66px]" style="color:<%= phase_colour %>;">Weight</span>
        </div>
        <% if weight_done %><%= render 'symptoms/bi_check', colour: phase_colour %><% end %>
      </summary>
      <div class="pb-5" data-controller="vertical-picker"
           data-vertical-picker-min-value="30.0"
           data-vertical-picker-max-value="200.0"
           data-vertical-picker-step-value="0.5"
           data-vertical-picker-value-value="<%= @log.weight || 65.0 %>"
           data-vertical-picker-unit-value=" kg"
           data-vertical-picker-field-value="weight"
           data-action="vertical-picker:change->symptom#saveFromPicker">
        <div class="flex justify-center items-baseline gap-1 mb-3">
          <span data-vertical-picker-target="display" class="vp-display">65.0 kg</span>
        </div>
        <div class="relative mx-auto w-[100px] h-[150px]">
          <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-[40px] vp-bg pointer-events-none"></div>
          <div data-vertical-picker-target="track" class="vp-track h-full py-[55px]"
               data-action="scroll->vertical-picker#scroll"></div>
        </div>
      </div>
    </details>

    <%# 10. Notes regarding today %>
    <details class="group border-b border-brand-field" id="section-notes">
      <summary class="flex items-center justify-between py-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
        <div class="flex items-center gap-3">
          <svg class="transition-transform duration-200 group-open:rotate-90 shrink-0"
               xmlns="http://www.w3.org/2000/svg" width="20" height="20"
               fill="none" stroke="<%= phase_colour %>" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <polyline points="9 18 15 12 9 6" />
          </svg>
          <span class="font-medium text-[22px] tracking-[0.66px]" style="color:<%= phase_colour %>;">Notes regarding today</span>
        </div>
        <% if notes_done %><%= render 'symptoms/bi_check', colour: phase_colour %><% end %>
      </summary>
      <div class="pb-5">
        <label for="symptom_notes" class="sr-only">Notes regarding today</label>
        <textarea id="symptom_notes" name="symptom_log[notes]" rows="4"
                  placeholder="Enter your notes here..."
                  data-action="input->symptom#saveNotes"
                  aria-label="Notes regarding today"
                  class="w-full rounded-xl px-4 py-3 text-sm border-0 resize-none outline-none font-['Montserrat']"
                  style="background:#EDE1D5; color:#3d2b28;"><%= @log.notes %></textarea>
      </div>
    </details>

    <%# Submit %>
    <div class="pt-6 pb-8">
      <%= link_to tracking_index_path,
            class: "block w-full text-white text-center rounded-lg py-4 text-xl font-medium tracking-wide font-['Montserrat']",
            style: "background:#{phase_colour}; text-decoration:none;" do %>
        Submit
      <% end %>
    </div>

  </div>
</div>
