<% content_for(:page_title) { "Self Analysis" } %>
<% content_for(:header_dark) { "true" } %>
<% content_for(:header_color) { @meta.dig(:colour) || "#933a35" } %>
<% content_for(:hide_quick_actions) { "true" } %>
<%# This page renders its own centred calendar button below, so opt out of the shared bottom-right FAB. %>
<% content_for(:hide_calendar_fab) { "true" } %>

<%
  def arc_path(cx, cy, r_out, r_in, start_deg, end_deg)
    to_rad = Math::PI / 180.0
    sweep = end_deg - start_deg
    sweep = 359.9999 if sweep.abs >= 360
    large = sweep.abs > 180 ? 1 : 0
    dir   = sweep >= 0 ? 1 : 0
    sx = cx + r_out * Math.cos(start_deg * to_rad)
    sy = cy + r_out * Math.sin(start_deg * to_rad)
    ex = cx + r_out * Math.cos(end_deg   * to_rad)
    ey = cy + r_out * Math.sin(end_deg   * to_rad)
    ix = cx + r_in  * Math.cos(end_deg   * to_rad)
    iy = cy + r_in  * Math.sin(end_deg   * to_rad)
    jx = cx + r_in  * Math.cos(start_deg * to_rad)
    jy = cy + r_in  * Math.sin(start_deg * to_rad)
    ["M #{sx.round(3)},#{sy.round(3)}", "A #{r_out},#{r_out} 0 #{large},#{dir} #{ex.round(3)},#{ey.round(3)}", "L #{ix.round(3)},#{iy.round(3)}", "A #{r_in},#{r_in} 0 #{large},#{1 - dir} #{jx.round(3)},#{jy.round(3)}", "Z"].join(" ")
  end
%>

<% phase_colour = @meta&.dig(:colour) || "#933a35" %>
<% phase_label  = @phase ? @phase.capitalize : nil %>
<% phase_season = @meta&.dig(:season) %>

<div class="min-h-screen pb-24 bg-brand-field">
  <div class="max-w-app mx-auto px-4">

    <%# ── Date picker drum ────────────────────────────────────────────── %>
    <%= render "shared/date_picker_drum", date: @date, date_path: ->(d) { tracking_index_path(date: d) } %>

    <%# ── Avatar (tap to change) ──────────────────────────────────────── %>
    <div class="flex justify-center pt-8 pb-5" data-controller="profile-modal"
         data-action="click@window->profile-modal#clickOutside">
      <button type="button" data-action="click->profile-modal#openAvatarModal"
              class="relative block w-56 h-56 shrink-0 bg-transparent border-0 p-0 cursor-pointer"
              aria-label="Change profile picture">
        <div class="w-56 h-56 rounded-full flex items-center justify-center overflow-hidden"
             style="background:<%= phase_colour %>;">
          <% if current_user.avatar_preset.present? %>
            <% preset = AvatarService.find_by_id(current_user.avatar_preset) %>
            <% if preset %>
              <%= image_tag "avatars/#{preset[:file]}", class: "w-full h-full object-cover", alt: preset[:name] %>
            <% end %>
          <% elsif current_user.avatar.attached? %>
            <%= image_tag current_user.avatar,
                  class: "w-full h-full object-cover",
                  alt: current_user.name %>
          <% elsif current_user.avatar_url.present? %>
            <%= image_tag current_user.avatar_url,
                  class: "w-full h-full object-cover",
                  alt: current_user.name %>
          <% else %>
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="none"
                 stroke="white" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
               <circle cx="12" cy="8" r="4" />
               <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" />
            </svg>
          <% end %>
        </div>
        <%# Camera edit badge %>
        <span class="absolute bottom-2 right-2 w-10 h-10 rounded-full bg-white shadow-md
                     flex items-center justify-center" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none"
               stroke="<%= phase_colour %>" stroke-width="1.8" viewBox="0 0 24 24">
             <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
             <circle cx="12" cy="13" r="4" />
          </svg>
        </span>
      </button>

      <%# Avatar picker modal — inline here (and in /settings/profile) so the
           camera/avatar tap works without leaving /tracking. %>
      <%= render "settings/avatar_modal" %>
    </div>

    <%# ── Phase text ──────────────────────────────────────────────────── %>
    <div class="text-center mb-6">
      <% if phase_label %>
        <p class="text-2xl font-medium text-brand-primary font-sans"><%= t('tracking.index.current_phase') %></p>
        <h1 class="text-3xl font-extrabold leading-tight" style="color:<%= phase_colour %>;">
          <%= phase_label %> Phase
        </h1>
      <% else %>
        <div class="rounded-2xl px-4 py-3 text-sm bg-brand-error text-brand-primary">
          <%= t('tracking.index.log_period') %>
        </div>
      <% end %>
    </div>

    <%# ── Daily Analysis card ────────────────────────────────────────────
         Only shows when arriving at /tracking itself (no date param), not
         when tapping a day in the strip below. Auto-closes after ~10s. %>
    <% if params[:date].blank? && phase_label %>
      <%
        analysis_messages = {
          "menstrual"  => "This is your time to rest and restore. Listen to your body — it knows what it needs.",
          "follicular" => "Energy is rising and ideas are flowing. A great time to start new projects and plan ahead.",
          "ovulation"  => "You are magnetic and at your peak. Embrace social connection and communicate with confidence.",
          "luteal"     => "Turn inward and focus on the details. Execute projects and reflect on what matters most."
        }
        analysis_text = analysis_messages[@phase] || "Track your symptoms daily to unlock personalized insights."
      %>
      <div class="flex justify-center mb-6" data-controller="dismissible">
        <div class="relative bg-white rounded-[29px] pl-5 pr-3 py-5 w-full max-w-[400px] flex items-center gap-1" data-dismissible-target="card">
          <p class="flex-1 min-w-0 text-brand-primary font-medium text-sm leading-snug font-sans line-clamp-3">
            <%= analysis_text %>
          </p>
          <button data-action="click->dismissible#close" aria-label="Dismiss"
                  class="shrink-0 w-8 h-8 rounded-full flex items-center justify-center border-0 cursor-pointer bg-brand-field">
            <span class="text-brand-primary text-lg font-medium leading-none font-sans">×</span>
          </button>
        </div>
      </div>
    <% end %>

    <%# ── Cycle-day strip ─────────────────────────────────────────────── %>
    <% if @strip.present? %>
      <div class="mb-1 overflow-x-auto scrollbar-hide" data-controller="center-scroll">
        <div class="flex gap-3 pt-2 pb-1 w-max px-4">
          <% @strip.each do |day| %>
            <% dot_colour = day[:colour] || "#D18D83" %>
            <% if day[:date] > Time.zone.today %>
              <%# Future days are for preview only — tapping them does nothing. %>
              <div aria-hidden="true" title="<%= day[:date].strftime("%A, %d %B") %>"
                   class="w-12 h-12 rounded-full flex items-center justify-center text-base font-semibold text-white opacity-75 cursor-default"
                   style="background:<%= dot_colour %>;">
                <%= day[:date].day %>
              </div>
            <% else %>
              <%= link_to tracking_index_path(date: day[:date].to_s),
                    class: "no-underline",
                    "aria-label": day[:date].strftime("%A, %d %B") do %>
                <div class="w-12 h-12 rounded-full flex items-center justify-center text-base font-semibold <%= day[:current] ? 'text-white ring-2 ring-offset-2 ring-white' : 'text-white opacity-75' %>"
                     style="background:<%= dot_colour %>;"
                     <%= 'data-center-scroll-target="current"'.html_safe if day[:current] %>>
                  <%= day[:date].day %>
                </div>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
      <% if @cycle_day %>
        <p class="text-center text-xs text-brand-primary font-sans mb-6">Cycle Day <%= @cycle_day %></p>
      <% end %>
    <% end %>

    <%# ── Navigation cards ───────────────────────────────────────────── %>
    <div class="flex flex-col gap-3 mb-8">

      <%= link_to symptoms_path,
            class: "flex justify-between items-center rounded-lg px-5 min-h-[3rem] py-3 bg-white no-underline" do %>
        <span class="flex-1 min-w-0 text-xl font-medium text-brand-primary font-sans"><%= t('tracking.index.my_symptoms') %></span>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" shrink-0="true"
             stroke="<%= phase_colour %>" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true" class="shrink-0">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      <% end %>

      <%= link_to superpowers_path,
            class: "flex justify-between items-center rounded-lg px-5 min-h-[3rem] py-3 bg-white no-underline" do %>
        <span class="flex-1 min-w-0 text-xl font-medium text-brand-primary font-sans">My Superpowers</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none"
             stroke="<%= phase_colour %>" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true" class="shrink-0">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      <% end %>

      <%= link_to period_tracking_index_path,
            class: "flex justify-between items-center rounded-lg px-5 min-h-[3rem] py-3 bg-white no-underline" do %>
        <span class="flex-1 min-w-0 text-xl font-medium text-brand-primary font-sans">Track My Period</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none"
             stroke="<%= phase_colour %>" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true" class="shrink-0">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      <% end %>

    </div>

  </div>
</div>

<%# ── Post-tracking-save prediction modal ──
     Shown after saving a period (tracking#create / #period_update) or
     submitting symptoms/superpowers tracking -- all three feed the same
     cycle prediction, so they share this one confirmation. Was previously
     gated on params[:period_saved], which nothing ever actually set on
     redirect -- this modal has never fired until now. Also previously used
     onclick="..." attributes, which this app's nonce-based CSP silently
     blocks (see tracking_saved_modal_controller.js) -- moot while
     unreachable, but would've left the close buttons dead on arrival. %>
<% if params[:tracking_saved] == "1" %>
  <div id="tracking-saved-modal" data-controller="tracking-saved-modal"
       class="fixed inset-0 z-[200] flex items-center justify-center bg-brand-overlay/90"
       role="dialog" aria-modal="true" aria-label="Tracking saved"
       data-action="click->tracking-saved-modal#overlayClick">
    <div class="relative w-[337px] bg-white rounded-[29px] shadow-[0_24px_64px_rgba(0,0,0,0.16)] px-7 pt-8 pb-8 flex flex-col items-center gap-5">
      <button type="button" aria-label="Close" data-action="click->tracking-saved-modal#close"
              class="absolute top-3 right-3 w-11 h-11 flex items-center justify-center rounded-full rotate-45 border-0 bg-brand-field cursor-pointer">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#933a35" stroke-width="3">
          <line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" />
        </svg>
      </button>
      <%= image_tag "screen1logo.png", alt: "Season", class: "w-[87px] h-[88px] object-contain mt-4" %>
      <p class="text-brand-primary font-medium text-2xl leading-[30px] text-center font-sans m-0">
        Your prediction will be adjusted based on the information you provide
      </p>
      <button type="button" data-action="click->tracking-saved-modal#close"
              class="w-full h-[52px] bg-brand-primary text-white rounded-xl border-none font-medium text-lg font-sans cursor-pointer">
        Done
      </button>
    </div>
  </div>
<% end %>

<%# ── Calendar button — fixed bottom-centre, replaces the quick-actions FAB on this page ── %>
<%= render "shared/calendar_center_fab" %>

<%# Render feedback modal inline for iOS Ruby Native compatibility %>
<%= render "shared/feedback_modal" %>
