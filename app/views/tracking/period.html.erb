<% editing = @existing.present? %>
<% content_for(:page_title) { "Track my period" } %>
<%= native_navbar_tag("Track my period") if native_app? %>
<% content_for(:header_color) { @phase_col } %>

<%
  today      = Time.zone.today
  first_day  = @month
  last_day   = @month.end_of_month
  start_pad  = (first_day.wday == 0 ? 6 : first_day.wday - 1)
  prev_month = @month.prev_month
  next_month = @month.next_month

  # Active period bar — highlight confirmed period days in this month (no fabricated fallback)
  period_start = @existing
  period_end   = @period_end
  period_days  = if period_start && period_end
    # Both ends known — show the intersection of the period range with this month
    range_start = [period_start, first_day].max
    range_end   = [period_end, last_day].min
    range_start <= range_end ? (range_start..range_end).to_a : []
  elsif period_start && period_start.year == @month.year && period_start.month == @month.month
    # Start is this month, end not yet set — highlight from start to today
    range_end = [today, last_day].min
    period_start <= range_end ? (period_start..range_end).to_a : []
  else
    []
  end
%>

<div class="bg-white min-h-screen pb-20">
  <div class="max-w-app mx-auto">

    <%# ── Greeting ─────────────────────────────────────────────────────── %>
    <div class="pt-8 pb-2 px-4">
      <p class="text-brand-primary italic font-medium text-[36px] leading-[44px] font-['Montserrat'] m-0">
        Hello <%= current_user.name&.split&.first || "there" %>
      </p>
      <p class="text-brand-primary font-light text-2xl leading-[29px] font-['Montserrat'] m-0 mt-1">
        This is your month
      </p>
    </div>

    <%# ── Month navigation ─────────────────────────────────────────────── %>
    <div class="flex items-center justify-start gap-4 pt-2 pb-4 px-4">
      <%= link_to period_tracking_index_path(date: prev_month),
            class: "flex items-center justify-center w-9 h-9 rounded-full bg-brand-field no-underline" do %>
        <svg width="16" height="16" fill="none" stroke="#933a35" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg>
      <% end %>
      <span class="font-medium text-base text-brand-primary font-['Montserrat'] tracking-[0.07em]"><%= @month.strftime("%B") %></span>
      <%= link_to period_tracking_index_path(date: next_month),
            class: "flex items-center justify-center w-9 h-9 rounded-full bg-brand-field no-underline" do %>
        <svg width="16" height="16" fill="none" stroke="#933a35" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6" /></svg>
      <% end %>
    </div>

    <%# ── Day-of-week headers ──────────────────────────────────────────── %>
    <div class="grid grid-cols-7 gap-0 px-4 mb-1">
      <% %w[Mo Tu We Th Fr Sa Su].each do |d| %>
        <div class="text-center text-brand-secondary text-xs font-semibold tracking-wider py-1"><%= d %></div>
      <% end %>
    </div>

    <%# ── Calendar grid ────────────────────────────────────────────────── %>
    <div class="grid grid-cols-7 auto-rows-calendar gap-x-0 gap-y-2 px-4">
      <% start_pad.times { concat(tag.div) } %>

      <% (first_day..last_day).each do |day| %>
        <%
          is_period_day = period_days.include?(day)
          is_selected   = day == @selected
          is_today      = day == today
          is_future     = day > today
          is_past       = day <= today

          # Phase band: show period color for period days, or subtle for past, or none for future
          band_colour = is_period_day ? '#933a35' : (is_past ? '#EDE1D5' : 'transparent')

          # Day number styling
          num_bg   = is_selected ? @phase_col : (is_today ? '#933a35' : 'transparent')
          num_col  = is_selected || is_today ? '#FFFFFF' : (is_future ? '#C4B8B8' : (is_period_day ? '#933a35' : '#3d2b28'))
          num_wt   = (is_selected || is_today) ? '700' : (is_period_day ? '600' : '400')
        %>
        <% if is_future %>
          <div style="display:flex; flex-direction:column; height:100%; overflow:hidden;">
            <div style="height:11px; flex-shrink:0; background:transparent;"></div>
            <div style="flex:1; padding:4px 4px 3px; display:flex; flex-direction:column; overflow:hidden;">
              <span style="font-size:13px; font-weight:<%= num_wt %>; color:<%= num_col %>; line-height:1; flex-shrink:0;"><%= day.day %></span>
            </div>
          </div>
        <% else %>
          <a href="<%= period_tracking_index_path(selected_date: day) %>" data-turbo="false"
             style="display:flex; flex-direction:column; text-decoration:none; height:100%; overflow:hidden;">
            <div style="height:11px; flex-shrink:0; background:<%= band_colour %>;"></div>
            <div style="flex:1; padding:4px 4px 3px; display:flex; flex-direction:column; overflow:hidden;">
              <% if is_today || is_selected %>
                <span style="display:inline-flex; align-items:center; justify-content:center; min-width:24px; height:24px; padding:0 4px; border-radius:12px; background:<%= num_bg %>; color:<%= num_col %>; font-size:12px; font-weight:700; line-height:1; align-self:flex-start; flex-shrink:0;">
                  <%= day.day %>
                </span>
              <% else %>
                <span style="font-size:13px; font-weight:<%= num_wt %>; color:<%= num_col %>; line-height:1; flex-shrink:0;"><%= day.day %></span>
              <% end %>
            </div>
          </a>
        <% end %>
      <% end %>
    </div>

    <%# ── Submit ────────────────────────────────────────────────────────── %>
    <div class="px-4 pt-4 pb-2">
      <p class="text-center text-sm text-brand-secondary font-['Montserrat'] mb-3">
        <%= t("tracking.period_update.period.selected") %> <strong class="text-brand-primary"><%= @selected.strftime("%-d %B") %></strong>
      </p>
      <div class="flex flex-col gap-3 items-center">
        <a href="<%= period_tracking_index_path(save: 1, field: "start", date: @selected) %>" data-turbo="false"
           class="block w-[253px] text-center no-underline text-white bg-brand-primary rounded-lg py-4 text-xl font-medium font-['Montserrat']">
          <%= t("tracking.period_update.period.set_start") %>
        </a>
        <a href="<%= period_tracking_index_path(save: 1, field: "end", date: @selected) %>" data-turbo="false"
           class="block w-[253px] text-center no-underline text-brand-primary border-2 border-brand-primary bg-transparent rounded-lg py-4 text-xl font-medium font-['Montserrat']">
          <%= t("tracking.period_update.period.set_end") %>
        </a>
      </div>
      <% if @existing || @period_end %>
        <div class="mt-4 text-center text-xs text-brand-secondary font-['Montserrat'] space-y-1">
          <% if @existing %><p><%= t("tracking.period_update.period.label_start") %> <%= @existing.strftime("%-d %B %Y") %></p><% end %>
          <% if @period_end %><p><%= t("tracking.period_update.period.label_end") %> <%= @period_end.strftime("%-d %B %Y") %></p><% end %>
        </div>
      <% end %>
    </div>

  </div>
</div>
