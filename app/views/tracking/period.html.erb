<% content_for(:page_title) { "Track my period" } %>
<%# No header_dark/header_color here — unlike other tracking pages, this
     screen's header is the plain neutral bg-brand-field bar with maroon
     icon/title (the layout's default for a page that sets neither), not a
     phase-tinted one. Figma confirms it: every "Track my period" reference
     shows a tan header with a maroon hamburger + title regardless of what
     cycle phase the user is currently in. %>
<%# Not under settings/ or calendar#index, so the layout would otherwise show
     both the "+" quick-actions FAB and the default calendar FAB. This is a
     focused single-task form (back link + Submit already cover navigation),
     so suppress both defaults and don't render a replacement FAB either. %>
<% content_for(:hide_quick_actions) { "true" } %>
<% content_for(:hide_calendar_fab) { "true" } %>
<%# shared/_back_link colours itself via var(--phase-color), so this still
     has to be set — just not to the dynamic @phase_col. Same "this page is
     static brand-primary, not phase-reactive" reasoning as the header
     above: "< back" should always be brand red, not whatever colour the
     user's current cycle phase happens to be. %>
<% phase_color("#933a35") %>

<%
  today       = Time.zone.today
  first_day   = @month.beginning_of_month
  last_day    = @month.end_of_month
  first_dow   = (first_day.wday == 0) ? 6 : first_day.wday - 1
  trailing    = (7 - ((first_dow + last_day.day) % 7)) % 7
  prev_tail   = (first_day - first_dow..first_day - 1).to_a
  next_head   = (last_day + 1..last_day + trailing).to_a
  all_dates   = prev_tail + (first_day..last_day).to_a + next_head
  prev_month  = @month.prev_month
  next_month  = @month.next_month

  # Same 5-row cap as /calendar (see CalendarHelper#cap_calendar_weeks).
  # The existing/selected period date takes priority over today: this is an
  # edit form, so the row holding the date being edited must stay visible
  # even if that pushes "today" out of view.
  reference_date = if @existing && @existing.year == @month.year && @existing.month == @month.month
    @existing
  elsif @month.year == today.year && @month.month == today.month
    today
  else
    first_day
  end
  all_dates = cap_calendar_weeks(all_dates, reference_date)

  start_heading = t("tracking.period_update.period.select_start_heading")
  end_heading   = t("tracking.period_update.period.select_end_heading")
%>

<div class="bg-white min-h-screen pb-28"
     data-controller="onboarding-calendar"
     data-onboarding-calendar-start-heading-value="<%= start_heading %>"
     data-onboarding-calendar-end-heading-value="<%= end_heading %>">
  <div class="max-w-app mx-auto px-4 pt-3">

    <%# ── Back (below app bar) ── %>
    <%= render "shared/back_link", fallback: tracking_index_path %>

    <%# ── Greeting ── %>
    <div class="mb-3.5">
      <p class="italic text-brand-primary text-4xl font-medium leading-[44px] font-sans m-0">
        Hello <%= current_user.name&.split&.first || "there" %>
      </p>
      <p class="text-brand-primary text-base font-medium m-0" data-onboarding-calendar-target="heading">
        <%= start_heading %>
      </p>
    </div>

    <%# ── Month navigation ── %>
    <div class="flex items-center gap-4 mb-4">
      <%= link_to period_tracking_index_path(date: prev_month),
            class: "flex items-center justify-center w-9 h-9 rounded-full bg-brand-field no-underline" do %>
        <svg width="16" height="16" fill="none" stroke="#933a35" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg>
      <% end %>
      <span class="font-medium text-base text-brand-primary font-sans tracking-007"><%= @month.strftime("%B") %></span>
      <%= link_to period_tracking_index_path(date: next_month),
            class: "flex items-center justify-center w-9 h-9 rounded-full bg-brand-field no-underline" do %>
        <svg width="16" height="16" fill="none" stroke="#933a35" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6" /></svg>
      <% end %>
    </div>

  </div>

  <%= form_with url: period_tracking_index_path, method: :patch, local: true do |f| %>
    <%= f.hidden_field :last_period_start, value: @existing&.iso8601,
          data: { onboarding_calendar_target: "startInput" } %>
    <%= f.hidden_field :last_period_end, value: @period_end&.iso8601,
          data: { onboarding_calendar_target: "endInput" } %>

    <%# ── Day-of-week headers + calendar grid: full-bleed edge-to-edge, no horizontal padding ── %>
    <div class="max-w-app mx-auto">
      <div class="grid grid-cols-7 gap-0 mb-1">
        <% weekday_initials.each do |d| %>
          <div class="text-center text-brand-secondary text-xs font-semibold tracking-wider py-1"><%= d %></div>
        <% end %>
      </div>

      <div class="grid grid-cols-7 auto-rows-calendar gap-x-0 gap-y-2">
        <% all_dates.each do |day| %>
          <%
            in_month   = day.month == @month.month
            is_today   = day == today
            is_future  = day > today
          %>
          <% if !in_month || is_future %>
            <div style="display:flex; flex-direction:column; height:100%; overflow:hidden;<%= in_month ? '' : ' opacity:0.45;' %>">
              <div style="height:14px; flex-shrink:0; background:#EDE1D5;"></div>
              <div style="flex:1; padding:1px 4px 3px; display:flex; flex-direction:column;">
                <div style="display:flex; align-items:center; justify-content:center;">
                  <span style="font-size:13px; font-weight:400; color:#C4B8B8; line-height:1;">
                    <%= day.day %>
                  </span>
                </div>
              </div>
            </div>
          <% else %>
            <button type="button"
                    data-action="click->onboarding-calendar#select"
                    data-onboarding-calendar-target="day"
                    data-date="<%= day.iso8601 %>"
                    data-today="<%= is_today %>"
                    style="display:flex; flex-direction:column; height:100%; overflow:hidden; background:transparent; border:none; padding:0; cursor:pointer;">
              <%# Matches calendar/_day_cell's band pattern (show_cycle_day_on_band):
                   the band carries the *cycle* day (1 = whichever date is tapped as
                   start, regardless of which date-of-month that is), separate from
                   the actual date-of-month shown in the number span below. Text is
                   set by #renderHighlights in the JS controller, not here — the
                   band's own idle text stays empty. %>
              <span data-onboarding-calendar-target="band"
                    style="height:14px; flex-shrink:0; display:flex; align-items:center; justify-content:center; background:#EDE1D5; color:#FFFFFF; font-size:9px; font-weight:700; line-height:1; letter-spacing:0.03em;"></span>
              <div style="flex:1; padding:<%= is_today ? '0' : '1px' %> 4px 3px; display:flex; flex-direction:column;">
                <div style="display:flex; align-items:center; justify-content:center;">
                  <% if is_today %>
                    <span style="display:inline-flex; align-items:center; justify-content:center; min-width:24px; height:24px; padding:0 4px; border-radius:0 0 12px 12px; background:#933a35; color:#FFF; font-size:12px; font-weight:700; line-height:1; box-sizing:border-box;">
                      <%= day.day %>
                    </span>
                  <% else %>
                    <%# #EDE1D5 — the actual date-number colour, per Figma. No
                         badge/circle even when the day is inside the selected period —
                         the band above is the only selection indicator now. Static;
                         nothing here changes with selection, so no JS target needed. %>
                    <span style="font-size:13px; font-weight:600; color:#EDE1D5; line-height:1;">
                      <%= day.day %>
                    </span>
                  <% end %>
                </div>
              </div>
            </button>
          <% end %>
        <% end %>
      </div>
    </div>

    <%# ── Submit ── %>
    <div class="max-w-app mx-auto px-4 pt-6 pb-4 flex justify-center">
      <%= f.submit "Submit",
            data: { onboarding_calendar_target: "submit" },
            class: "flex items-center justify-center w-[253px] h-[52px] text-white bg-brand-primary rounded-lg text-2xl font-medium font-sans border-0 cursor-pointer #{'hidden' unless @existing}" %>
    </div>
  <% end %>
</div>
