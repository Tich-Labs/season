<%# Weekly Feedback modal - slides up from bottom %>
<div id="weekly-feedback-modal-container"
     data-controller="weekly-feedback-modal"
     class="hidden fixed inset-0 z-60 bg-black/45 flex items-end justify-center p-0">

  <div data-weekly-feedback-modal-target="container"
       class="bg-brand-background rounded-t-3xl p-8 pt-8 w-full max-w-app relative max-h-[85dvh] overflow-y-auto" style="padding-bottom: calc(8rem + env(safe-area-inset-bottom, 0px));">

    <%# Drag handle %>
    <div class="w-10 h-1 bg-brand-warm rounded mx-auto mb-6"></div>

    <%# Close %>
    <button type="button"
            data-action="click->weekly-feedback-modal#close"
            class="absolute top-5 right-5 bg-none border-none text-brand-secondary text-xl leading-none cursor-pointer p-1"
            aria-label="Close">&times;</button>

    <%# Week label %>
    <h2 data-weekly-feedback-modal-target="weekLabel" class="font-montserrat text-xl font-bold text-brand-primary m-0 mb-5"></h2>

    <%# Already completed state %>
    <div data-weekly-feedback-modal-target="alreadyCompleted" style="display:none;" class="text-center py-8">
      <div class="w-14 h-14 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg width="28" height="28" fill="none" stroke="#2E6B3E" stroke-width="2.5" viewBox="0 0 24 24">
          <polyline points="20 6 9 17 4 12" />
        </svg>
      </div>
      <p class="text-brand-primary text-lg font-semibold mb-2"><%= t("shared.weekly_feedback_modal.already_completed") %></p>
      <p class="text-brand-secondary text-sm mb-6"><%= t("shared.weekly_feedback_modal.already_completed_text") %></p>
      <button type="button"
              data-action="click->weekly-feedback-modal#close"
              class="bg-brand-primary text-white rounded-xl py-3 px-8 text-15 font-semibold font-sans">
        <%= t("shared.weekly_feedback_modal.close") %>
      </button>
    </div>

    <%# Form wrapper %>
    <div class="wf-form-wrapper">
      <form data-action="submit->weekly-feedback-modal#submit">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

        <div data-weekly-feedback-modal-target="questions" class="space-y-6 mb-6">
        </div>

        <button type="submit"
                class="w-full py-3 bg-brand-primary text-white rounded-xl text-base font-medium font-sans hover:bg-brand-primary-dark transition-colors">
          <%= t("shared.weekly_feedback_modal.submit") %>
        </button>
      </form>
    </div>

    <%# Success state %>
    <div data-weekly-feedback-modal-target="success" style="display:none;" class="text-center py-8">
      <div class="w-14 h-14 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg width="28" height="28" fill="none" stroke="#2E6B3E" stroke-width="2.5" viewBox="0 0 24 24">
          <polyline points="20 6 9 17 4 12" />
        </svg>
      </div>
      <p class="text-brand-primary text-lg font-semibold mb-2"><%= t("shared.weekly_feedback_modal.thank_you") %></p>
      <p class="text-brand-secondary text-sm mb-6"><%= t("shared.weekly_feedback_modal.success_text") %></p>
      <button type="button"
              data-action="click->weekly-feedback-modal#close"
              class="bg-brand-primary text-white rounded-xl py-3 px-8 text-15 font-semibold font-sans">
        <%= t("shared.weekly_feedback_modal.close") %>
      </button>
    </div>
  </div>

  <%# Hidden template for questions %>
  <template data-weekly-feedback-modal-target="questionTemplate">
    <div data-question-id="" data-question-type="" class="rounded-xl bg-white/50 p-4">
      <p class="wf-question-text font-montserrat text-base font-medium text-brand-primary mb-3"></p>

      <%# Multiple choice options %>
      <div class="wf-multiple-choice" style="display:none;flex-wrap:wrap;gap:8px;"></div>

      <%# Yes / No + input %>
      <div class="wf-yesno-wrapper" style="display:none;">
        <div class="flex gap-3 mb-3">
          <button type="button" data-value="yes" class="wf-yesno-btn flex-1 py-2 px-4 rounded-lg text-sm font-medium border font-sans" style="background:#FFFFFF;color:#933a35;border-color:#EDE1D5;"
                  data-action="click->weekly-feedback-modal#toggleYesNo"><%= t("shared.weekly_feedback_modal.yes") %></button>
          <button type="button" data-value="no" class="wf-yesno-btn flex-1 py-2 px-4 rounded-lg text-sm font-medium border font-sans" style="background:#FFFFFF;color:#933a35;border-color:#EDE1D5;"
                  data-action="click->weekly-feedback-modal#toggleYesNo"><%= t("shared.weekly_feedback_modal.no") %></button>
        </div>
        <div class="wf-why-input" style="display:none;">
          <textarea class="wf-why-textarea w-full px-4 py-3 rounded-xl border border-brand-field bg-white text-gray-800 text-base font-sans placeholder:text-gray-400 focus:border-brand-primary focus:outline-none resize-none"
                    rows="2" placeholder="<%= t("shared.weekly_feedback_modal.why_placeholder") %>"></textarea>
        </div>
      </div>

      <%# Text only %>
      <div class="wf-text-wrapper" style="display:none;">
        <textarea class="wf-text-textarea w-full px-4 py-3 rounded-xl border border-brand-field bg-white text-gray-800 text-base font-sans placeholder:text-gray-400 focus:border-brand-primary focus:outline-none resize-none"
                  rows="3" placeholder="<%= t("shared.weekly_feedback_modal.answer_placeholder") %>"></textarea>
      </div>
    </div>
  </template>
</div>
