<%#
  Locals:
    field_id   — String, id attribute for the button AND the notification
                 preference key sent to the server (matches every call site)
    checked    — Boolean, initial state
    aria_label — String, screen-reader label

  Reuses the .toggle-btn/.toggle-track/.toggle-thumb CSS already proven on
  Settings > Calendar (app/assets/tailwind/application.css). Persists via a
  real Stimulus data-action — see notification_toggle_controller.js for why
  this can't be an inline onclick/onchange attribute under this app's CSP.
%>
<button type="button"
        id="<%= field_id %>"
        role="switch"
        aria-label="<%= aria_label %>"
        aria-checked="<%= checked %>"
        class="toggle-btn <%= "active" if checked %>"
        data-controller="notification-toggle"
        data-notification-toggle-key-value="<%= field_id %>"
        data-notification-toggle-url-value="<%= update_notifications_settings_path %>"
        data-action="click->notification-toggle#toggle">
  <div class="toggle-track"><div class="toggle-thumb"></div></div>
</button>
