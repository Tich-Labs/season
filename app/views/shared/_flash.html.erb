<%#
  App-wide flash display. Most controllers set flash[:notice] / flash[:alert]
  on redirect (e.g. SettingsController#update_password) but the main layout
  never rendered them, so success/failure feedback was silently dropped —
  actions looked like they "did nothing" even when they worked (or failed
  validation) server-side. Auth screens render their own inline errors and
  opt out via :hide_flash.
%>
<% if (notice.present? || alert.present?) && !content_for?(:hide_flash) %>
  <div class="max-w-app mx-auto px-4 pt-3 space-y-2">
    <% if notice.present? %>
      <div role="status" data-controller="auto-hide" data-auto-hide-delay-value="5"
           class="bg-brand-field rounded-xl px-4 py-3 flex items-start justify-between gap-3">
        <span class="text-brand-primary text-sm font-medium"><%= notice %></span>
        <button type="button" data-action="click->auto-hide#dismiss" aria-label="Dismiss" class="shrink-0 text-brand-primary/70 bg-transparent border-0 p-0 cursor-pointer">✕</button>
      </div>
    <% end %>
    <% if alert.present? %>
      <div role="alert" data-controller="auto-hide" data-auto-hide-delay-value="5"
           class="bg-brand-error rounded-xl px-4 py-3 flex items-start justify-between gap-3">
        <span class="text-brand-primary text-sm font-medium"><%= alert %></span>
        <button type="button" data-action="click->auto-hide#dismiss" aria-label="Dismiss" class="shrink-0 text-brand-primary/70 bg-transparent border-0 p-0 cursor-pointer">✕</button>
      </div>
    <% end %>
  </div>
<% end %>
