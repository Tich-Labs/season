<%# Consent info modal - slides up from bottom %>
<div id="consent-info-modal-container"
     data-controller="consent-info-modal"
     class="hidden fixed inset-0 z-60 bg-black/45 flex items-end justify-center p-0">

  <div class="bg-brand-background rounded-t-3xl p-8 pt-8 w-full max-w-app relative max-h-[80dvh] overflow-y-auto" style="padding-bottom: calc(6rem + env(safe-area-inset-bottom, 0px));">

    <%# Drag handle %>
    <div class="w-10 h-1 bg-brand-warm rounded mx-auto mb-6"></div>

    <%# Close %>
    <button type="button"
            data-action="click->consent-info-modal#close"
            class="absolute top-5 right-5 bg-none border-none text-brand-secondary text-xl leading-none cursor-pointer p-1"
            aria-label="Close">&times;</button>

    <%# Title %>
    <h2 id="ci-title" class="font-montserrat text-xl font-bold text-brand-primary m-0 mb-3"></h2>

    <%# What data %>
    <p class="font-montserrat text-base font-semibold text-brand-primary m-0 mb-2">What this includes:</p>
    <p id="ci-what" class="font-montserrat text-sm text-brand-secondary m-0 mb-3 leading-relaxed"></p>

    <%# Items list %>
    <ul id="ci-items" class="list-none p-0 m-0 mb-4 space-y-1.5"></ul>

    <%# Why %>
    <p class="font-montserrat text-base font-semibold text-brand-primary m-0 mb-2">Why we need it:</p>
    <p id="ci-why" class="font-montserrat text-sm text-brand-secondary m-0 mb-3 leading-relaxed"></p>

    <%# Rights %>
    <div class="bg-brand-error rounded-xl p-4 mt-4">
      <p class="font-montserrat text-sm font-semibold text-brand-primary m-0 mb-1">Your Rights</p>
      <p id="ci-rights" class="font-montserrat text-sm text-brand-secondary m-0 leading-relaxed"></p>
    </div>

    <%# Got it button %>
    <button type="button"
            data-action="click->consent-info-modal#close"
            class="w-full mt-6 py-3 bg-brand-primary text-white rounded-xl text-base font-medium font-sans">
      Got it
    </button>

  </div>
</div>
