<%# Support / Bug Report modal - slides up from bottom %>
<div id="support-modal-container"
     data-controller="support-modal"
     class="hidden fixed inset-0 z-60 bg-black/45 flex items-end justify-center p-0">

  <div class="bg-brand-background rounded-t-3xl p-8 pt-8 w-full max-w-app relative" style="padding-bottom: calc(8rem + env(safe-area-inset-bottom, 0px));">

    <%# Drag handle %>
    <div class="w-10 h-1 bg-[#D1C4C2] rounded mx-auto mb-6"></div>

    <%# Close %>
    <button type="button"
            data-action="click->support-modal#close"
            class="absolute top-5 right-5 bg-none border-none text-brand-secondary text-xl leading-none cursor-pointer p-1"
            aria-label="Close">&times;</button>

    <%# Heading %>
    <h2 id="sm-heading" class="font-montserrat text-xl font-bold text-brand-primary m-0 mb-1.5"><%= t("shared.support_modal.title") %></h2>
    <p id="sm-description" class="font-montserrat text-sm text-brand-secondary m-0 mb-5 leading-relaxed"><%= t("shared.support_modal.description") %></p>

    <%# Form %>
    <form action="/feedbacks" method="post" enctype="multipart/form-data">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <input type="hidden" id="support_type" name="feedback[type]" value="support">

      <%# Type toggle %>
      <div class="flex gap-2 mb-4">
        <button type="button"
                data-type="support"
                data-action="click->support-modal#selectType"
                class="sm-type-btn flex-1 py-2 px-3 rounded-lg text-sm font-medium bg-brand-primary text-white border border-brand-primary transition-colors">
          <%= t("shared.support_modal.support") %>
        </button>
        <button type="button"
                data-type="bug_report"
                data-action="click->support-modal#selectType"
                class="sm-type-btn flex-1 py-2 px-3 rounded-lg text-sm font-medium bg-brand-field text-brand-primary border border-brand-field transition-colors">
          <%= t("shared.support_modal.bug") %>
        </button>
      </div>

      <%# Message textarea %>
      <textarea id="sm-message" name="feedback[message]"
                rows="4"
                required
                placeholder="<%= t("shared.support_modal.placeholder") %>"
                class="w-full px-4 py-3 rounded-xl border border-brand-field bg-white text-gray-800 text-base font-['Montserrat'] placeholder-gray-400 focus:border-brand-primary focus:ring-1 focus:ring-brand-primary focus:outline-none resize-none"></textarea>

      <%# Attachment (screenshot/audio) %>
      <div class="mt-3">
        <label class="flex items-center gap-2 text-sm text-brand-primary cursor-pointer hover:bg-brand-field px-3 py-2 rounded-lg transition-colors">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
          </svg>
          <span><%= t("shared.support_modal.add_attachment") %></span>
          <input type="file" name="feedback[media]" accept="image/*,audio/*" class="hidden" data-action="change->support-modal#fileSelected">
        </label>
        <p id="sm-attachment-name" class="text-xs text-gray-500 px-3 mt-1 truncate"></p>
      </div>

      <div id="fm-error"></div>

      <%# Submit button %>
      <button type="submit"
              class="w-full mt-4 py-3 bg-brand-primary text-white rounded-xl text-base font-medium font-['Montserrat'] hover:bg-[#7a2f2a] transition-colors">
        <%= t("shared.support_modal.send") %>
      </button>
    </form>
  </div>
</div>
