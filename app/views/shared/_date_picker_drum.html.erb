<%# Date picker drum — collapsed pill that expands into a scrollable list of
     the last 30 days (see date_picker_controller.js). Shared by /symptoms,
     /superpowers, and /tracking.
     Locals:
       date:      the currently selected Date
       date_path: callable taking a Date, returning its URL
     Marks the selected day with data-selected so the controller's open()
     can scroll it into view -- previously nothing set this on any of the
     three pages, so that auto-scroll was silently dead everywhere. The
     collapsed button is hidden on open (toggleButton target) -- previously
     it stayed visible on top of the expanded list, its own label/chevron
     overlapping the close button and first row underneath it.
     This is a plain list, not a wheel picker (contrast the sp-highlight
     scroll-pickers used for sleep/temperature/weight/cycle-length) -- every
     row stays fully legible and only the selected day is bold, matching
     Figma. Previously this used sp-highlight's own heavy padding/fade/crop
     styling, which only kept ~1 row legible at a time. %>
<div class="flex justify-center pt-6 pb-2" data-controller="date-picker">
  <div class="relative bg-brand-field overflow-hidden transition-all duration-300 ease-out"
       style="width:155px; height:31px; border-radius:133px;"
       data-date-picker-target="drum">

    <%# Collapsed pill header %>
    <button class="w-full h-[31px] flex items-center justify-center gap-2 text-brand-primary font-medium text-base font-sans focus:outline-none"
            data-date-picker-target="toggleButton"
            data-action="click->date-picker#toggle"
            aria-label="Select date">
      <%= date.strftime("%-d %B") %>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none"
           stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true">
        <polyline points="6 9 12 15 18 9" />
      </svg>
    </button>

    <%# Expanded content %>
    <div class="hidden" data-date-picker-target="content">
      <div class="flex justify-end pt-3 pr-4 pb-1">
        <button data-action="click->date-picker#close" aria-label="Close date picker"
                class="text-brand-primary focus:outline-none">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none"
               stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true">
            <polyline points="18 15 12 9 6 15" />
          </svg>
        </button>
      </div>
      <ul class="overflow-y-auto text-center scrollbar-hide" style="height:173px;">
        <%# Date.current, not Date.today -- the latter reads the system/OS
             timezone, not this app's configured Time.zone (UTC). They agree
             most of the day, but disagree for a few hours around each UTC
             midnight on any server whose local clock runs ahead of UTC --
             during that window Date.today already reads "tomorrow" while
             the rest of the app (Time.zone.today) still says "today",
             making one extra, actually-future day render here as if it
             were valid history to tap into. %>
        <% ((Date.current - 29)..Date.current).each do |d| %>
          <% selected = d == date %>
          <li class="py-px leading-tight">
            <%= link_to d.strftime("%-d %B"), date_path.call(d),
                  class: "block font-sans no-underline text-brand-primary #{selected ? 'font-bold text-sm' : 'font-normal text-sm'}",
                  data: (selected ? {selected: true} : {}) %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>
