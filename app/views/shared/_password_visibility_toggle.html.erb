<%# Eye icon that shows/hides the sibling password input. Pairs with a
    wrapping `data-controller="password-visibility"` div and an input carrying
    `data-password-visibility-target="input"` (see password_visibility_controller.js). %>
<button type="button" data-action="click->password-visibility#toggle" aria-label="Toggle password visibility"
        class="absolute right-3 top-1/2 -translate-y-1/2 cursor-pointer bg-transparent border-0 p-0">
  <svg data-password-visibility-target="eyeOpen" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="rgba(147,58,53,0.5)" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
  <svg data-password-visibility-target="eyeClosed" class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="rgba(147,58,53,0.5)" stroke-width="1.5"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" /><line x1="1" y1="1" x2="23" y2="23" /></svg>
</button>
