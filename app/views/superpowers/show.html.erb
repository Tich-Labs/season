<%= native_navbar_tag("Superpowers review") if native_app? %>
<% content_for(:page_title) { "Superpowers — #{@superpower_log.date.strftime("%d %b")}" } %>

<div class="bg-brand-background min-h-screen pb-20">
  <div class="max-w-app mx-auto px-4 pt-5">

    <div class="flex items-center gap-3 mb-5">
      <%= link_to superpowers_path, class: "text-brand-primary" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <polyline points="15 18 9 12 15 6" />
        </svg>
      <% end %>
      <h1 class="text-brand-primary text-xl font-bold"><%= @superpower_log.date.strftime("%A, %-d %B") %></h1>
    </div>

    <% if @superpower_log.ratings.present? %>
      <div class="flex flex-col gap-3 mb-5">
        <% @superpower_log.ratings.each do |name, rating| %>
          <% val = rating.to_i %>
          <% pct = (val / 3.0 * 100).round %>
          <div class="bg-white rounded-xl p-4">
            <div class="flex justify-between items-center mb-3">
              <span class="text-brand-primary text-sm font-semibold"><%= name %></span>
              <span class="text-brand-primary text-sm font-bold"><%= val %>/3</span>
            </div>
            <div class="flex gap-1.5">
              <% 3.times do |i| %>
                <div class="flex-1 h-2 rounded-full" style="background:<%= i < val ? '#933a35' : '#EDE1D5' %>;"></div>
              <% end %>
            </div>
            <% if val > 0 %>
              <p class="text-xs text-brand-secondary mt-2 capitalize"><%= ["", "low", "medium", "high"][val] %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-white rounded-xl p-5 text-center mb-5">
        <p class="text-brand-secondary text-sm"><%= t("superpowers.show.no_logs") %></p>
      </div>
    <% end %>

    <%= link_to t("superpowers.show.view_day"), daily_view_path(date: @superpower_log.date.to_s),
          class: "block w-full bg-brand-primary text-white text-center rounded-xl py-4 text-lg font-medium no-underline" %>

  </div>
</div>
