<% content_for(:page_title) { "Superpowers" } %>
<% content_for(:header_color) { @phase_colour } %>
<% content_for(:header_dark) { "true" } %>
<%# Not under settings/ or calendar#index, so the layout was showing both
     the "+" quick-actions FAB and the calendar-home FAB stacked together.
     Keep only the calendar FAB. %>
<% content_for(:hide_quick_actions) { "true" } %>
<% content_for(:header_left) do %>
  <%= link_to tracking_index_path, class: "text-white text-sm font-medium no-underline p-2 font-montserrat" do %>
    &lt; back
  <% end %>
<% end %>

<div class="bg-white min-h-screen pb-32">

  <div class="max-w-app mx-auto px-4">

    <%# ── Date picker drum ────────────────────────────────────────────── %>
    <div class="flex justify-center pt-6 pb-2" data-controller="date-picker">
      <div class="relative bg-brand-field overflow-hidden transition-all duration-300 ease-out"
           style="width:155px; height:31px; border-radius:133px;"
           data-date-picker-target="drum">

        <button class="w-full h-[31px] flex items-center justify-center gap-2 text-brand-primary font-medium text-base font-sans focus:outline-none"
                data-action="click->date-picker#toggle"
                aria-label="Select date">
          <%= @date.strftime("%-d %B") %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none"
               stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </button>

        <div class="hidden" data-date-picker-target="content">
          <div class="flex justify-end pt-3 pr-4 pb-0">
            <button data-action="click->date-picker#close" aria-label="Close date picker"
                    class="text-brand-primary focus:outline-none">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none"
                   stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true">
                <polyline points="18 15 12 9 6 15" />
              </svg>
            </button>
          </div>
          <div class="relative" style="height:173px;">
            <div class="sp-highlight" style="top:65px; height:42px;"></div>
            <ul class="overflow-y-auto text-center scrollbar-hide"
                style="height:173px; padding:65px 0; scroll-snap-type:y mandatory;">
              <% ((Date.today - 29)..Date.today).each do |d| %>
                <li style="scroll-snap-align:center; height:42px; min-height:42px; display:flex; align-items:center; justify-content:center;">
                  <%= link_to d.strftime("%-d %B"), superpowers_path(date: d),
                        class: "block font-sans no-underline #{d == @date ? 'font-bold text-base text-brand-primary opacity-100' : 'font-normal text-sm text-brand-primary opacity-45'}" %>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Log today's superpowers -->
    <div class="bg-white rounded-xl p-5 mb-3"
         data-controller="superpower"
         data-superpower-url-value="<%= superpowers_path %>">
      <p class="text-brand-primary text-lg font-medium text-center font-sans">You are in your</p>
      <p class="font-extrabold text-3xl leading-tight text-center font-sans mb-6" style="color:<%= @phase_colour %>;">
        <%= @phase.capitalize %> Phase
      </p>

      <div class="flex flex-col">
        <% @superpowers.each do |sp| %>
          <% val = (@ratings[sp] || 0).to_i %>
          <%
            fill_pct = (val / 3.0 * 100).round
            fill_bg  = val.positive? \
              ? "background:linear-gradient(to right,#933a35 #{fill_pct}%,#EDE1D5 #{fill_pct}%)" \
              : "background:#EDE1D5"
          %>
          <div class="sp-row" style="margin-bottom:25px;">
            <span class="block font-medium font-sans mb-2"
                  style="font-size:16px; color:#933a35; letter-spacing:0.07em;">
              <%= sp %>
            </span>

            <div class="relative" style="padding-bottom:22px;">
              <input type="range" min="0" max="3" step="1" value="<%= val %>" autocomplete="off"
                     class="symptom-slider"
                     data-action="input->superpower#save"
                     data-field="<%= sp %>"
                     aria-label="<%= sp %> rating"
                     style="<%= fill_bg %>;">

              <span class="absolute text-xs font-sans font-normal tracking-[0.4px] pointer-events-none"
                    style="left:calc(22px + (100% - 44px) * 1 / 3); top:20px; transform:translateX(-50%); color:<%= val == 1 ? '#933a35' : '#999' %>;"
                    data-level="1">
                low
              </span>
              <span class="absolute text-xs font-sans font-normal tracking-[0.4px] pointer-events-none"
                    style="left:calc(22px + (100% - 44px) * 2 / 3); top:20px; transform:translateX(-50%); color:<%= val == 2 ? '#933a35' : '#999' %>;"
                    data-level="2">
                medium
              </span>
              <span class="absolute text-xs font-sans font-normal tracking-[0.4px] pointer-events-none"
                    style="right:22px; top:20px; transform:translateX(50%); color:<%= val == 3 ? '#933a35' : '#999' %>;"
                    data-level="3">
                high
              </span>
            </div>
          </div>
        <% end %>
      </div>

      <%# Submit button %>
      <div class="mt-6">
        <%= link_to "Submit", tracking_index_path,
              class: "block w-[253px] mx-auto text-white text-center rounded-lg py-4 text-xl font-medium tracking-wide font-sans no-underline bg-brand-primary" %>
      </div>
    </div>

    <!-- Recent logs -->
    <% if @superpower_logs&.any? %>
      <div class="bg-white rounded-xl p-5">
        <h2 class="text-brand-primary text-lg font-bold mb-4">Recent logs</h2>
        <div class="flex flex-col gap-2">
          <% @superpower_logs.last(7).reverse.each do |log| %>
            <a href="<%= superpower_path(log) %>"
               class="flex justify-between items-center p-3 bg-brand-background rounded-lg no-underline">
              <span class="text-brand-primary text-sm font-medium"><%= log.date.strftime("%d %b") %></span>
              <% if log.ratings.present? %>
                <span class="text-brand-secondary text-xs"><%= log.ratings.size %> rated</span>
              <% end %>
              <svg xmlns="http://www.w3.org/2000/svg" width="4" height="4" fill="none" stroke="#933a35" stroke-width="2" viewBox="0 0 24 24">
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </a>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>
</div>
