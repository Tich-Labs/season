<% content_for(:page_title) { "Superpowers" } %>
<% content_for(:header_color) { @phase_colour } %>
<% content_for(:header_dark) { "true" } %>
<%# Not under settings/ or calendar#index, so the layout would otherwise show
     both the "+" quick-actions FAB and the default calendar FAB. Neither is
     in Figma for this screen — the header-left "< back" link below is the
     only navigation this page needs. %>
<% content_for(:hide_quick_actions) { "true" } %>
<% content_for(:hide_calendar_fab) { "true" } %>
<% content_for(:header_left) do %>
  <%= link_to tracking_index_path, class: "text-white text-sm font-medium no-underline p-2 font-montserrat" do %>
    &lt; back
  <% end %>
<% end %>

<div class="bg-white min-h-screen pb-32">

  <div class="max-w-app mx-auto px-4">

    <%# ── Date picker drum ────────────────────────────────────────────── %>
    <%= render "shared/date_picker_drum", date: @date, date_path: ->(d) { superpowers_path(date: d) } %>

    <!-- Log today's superpowers -->
    <div class="bg-white rounded-xl p-5 mb-3"
         data-controller="superpower"
         data-superpower-url-value="<%= superpowers_path %>">
      <p class="text-brand-primary text-lg font-medium text-center font-sans">You are in your</p>
      <p class="font-extrabold text-3xl leading-tight text-center font-sans mb-6" style="color:<%= @phase_colour %>;">
        <%= @phase.capitalize %> Phase
      </p>

      <div class="flex flex-col">
        <% @superpowers.each do |sp| %>
          <% val = (@ratings[sp] || 0).to_i %>
          <%
            fill_pct = (val / 3.0 * 100).round
            fill_bg  = val.positive? \
              ? "background:linear-gradient(to right,#933a35 #{fill_pct}%,#EDE1D5 #{fill_pct}%)" \
              : "background:#EDE1D5"
          %>
          <div class="sp-row" style="margin-bottom:25px;">
            <span class="block font-medium font-sans mb-2"
                  style="font-size:16px; color:#933a35; letter-spacing:0.07em;">
              <%= sp %>
            </span>

            <div class="relative" style="padding-bottom:22px;">
              <input type="range" min="0" max="3" step="1" value="<%= val %>" autocomplete="off"
                     class="symptom-slider"
                     data-action="input->superpower#save"
                     data-field="<%= sp %>"
                     aria-label="<%= sp %> rating"
                     style="<%= fill_bg %>;">

              <span class="absolute text-xs font-sans font-normal tracking-[0.4px] pointer-events-none"
                    style="left:calc(22px + (100% - 44px) * 1 / 3); top:20px; transform:translateX(-50%); color:<%= val == 1 ? '#933a35' : '#999' %>;"
                    data-level="1">
                low
              </span>
              <span class="absolute text-xs font-sans font-normal tracking-[0.4px] pointer-events-none"
                    style="left:calc(22px + (100% - 44px) * 2 / 3); top:20px; transform:translateX(-50%); color:<%= val == 2 ? '#933a35' : '#999' %>;"
                    data-level="2">
                medium
              </span>
              <span class="absolute text-xs font-sans font-normal tracking-[0.4px] pointer-events-none"
                    style="right:22px; top:20px; transform:translateX(50%); color:<%= val == 3 ? '#933a35' : '#999' %>;"
                    data-level="3">
                high
              </span>
            </div>
          </div>
        <% end %>
      </div>

      <%# Submit button — pre-submit review modal, matching the pattern
           /symptoms uses (see submit_modal_controller.js / this page's
           superpowers-submit-modal equivalent). Previously a bare link
           straight to /tracking with no review step at all. %>
      <div class="mt-6" data-controller="superpowers-submit-modal">
        <button type="button" data-action="click->superpowers-submit-modal#open"
                class="block w-[253px] mx-auto text-white text-center rounded-lg py-4 text-xl font-medium tracking-wide font-sans border-0 cursor-pointer bg-brand-primary">
          <%= t("superpowers.index.submit") %>
        </button>

        <%# ── Pre-submit review modal ───────────────────────────────────── %>
        <div class="hidden fixed inset-0 z-[100] flex items-start justify-center bg-black/40"
             data-superpowers-submit-modal-target="modal"
             data-action="click->superpowers-submit-modal#overlayClick">
          <div class="relative bg-white rounded-[29px] mx-4 mt-8" style="width:351px; max-width:calc(100vw - 32px);">
            <%# Close button %>
            <button data-action="click->superpowers-submit-modal#close" aria-label="Close"
                    class="absolute top-3 right-3 w-11 h-11 flex items-center justify-center rounded-full rotate-45 border-0 bg-transparent cursor-pointer"
                    style="color:#A43600;">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#933a35" stroke-width="3">
                <line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" />
              </svg>
            </button>

            <%# Title %>
            <p class="text-brand-primary font-medium text-22 text-center pt-8 pb-2 leading-tight font-sans"><%= t("superpowers.index.confirm_tracking_title") %></p>
            <div class="mx-[30px] border-t border-brand-field mb-4"></div>

            <%# Count %>
            <p data-superpowers-submit-modal-target="count"
               class="text-brand-primary font-medium text-base tracking-003 px-[25px] mb-3 font-sans"></p>

            <%# Scrollable list — populated dynamically by JS %>
            <div class="mx-[15px] bg-brand-field/50 rounded-[30px] py-3 px-4 mb-5" style="max-height:280px; overflow-y:auto;">
              <div data-superpowers-submit-modal-target="list"></div>
            </div>

            <%# Buttons %>
            <%= link_to t("superpowers.index.submit_tracking"), tracking_index_path(tracking_saved: 1),
                  class: "block mx-[25px] text-center bg-brand-primary text-white rounded-lg py-[14px] text-base font-medium tracking-003 font-sans no-underline mb-3" %>
            <button data-action="click->superpowers-submit-modal#close"
                    class="block w-full text-center text-brand-primary text-base font-medium tracking-003 font-sans pb-6 border-0 bg-transparent cursor-pointer">
              <%= t("superpowers.index.go_back") %>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Recent logs -->
    <% if @superpower_logs&.any? %>
      <div class="bg-white rounded-xl p-5">
        <h2 class="text-brand-primary text-lg font-bold mb-4">Recent logs</h2>
        <div class="flex flex-col gap-2">
          <% @superpower_logs.last(7).reverse.each do |log| %>
            <a href="<%= superpower_path(log) %>"
               class="flex justify-between items-center p-3 bg-brand-background rounded-lg no-underline">
              <span class="text-brand-primary text-sm font-medium"><%= log.date.strftime("%d %b") %></span>
              <% if log.ratings.present? %>
                <span class="text-brand-secondary text-xs"><%= log.ratings.size %> rated</span>
              <% end %>
              <svg xmlns="http://www.w3.org/2000/svg" width="4" height="4" fill="none" stroke="#933a35" stroke-width="2" viewBox="0 0 24 24">
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </a>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>
</div>
