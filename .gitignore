# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*
!/.env.template

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/db/*.sqlite3
/db/*.sqlite3-journal
/db/*.sqlite3-wal
/db/*.sqlite3-shm
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

# Dev usage
setup.sh

/app/assets/builds/*
!/app/assets/builds/.keep

# Ignore code samples or generated docs content not checked in
/docs/code/

# Ignore specific non-avatar images
/app/assets/images/avatars/frame-255.png
/app/assets/images/avatars/frame-256.png
.DS_Store
docs/railsworld.html
Archive SeasonApp_2026-05-22T09-06-50.txt
*.bak
node_modules/
test-results/
playwright-report/
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/.kotlin/
android/local.properties
android/gradlew.bat

# iOS build artifacts
ios/SeasonApp/build/
ios/**/*.xcarchive

# Ruby Native
.ruby_native/

# IDE / local tooling
.idea/
.claude/

