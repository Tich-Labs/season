{
  "rules": [
    {
      "patterns": [
        "/calendar",
        "/tracking",
        "/daily/*",
        "/symptoms",
        "/superpowers"
      ],
      "properties": {
        "presentation": "default",
        "pull_to_refresh_enabled": true
      }
    },
    {
      "patterns": [
        "/settings/*",
        "/account/*"
      ],
      "properties": {
        "presentation": "modal",
        "pull_to_refresh_enabled": false
      }
    }
  ]
}
