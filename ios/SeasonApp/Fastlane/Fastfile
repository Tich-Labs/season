default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    xcodegen
    build_app(
      scheme: "SeasonApp",
      workspace: "SeasonApp.xcworkspace",
      export_method: "app-store-connect",
      clean: true
    )
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc "Build for development (local testing)"
  lane :dev do
    xcodegen
    build_app(
      scheme: "SeasonApp",
      workspace: "SeasonApp.xcworkspace",
      export_method: "development",
      clean: true
    )
  end
end
