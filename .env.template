# Database (local PostgreSQL)
# If using trust auth (Homebrew default): postgresql://localhost/season_development
# If using password auth (EDB/Postgres.app): postgresql://username:password@localhost/season_development
DATABASE_URL=postgresql://localhost/season_development
DATABASE_URL_TEST=postgresql://localhost/season_test

# OAuth Credentials
# Google OAuth
# IMPORTANT: In Google Cloud Console, enable the Google Calendar API for your project.
# The OAuth consent screen must include the "https://www.googleapis.com/auth/calendar" scope.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Apple OAuth (Sign In with Apple)
# Requires: Service ID + Key from developer.apple.com
# 1. developer.apple.com → Certificates → + → Services IDs → "Season Sign In"
# 2. Keys → + → Sign In with Apple → configure → download .p8 file
# 3. Team ID is shown at top-right of developer.apple.com
# 4. Private key: base64 -i ~/Downloads/AuthKey_XXXX.p8
APPLE_CLIENT_ID=com.season-app.ios.signin
APPLE_TEAM_ID=28NDQR5JC4
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----"

# Resend (Transactional Email)
RESEND_API_KEY=re_xxxxxxxxxxxxx

